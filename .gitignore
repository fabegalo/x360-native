# Everything machine-local, proprietary or derived lives under .local/:
#   toolchains/  downloaded compilers (LLVM)
#   build/       CMake build trees
#   inputs/      user-supplied XEX/dashboard/game files (never committed)
#   aot/         generated local project metadata (generic imported games)
#   evidence/    runtime logs, diagnostics and measured results
#   archive/     preserved historical sources, backups and unknown-purpose data
#   tmp/         isolated temporary fixtures
#   user/        saves, profiles, content
.local/

# CMake per-user overrides (may contain local SDK/toolchain paths)
CMakeUserPresets.json

# Editor noise
.vs/
.vscode/
*.swp

# Code generated by rexglue codegen from user-supplied XEX files (generated/<module>/).
# generated/rexglue.cmake comes from SDK templates, not from the XEX, and is kept.
# Manual titles keep the pinned SDK's source-tree generation contract; generic
# AOT outputs live in .local/build/aot/<identity>/generated. Neither is published.
titles/*/generated/*
!titles/*/generated/rexglue.cmake
# Standalone 1888 app manifests emit unused integration templates. The host
# consumes generated/<app>/sources.cmake through its own CMakeLists.txt.
/titles/dash_1888/*/generated/
titles/*/out/

# Accidental out-of-tree build output; canonical builds remain in .local/build.
/build/
/out/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
*.obj
*.o
*.pch
*.pdb
*.ilk
*.exp
*.idb
*.exe
*.dll
*.lib

# Python tooling and abandoned synthetic pipeline-cache test directories.
__pycache__/
*.py[cod]
.pytest_cache/
/pipeline-store-test-*/

# Original content belongs under .local/inputs, never in tracked source.
*.iso
*.xex
*.xexp
*.xtt
*.stfs
