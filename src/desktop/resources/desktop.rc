#include <windows.h>
#include "x360n_version.h"
1 ICON "desktop.ico"
1 VERSIONINFO
 FILEVERSION X360N_VERSION_MAJOR,X360N_VERSION_MINOR,X360N_VERSION_PATCH,0
 PRODUCTVERSION X360N_VERSION_MAJOR,X360N_VERSION_MINOR,X360N_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "x360-native preparation preview\0"
   VALUE "ProductName", "x360-native\0"
   VALUE "ProductVersion", X360N_VERSION
   VALUE "FileVersion", X360N_VERSION
   VALUE "OriginalFilename", "x360-native.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
