# Called by the sole staging producer for a destination. Never expose a partial
# DLL at its loadable name; a failed copy/rename leaves the previous file intact.
file(MAKE_DIRECTORY "${destination}")
list(REMOVE_DUPLICATES sources)
foreach(source IN LISTS sources)
    if(source STREQUAL "")
        continue()
    endif()
    get_filename_component(name "${source}" NAME)
    set(output "${destination}/${name}")
    file(SHA256 "${source}" expected)
    if(EXISTS "${output}")
        file(SHA256 "${output}" actual)
        if(actual STREQUAL expected)
            continue()
        endif()
    endif()
    # This producer owns this destination; a stale interrupted copy is replaced.
    set(temporary "${output}.stage-tmp")
    file(COPY_FILE "${source}" "${temporary}")
    file(SHA256 "${temporary}" actual)
    if(NOT actual STREQUAL expected)
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Runtime changed during staging: ${source}")
    endif()
    file(RENAME "${temporary}" "${output}" RESULT result)
    if(NOT result STREQUAL "0")
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Cannot publish runtime ${output}: ${result}")
    endif()
endforeach()
