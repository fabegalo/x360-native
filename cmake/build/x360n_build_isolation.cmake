function(x360n_guard_ninja)
    if(X360N_PROCESS_SUPERVISOR AND CMAKE_GENERATOR MATCHES "Ninja")
        get_filename_component(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
        get_filename_component(_parent "${CMAKE_SOURCE_DIR}" DIRECTORY)
        set(_title "")
        if(_parent STREQUAL "${_root}/titles" OR _parent STREQUAL "${_root}/.local/aot")
            get_filename_component(_title "${CMAKE_SOURCE_DIR}" NAME)
        endif()
        if(NOT EXISTS "${X360N_PROCESS_SUPERVISOR}")
            message(FATAL_ERROR "Native process supervisor missing")
        endif()
        if(NOT X360N_REAL_NINJA)
            set(X360N_REAL_NINJA "${CMAKE_MAKE_PROGRAM}" CACHE FILEPATH "Underlying pinned Ninja")
        endif()
        set(_guard "${CMAKE_BINARY_DIR}/x360n-ninja${CMAKE_EXECUTABLE_SUFFIX}")
        configure_file("${X360N_PROCESS_SUPERVISOR}" "${_guard}" COPYONLY)
        set(_config "{}")
        foreach(_pair "root|${_root}" "build|${CMAKE_BINARY_DIR}" "title|${_title}" "ninja|${X360N_REAL_NINJA}")
            string(FIND "${_pair}" "|" _separator)
            string(SUBSTRING "${_pair}" 0 ${_separator} _name)
            math(EXPR _start "${_separator}+1")
            string(SUBSTRING "${_pair}" ${_start} -1 _value)
            string(REPLACE "\\" "/" _value "${_value}")
            string(REPLACE "\"" "\\\"" _value "${_value}")
            string(JSON _config SET "${_config}" "${_name}" "\"${_value}\"")
        endforeach()
        file(WRITE "${CMAKE_BINARY_DIR}/x360n-ninja.json" "${_config}\n")
        set(CMAKE_MAKE_PROGRAM "${_guard}" CACHE FILEPATH "Ninja with native build ownership" FORCE)
        return()
    endif()
    if(NOT WIN32 OR NOT CMAKE_GENERATOR MATCHES "Ninja")
        return()
    endif()
    get_filename_component(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    if(NOT X360N_REAL_NINJA)
        set(X360N_REAL_NINJA "${CMAKE_MAKE_PROGRAM}" CACHE FILEPATH "Underlying pinned Ninja")
    endif()
    set(_title "__root__")
    get_filename_component(_parent "${CMAKE_SOURCE_DIR}" DIRECTORY)
    if(_parent STREQUAL "${_root}/titles" OR _parent STREQUAL "${_root}/.local/aot")
        get_filename_component(_title "${CMAKE_SOURCE_DIR}" NAME)
    endif()
    set(_guard "${CMAKE_BINARY_DIR}/x360n-ninja.cmd")
    file(TO_NATIVE_PATH "${CMAKE_BINARY_DIR}" _build)
    file(WRITE "${_guard}" "@echo off\r\npowershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${_root}/scripts/build/ninja-guard.ps1\" \"${_root}\" \"${_build}\" \"${_title}\" \"${X360N_REAL_NINJA}\" %*\r\nexit /b %ERRORLEVEL%\r\n")
    set(CMAKE_MAKE_PROGRAM "${_guard}" CACHE FILEPATH "Ninja with per-build ownership" FORCE)
endfunction()
