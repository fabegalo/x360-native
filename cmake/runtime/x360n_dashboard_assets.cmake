# Exact original inputs, checked before codegen/build as well as at runtime.
# The compiled table is checked against preparation.toml by dashboard-assets tests.
function(x360n_dashboard_profile_root output manifest)
    # This build-time guard deliberately accepts only the manifest's explicit,
    # single-line quoted [project].game_root, with no basename/version search.
    file(STRINGS "${manifest}" lines)
    set(in_project FALSE)
    set(found FALSE)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(line MATCHES "^\\[([^]]+)\\]")
            if(CMAKE_MATCH_1 STREQUAL "project")
                set(in_project TRUE)
            else()
                set(in_project FALSE)
            endif()
        elseif(in_project AND line MATCHES "^game_root[ \t]*=[ \t]*[\"']([^\"']+)[\"'][ \t]*(#.*)?$")
            if(found)
                message(FATAL_ERROR "Duplicate dashboard game_root in ${manifest}")
            endif()
            set(path "${CMAKE_MATCH_1}")
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Dashboard profile must declare a single quoted [project].game_root: ${manifest}")
    endif()
    get_filename_component(parent "${manifest}" DIRECTORY)
    if(IS_ABSOLUTE "${path}")
        get_filename_component(path "${path}" ABSOLUTE)
    else()
        get_filename_component(path "${parent}/${path}" ABSOLUTE)
    endif()
    set(${output} "${path}" PARENT_SCOPE)
endfunction()

function(x360n_guard_dashboard_profile target manifest)
    x360n_dashboard_profile_root(root "${manifest}")
    get_filename_component(parent "${manifest}" DIRECTORY)
    file(STRINGS "${parent}/preparation.toml" versions REGEX "^dashboard_version[ \t]*=")
    list(LENGTH versions count)
    if(NOT count EQUAL 1 OR NOT versions MATCHES "^dashboard_version[ \t]*=[ \t]*[\"']([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)[\"']")
        message(FATAL_ERROR "Dashboard profile has no unambiguous version: ${parent}/preparation.toml")
    endif()
    set(version "${CMAKE_MATCH_1}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}" "${parent}/preparation.toml")
    x360n_guard_dashboard(${target} "${version}" "${root}")
endfunction()

function(x360n_verify_dashboard_assets root header version)
    file(STRINGS "${header}" entries REGEX "^  \\{")
    if(NOT entries)
        message(FATAL_ERROR "Dashboard ${version}: no original dependency identities")
    endif()
    foreach(entry IN LISTS entries)
        if(NOT entry MATCHES "^  \\{\"([^\"]+)\", \"([0-9a-f]*)\"\\},$")
            message(FATAL_ERROR "Dashboard ${version}: invalid original dependency identity: ${entry}")
        endif()
        set(path "${CMAKE_MATCH_1}")
        set(expected "${CMAKE_MATCH_2}")
        string(LENGTH "${expected}" length)
        if(NOT length EQUAL 64)
            message(FATAL_ERROR "Dashboard Retail ${version}: ${path} has no verified matching version/hash; no fallback")
        endif()
        if(NOT EXISTS "${root}/${path}")
            message(FATAL_ERROR "Dashboard Retail ${version}: required original dependency ${path} is missing; expected SHA-256 ${expected}")
        endif()
        file(SHA256 "${root}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Dashboard Retail ${version}: incompatible ${path}: ${actual}; expected ${expected}; no fallback")
        endif()
    endforeach()
endfunction()

function(x360n_guard_dashboard target version root)
    set(header "${CMAKE_CURRENT_SOURCE_DIR}/src/original_assets.h")
    x360n_verify_dashboard_assets("${root}" "${header}" "${version}")
    add_custom_target(${target}_original_assets_check
        COMMAND ${CMAKE_COMMAND} "-DROOT=${root}" "-DHEADER=${header}" "-DVERSION=${version}"
            -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        VERBATIM)
    # Includes separate overlapping AOT images, before their source generation.
    foreach(suffix "" _codegen _bootanim _gamerprofile _xam_ui _signin _createprofile _vk _hud _deviceselector)
        if(TARGET ${target}${suffix})
            add_dependencies(${target}${suffix} ${target}_original_assets_check)
        endif()
    endforeach()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    if(DEFINED MANIFEST)
        x360n_dashboard_profile_root(ROOT "${MANIFEST}")
    endif()
    x360n_verify_dashboard_assets("${ROOT}" "${HEADER}" "${VERSION}")
endif()
