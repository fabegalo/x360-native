# Load the verified SDK and its official project/codegen contract.
macro(x360n_setup_rexglue name)
    if(X360N_SHARED_SDK_EXPORT)
        enable_language(C)
        foreach(_property COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES LINK_OPTIONS)
            get_directory_property(_inherited ${_property})
            if(_inherited)
                message(FATAL_ERROR "Shared SDK cannot inherit title directory ${_property}; prepare with X360N_SHARED_SDK=0")
            endif()
        endforeach()
        if(NOT EXISTS "${X360N_SHARED_SDK_EXPORT}")
            message(FATAL_ERROR "Verified shared SDK export is missing; prepare again")
        endif()
        include("${X360N_SHARED_SDK_EXPORT}")
    elseif(REXSDK_DIR)
        add_subdirectory("${REXSDK_DIR}" rexglue-sdk)
    else()
        find_package(rexglue 0.11.0 REQUIRED CONFIG)
    endif()
    set(_x360n_project_args ${ARGN})
    if(X360N_CODEGEN_BOOTSTRAP AND NOT "MODULE_TARGETS" IN_LIST _x360n_project_args)
        # Configure the producer before reading an inventory emitted by an older SDK.
        set(_x360n_bootstrap_modules "${CMAKE_CURRENT_BINARY_DIR}/.preparation/bootstrap-modules.cmake")
        file(WRITE "${_x360n_bootstrap_modules}" "# Producer bootstrap; normal configuration uses the regenerated module inventory.\n")
        list(APPEND _x360n_project_args MODULE_TARGETS "${_x360n_bootstrap_modules}")
    endif()
    rexglue_project(${name} ${_x360n_project_args})
    unset(_x360n_project_args)
    unset(_x360n_bootstrap_modules)
endmacro()
