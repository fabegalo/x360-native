# Adapt the pinned, unmodified integration template in the build directory.
# Codegen may rewrite its own source template; it cannot erase this integration.
macro(x360n_include_rexglue integration)
    if(X360N_SHARED_SDK_EXPORT)
        enable_language(C)
        foreach(_property COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES LINK_OPTIONS)
            get_directory_property(_inherited ${_property})
            if(_inherited)
                message(FATAL_ERROR "Shared SDK cannot inherit title directory ${_property}; prepare with X360N_SHARED_SDK=0")
            endif()
        endforeach()
        if(NOT EXISTS "${X360N_SHARED_SDK_EXPORT}")
            message(FATAL_ERROR "Verified shared SDK export is missing; prepare again")
        endif()
        get_filename_component(_integration "${integration}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_integration}")
        file(READ "${_integration}" _text)
        set(_needle "add_subdirectory(\"\${REXSDK_DIR}\" rexglue-sdk)")
        string(FIND "${_text}" "${_needle}" _offset)
        if(_offset LESS 0)
            message(FATAL_ERROR "Unsupported pinned SDK integration; shared SDK cannot be substituted safely")
        endif()
        string(REPLACE "${_needle}" "include(\"\${X360N_SHARED_SDK_EXPORT}\")" _text "${_text}")
        set(_adapted "${CMAKE_CURRENT_BINARY_DIR}/x360n-title-rexglue.cmake")
        if(EXISTS "${_adapted}")
            file(READ "${_adapted}" _old)
        else()
            set(_old "")
        endif()
        if(NOT _old STREQUAL _text)
            file(WRITE "${_adapted}" "${_text}")
        endif()
        include("${_adapted}")
    else()
        include("${integration}")
    endif()
endmacro()
