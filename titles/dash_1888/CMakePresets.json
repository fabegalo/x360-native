{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x360n-win-amd64",
      "displayName": "x360-native: Windows AMD64 Release (pinned LLVM, SDK from source)",
      "description": "Builds the SDK from ../../external/rexglue-sdk (REXSDK_DIR) and runs codegen as part of the build. Use scripts\\build-title.ps1.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../.local/build/titles/dash_1888",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "${sourceDir}/../../.local/toolchains/llvm-22.1.8/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/../../.local/toolchains/llvm-22.1.8/bin/clang++.exe",
        "CMAKE_C_FLAGS": "-march=x86-64-v2",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v2",
        "REXSDK_DIR": "${sourceDir}/../../external/rexglue-sdk",
        "REXGLUE_USE_VULKAN": "ON",
        "PYTHON_EXECUTABLE": "${sourceDir}/../../.local/toolchains/python-3.14.8/python.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x360n-win-amd64",
      "configurePreset": "x360n-win-amd64"
    }
  ]
}
