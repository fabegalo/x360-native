+REX_TEST_CASE("original system UI owns only its session controller and privileged input", "[kernel][xam][input][system-ui-session]") {
+  using namespace rex::test_input;
+  g_fake = {};
+  g_fake[0].devices = {MakePad(1, 0), MakePad(2, 1)};
+  g_fake[0].states[1] = Buttons(0);
+  g_fake[0].states[2] = Buttons(0);
+  FakeProvider provider;
+  rex::test::KernelFixture fixture({}, {&provider}, {}, {}, "fake_a");
+  fixture.RunOnGuestThread([&](rex::test::Caller& caller) {
+    auto& xam = rex::xam::CurrentXAM();
+    auto& input = fixture.GetInput();
+    xam.AttachInput(&input);
+    rex::ScopeGuard detach([&] { xam.DetachInput(); });
+    auto& ui = xam.GetSystemUI();
+    REQUIRE(input.GetState(0).has_value());
+    REQUIRE(input.GetState(1).has_value());
+    REQUIRE(ui.RegisterSystemApp({5, 2, 0x1234, 0}) == 0);
+    CHECK_FALSE(ui.BeginSystemUi(6, 2, 0));
+    CHECK_FALSE(ui.BeginSystemUi(5, 2, 4));
+    REQUIRE(ui.BeginSystemUi(5, 2, 0));
+    CHECK_FALSE(ui.BeginSystemUi(5, 2, 0));
+    CHECK_FALSE(ui.SetSystemUiVisible(6));
+    REQUIRE(ui.SetSystemUiVisible(5));
+    CHECK(caller.XAM("XamIsUIActive") == 1);
+    CHECK(caller.XAM("XamEnableSystemAppInput", {1, 1}) == 1627);
+    CHECK(caller.XAM("XamEnableSystemAppInput", {255, 1}) == 0);
+    const auto state = caller.Alloc(sizeof(rex::xam::X_INPUT_STATE)), stroke = caller.Alloc(sizeof(rex::xam::X_INPUT_KEYSTROKE));
+    g_fake[0].states[1] = Buttons(rex::hid::kPadA);
+    g_fake[0].states[2] = Buttons(rex::hid::kPadB);
+    REQUIRE(caller.XAM("XamInputGetState", {0, 1, state}) == 0);
+    CHECK(caller.Load32(state) == 0);
+    CHECK(caller.Load32(state + 4) == 0);
+    REQUIRE(caller.XAM("XamInputGetState", {0, 0x80000001, state}) == 0);
+    CHECK(caller.Load32(state + 4) >> 16 == rex::hid::kPadA);
+    CHECK(caller.XAM("XamInputGetKeystroke", {0, 1, stroke}) == rex::kernel::X_ERROR_EMPTY);
+    REQUIRE(caller.XAM("XamInputGetKeystrokeHudEx", {255, 1, stroke}) == 0);
+    CHECK(caller.Load8(stroke + 6) == 0);
+    CHECK(caller.XAM("XamInputGetKeystrokeHudEx", {255, 1, stroke}) == rex::kernel::X_ERROR_EMPTY);
+    REQUIRE(caller.XAM("XamInputGetKeystroke", {1, 1, stroke}) == 0);
+    CHECK(caller.Load8(stroke + 6) == 1);
+    CHECK(caller.XAM("XamInputGetKeystrokeHudEx", {4, 1, stroke}) == rex::kernel::X_ERROR_BAD_ARGUMENTS);
+    CHECK(caller.XAM("XamInputGetKeystrokeHud", {0, 0}) == rex::kernel::X_ERROR_BAD_ARGUMENTS);
+    CHECK(caller.XAM("XamAppUnloadStack", {1}) == 87);
+    CHECK_FALSE(ui.GetSystemUiSession().close_requested);
+    CHECK(caller.XAM("XamAppUnloadSelf") == 0);
+    CHECK(ui.GetSystemUiSession().close_requested);
+    CHECK_FALSE(ui.EndSystemUi(6));
+    REQUIRE(ui.EndSystemUi(5));
+    CHECK(caller.XAM("XamIsUIActive") == 0);
+    REQUIRE(ui.BeginSystemUi(5, 2, 255));
+    REQUIRE(ui.SetSystemUiVisible(5));
+    CHECK(caller.XAM("XamEnableSystemAppInput", {1, 1}) == 0);
+    CHECK(caller.XAM("XamEnableSystemAppInput", {4, 1}) == 1627);
+    REQUIRE(ui.EndSystemUi(5));
+    CHECK(caller.XAM("XamAppUnloadSelf") == 1627);
+    const auto tick = caller.XAM("GetTickCount", {0xDEADBEEF});
+    CHECK(static_cast<rex::u32>(caller.XAM("GetTickCount") - tick) < 10000);
+  });
