-  /**
-   * Loops draw n lines for n input vertices, so two vertices draw two lines, and a loop of one
-   * vertex is ignored.
-   */
+  static constexpr u32 GetTriangleStripListIndexCount(
+      u32 strip_index_count) {
+    return strip_index_count > 2 ? (strip_index_count - 2) * 3 : 0;
+  }
+  template <typename Index, typename IndexTransform>
+  static void TriangleStripToList(Index* dest, const Index* source,
+                                  u32 source_index_count,
+                                  const IndexTransform& index_transform) {
+    if (source_index_count <= 2) {
+      // To match GetTriangleStripListIndexCount.
+      return;
+    }
+    Index index_previous_2 = index_transform(source[0]);
+    Index index_previous = index_transform(source[1]);
+    for (u32 i = 2; i < source_index_count; ++i) {
+      Index index_current = index_transform(source[i]);
+      if (i & 1) {
+        *(dest++) = index_previous;
+        *(dest++) = index_previous_2;
+      } else {
+        *(dest++) = index_previous_2;
+        *(dest++) = index_previous;
+      }
+      *(dest++) = index_current;
+      index_previous_2 = index_previous;
+      index_previous = index_current;
+    }
+  }
+
   static constexpr u32 GetLineLoopStripIndexCount(u32 loop_index_count) {
+    // Even if 2 vertices are supplied, two lines are still drawn between them.
+    // https://www.khronos.org/opengl/wiki/Primitive
     return loop_index_count > 1 ? loop_index_count + 1 : 0;
   }
