+namespace {
+class UtilityCacheApp final : public rex::test::ObjectApp<rex::codegen::ToolApp> {
+ public:
+  UtilityCacheApp(const std::filesystem::path& app_root, const std::filesystem::path& cache)
+      : ObjectApp("utility_cache_test", app_root), cache_(cache) {}
+ protected:
+  rex::Result<void> OnConfigure(rex::SettingsRegistry& settings) override {
+    REX_TRY_VOID(ToolApp::OnConfigure(settings));
+    return REX_PATHS().cache_root.Set(cache_);
+  }
+ private:
+  std::filesystem::path cache_;
+};
+}
+
+REX_TEST_CASE("the canonical runtime utility drive persists outside original inputs", "[kernel][title][utility-cache]") {
+  const rex::test::TempFolder folder("rex_runtime_utility_");
+  rex::test::ReleaseTestMemory();
+  const auto cache = folder.path / "cache";
+  UtilityCacheApp app(folder.path, cache);
+  REQUIRE(app.Start());
+  rex::test::WriteTitle(folder.path / "game");
+  REQUIRE(rex::kernel::GetTitlePaths().game_root.Set(folder.path / "game"));
+  REQUIRE(rex::kernel::GetTitlePaths().entry.Set("default.xex"));
+  rex::kernel::TitleRuntime runtime(MakeImage());
+  REQUIRE(runtime.Load());
+  {
+    auto file = runtime.GetFileSystem().Open("cache:\\generic.bin",
+        rex::filesystem::OpenOptions{.disposition = rex::filesystem::Disposition::kCreate,
+                                    .access = rex::filesystem::Access::kWriteData});
+    REQUIRE(file);
+    const std::array<rex::u8, 3> bytes{1, 2, 3};
+    REQUIRE(file->file->Write(bytes, 0));
+  }
+  runtime.Unload();
+  REQUIRE(runtime.Load());
+  auto stat = runtime.GetFileSystem().Stat("cache:\\generic.bin");
+  REQUIRE(stat);
+  CHECK(std::filesystem::file_size(cache / "utility/generic.bin") == 3);
+  CHECK_FALSE(std::filesystem::exists(folder.path / "game/cache"));
+  CHECK_FALSE(std::filesystem::exists(folder.path / "game/utility"));
+  runtime.Unload();
+}
+
+REX_TEST_CASE("a failed utility directory cannot produce a loaded runtime", "[kernel][title][utility-cache]") {
+  const rex::test::TempFolder folder("rex_runtime_utility_failure_");
+  rex::test::ReleaseTestMemory();
+  const auto cache = folder.path / "blocked";
+  std::ofstream(cache, std::ios::binary).write("preserve", 8);
+  UtilityCacheApp app(folder.path, cache);
+  REQUIRE(app.Start());
+  rex::test::WriteTitle(folder.path / "game");
+  REQUIRE(rex::kernel::GetTitlePaths().game_root.Set(folder.path / "game"));
+  REQUIRE(rex::kernel::GetTitlePaths().entry.Set("default.xex"));
+  rex::kernel::TitleRuntime runtime(MakeImage());
+  CHECK_FALSE(runtime.Load());
+  CHECK_FALSE(runtime.IsLoaded());
+  CHECK(std::filesystem::file_size(cache) == 8);
+  CHECK_FALSE(std::filesystem::exists(folder.path / "game/utility"));
+}
+
+REX_TEST_CASE("tool analysis never mounts or creates a utility drive beside originals", "[kernel][codegen][utility-cache]") {
+  const rex::test::TempFolder original("rex_tool_utility_original_");
+  const rex::test::TempFolder host("rex_tool_utility_host_");
+  rex::test::ReleaseTestMemory();
+  rex::test::ObjectApp<rex::codegen::ToolApp> app("tool_utility_test", host.path);
+  auto tool = app.Open(original.path);
+  REQUIRE(tool);
+  CHECK_FALSE(tool->GetRuntime().GetFileSystem().FindLink("cache:"));
+  CHECK(std::filesystem::is_empty(original.path));
+}
