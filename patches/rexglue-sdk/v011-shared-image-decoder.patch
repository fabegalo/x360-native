+REX_TEST_CASE("shared PNG decoder preserves RGBA pixels for headless XAM and overlays", "[xam][shared-image-decoder]") {
+  const std::vector<rex::u8> png{
+      0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a,
+      0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44, 0x52,
+      0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01,
+      0x08, 0x06, 0x00, 0x00, 0x00, 0x1f, 0x15, 0xc4, 0x89,
+      0x00, 0x00, 0x00, 0x10, 0x49, 0x44, 0x41, 0x54,
+      0x78, 0x01, 0x01, 0x05, 0x00, 0xfa, 0xff,
+      0x00, 0x11, 0x22, 0x33, 0xff, 0x02, 0x14, 0x01, 0x66,
+      0xb9, 0xe1, 0xfa, 0xc1, 0x00, 0x00, 0x00, 0x00,
+      0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82};
+  int width = 7, height = 9;
+  const auto pixels = rex::ui::DecodeImageRGBA(png.data(), png.size(), width, height);
+  CHECK(width == 1); CHECK(height == 1);
+  CHECK(pixels == std::vector<rex::u8>{0x11, 0x22, 0x33, 0xFF});
+  CHECK(rex::ui::DecodeImageRGBA(nullptr, 1, width, height).empty());
+  CHECK(width == 0); CHECK(height == 0);
+  CHECK(rex::ui::DecodeImageRGBA(png.data(), static_cast<size_t>(std::numeric_limits<int>::max()) + 1, width, height).empty());
+  CHECK(width == 0); CHECK(height == 0);
+  CHECK(rex::ui::DecodeImageRGBA(png.data(), 4, width, height).empty());
+  CHECK(width == 0); CHECK(height == 0);
+}
