 #include <rex/types.h>
 
 namespace rex::ui {
+
+/** Fullscreen shortcut, including repeats so callers can consume them. */
+inline bool IsFullscreenToggleKey(const InputEvent& event) {
+  return event.type == InputEvent::Type::kKeyDown &&
+      (event.key == VirtualKey::kF11 ||
+       (event.key == VirtualKey::kReturn && HasFlags(event.modifiers, KeyModifiers::kAlt)));
+}
+
 
 /** Base of every window event. */
 class UIEvent {
