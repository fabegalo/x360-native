+REX_TEST_CASE("fullscreen shortcuts toggle once and preserve plain Enter", "[ui][hid][fullscreen-toggle]") {
+  UIApp app;
+  app.input_drivers = "none";
+  REQUIRE(app.Start());
+  auto& settings = app.GetUI().GetSettings();
+  REQUIRE(settings.fullscreen.Set(false)); app.Pump();
+  const auto key = [&](rex::VirtualKey code, rex::KeyModifiers modifiers = {}, bool repeat = false) {
+    rex::test_ui::Deliver([=](rex::ui::IUIEventListener& listener) {
+      rex::InputEvent e{.type = rex::InputEvent::Type::kKeyDown, .key = code, .modifiers = modifiers, .repeat = repeat};
+      listener.OnInputEvent(e);
+      if (rex::ui::IsFullscreenToggleKey(e)) CHECK(e.handled);
+    });
+    app.Pump();
+  };
+  key(rex::VirtualKey::kF11); CHECK(settings.fullscreen.Get()); CHECK(g_ui.fullscreen);
+  const int changes = g_ui.set_fullscreen_calls;
+  key(rex::VirtualKey::kF11, {}, true); CHECK(g_ui.set_fullscreen_calls == changes);
+  key(rex::VirtualKey::kReturn); CHECK(settings.fullscreen.Get());
+  key(rex::VirtualKey::kF10); CHECK(settings.fullscreen.Get());
+  key(rex::VirtualKey::kReturn, rex::KeyModifiers::kAlt);
+  CHECK_FALSE(settings.fullscreen.Get()); CHECK_FALSE(g_ui.fullscreen);
+  app.Shutdown();
+}
+
+#if REX_PLATFORM_WIN32
+REX_TEST_CASE("embedded fullscreen shortcuts notify the persistent host without changing the child", "[ui][hid][fullscreen-toggle]") {
+  UIApp app;
+  app.input_drivers = "none";
+  REQUIRE(app.Start());
+  const auto parent = CreateWindowExW(0, L"STATIC", L"Fullscreen host fixture", WS_OVERLAPPEDWINDOW,
+      0, 0, 400, 240, nullptr, nullptr, GetModuleHandleW(nullptr), nullptr);
+  REQUIRE(parent);
+  rex::ScopeGuard destroy([&] { DestroyWindow(parent); });
+  const auto child = CreateWindowExW(0, L"STATIC", L"Embedded fixture", WS_CHILD,
+      0, 0, 400, 240, parent, nullptr, GetModuleHandleW(nullptr), nullptr);
+  REQUIRE(child);
+  g_ui.native_window = {rex::NativeWindow::Type::kWin32, child};
+  const bool fullscreen = app.GetUI().GetSettings().fullscreen.Get();
+  const int changes = g_ui.set_fullscreen_calls;
+  rex::test_ui::DeliverKey(rex::InputEvent::Type::kKeyDown, rex::VirtualKey::kF11);
+  app.Pump();
+  MSG message{};
+  REQUIRE(PeekMessageW(&message, parent, WM_APP + 0x362, WM_APP + 0x362, PM_REMOVE));
+  rex::test_ui::DeliverKey(rex::InputEvent::Type::kKeyDown, rex::VirtualKey::kF11, true);
+  app.Pump();
+  CHECK_FALSE(PeekMessageW(&message, parent, WM_APP + 0x362, WM_APP + 0x362, PM_REMOVE));
+  CHECK(GetParent(child) == parent);
+  CHECK(app.GetUI().GetSettings().fullscreen.Get() == fullscreen);
+  CHECK(g_ui.set_fullscreen_calls == changes);
+  app.Shutdown();
+}
+#endif
