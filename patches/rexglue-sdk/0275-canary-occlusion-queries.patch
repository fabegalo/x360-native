+// Portable variant identity: upstream fields and independent local extensions.
+struct ShaderModificationKey {
+  uint64_t low;
+  uint64_t high;
+  constexpr ShaderModificationKey(uint64_t low_value = 0, uint64_t high_value = 0)
+      : low(low_value), high(high_value) {}
+  constexpr explicit operator bool() const { return low || high; }
+  constexpr bool operator==(const ShaderModificationKey& other) const {
+    return low == other.low && high == other.high;
+  }
+  constexpr bool operator!=(const ShaderModificationKey& other) const { return !(*this == other); }
+  constexpr bool operator<(const ShaderModificationKey& other) const {
+    return high < other.high || (high == other.high && low < other.low);
+  }
+  constexpr ShaderModificationKey operator|(ShaderModificationKey other) const {
+    return {low | other.low, high | other.high};
+  }
+  constexpr ShaderModificationKey operator&(ShaderModificationKey other) const {
+    return {low & other.low, high & other.high};
+  }
+  constexpr ShaderModificationKey operator~() const { return {~low, ~high}; }
+  constexpr ShaderModificationKey& operator|=(ShaderModificationKey other) {
+    low |= other.low; high |= other.high; return *this;
+  }
+  constexpr ShaderModificationKey& operator&=(ShaderModificationKey other) {
+    low &= other.low; high &= other.high; return *this;
+  }
+};
+static_assert(sizeof(ShaderModificationKey) == 16);
+struct ShaderModificationKeyHash {
+  size_t operator()(ShaderModificationKey key) const {
+    return std::hash<uint64_t>{}(key.low) ^
+           (std::hash<uint64_t>{}(key.high) + size_t(0x9e3779b9) +
+            (std::hash<uint64_t>{}(key.low) << 6) + (std::hash<uint64_t>{}(key.low) >> 2));
+  }
+};
+
