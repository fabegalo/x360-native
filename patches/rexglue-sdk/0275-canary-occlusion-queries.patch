+ZPDMode GetZPDMode(const XenosSettings& settings) {
+  if (!settings.occlusion_query_enable.Get()) return ZPDMode::kFake;
+  const auto& mode = settings.occlusion_query.Get();
+  if (mode == "fake") return ZPDMode::kFake;
+  if (mode == "strict") return ZPDMode::kStrict;
+  if (mode == "fast-alt") return ZPDMode::kFastAlt;
