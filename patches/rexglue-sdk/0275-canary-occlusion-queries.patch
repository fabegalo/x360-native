+REX_TEST_CASE("High modification words retain independent translation ownership", "[gpu][shader][shader-fetch]") {
+  g_destroyed = 0;
+  {
+    CountedShader shader(rex::xenos::ShaderType::kVertex, 1, kUcode.data(), kUcode.size());
