+    CHECK(low != high);
+    CHECK(shader.GetTranslations().size() == 2);
+    shader.DestroyTranslation(high_key);
+    CHECK(shader.GetTranslation(high_key) == nullptr);
+    CHECK(shader.GetTranslation(low_key) == low);
