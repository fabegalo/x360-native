+#ifndef XENIA_GPU_VULKAN_VULKAN_QUERY_POOL_H_
+#define XENIA_GPU_VULKAN_VULKAN_QUERY_POOL_H_
+
+#include <cstdint>
+#include <vector>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/ui/vulkan/api.h>
+
