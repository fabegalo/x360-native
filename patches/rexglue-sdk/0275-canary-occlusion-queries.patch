+#ifndef XENIA_GPU_VULKAN_VULKAN_QUERY_POOL_H_
+#define XENIA_GPU_VULKAN_VULKAN_QUERY_POOL_H_
+
+#include <cstdint>
+#include <vector>
+
+#include "gpu/xenos/command_processor.h"
+#include "gpu/xenos/host/vulkan/api.h"
+
+namespace rex {
