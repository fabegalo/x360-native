+void CommandProcessor::WriteZPDReport(u32 address, const XenosZPDReport& value) {
+  if (address % alignof(xenos::DepthSampleCounts)) {
+    FailQuery("unaligned ZPD report address");
+    return;
+  }
+  auto writable = physical_memory_.GetWritablePhysicalSpan({address, sizeof(xenos::DepthSampleCounts)});
+  if (!writable) {
+    FailQuery("ZPD report outside physical memory");
+    return;
+  }
+  value.WriteTo(reinterpret_cast<xenos::DepthSampleCounts*>(writable->data()));
+  if (!physical_memory_.NotifyPhysicalWrite({address, sizeof(xenos::DepthSampleCounts)}))
+    FailQuery("cannot publish ZPD report");
+}
