+
+namespace {
+class RingProcessor final : public rex::gpu::CommandProcessor {
+ public:
+  RingProcessor(rex::gpu::XenosGraphicsDriverBase* driver, rex::test::FakeTitleContext& title)
+      : CommandProcessor(driver, rex::TitleInfo{}, title, title, title) {}
+  void IssueSwap(rex::u32, rex::u32, rex::u32) override {}
+  void Seed() {
+    CallInThreadAndWait([&] {
+      primary_buffer_ptr_ = 0x1000; primary_buffer_size_ = 0x100;
+      read_ptr_index_ = 63; write_ptr_index_.store(63);
+      read_ptr_writeback_ptr_ = 0xDEAD;
+    });
+  }
+  std::array<rex::u32, 5> ReadRing() {
+    std::array<rex::u32, 5> result{};
+    CallInThreadAndWait([&] {
+      result = {primary_buffer_ptr_, primary_buffer_size_, read_ptr_index_,
+                write_ptr_index_.load(), read_ptr_writeback_ptr_};
+    });
+    return result;
+  }
+ protected:
+  bool SetupContext() override { return true; }
+  void ShutdownContext() override {}
+  rex::gpu::Shader* LoadShader(rex::xenos::ShaderType, rex::u32, const rex::u32*, rex::u32) override { return nullptr; }
+  bool IssueDraw(rex::xenos::PrimitiveType, rex::u32, IndexBuffer*, bool) override { return true; }
+  bool IssueCopy() override { return true; }
+};
+}
+
+REX_TEST_CASE_METHOD(Fixture, "ring replacement resets the producer, consumer and writeback on the real worker", "[gpu][ring-reinitialization]") {
+  rex::test::FakeTitleContext title(rex::test::GetTestMemory());
+  rex::test::FakeDriverContext context;
+  rex::gpu::null::NullXenosGraphicsDriver driver;
+  REQUIRE(driver.Initialize(context));
+  RingProcessor processor(&driver, title);
+  REQUIRE(processor.Initialize());
+  rex::ScopeGuard stop([&] { processor.Shutdown(); driver.Shutdown(); });
+  for (rex::u32 cycle = 0; cycle < 8; ++cycle) {
+    processor.Seed();
+    processor.InitializeRingBuffer(0x2000 + cycle * 0x1000, 5);
+    const auto ring = processor.ReadRing();
+    CHECK(ring[0] == 0x2000 + cycle * 0x1000);
+    CHECK(ring[1] == 256);
+    CHECK(ring[2] == 0);
+    CHECK(ring[3] == 0);
+    CHECK(ring[4] == 0);
+    processor.EnableReadPointerWriteBack(0x4000, 3);
+    CHECK(processor.ReadRing()[4] == 0x4000);
+  }
+  std::atomic<rex::u32> calls{0};
+  std::vector<std::thread> producers;
+  for (unsigned i = 0; i < 4; ++i) producers.emplace_back([&] {
+    for (unsigned j = 0; j < 32; ++j) processor.CallInThread([&] { calls.fetch_add(1); });
+  });
+  for (auto& producer : producers) producer.join();
+  processor.CallInThreadAndWait([&] { calls.fetch_add(1); });
+  CHECK(calls.load() == 129);
+}
