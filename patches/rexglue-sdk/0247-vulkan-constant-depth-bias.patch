--- /dev/null
+++ b/include/rex/graphics/vulkan/depth_bias.h
@@ -0,0 +1,79 @@
+#pragma once
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2020 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ * Constant-unit depth bias adapted from JTM-rootstorm's Xenia Canary change
+ * a8d034c00df4570f68fa14186cbde8c6f172870a.
+ */
+
+#include <algorithm>
+#include <rex/graphics/util/draw.h>
+#include <rex/ui/vulkan/device.h>
+
+namespace rex::graphics::vulkan {
+
+struct HostDepthBias {
+  float constant_factor = 0.0f;
+  float slope_factor = 0.0f;
+  bool force_unorm = false;
+};
+
+inline HostDepthBias GetHostDepthBias(const RegisterFile& regs, bool primitive_polygonal,
+                                    uint32_t scale_x, uint32_t scale_y,
+                                    const ui::vulkan::VulkanDevice::Properties& properties,
+                                    bool force_unorm_requested) {
+  HostDepthBias bias;
+  bias.force_unorm = force_unorm_requested && properties.depthBiasControl &&
+                    properties.leastRepresentableValueForceUnormRepresentation &&
+                    properties.depthBiasExact;
+  draw_util::GetPreferredFacePolygonOffset(regs, primitive_polygonal,
+                                          bias.slope_factor, bias.constant_factor);
+  const bool float24 = regs.Get<reg::RB_DEPTH_INFO>().depth_format ==
+                       xenos::DepthRenderTargetFormat::kD24FS8;
+  bias.constant_factor *= float24 ? draw_util::kD3D10PolygonOffsetFactorFloat24
+                                  : draw_util::kD3D10PolygonOffsetFactorUnorm24;
+  if (bias.force_unorm && float24) {
+    // Guest [0, 1] occupies host [0, 0.5]. Constant units don't automatically
+    // follow that exponent reduction, unlike legacy floating-point bias.
+    bias.constant_factor *= 0.5f;
+  }
+  bias.slope_factor *= xenos::kPolygonOffsetScaleSubpixelUnit *
+                       float(std::max(scale_x, scale_y));
+  return bias;
+}
+
+// Build the pNext chain only while executing: recorded commands own values,
+// never pointers to temporary VkDepthBiasInfoEXT / representation structures.
+inline void ExecuteDepthBias2(const ui::vulkan::VulkanDevice::Functions& dfn,
+                             VkCommandBuffer command_buffer, float constant_factor,
+                             float clamp, float slope_factor,
+                             VkDepthBiasRepresentationEXT representation, VkBool32 exact) {
+  VkDepthBiasRepresentationInfoEXT representation_info{};
+  representation_info.sType = VK_STRUCTURE_TYPE_DEPTH_BIAS_REPRESENTATION_INFO_EXT;
+  representation_info.depthBiasRepresentation = representation;
+  representation_info.depthBiasExact = exact;
+  VkDepthBiasInfoEXT info{};
+  info.sType = VK_STRUCTURE_TYPE_DEPTH_BIAS_INFO_EXT;
+  info.pNext = &representation_info;
+  info.depthBiasConstantFactor = constant_factor;
+  info.depthBiasClamp = clamp;
+  info.depthBiasSlopeFactor = slope_factor;
+  dfn.vkCmdSetDepthBias2EXT(command_buffer, &info);
+}
+
+template <typename CommandBuffer>
+inline void RecordHostDepthBias(CommandBuffer& commands, const HostDepthBias& bias) {
+  if (bias.force_unorm) {
+    commands.CmdVkSetDepthBias2EXT(
+        bias.constant_factor, 0.0f, bias.slope_factor,
+        VK_DEPTH_BIAS_REPRESENTATION_LEAST_REPRESENTABLE_VALUE_FORCE_UNORM_EXT, true);
+  } else {
+    commands.CmdVkSetDepthBias(bias.constant_factor, 0.0f, bias.slope_factor);
+  }
+}
+
+}  // namespace rex::graphics::vulkan
