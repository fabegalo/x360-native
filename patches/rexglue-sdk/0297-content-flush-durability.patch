+u32 ContentManager::FlushContent(std::string_view root_name) {
+  auto session_lock = user_profile_.LockSettings();
+  std::lock_guard lock(mutex_);
+  const auto it = open_packages_.find(string::StringKeyIgnoreCase(root_name));
+  if (it == open_packages_.end()) return kernel::X_ERROR_FILE_NOT_FOUND;
+  if (it->second->GetPackageContentData().content_type == kernel::XContentType::kSavedGame &&
+      it->second->GetStorageEpoch() != user_profile_.GetStorageEpoch()) return kernel::X_ERROR_ACCESS_DENIED;
+  const auto root = title_.file_system.FindLink(std::string(root_name) + ':');
+  if (!root || root->empty()) return kernel::X_ERROR_FILE_NOT_FOUND;
+  for (const auto& file : title_.objects.All<kernel::IOpenedFile>()) {
+    const auto path = file->GetAbsolutePath();
+    if (!rex::string::utf8_starts_with_case(path, *root)) continue;
+    const auto rest = std::string_view(path).substr(root->size());
+    if (!rest.empty() && rest.front() != '\\' && rest.front() != '/' && root->back() != '\\' && root->back() != '/') continue;
+    if (kernel::XFAILED(file->Flush())) return kernel::X_ERROR_ACCESS_DENIED;
+  }
+  return kernel::X_ERROR_SUCCESS;
+}
 
