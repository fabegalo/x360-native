+X_STATUS FileObject::Flush() {
+  std::lock_guard lock(file_lock);
+  if (!file->IsAccessible()) return X_STATUS_ACCESS_DENIED;
+  const auto writable = filesystem::Access::kWriteData | filesystem::Access::kAppendData;
+  if ((file->GetAccess() & writable) == filesystem::Access::kNone) return X_STATUS_SUCCESS;
+  const auto flushed = file->Flush();
+  return flushed ? X_STATUS_SUCCESS : ToXStatus(flushed.error());
+}
 
