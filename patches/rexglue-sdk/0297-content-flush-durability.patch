+REX_TEST_CASE("content flush validates real mounted roots and publishes the original completion", "[kernel][xam][save-storage]") {
+  SignedInProfileFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+    auto& manager = rex::xam::CurrentXAM().GetContentManager();
+    const auto name = c.AllocString("SAVE"), overlap = c.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    CHECK(c.XAM("XamContentFlush", {0, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(c.XAM("XamContentFlush", {name, 0}) == rex::kernel::X_ERROR_FILE_NOT_FOUND);
+    CHECK(c.XAM("XamContentFlush", {name, overlap}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(c.Load32(overlap) == rex::kernel::X_ERROR_FILE_NOT_FOUND);
+    rex::kernel::XCONTENT_AGGREGATE_DATA save{};
+    save.device_id = 1; save.title_id = 0x12345678;
+    save.xuid = profile.GetXUID(); save.content_type = rex::kernel::XContentType::kSavedGame;
+    save.SetFileName("flush");
+    REQUIRE(manager.CreateContent("SAVE", profile.GetXUID(), save));
+    CHECK(c.XAM("XamContentFlush", {name, 0}) == 0);
+    CHECK(c.XAM("XamContentFlush", {name, overlap}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(c.Load32(overlap) == 0);
+    REQUIRE(manager.CloseContent("SAVE"));
+    CHECK(c.XAM("XamContentFlush", {name, 0}) == rex::kernel::X_ERROR_FILE_NOT_FOUND);
+  });
