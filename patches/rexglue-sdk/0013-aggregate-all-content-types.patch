+std::vector<XCONTENT_AGGREGATE_DATA> ContentManager::ListContentAllTypes(
+    uint32_t device_id, uint64_t xuid, uint32_t title_filter) {
+  std::vector<XCONTENT_AGGREGATE_DATA> result;
+  // Only canonical title/type directory names belong to the content catalog.
+  // In particular, Headers is metadata, never a content type.
+  auto hex_id = [](const std::filesystem::path& name, uint32_t& value) {
+    const auto s = rex::path_to_utf8(name);
+    if (s.size() != 8) return false;
+    value = 0;
+    for (const char c : s) {
+      const int n = c >= '0' && c <= '9' ? c - '0' :
+                    c >= 'a' && c <= 'f' ? c - 'a' + 10 :
+                    c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+      if (n < 0) return false;
+      value = (value << 4) | uint32_t(n);
+    }
+    return true;
+  };
+  const auto user_root = root_path_ / fmt::format("{:016X}", xuid);
+  for (const auto& title : rex::filesystem::ListFiles(user_root)) {
+    uint32_t title_id;
+    if (title.type != rex::filesystem::FileInfo::Type::kDirectory ||
+        !hex_id(title.name, title_id) || (title_filter && title_id != title_filter)) continue;
+    for (const auto& type : rex::filesystem::ListFiles(user_root / title.name)) {
+      uint32_t content_type;
+      if (type.type != rex::filesystem::FileInfo::Type::kDirectory ||
+          !hex_id(type.name, content_type)) continue;
+      auto items = ListContent(device_id, xuid, XContentType(content_type), title_id);
+      result.insert(result.end(), items.begin(), items.end());
+    }
+  }
+  return result;
+}
