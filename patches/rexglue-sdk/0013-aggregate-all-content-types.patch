+REX_TEST_CASE("all-type content enumeration filters canonical directories and preserves full owner XUIDs", "[kernel][xam][aggregate-content]") {
+  KernelFixture fixture([](const std::filesystem::path& root) {
+    REQUIRE(std::filesystem::equivalent(root.parent_path(), std::filesystem::temp_directory_path()));
+    REQUIRE(root.filename().string().starts_with("rexglue_kernel_fixture_"));
+    for (const char* path : {"0000000000000000/584108B7/000D0000/package-a",
+        "0000000000000000/12345678/00080000/package-b",
+        "0000000000000000/invalid/000D0000/not-a-title",
+        "0000000000000000/584108B7/Headers/000D0000",
+        "E000000000000001/584108B7/000D0000/owned"})
+      std::filesystem::create_directories(root / path);
+  });
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto handle_ptr = caller.Alloc(4), count_ptr = caller.Alloc(4);
+    const auto buffer = caller.Alloc(sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA));
+    auto query = [&](u64 owner, u32 title, u32 device = 1) {
+      REQUIRE(caller.XAM("XamContentAggregateCreateEnumerator", {owner, device, 0xFFFFFFFF, title, handle_ptr}) == 0);
+      const auto handle = caller.Load32(handle_ptr);
+      REQUIRE(handle != 0);
+      std::set<std::pair<u32, u32>> found;
+      bool ended = false;
+      for (unsigned i = 0; i < 8; ++i) {
+        const auto result = caller.XAM("XamEnumerate", {handle, 0, buffer, sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA), count_ptr, 0});
+        if (result == rex::kernel::X_ERROR_NO_MORE_FILES) { ended = true; break; }
+        REQUIRE(result == 0);
+        REQUIRE(caller.Load32(count_ptr) == 1);
+        const auto* item = reinterpret_cast<const rex::kernel::XCONTENT_AGGREGATE_DATA*>(caller.GetBase() + buffer);
+        CHECK(static_cast<u64>(item->xuid) == owner);
+        found.emplace(static_cast<u32>(item->title_id), std::to_underlying(static_cast<rex::kernel::XContentType>(item->content_type)));
+      }
+      CHECK(ended);
+      CHECK(caller.Kernel("NtClose", {handle}) == 0);
+      return found;
+    };
+    const std::set<std::pair<u32, u32>> shared{{0x584108B7, 0xD0000}, {0x12345678, 0x80000}};
+    const std::set<std::pair<u32, u32>> single{{0x584108B7, 0xD0000}};
+    CHECK(query(0, 0) == shared);
+    CHECK(query(0, 0x584108B7) == single);
+    CHECK(query(0xE000000000000001ull, 0) == single);
+    CHECK(query(1, 0).empty());
+    CHECK(query(0, 0xAAAAAAAA).empty());
+    CHECK(query(0, 0, 2).empty());
+  });
