+std::vector<kernel::XCONTENT_AGGREGATE_DATA> ContentManager::ListContentAllTypes(
+    u32 device_id, u64 xuid, u32 title_filter) {
+  std::vector<kernel::XCONTENT_AGGREGATE_DATA> result;
+  auto hex_id = [](const std::filesystem::path& name, u32& value) {
+    const auto text = rex::string::PathToUTF8(name);
+    if (text.size() != 8) return false;
+    value = 0;
+    for (const char ch : text) {
+      const int digit = ch >= '0' && ch <= '9' ? ch - '0' :
+          ch >= 'a' && ch <= 'f' ? ch - 'a' + 10 : ch >= 'A' && ch <= 'F' ? ch - 'A' + 10 : -1;
+      if (digit < 0) return false;
+      value = (value << 4) | static_cast<u32>(digit);
+    }
+    return true;
+  };
+  const auto user_root = root_path_ / std::format("{:016X}", xuid);
+  std::error_code error;
+  std::filesystem::directory_iterator title(user_root, error), end;
+  while (!error && title != end) {
+    u32 title_id;
+    if (title->is_directory(error) && !error && hex_id(title->path().filename(), title_id) &&
+        (!title_filter || title_filter == title_id)) {
+      std::error_code type_error;
+      std::filesystem::directory_iterator type(title->path(), type_error);
+      while (!type_error && type != end) {
+        u32 content_type;
+        if (type->is_directory(type_error) && !type_error && hex_id(type->path().filename(), content_type)) {
+          auto items = ListContent(device_id, xuid, static_cast<kernel::XContentType>(content_type), title_id);
+          result.insert(result.end(), items.begin(), items.end());
+        }
+        type.increment(type_error);
+      }
+      if (type_error) REXSYS_DEBUG("Content type enumeration failed: {}", type_error.message());
+    }
+    title.increment(error);
+  }
+  if (error && error != std::errc::no_such_file_or_directory)
+    REXSYS_WARN("Content title enumeration failed: {}", error.message());
+  return result;
+}
