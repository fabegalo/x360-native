 }
 
+Result<X_HANDLE> ThreadRegistry::LaunchHostThread(std::string_view name, u32 stack_size,
+    rex::MoveOnlyFunction<int()> body) {
+  if (StateOf(runtime_).IsTerminatingTitle())
+    return Err<X_HANDLE>(StatusError(X_STATUS_PROCESS_IS_TERMINATING));
+  auto thread = std::make_unique<KernelThread>(runtime_, stack_size, 0, std::move(body));
+  thread->SetName(name);
+  return Launch(std::move(thread));
+}
+
 ICallingThread* ThreadRegistry::GetCallingThread() {
   return KernelThread::GetCallingThread();
 }
