+REX_TEST_CASE("typed settings persist per account and failed publication keeps the old value", "[kernel][xam][profile-settings]") {
+  SignedInProfileFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  const auto first = profile.GetXUID();
+  using P = rex::xam::UserProfile;
+  REQUIRE(profile.AddSetting(std::make_unique<P::Int32Setting>(0x10040111, -123)));
+  REQUIRE(profile.AddSetting(std::make_unique<P::Int64Setting>(0x20080112, -1234567890123ll)));
+  REQUIRE(profile.AddSetting(std::make_unique<P::DoubleSetting>(0x30080113, 1.25)));
+  REQUIRE(profile.AddSetting(std::make_unique<P::UnicodeSetting>(0x40400114, u"Perfil \u00e7")));
+  REQUIRE(profile.AddSetting(std::make_unique<P::FloatSetting>(0x50040115, 2.5f)));
+  REQUIRE(profile.AddSetting(std::make_unique<P::BinarySetting>(0x60400116, std::vector<rex::u8>{1,2,3})));
+  REQUIRE(profile.AddSetting(std::make_unique<P::DateTimeSetting>(0x70080117, 1234567890)));
+  const auto settings = fixture.GetRoot() / "profiles" / std::format("{:016X}", first) / "settings-v1";
+  auto bytes = rex::platform::ReadHostFile(settings / "10040111.dat");
+  REQUIRE(bytes); CHECK(*bytes == std::vector<rex::u8>{0xFF, 0xFF, 0xFF, 0x85});
+  auto blocked = settings / "10040111.dat.tmp";
+  REQUIRE(std::filesystem::create_directory(blocked));
+  CHECK_FALSE(profile.AddSetting(std::make_unique<P::Int32Setting>(0x10040111, 999)));
+  CHECK(static_cast<P::Int32Setting*>(profile.GetSetting(0x10040111))->value == -123);
+  REQUIRE(std::filesystem::remove(blocked));
+  rex::u64 second = 0;
+  REQUIRE(profile.CreateLocal("Other", &second) == 0);
+  REQUIRE(profile.SetLocalSession(second) == 0);
+  auto* absent = profile.GetSetting(0x10040111);
+  REQUIRE(absent); CHECK_FALSE(absent->is_set); CHECK_FALSE(absent->load_failed);
+  REQUIRE(profile.AddSetting(std::make_unique<P::Int32Setting>(0x10040111, 456)));
+  REQUIRE(profile.SetLocalSession(first) == 0);
+  CHECK(static_cast<P::Int32Setting*>(profile.GetSetting(0x10040111))->value == -123);
+  P reopened;
+  REQUIRE(reopened.InitializeLocal(fixture.GetRoot()));
+  CHECK(static_cast<P::Int32Setting*>(reopened.GetSetting(0x10040111))->value == -123);
+  CHECK(static_cast<P::Int64Setting*>(reopened.GetSetting(0x20080112))->value == -1234567890123ll);
+  CHECK(static_cast<P::DoubleSetting*>(reopened.GetSetting(0x30080113))->value == 1.25);
+  CHECK(static_cast<P::UnicodeSetting*>(reopened.GetSetting(0x40400114))->value == u"Perfil \u00e7");
+  CHECK(static_cast<P::FloatSetting*>(reopened.GetSetting(0x50040115))->value == 2.5f);
+  CHECK(static_cast<P::BinarySetting*>(reopened.GetSetting(0x60400116))->value == std::vector<rex::u8>{1,2,3});
+  CHECK(static_cast<P::DateTimeSetting*>(reopened.GetSetting(0x70080117))->value == 1234567890);
+}
