+
+void UserProfile::LoadSetting(Setting* setting) {
+  const auto fallback = setting_defaults_.find(setting->setting_id);
+  const auto empty = EmptySetting(setting->setting_id);
+  const auto initial = empty ? EncodeSetting(*empty) : std::nullopt;
+  if (fallback == setting_defaults_.end() && !initial) { setting->load_failed = true; return; }
+  const auto& bytes = fallback != setting_defaults_.end() ? fallback->second.bytes : *initial;
+  DecodeSetting(*setting, bytes);
+  setting->is_set = fallback != setting_defaults_.end() && fallback->second.is_set;
+  setting->loaded_xuid = GetXUID();
+  setting->loaded_title_id = setting->IsTitleSpecific() && title_id_ ? title_id_() : 0;
+  setting->load_failed = false;
+  const auto path = SettingPath(setting);
+  if (path.empty()) return;
+  std::error_code error;
+  if (!std::filesystem::exists(path, error) && !error) return;
+  auto* file = rex::platform::OpenFile(path, "rb");
+  if (!file) { setting->load_failed = true; return; }
+  Setting::Key key{}; key.value = setting->setting_id;
+  std::vector<uint8_t> stored(key.size + 1);
+  const auto count = fread(stored.data(), 1, stored.size(), file);
+  const bool failed = ferror(file) != 0;
+  fclose(file);
+  stored.resize(count);
+  setting->load_failed = failed || !DecodeSetting(*setting, stored);
+}
+
+bool UserProfile::SaveSetting(Setting* setting) {
+  const auto bytes = EncodeSetting(*setting);
+  const auto path = SettingPath(setting);
+  if (!bytes || path.empty()) return false;
+  std::error_code error;
+  std::filesystem::create_directories(path.parent_path(), error);
+  return !error && rex::platform::WriteHostFile(path, *bytes, true).has_value();
 }
 
