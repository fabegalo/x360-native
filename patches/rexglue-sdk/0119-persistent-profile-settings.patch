+REX_TEST_CASE("profile write validates the entire request and read preserves corrupt-file errors", "[kernel][xam][profile-settings]") {
+  SignedInProfileFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& c) {
+    using P = rex::xam::UserProfile;
+    auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+    const auto records = c.Alloc(80), overlap = c.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    auto* values = reinterpret_cast<rex::xam::X_USER_PROFILE_SETTING*>(c.GetBase() + records);
+    std::memset(values, 0, 80);
+    values[0].setting_id = 0x10040118; values[0].data.type = 1; values[0].data.s32 = 1234;
+    values[1].setting_id = 0x10080119; values[1].data.type = 1; values[1].data.s32 = 5678;
+    CHECK(c.XAM("XamUserWriteProfileSettings", {0, 0, 2, records, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK_FALSE(profile.GetSetting(0x10040118)->is_set);
+    values[1].setting_id = 0x10040006;
+    CHECK(c.XAM("XamUserWriteProfileSettings", {0, 0, 2, records, 0}) == rex::kernel::X_ERROR_ACCESS_DENIED);
+    CHECK_FALSE(profile.GetSetting(0x10040118)->is_set);
+    CHECK(c.XAM("XamUserWriteProfileSettings", {0, 0, 1, records, overlap}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(c.Load32(overlap) == 0);
+    CHECK(static_cast<P::Int32Setting*>(profile.GetSetting(0x10040118))->value == 1234);
+    values[0].data.type = 2;
+    CHECK(c.XAM("XamUserWriteProfileSettings", {0, 0, 1, records, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(c.XAM("XamUserWriteProfileSettings", {0, 0, 33, records, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(c.XAM("XamUserWriteProfileSettings", {0, 0, 1, 0x7F100000, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    const auto setting_ids = c.Alloc(4), output = c.Alloc(64);
+    c.Store32(setting_ids, 0x10040FFF);
+    REQUIRE(ReadProfile(c, 0, 0, 0, 1, setting_ids, output) == 0);
+    CHECK(c.Load32(output + 8) == 0);
+    CHECK(c.Load8(output + 8 + 24) == 0xFF);
+    c.Store32(setting_ids, 0x10080119);
+    CHECK(ReadProfile(c, 0, 0, 0, 1, setting_ids, output) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    const auto path = fixture.GetRoot() / "profiles" / std::format("{:016X}", profile.GetXUID()) / "settings-v1/10040118.dat";
+    std::ofstream(path, std::ios::binary).write("bad", 3);
+    const auto original = profile.GetXUID(); rex::u64 other = 0;
+    REQUIRE(profile.CreateLocal("Reload", &other) == 0);
+    REQUIRE(profile.SetLocalSession(other) == 0);
+    REQUIRE(profile.GetSetting(0x10040118));
+    REQUIRE(profile.SetLocalSession(original) == 0);
+    c.Store32(setting_ids, 0x10040118); c.Store32(output, 0xCAFEBABE);
+    CHECK(ReadProfile(c, 0, 0, 0, 1, setting_ids, output) == rex::kernel::X_ERROR_FUNCTION_FAILED);
+    CHECK(c.Load32(output) == 0xCAFEBABE);
+    CHECK(profile.GetSetting(0x10040118)->load_failed);
+  });
