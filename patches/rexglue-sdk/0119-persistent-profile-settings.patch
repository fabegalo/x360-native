+using ProfileSetting = UserProfile::Setting;
+template <typename T> std::vector<uint8_t> SettingScalar(T value) {
+  std::vector<uint8_t> bytes(sizeof(T));
+  memory::store_and_swap<T>(bytes.data(), value);
+  return bytes;
+}
+std::unique_ptr<ProfileSetting> EmptySetting(uint32_t id) {
+  ProfileSetting::Key key{}; key.value = id;
+  switch (ProfileSetting::Type(key.type)) {
+    case ProfileSetting::Type::kInt32:
+    case ProfileSetting::Type::kFloat: if (key.size != 4) return {}; break;
+    case ProfileSetting::Type::kInt64:
+    case ProfileSetting::Type::kDouble:
+    case ProfileSetting::Type::kDateTime: if (key.size != 8) return {}; break;
+    case ProfileSetting::Type::kUnicode: if (key.size < 2 || key.size % 2) return {}; break;
+    case ProfileSetting::Type::kBinary: break;
+    default: return {};
+  }
+  switch (ProfileSetting::Type(key.type)) {
+    case ProfileSetting::Type::kInt32: return std::make_unique<UserProfile::Int32Setting>(id, 0);
+    case ProfileSetting::Type::kInt64: return std::make_unique<UserProfile::Int64Setting>(id, 0);
+    case ProfileSetting::Type::kDouble: return std::make_unique<UserProfile::DoubleSetting>(id, 0);
+    case ProfileSetting::Type::kFloat: return std::make_unique<UserProfile::FloatSetting>(id, 0);
+    case ProfileSetting::Type::kDateTime: return std::make_unique<UserProfile::DateTimeSetting>(id, 0);
+    case ProfileSetting::Type::kUnicode: return std::make_unique<UserProfile::UnicodeSetting>(id, u"");
+    case ProfileSetting::Type::kBinary: return std::make_unique<UserProfile::BinarySetting>(id);
+    default: return {};
+  }
+}
+std::optional<std::vector<uint8_t>> EncodeSetting(const ProfileSetting& setting) {
+  ProfileSetting::Key key{}; key.value = setting.setting_id;
+  if (key.type != uint32_t(setting.type)) return {};
+  std::vector<uint8_t> bytes;
+  switch (setting.type) {
+    case ProfileSetting::Type::kInt32: bytes = SettingScalar(static_cast<const UserProfile::Int32Setting&>(setting).value); break;
+    case ProfileSetting::Type::kInt64: bytes = SettingScalar(static_cast<const UserProfile::Int64Setting&>(setting).value); break;
+    case ProfileSetting::Type::kDouble: bytes = SettingScalar(static_cast<const UserProfile::DoubleSetting&>(setting).value); break;
+    case ProfileSetting::Type::kFloat: bytes = SettingScalar(static_cast<const UserProfile::FloatSetting&>(setting).value); break;
+    case ProfileSetting::Type::kDateTime: bytes = SettingScalar(static_cast<const UserProfile::DateTimeSetting&>(setting).value); break;
+    case ProfileSetting::Type::kUnicode: {
+      const auto& value = static_cast<const UserProfile::UnicodeSetting&>(setting).value;
+      if (value.size() >= key.size / 2) return {};
+      bytes.resize((value.size() + 1) * 2);
+      for (size_t i = 0; i < value.size(); ++i)
+        memory::store_and_swap<uint16_t>(bytes.data() + i * 2, value[i]);
+      break;
+    }
+    case ProfileSetting::Type::kBinary: bytes = static_cast<const UserProfile::BinarySetting&>(setting).value; break;
+    default: return {};
+  }
+  if (bytes.size() > key.size) return {};
+  return bytes;
+}
+bool DecodeSetting(ProfileSetting& setting, const std::vector<uint8_t>& bytes) {
+  ProfileSetting::Key key{}; key.value = setting.setting_id;
+  if (key.type != uint32_t(setting.type) || bytes.size() > key.size) return false;
+  switch (setting.type) {
+    case ProfileSetting::Type::kInt32:
+      if (bytes.size() != 4) return false;
+      static_cast<UserProfile::Int32Setting&>(setting).value = memory::load_and_swap<int32_t>(bytes.data()); break;
+    case ProfileSetting::Type::kInt64:
+      if (bytes.size() != 8) return false;
+      static_cast<UserProfile::Int64Setting&>(setting).value = memory::load_and_swap<int64_t>(bytes.data()); break;
+    case ProfileSetting::Type::kDouble:
+      if (bytes.size() != 8) return false;
+      static_cast<UserProfile::DoubleSetting&>(setting).value = memory::load_and_swap<double>(bytes.data()); break;
+    case ProfileSetting::Type::kFloat:
+      if (bytes.size() != 4) return false;
+      static_cast<UserProfile::FloatSetting&>(setting).value = memory::load_and_swap<float>(bytes.data()); break;
+    case ProfileSetting::Type::kDateTime:
+      if (bytes.size() != 8) return false;
+      static_cast<UserProfile::DateTimeSetting&>(setting).value = memory::load_and_swap<int64_t>(bytes.data()); break;
+    case ProfileSetting::Type::kUnicode: {
+      if (bytes.size() < 2 || bytes.size() % 2) return false;
+      std::u16string value;
+      for (size_t i = 0; i < bytes.size(); i += 2) {
+        const auto c = memory::load_and_swap<uint16_t>(bytes.data() + i);
+        if (!c) {
+          if (i + 2 != bytes.size()) return false;
+          static_cast<UserProfile::UnicodeSetting&>(setting).value = std::move(value);
+          setting.is_set = true;
+          return true;
+        }
+        value.push_back(c);
+      }
+      return false;
+    }
+    case ProfileSetting::Type::kBinary: static_cast<UserProfile::BinarySetting&>(setting).value = bytes; break;
+    default: return false;
+  }
+  setting.is_set = true;
+  return true;
+}
