diff --git a/include/rex/kernel/xam/module.h b/include/rex/kernel/xam/module.h
index f795772..f73329d 100644
--- a/include/rex/kernel/xam/module.h
+++ b/include/rex/kernel/xam/module.h
@@ -40,6 +40,48 @@ class XamModule : public system::KernelModule {
   // The profile selects the original system UI module; the shared runtime only
   // transports requests and tracks registrations. No UI/state change is implied.
   std::function<X_HRESULT(uint32_t, uint32_t, uint32_t)> system_ui_request;
+  struct SystemUiSession {
+    uint32_t module = 0, user = 0;
+    bool visible = false, input_enabled = false, close_requested = false;
+  };
+  // One foreground system application. Rendering and guest destruction belong
+  // to the selected original UI host, outside these locks and export calls.
+  bool BeginSystemUi(uint32_t module, uint32_t slot, uint32_t user) {
+    std::lock_guard lock(system_apps_mutex_);
+    auto it = system_apps_.find(slot);
+    if (system_ui_.module || user >= 4 || it == system_apps_.end() ||
+        it->second.module != module) return false;
+    system_ui_ = {module, user};
+    return true;
+  }
+  SystemUiSession GetSystemUiSession() {
+    std::lock_guard lock(system_apps_mutex_);
+    return system_ui_;
+  }
+  bool SetSystemUiVisible(uint32_t module) {
+    std::lock_guard lock(system_apps_mutex_);
+    if (!module || module != system_ui_.module) return false;
+    system_ui_.visible = true;
+    return true;
+  }
+  bool EnableSystemUiInput(uint32_t user, bool enable) {
+    std::lock_guard lock(system_apps_mutex_);
+    if (!system_ui_.module || user != system_ui_.user) return false;
+    system_ui_.input_enabled = enable;
+    return true;
+  }
+  bool RequestSystemUiClose() {
+    std::lock_guard lock(system_apps_mutex_);
+    if (!system_ui_.module) return false;
+    system_ui_.close_requested = true;
+    return true;
+  }
+  bool EndSystemUi(uint32_t module) {
+    std::lock_guard lock(system_apps_mutex_);
+    if (!module || module != system_ui_.module) return false;
+    system_ui_ = {};
+    return true;
+  }
   struct SystemApp { uint32_t module, slot, callback, resource_id; };
   uint32_t RegisterSystemApp(SystemApp app) {
     if (!app.module || !app.callback) return 1627;
@@ -83,6 +125,7 @@ class XamModule : public system::KernelModule {
   std::unordered_map<uint32_t, SystemApp> system_apps_;
   LoaderData loader_data_;
   uint32_t language_fallback_table_ = 0;  // Owned guest UTF16 strings, 16 bytes per ID.
+  SystemUiSession system_ui_;
 };
 
