+      ffxApiGetResourceDX12(input_resource, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+  dispatch_desc.depth =
+      ffxApiGetResourceDX12(input_resource, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ,
+                            FFX_API_RESOURCE_USAGE_DEPTHTARGET);
