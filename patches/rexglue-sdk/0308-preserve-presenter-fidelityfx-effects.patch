+  if (!std::strcmp(p_name, "vkBindBufferMemory2KHR")) {
+    return get_device_proc_addr(device, "vkBindBufferMemory2");
+  }
+  if (!std::strcmp(p_name, "vkBindImageMemory2KHR")) {
+    return get_device_proc_addr(device, "vkBindImageMemory2");
+  }
