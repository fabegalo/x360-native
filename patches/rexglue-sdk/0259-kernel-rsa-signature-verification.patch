+// shortcut: loading these headers does not verify their RSA signature; add with the local XEX key.
+u32 XexLoadImageHeaders_entry(GuestPtrT<X_ANSI_STRING> path, MappedVoid headers, u32 size) {
+  auto& title = GetCurrent();
+  auto& memory = title.GetGuestMemory();
+  if (!path || !headers || !memory.GetReadOnlySpan(path.GetGuestAddress(), sizeof(X_ANSI_STRING)))
+    return X_STATUS_INVALID_PARAMETER;
+  if (!path->length || path->length > path->maximum_length) return X_STATUS_INVALID_PARAMETER;
+  const auto characters = memory.GetReadOnlySpan(path->pointer, path->length);
+  if (!characters) return X_STATUS_INVALID_PARAMETER;
+  const std::string target(reinterpret_cast<const char*>(characters->data()), characters->size());
+  if (target.find('\0') != std::string::npos) return X_STATUS_INVALID_PARAMETER;
+  auto opened = title.GetFileSystem().Open(target, {.access = filesystem::Access::kReadData});
+  if (!opened) return ToXStatus(opened.error());
+  const auto file_size = opened->file->GetInfo().size;
+  auto read = [&](std::span<u8> bytes) {
+    if (bytes.size() > file_size) return false;
+    const auto copied = opened->file->Read(bytes, 0);
+    return copied && *copied == bytes.size();
+  };
+  constexpr u32 kInvalidImage = 0xC000007B;
+  std::array<u8, 24> header{};
+  if (!read(header) || std::memcmp(header.data(), "XEX2", 4)) return kInvalidImage;
+  const u32 header_size = memory::load_and_swap<u32>(header.data() + 8);
+  const u32 security = memory::load_and_swap<u32>(header.data() + 16);
+  if (header_size < 24 + 0x108 || header_size > file_size || security < 24 ||
+      security > header_size - 0x108) return kInvalidImage;
+  if (header_size > size) return X_STATUS_BUFFER_TOO_SMALL;
+  if (!memory.GetWritableSpan(headers.GetGuestAddress(), header_size)) return X_STATUS_INVALID_PARAMETER;
+  if (!read({headers.As<u8*>(), header_size})) return kInvalidImage;
+  memory::store_and_swap<u32>(headers.As<u8*>() + 16, headers.GetGuestAddress() + security);
+  return X_STATUS_SUCCESS;
 }
 
