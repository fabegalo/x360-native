+u32 XeKeysVerifyRSASignature_entry(u32 key, MappedVoid digest, MappedVoid signature) {
+  auto& memory = GetCurrent().GetGuestMemory();
+  if (!digest || !signature || !memory.GetReadOnlySpan(digest.GetGuestAddress(), 20) || !memory.GetReadOnlySpan(signature.GetGuestAddress(), 256)) return 0;
+  std::array<uint8_t, 0x110> public_key{};
+  if (!LoadRsaPublicKey(key, public_key)) return 0;
+  const bool valid = VerifyRsaSignature(public_key.data(), digest.As<uint8_t*>(), signature.As<uint8_t*>());
+  REXKRNL_INFO("XeKeysVerifyRSASignature(key {}) -> {}", key, valid);
+  return valid ? 1 : 0;
+}
+
+u32 XeKeysGetKey_entry(u32 index, MappedVoid buffer, MappedU32 size) {
+  std::array<uint8_t, 0x110> key{};
+  if (!LoadLocalKey(std::format("xekey-0x{:x}", index), key, true)) {
+    REXKRNL_WARN("XeKeysGetKey({:#x}) - no local key, buffer untouched", index);
+    return index;
+  }
+  auto& memory = GetCurrent().GetGuestMemory();
+  if (!buffer || !size || !memory.GetWritableSpan(size.GetGuestAddress(), 4) || !memory.GetReadOnlySpan(size.GetGuestAddress(), 4)) return X_STATUS_INVALID_PARAMETER;
+  if (*size < key.size()) {
+    *size = uint32_t(key.size());
+    return X_STATUS_BUFFER_TOO_SMALL;
+  }
+  if (!memory.GetWritableSpan(buffer.GetGuestAddress(), key.size())) return X_STATUS_INVALID_PARAMETER;
+  std::memcpy(buffer.As<uint8_t*>(), key.data(), key.size());
+  *size = uint32_t(key.size());
+  return X_STATUS_SUCCESS;
+}
