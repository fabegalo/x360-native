+// XexLoadImageHeaders(ANSI_STRING* path, header buffer, size). XAM 17559 8168CB20
+// validates system packages with it: the XEX2 header (up to the PE data offset at
+// +8) is copied and +0x10 becomes a pointer to the copied security info, whose
+// 256-byte header signature (+8) XAM hashes; on BUFFER_TOO_SMALL it retries larger.
+// shortcut: the header's RSA signature is not verified here; add it with the kernel XEX key.
+u32 XexLoadImageHeaders_entry(ppc_ptr_t<X_ANSI_STRING> path, mapped_void headers, u32 size) {
+  constexpr X_STATUS kInvalidImageFormat = 0xC000007B;
+  if (!path || !headers) return X_STATUS_INVALID_PARAMETER;
+  const auto target = util::TranslateAnsiPath(REX_KERNEL_MEMORY(), path);
+  auto entry = REX_KERNEL_FS()->ResolvePath(target);
+  if (!entry) return X_STATUS_OBJECT_NAME_NOT_FOUND;
+  filesystem::File* file = nullptr;
+  if (XFAILED(entry->Open(filesystem::FileAccess::kFileReadData, &file))) return X_STATUS_ACCESS_DENIED;
+  struct FileGuard { filesystem::File* file; ~FileGuard() { file->Destroy(); } } guard{file};
+  auto read = [&](std::span<uint8_t> bytes) {
+    size_t count = 0;
+    return bytes.size() <= entry->size() && XSUCCEEDED(file->ReadSync(bytes, 0, &count)) && count == bytes.size();
+  };
+  std::array<uint8_t, 24> header{};
+  if (!read(header) || std::memcmp(header.data(), "XEX2", 4) != 0) return kInvalidImageFormat;
+  const auto header_size = memory::load_and_swap<uint32_t>(header.data() + 8);
+  const auto security = memory::load_and_swap<uint32_t>(header.data() + 0x10);
+  if (header_size < header.size() || header_size > entry->size() || security < header.size() ||
+      security > header_size - 0x108)
+    return kInvalidImageFormat;
+  if (header_size > size) return X_STATUS_BUFFER_TOO_SMALL;
+  auto* out = headers.as<uint8_t*>();
+  if (!read({out, header_size})) return kInvalidImageFormat;
+  memory::store_and_swap<uint32_t>(out + 0x10, headers.guest_address() + security);
+  REXKRNL_DEBUG("XexLoadImageHeaders({}) -> {} bytes", target, header_size);
+  return X_STATUS_SUCCESS;
 }
 
 // LDI caller-owned workspace profile used by XAM 17559's avatar stream.
