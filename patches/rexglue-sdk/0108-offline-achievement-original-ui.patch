+namespace {
+bool NotificationStringReadable(uint32_t address) {
+  if (!address) return true;
+  if (address & 1) return false;
+  auto* memory = REX_KERNEL_MEMORY();
+  uint32_t checked_page = 0xFFFFFFFF;
+  // The original queue copies at most 255 UTF16 code units.
+  for (uint32_t i = 0; i < 256; ++i) {
+    const uint64_t next = uint64_t(address) + i * 2;
+    if (next + 2 > 0x100000000ull) return false;
+    const auto current = static_cast<uint32_t>(next);
+    if ((current >> 12) != checked_page) {
+      auto* heap = memory->LookupHeap(current);
+      rex::memory::HeapAllocationInfo region{};
+      if (!heap || !heap->QueryRegionInfo(current, &region) ||
+          !(region.state & rex::memory::kMemoryAllocationCommit) ||
+          !(region.protect & rex::memory::kMemoryProtectRead)) return false;
+      checked_page = current >> 12;
+    }
+    if (!rex::memory::load_and_swap<uint16_t>(memory->TranslateVirtual(current))) return true;
+  }
+  return true;
+}
+uint32_t QueueOriginalNotification(PPCContext& ctx, bool extended) {
+  // 816A9DE8: exact FE/21013 request, including the 64-bit context at +32.
+  const uint32_t user = ctx.r4.u32, priority = ctx.r5.u32;
+  if ((user >= 4 && user != 0xFF) || priority > 3) return 0x80070057u;
+  if (!NotificationStringReadable(ctx.r6.u32)) return 0x80070057u;
+  auto* memory = REX_KERNEL_MEMORY();
+  const uint32_t request = memory->SystemHeapAlloc(40);
+  if (!request) return 0x8007000Eu;
+  auto* words = memory->TranslateVirtual<rex::be<uint32_t>*>(request);
+  std::memset(words, 0, 40);
+  words[0] = ctx.r3.u32; words[1] = user; words[2] = priority; words[3] = ctx.r6.u32;
+  if (extended) {
+    words[4] = ctx.r8.u32; words[5] = ctx.r7.u32; words[6] = ctx.r9.u32;
+  }
+  const uint64_t context = extended ? ctx.r10.u64 : ctx.r7.u64;
+  words[8] = static_cast<uint32_t>(context >> 32); words[9] = static_cast<uint32_t>(context);
+  const auto status = REX_KERNEL_STATE()->app_manager()->DispatchMessageSync(0xFE, 0x21013, request, 40);
+  memory->SystemHeapFree(request);
+  return status;
+}
+}
+extern "C" REX_FUNC(__imp__XNotifyQueueUI) { ctx.r3.u64 = QueueOriginalNotification(ctx, false); }
+extern "C" REX_FUNC(__imp__XNotifyQueueUIEx) { ctx.r3.u64 = QueueOriginalNotification(ctx, true); }
