+REX_TEST_CASE("original achievement callbacks can unregister themselves on the unlocking thread", "[kernel][xam][achievement-ui]") {
+  KernelFixture fixture;
+  auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+  u32 calls = 0;
+  ui.SetAchievementUnlockedCallback([&](u64 xuid, u32 user, u32 title, u32 achievement) {
+    ++calls; CHECK(xuid == 0xE123456789ABCDEFull); CHECK(user == 2); CHECK(title == 42); CHECK(achievement == 99);
+    ui.SetAchievementUnlockedCallback({});
+  });
+  std::thread worker([&] { ui.NotifyAchievementUnlocked(0xE123456789ABCDEFull, 2, 42, 99); });
+  worker.join();
+  ui.NotifyAchievementUnlocked(0xE123456789ABCDEFull, 2, 42, 99);
+  CHECK(calls == 1);
+}
