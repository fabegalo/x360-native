 void XNotifyPositionUI_entry([[maybe_unused]] u32 position) {}
 
+static bool NotificationStringReadable(u32 address) {
+  if (!address) return true;
+  if (address & 1) return false;
+  for (u32 i = 0; i < 256; ++i) {
+    const u64 at = u64{address} + i * 2;
+    if (at + 2 > 0x100000000ull || !CurrentTitle().heap.IsGuestRangeAccessible(
+        static_cast<u32>(at), 2, kernel::kMemoryProtectRead)) return false;
+    if (!memory::load_and_swap<u16>(CurrentTitle().membase.TranslateVirtual(static_cast<u32>(at)))) return true;
+  }
+  return true;
+}
+
+static u32 QueueOriginalNotification(u32 type, u32 user, u32 priority, u32 text, u64 context,
+                                    u32 arg1 = 0, u32 arg2 = 0, u32 arg3 = 0) {
+  if ((user >= 4 && user != 0xFF) || priority > 3 || !NotificationStringReadable(text))
+    return kernel::X_E_INVALIDARG;
+  const auto request = CurrentTitle().heap.SystemHeapAlloc(40);
+  if (!request) return 0x8007000E;
+  ScopeGuard release([&] { CurrentTitle().heap.SystemHeapFree(request); });
+  auto* words = CurrentTitle().membase.TranslateVirtual<be_u32*>(request);
+  std::memset(words, 0, 40);
+  words[0] = type; words[1] = user; words[2] = priority; words[3] = text;
+  words[4] = arg2; words[5] = arg1; words[6] = arg3;
+  words[8] = static_cast<u32>(context >> 32); words[9] = static_cast<u32>(context);
+  return CurrentXAM().GetAppManager().DispatchMessageSync(0xFE, 0x21013, request, 40);
+}
+
+u32 XNotifyQueueUI_entry(u32 type, u32 user, u32 priority, u32 text, u64 context) {
+  return QueueOriginalNotification(type, user, priority, text, context);
+}
+
+u32 XNotifyQueueUIEx_entry(u32 type, u32 user, u32 priority, u32 text, u32 arg1, u32 arg2, u32 arg3, u64 context) {
+  return QueueOriginalNotification(type, user, priority, text, context, arg1, arg2, arg3);
+}
+
 void XNotifyBroadcast_entry(u32 id, u32 parameter) {
   CurrentTitle().notifier.BroadcastNotification(id, parameter);
 }
