+namespace {
+// Retail 17559 wrappers 816C4678/816C4808 request the original GamerProfile
+// application in modes 2/4. XUID is passed in one PPC argument register (r5).
+uint32_t ShowOriginalAchievements(uint32_t user, uint32_t title, uint64_t xuid,
+                                  uint32_t mode, uint32_t achievement) {
+  if (user >= 4) return 87;  // ERROR_INVALID_PARAMETER
+  auto* kernel = REX_KERNEL_STATE();
+  auto* memory = REX_KERNEL_MEMORY();
+  const uint32_t request = memory->SystemHeapAlloc(544);
+  if (!request) return 14;
+  auto* words = memory->TranslateVirtual<rex::be<uint32_t>*>(request);
+  std::memset(words, 0, 544);
+  words[0] = user; words[1] = mode;
+  words[2] = static_cast<uint32_t>(xuid >> 32); words[3] = static_cast<uint32_t>(xuid);
+  words[4] = title; words[5] = achievement;
+  const auto status = kernel->app_manager()->DispatchMessageSync(0xFE, 0x21008, request, 544);
+  memory->SystemHeapFree(request);
+  // 816C16C8 uses the same error mapping as the existing GamerCard request.
+  return static_cast<int32_t>(status) < 0 ? (status == 0x8007000Eu ? 14u : 1627u) : 0u;
+}
+}
+extern "C" REX_FUNC(__imp__XamShowAchievementsUI) {
+  ctx.r3.u64 = ShowOriginalAchievements(ctx.r3.u32, ctx.r4.u32, 0, 2, 0);
+}
+extern "C" REX_FUNC(__imp__XamShowAchievementsUIEx) {
+  ctx.r3.u64 = ShowOriginalAchievements(ctx.r3.u32, ctx.r4.u32, ctx.r5.u64, 2, 0);
+}
+extern "C" REX_FUNC(__imp__XamShowAchievementDetailsUI) {
+  ctx.r3.u64 = ShowOriginalAchievements(ctx.r3.u32, ctx.r4.u32, 0, 4, ctx.r5.u32);
+}
