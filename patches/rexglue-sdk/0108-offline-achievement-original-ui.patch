+REX_TEST_CASE("original notification requests preserve the full context and Ex argument layout", "[kernel][xam][achievement-ui]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& c) {
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    std::array<u32, 10> words{};
+    u32 address = 0, calls = 0;
+    ui.system_ui_request = [&](u32 message, u32 packet, u32 size) {
+      CHECK(message == 0x21013); CHECK(size == 40);
+      address = packet; ++calls;
+      for (u32 i = 0; i < words.size(); ++i) words[i] = c.Load32(packet + i * 4);
+      return 0;
+    };
+    const auto text = c.Alloc(512);
+    for (u32 i = 0; i < 128; ++i) c.Store32(text + i * 4, 0x00410041);
+    constexpr u64 context = 0xE123456789ABCDEFull;
+    REQUIRE(c.XAM("XNotifyQueueUI", {1, 255, 3, text, context}) == 0);
+    CHECK(words[0] == 1); CHECK(words[1] == 255); CHECK(words[2] == 3); CHECK(words[3] == text);
+    CHECK(words[4] == 0); CHECK(words[5] == 0); CHECK(words[6] == 0); CHECK(words[7] == 0);
+    CHECK(words[8] == 0xE1234567); CHECK(words[9] == 0x89ABCDEF);
+    CHECK(rex::xam::CurrentTitle().heap.QueryAllocationSize(address) == 0);
+    REQUIRE(c.XAM("XNotifyQueueUIEx", {2, 1, 0, 0, 0xAA, 0xBB, 0xCC, context}) == 0);
+    CHECK(words[0] == 2); CHECK(words[1] == 1); CHECK(words[4] == 0xBB); CHECK(words[5] == 0xAA);
+    CHECK(words[6] == 0xCC); CHECK(words[7] == 0); CHECK(words[8] == 0xE1234567); CHECK(words[9] == 0x89ABCDEF);
+    const auto before = calls;
+    CHECK(c.XAM("XNotifyQueueUI", {1, 4, 0, 0, 0}) == rex::kernel::X_E_INVALIDARG);
+    CHECK(c.XAM("XNotifyQueueUI", {1, 0, 4, 0, 0}) == rex::kernel::X_E_INVALIDARG);
+    CHECK(c.XAM("XNotifyQueueUI", {1, 0, 0, text + 1, 0}) == rex::kernel::X_E_INVALIDARG);
+    CHECK(c.XAM("XNotifyQueueUI", {1, 0, 0, 0x7F100000, 0}) == rex::kernel::X_E_INVALIDARG);
+    CHECK(c.XAM("XNotifyQueueUI", {1, 0, 0, 0xFFFFFFFE, 0}) == rex::kernel::X_E_INVALIDARG);
+    CHECK(calls == before);
+    ui.system_ui_request = {};
+    CHECK(c.XAM("XNotifyQueueUI", {1, 0, 0, 0, context}) == rex::kernel::X_E_NOTFOUND);
+  });
+}
