+REX_TEST_CASE("Guide dashboard return preserves the complete original context and selected reason", "[kernel][xam][guide-dashboard-return]") {
+  for (const u32 reason : {0u, 72u, 0xFFFFFFFFu}) {
+    KernelFixture fixture;
+    auto& loader = rex::xam::CurrentXAM().GetLoaderState();
+    loader.launch_path = "old.xex"; loader.launch_flags = 42;
+    loader.launch_data_present = true; loader.launch_data = {1, 2};
+    fixture.RunOnGuestThread([&](Caller& c) {
+      for (const u32 bad : {0u, 0x7F100000u, 0xFFFFFFF0u})
+        CHECK(c.XAM("XamLoaderRebootToDash", {bad}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+      CHECK(loader.launch_path == "old.xex"); CHECK(loader.launch_flags == 42);
+      CHECK(loader.launch_data == std::vector<u8>{1, 2});
+    });
+    std::vector<u8> expected(1020);
+    for (u32 i = 0; i < expected.size(); ++i) expected[i] = static_cast<u8>(i);
+    bool returned = false;
+    fixture.RunUntilGuestThreadEnds([&](Caller& c) {
+      const auto context = c.Alloc(8192) + 4096 - 8;
+      std::memcpy(c.GetBase() + context, expected.data(), expected.size());
+      c.Store32(context + 4, reason); c.Store32(context + 8, 0x12345678);
+      std::memcpy(expected.data(), c.GetBase() + context, expected.size());
+      c.XAM("XamLoaderRebootToDash", {context});
+      returned = true;
+    });
+    CHECK_FALSE(returned);
+    CHECK(loader.exit_request == rex::xam::XAMLoaderState::ExitRequest::Dashboard);
+    CHECK(loader.launch_flags == (reason == 72 ? 0x100000u : 0u));
+    CHECK(loader.launch_path.empty()); CHECK(loader.launch_data_present);
+    CHECK(loader.launch_data == expected);
+  }
+}
