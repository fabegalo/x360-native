+u32 XamLoaderRebootToDash_entry(MappedVoid context) {
+  constexpr u32 size = 1020;
+  if (!CurrentTitle().heap.IsGuestRangeAccessible(context.GetGuestAddress(), size,
+                                                 kernel::kMemoryProtectRead))
+    return kernel::X_ERROR_INVALID_PARAMETER;
+  const auto* bytes = context.As<const u8*>();
+  const auto reason = memory::load_and_swap<u32>(bytes + 4);
+  const auto user = memory::load_and_swap<u32>(bytes + 8);
+  auto& loader = CurrentXAM().GetLoaderState();
+  loader.launch_data.assign(bytes, bytes + size);
+  loader.launch_data_present = true;
+  loader.launch_path.clear();
+  loader.launch_flags = reason == 72 ? 0x100000 : 0;
+  loader.exit_request = XAMLoaderState::ExitRequest::Dashboard;
+  REXXAM_INFO("XamLoaderRebootToDash: reason={} user={:08X} flags={:08X} data_size={}",
+      reason, user, loader.launch_flags, loader.launch_data.size());
+  CurrentTitle().exit.TerminateTitle();
+  return kernel::X_ERROR_SUCCESS;
 }
 
 void XamLoaderTerminateTitle_entry() {
