+  return language > 0 && language < 18 && language != 10 ? language : 1;
+}
+
+// Xenia Canary: language ABI generations expose different subsets of console IDs.
+u32 LanguageForAbi(u32 limit) {
+  const u32 language = XamGetLanguage_entry();
+  if (language < limit) return language;
+  const u32 country = GetXAMSettings().user_country->Get();
+  return country == 53 ? 2 : country == 56 ? 7 : 1;
+}
+
+u32 XGetLanguage_entry() { return LanguageForAbi(10); }
+u32 XTLGetLanguageV2_entry() { return LanguageForAbi(13); }
+u32 XamGetCountry_entry() {
