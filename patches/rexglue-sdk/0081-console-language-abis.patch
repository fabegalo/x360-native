                      "[xam][language]") {
   for (u32 id = 1; id < static_cast<u32>(rex::kernel::XLanguage::kMaxLanguages); ++id) {
     INFO(id);
     { rex::test::ReleaseTestMemory(); }
     BootedRuntime booted(id);
-    CHECK(booted.GetRuntime().GetUserLanguage() == static_cast<XLanguage>(id));
-    CHECK(booted.CallXGetLanguage() == id);
+    // Console setting 10 is reserved; the legacy export only exposes IDs 1..9.
+    const u32 console_id = id == 10 ? 1 : id;
+    CHECK(booted.GetRuntime().GetUserLanguage() == static_cast<XLanguage>(console_id));
+    CHECK(booted.CallXGetLanguage() == (console_id < 10 ? console_id : 1));
   }
 }
 
