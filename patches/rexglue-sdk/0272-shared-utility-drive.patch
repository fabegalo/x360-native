--- a/src/system/runtime.cpp
+++ b/src/system/runtime.cpp
@@ -364,9 +364,27 @@
     REXSYS_DEBUG("  Registered NullDevice for \\Device\\Harddisk0\\{{Partition0,Cache0,Cache1}}");
   }
 
-  // NOTE: Do NOT register a device for cache: paths
-  // Games handle "device not found" gracefully but don't handle actual device
-  // errors (like NAME_COLLISION) well. Let cache: fail cleanly.
+  // Utility streams belong to the runtime VFS, including generic AOT hosts.
+  // Analysis must never create cache files beside read-only title inputs.
+  if (!tool_mode_) {
+    const auto utility_root =
+        (cache_root_.empty() ? user_data_root_ / "cache" : cache_root_) / "utility";
+    std::error_code error;
+    std::filesystem::create_directories(utility_root, error);
+    if (error) {
+      REXSYS_ERROR("Runtime::SetupVfs: Cannot create utility drive: {}", error.message());
+      return false;
+    }
+    auto utility_device =
+        std::make_unique<rex::filesystem::HostPathDevice>("\\CACHE", utility_root, false);
+    if (!utility_device->Initialize() ||
+        !file_system_->RegisterDevice(std::move(utility_device)) ||
+        !file_system_->RegisterSymbolicLink("cache:", "\\CACHE")) {
+      REXSYS_ERROR("Runtime::SetupVfs: Failed to mount utility drive cache:");
+      return false;
+    }
+    REXSYS_INFO("Utility drive cache: -> {}", utility_root.string());
+  }
 
   return true;
 }
