+uint32_t UserProfile::RemoveLocal(uint64_t xuid) {
+  auto storage_lock = rex::thread::global_critical_region::AcquireDirect();
+  bool signed_out = false;
+  {
+    std::lock_guard lock(identity_mutex_);
+    auto next = profiles_;
+    const auto target = std::find_if(next.begin(), next.end(),
+        [xuid](const auto& profile) { return profile.xuid == xuid; });
+    if (target == next.end()) return X_ERROR_NO_SUCH_USER;
+    // Do not overwrite a recovery record or erase any account content. The
+    // complete pre-commit snapshot also retains selection and migration format.
+    std::error_code error;
+    const auto recovery_dir = profile_path_.parent_path() / "deleted";
+    std::filesystem::create_directories(recovery_dir, error);
+    if (error) return X_ERROR_FUNCTION_FAILED;
+    const auto recovery = recovery_dir / fmt::format("{:016X}-{}-{}", xuid,
+        std::chrono::steady_clock::now().time_since_epoch().count(), profile_path_.filename().string());
+    if (!std::filesystem::copy_file(profile_path_, recovery, std::filesystem::copy_options::none, error) || error)
+      return X_ERROR_FUNCTION_FAILED;
+    auto* archive = rex::filesystem::OpenFile(recovery, "ab");
+    if (!archive) return X_ERROR_FUNCTION_FAILED;
+    bool durable = fflush(archive) == 0;
+#if REX_PLATFORM_WIN32
+    if (durable) durable = _commit(_fileno(archive)) == 0;
+#else
+    if (durable) durable = fsync(fileno(archive)) == 0;
+#endif
+    if (fclose(archive)) durable = false;
+    if (!durable) return X_ERROR_FUNCTION_FAILED;
+    next.erase(target);
+    auto selected = identity_;
+    const bool removed_selection = selected.xuid == xuid;
+    if (removed_selection) {
+      signed_out = selected.signin_state != 0;
+      selected = next.empty() ? Identity{} : next.front();
+      selected.signin_state = 0;
+      for (auto& profile : next) profile.signin_state = 0;
+    }
+    if (!PersistProfiles(next, selected)) return X_ERROR_FUNCTION_FAILED;
+    profiles_ = std::move(next);
+    identity_ = std::move(selected);
+    if (removed_selection) {
+      ++storage_epoch_;
+      for (auto& setting : setting_list_) if (setting->is_title_specific()) {
+        setting->loaded_title_id = 0;
+        if (setting->type == Setting::Type::BINARY) {
+          static_cast<BinarySetting*>(setting.get())->value.clear();
+          setting->is_set = false;
+        }
+      }
+    }
+  }
+  if (signed_out && kernel_state_) kernel_state_->BroadcastNotification(0xA, 1);
+  return X_ERROR_SUCCESS;
+}
