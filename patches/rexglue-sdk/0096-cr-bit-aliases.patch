+// The decoder presents cror/crnor with identical sources as two-operand aliases.
+// Decode the one source explicitly: operands[2] is not part of that contract.
+bool build_crmove(BuilderContext& ctx) {
+  const uint32_t dst = ctx.insn.operands[0], src = ctx.insn.operands[1];
+  ctx.println("\t{}.{} = {}.{};", ctx.cr(dst / 4), crBitName(dst % 4),
+              ctx.cr(src / 4), crBitName(src % 4));
+  return true;
+}
+
+bool build_crnot(BuilderContext& ctx) {
+  const uint32_t dst = ctx.insn.operands[0], src = ctx.insn.operands[1];
+  ctx.println("\t{}.{} = !({}.{});", ctx.cr(dst / 4), crBitName(dst % 4),
+              ctx.cr(src / 4), crBitName(src % 4));
+  return true;
+}
+
+// creqv/crxor with three identical operands: one destination, constant result.
+bool build_crset(BuilderContext& ctx) {
+  const uint32_t dst = ctx.insn.operands[0];
+  ctx.println("\t{}.{} = 1;", ctx.cr(dst / 4), crBitName(dst % 4));
+  return true;
+}
+
+bool build_crclr(BuilderContext& ctx) {
+  const uint32_t dst = ctx.insn.operands[0];
+  ctx.println("\t{}.{} = 0;", ctx.cr(dst / 4), crBitName(dst % 4));
+  return true;
+}
 }  // namespace rex::codegen
