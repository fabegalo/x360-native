diff --git a/src/codegen/builder/logical.cpp b/src/codegen/builder/logical.cpp
--- a/src/codegen/builder/logical.cpp
+++ b/src/codegen/builder/logical.cpp
@@ -502,4 +502,37 @@
   return true;
 }
 
+// The decoder presents cror/crnor with identical sources as two-operand aliases.
+// Decode the one source explicitly: operands[2] is not part of that contract.
+template <>
+bool Build<PPC_INST_CRMOVE>(BuilderContext& ctx) {
+  const u32 dst = ctx.insn.operands[0], src = ctx.insn.operands[1];
+  ctx.Println("\t{}.{} = {}.{};", ctx.CR(dst / 4), GetCRBitName(dst % 4),
+              ctx.CR(src / 4), GetCRBitName(src % 4));
+  return true;
+}
+
+template <>
+bool Build<PPC_INST_CRNOT>(BuilderContext& ctx) {
+  const u32 dst = ctx.insn.operands[0], src = ctx.insn.operands[1];
+  ctx.Println("\t{}.{} = !({}.{});", ctx.CR(dst / 4), GetCRBitName(dst % 4),
+              ctx.CR(src / 4), GetCRBitName(src % 4));
+  return true;
+}
+
+// creqv/crxor with three identical operands: one destination, constant result.
+template <>
+bool Build<PPC_INST_CRSET>(BuilderContext& ctx) {
+  const u32 dst = ctx.insn.operands[0];
+  ctx.Println("\t{}.{} = 1;", ctx.CR(dst / 4), GetCRBitName(dst % 4));
+  return true;
+}
+
+template <>
+bool Build<PPC_INST_CRCLR>(BuilderContext& ctx) {
+  const u32 dst = ctx.insn.operands[0];
+  ctx.Println("\t{}.{} = 0;", ctx.CR(dst / 4), GetCRBitName(dst % 4));
+  return true;
+}
+
 }  // namespace rex::codegen
