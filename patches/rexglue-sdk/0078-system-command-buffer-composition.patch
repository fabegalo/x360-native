+bool CommandProcessor::ExecutePacketType3_XE_SYSTEM_COMMANDS(memory::RingBuffer* reader,
+                                                             uint32_t packet, uint32_t count) {
+  // VdSwap inserts the command buffer published through VdSetSystemCommandBuffer.
+  // It runs between two title frames: restore the title's register state and
+  // shaders afterwards, so the title never observes the system recording.
+  // Payload: command address, dword count, completion fence, sequence, and
+  // the title front buffer fetch constant the command buffer inherits.
+  constexpr uint32_t kInheritedFetch = 15;
+  if (count < 10) {
+    reader->AdvanceRead(count * sizeof(uint32_t));
+    return false;
+  }
+  uint32_t list_ptr = CpuToGpu(reader->ReadAndSwap<uint32_t>());
+  uint32_t list_length = reader->ReadAndSwap<uint32_t>() & 0xFFFFFF;
+  uint32_t fence = reader->ReadAndSwap<uint32_t>();
+  uint32_t sequence = reader->ReadAndSwap<uint32_t>();
+  uint32_t front_buffer[6];
+  for (uint32_t& value : front_buffer) value = reader->ReadAndSwap<uint32_t>();
+  reader->AdvanceRead((count - 10) * sizeof(uint32_t));
+  RegisterFile& regs = *register_file_;
+  system_register_snapshot_.assign(regs.values, regs.values + RegisterFile::kRegisterCount);
+  Shader* vertex_shader = active_vertex_shader_;
+  Shader* pixel_shader = active_pixel_shader_;
+  const uint64_t bin_select = bin_select_;
+  const uint64_t bin_mask = bin_mask_;
+  for (uint32_t i = 0; i < 6; ++i)
+    WriteRegister(XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + kInheritedFetch * 6 + i, front_buffer[i]);
+  if (list_length) ExecuteIndirectBuffer(GpuToCpu(list_ptr), list_length);
+  for (uint32_t i = 0; i < RegisterFile::kRegisterCount; ++i) {
+    const uint32_t value = system_register_snapshot_[i];
+    if (regs.values[i] == value) continue;
+    // Constants carry backend binding state; other registers are read per draw.
+    // Assign those directly to avoid replaying side effects (scratch, gamma).
+    if (i >= XE_GPU_REG_SHADER_CONSTANT_000_X && i <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31)
+      WriteRegister(i, value);
+    else
+      const_cast<volatile uint32_t&>(regs.values[i]) = value;
+  }
+  active_vertex_shader_ = vertex_shader;
+  active_pixel_shader_ = pixel_shader;
+  bin_select_ = bin_select;
+  bin_mask_ = bin_mask;
+  memory::store_and_swap<uint32_t>(memory_->TranslatePhysical(fence), sequence);
+  return true;
+}
