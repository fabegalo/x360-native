+bool CommandProcessor::ExecutePacketType3_XE_SYSTEM_COMMANDS(memory::RingBuffer* reader,
+                                                             [[maybe_unused]] u32 packet, u32 count) {
+  // VdSwap inserts the command buffer published through VdSetSystemCommandBuffer.
+  // It runs between two title frames: restore the title's register state and
+  // shaders afterwards, so the title never observes the system recording.
+  // Payload: command address, dword count, completion fence, sequence, and
+  // the title front buffer fetch constant the command buffer inherits.
+  constexpr u32 kInheritedFetch = 15;
+  if (count < 10) {
+    reader->AdvanceRead(count * sizeof(u32));
+    return false;
+  }
+  u32 list_ptr = CPUToGPU(reader->ReadAndSwap<u32>());
+  u32 list_length = reader->ReadAndSwap<u32>() & 0xFFFFFF;
+  u32 fence = reader->ReadAndSwap<u32>();
+  u32 sequence = reader->ReadAndSwap<u32>();
+  u32 front_buffer[6];
+  for (u32& value : front_buffer) value = reader->ReadAndSwap<u32>();
+  reader->AdvanceRead((count - 10) * sizeof(u32));
+  xenos::RegisterFile& regs = *register_file_;
+  system_register_snapshot_.assign(regs.values, regs.values + xenos::RegisterFile::kRegisterCount);
+  Shader* vertex_shader = active_vertex_shader_;
+  Shader* pixel_shader = active_pixel_shader_;
+  const u64 saved_bin_select = bin_select_;
+  const u64 saved_bin_mask = bin_mask_;
+  for (u32 i = 0; i < 6; ++i)
+    WriteRegister(std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_00_0) + kInheritedFetch * 6 + i, front_buffer[i]);
+  if (list_length) ExecuteIndirectBuffer(GPUToCPU(list_ptr), list_length);
+  for (u32 i = 0; i < xenos::RegisterFile::kRegisterCount; ++i) {
+    const u32 value = system_register_snapshot_[i];
+    if (regs.values[i] == value) continue;
+    // Constants carry backend binding state; other registers are read per draw.
+    // Assign those directly to avoid replaying side effects (scratch, gamma).
+    if (i >= std::to_underlying(xenos::Register::SHADER_CONSTANT_000_X) && i <= std::to_underlying(xenos::Register::SHADER_CONSTANT_LOOP_31))
+      WriteRegister(i, value);
+    else
+      regs.values[i] = value;
+  }
+  active_vertex_shader_ = vertex_shader;
+  active_pixel_shader_ = pixel_shader;
+  bin_select_ = saved_bin_select;
+  bin_mask_ = saved_bin_mask;
+  if (auto stored = physical_memory_.StoreRelease32(fence, sequence); !stored) {
+    REXGPU_ERROR("System command buffer fence failed: {}", stored.error().GetDescription());
+    return false;
+  }
+  return true;
+}
