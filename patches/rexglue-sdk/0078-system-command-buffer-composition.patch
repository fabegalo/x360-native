+namespace {
+// Descriptor built by XAM 17559 816C9A20/816CCF00 -> 81842B08 (0x94 bytes):
+// +00 command buffer address, +04 size in dwords (24 bits), +08 front buffer
+// virtual page, +0C texture format, +10 color format, +14/+18 dimensions,
+// +1C/+20 optional scaler, +58/+90 optional title scaler.
+constexpr uint32_t kSystemCommandBufferSize = 0x94;
+struct SystemCommandBufferState {
+  std::mutex mutex;
+  std::array<uint8_t, kSystemCommandBufferSize> descriptor{};
+  bool present = false;
+  uint32_t published = 0;
+  uint32_t fence = 0;  // Guest physical-heap word written by the command processor.
+};
+SystemCommandBufferState system_command_buffer;
+std::atomic<SystemSwapCallback> system_swap_callback{nullptr};
+
+uint32_t DescriptorWord(const std::array<uint8_t, kSystemCommandBufferSize>& d, uint32_t offset) {
+  return memory::load_and_swap<uint32_t>(d.data() + offset);
+}
+uint32_t ExecutedSystemCommandBuffers() {
+  if (!system_command_buffer.fence) return 0;
+  return memory::load_and_swap<uint32_t>(
+      REX_KERNEL_MEMORY()->TranslateVirtual(system_command_buffer.fence));
+}
+}  // namespace
+
+void SetSystemSwapCallback(SystemSwapCallback callback) { system_swap_callback.store(callback); }
+
+u32 VdGet3dVideoFormat_entry() {
+  // The emulated output has no stereoscopic mode. XAM 17559 816C8010 compares
+  // the result with 3 before choosing its side-by-side system buffers.
+  return 0;
+}
+
+void VdSetSystemCommandBuffer_entry(mapped_void descriptor) {
+  std::lock_guard lock(system_command_buffer.mutex);
+  auto& state = system_command_buffer;
+  if (!descriptor) {
+    state.descriptor.fill(0);
+    state.present = false;
+    return;
+  }
+  std::memcpy(state.descriptor.data(), descriptor.as<uint8_t*>(), kSystemCommandBufferSize);
+  state.present = DescriptorWord(state.descriptor, 0) && (DescriptorWord(state.descriptor, 4) & 0xFFFFFF);
+  REXKRNL_DEBUG("VdSetSystemCommandBuffer: commands {:08X}+{} front {:08X} {}x{}",
+                DescriptorWord(state.descriptor, 0), DescriptorWord(state.descriptor, 4) & 0xFFFFFF,
+                DescriptorWord(state.descriptor, 8), DescriptorWord(state.descriptor, 0x14),
+                DescriptorWord(state.descriptor, 0x18));
+}
+
+u32 VdQuerySystemCommandBuffer_entry(u32 unk0) {
+  // XAM records into one of three rotating buffers after this returns nonzero.
+  // At most one published buffer may still wait for the command processor.
+  // Earlier swaps were already submitted by the title, so a bounded wait
+  // cannot depend on the caller's own pending swap.
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(100);
+  for (;;) {
+    uint32_t published;
+    {
+      std::lock_guard lock(system_command_buffer.mutex);
+      published = system_command_buffer.published;
+    }
+    if (published - ExecutedSystemCommandBuffers() <= 1) return 1;
+    if (std::chrono::steady_clock::now() >= deadline) return 0;
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+}
