+// A frameless virtual tail thunk has no fall-through and no table of local
+// labels. Keep this deliberately exact: an arbitrary bctr may be a switch.
+bool isVirtualTailThunk(DecodedBinary& decoded, uint32_t start, uint32_t end) {
+  if (end - start != 12)
+    return false;
+  const auto* object = decoded.get(start);
+  const auto* slot = decoded.get(start + 4);
+  const auto* ctr = decoded.get(start + 8);
+  const auto* branch = decoded.get(end);
+  if (!object || !slot || !ctr || !branch)
+    return false;
+  const auto scratch = object->D.RT;
+  return object->opcode == Opcode::lwz && object->D.RA == 3 && object->D.d == 0 &&
+         (scratch == 11 || scratch == 12) &&
+         slot->opcode == Opcode::lwz && slot->D.RA == scratch && slot->D.RT == scratch &&
+         static_cast<int16_t>(slot->D.d) >= 0 && (slot->D.d & 3) == 0 &&
+         ctr->opcode == Opcode::mtctr && ctr->XFX.RT == scratch &&
+         static_cast<uint32_t>(branch->code) == 0x4E800420;
+}
