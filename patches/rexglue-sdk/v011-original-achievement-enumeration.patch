+u32 XamUserCreateTitlesPlayedEnumerator_entry([[maybe_unused]] u32 title_id, u32 user_index, u64 xuid,
+                                              u32 offset, u32 count,
+                                              MappedU32 buffer_size, MappedU32 handle) {
+  if (!count || count > UINT32_MAX / sizeof(X_OFFLINE_TITLE_PLAYED) || user_index >= 4 ||
+      !buffer_size || !handle ||
+      !AchievementGuestSpan( buffer_size.GetGuestAddress(), 4,
+                            kernel::kMemoryProtectWrite) ||
+      !AchievementGuestSpan( handle.GetGuestAddress(), 4,
+                            kernel::kMemoryProtectWrite)) return X_ERROR_INVALID_PARAMETER;
+  *handle = 0;
+  *buffer_size = count * sizeof(X_OFFLINE_TITLE_PLAYED);
+  const auto identity = CurrentXAM().GetUserProfile().identity();
+  if (user_index != 0 || !identity.signin_state) return X_ERROR_NO_SUCH_USER;
+  const uint64_t requested_xuid = xuid ? uint64_t(xuid) : identity.xuid;
+  if (!CurrentXAM().GetUserProfile().FindLocal(requested_xuid).xuid) return X_ERROR_NO_SUCH_USER;
+  std::vector<X_OFFLINE_TITLE_PLAYED> titles;
+  for (const auto id : CurrentXAM().GetUserProfile().TitlesPlayed(requested_xuid)) {
+    std::vector<OfflineAchievementRecord> achievements;
+    const auto result = CurrentXAM().GetOfflineAchievements().List(requested_xuid, id, achievements);
+    // Historical played-title records may predate metadata import. They must
+    // not gain invented names, totals or achievements in this enumerator.
+    if (result == OfflineAchievementResult::kNotFound) continue;
+    if (result != OfflineAchievementResult::kSuccess) return OfflineAchievementError(result);
+    if (achievements.empty()) continue;
+    std::string name;
+    const auto name_result = CurrentXAM().GetOfflineAchievements().TitleName(id, name);
+    if (name_result != OfflineAchievementResult::kSuccess) return OfflineAchievementError(name_result);
+    X_OFFLINE_TITLE_PLAYED record{};
+    record.title_id = id;
+    record.achievement_count = static_cast<uint32_t>(achievements.size());
+    uint64_t total = 0, earned = 0;
+    uint32_t unlocked = 0;
+    for (const auto& achievement : achievements) {
+      total += achievement.info.gamerscore;
+      if (achievement.unlock_filetime) { ++unlocked; earned += achievement.info.gamerscore; }
+    }
+    if (total > UINT32_MAX || earned > UINT32_MAX) return 13;
+    record.total_score = static_cast<uint32_t>(total);
+    record.earned_score = static_cast<uint32_t>(earned);
+    record.unlocked_count = unlocked;
+    record.flags = unlocked ? 1u : 0u;  // Offline earned; no online flag/counter.
+    const auto title_name = rex::string::ToUTF16(name);
+    rex::string::CopyAndSwapTruncating(reinterpret_cast<char16_t*>(record.title_name),
+                                         title_name, 64);
+    titles.push_back(record);
+  }
+  StaticItemList items(count, sizeof(X_OFFLINE_TITLE_PLAYED));
+  for (size_t i = std::min<size_t>(offset, titles.size()); i < titles.size(); ++i)
+    *items.Append<X_OFFLINE_TITLE_PLAYED>() = titles[i];
+  kernel::X_HANDLE result_handle = kernel::kXInvalidHandleValue;
+  const auto status = CreateEnumerator(&result_handle, {user_index, 0xFB, 0xB0050, 0xB000B, 0},
+      EnumeratorObject(count, sizeof(X_OFFLINE_TITLE_PLAYED),
+          [items = std::move(items)](u32, u8* data, u32* written) mutable {
+            return items.Write(data, written);
+          }));
+  if (kernel::XFAILED(status)) return kernel::X_ERROR_FUNCTION_FAILED;
+  *handle = result_handle;
+  return X_ERROR_SUCCESS;
 }
 
