+void SpirvShaderTranslator::FSI_AccumulateSampleCount(spv::Id category, spv::Id count) {
+  // Reports are four pairs of uint32 pipe counters (not uint64 values).
+  // This executor aggregates in pipe A, leaving pipe B at zero; uint32 wrap
+  // is retained so subtraction of cumulative BEGIN/END reports still works.
+  const spv::Id base = builder_->makeUintConstant(
+      (xenos::kEdramSizeBytes / 4) * draw_resolution_scale_x_ * draw_resolution_scale_y_);
+  const spv::Id scope = builder_->makeUintConstant(spv::ScopeDevice);
+  const auto storage = features_.spirv_version >= spv::Spv_1_3
+                           ? spv::StorageClassStorageBuffer : spv::StorageClassUniform;
+  for (const auto offset : {category, const_uint_0_}) {
+    id_vector_temp_.clear();
+    id_vector_temp_.push_back(const_int_0_);
+    id_vector_temp_.push_back(builder_->createBinOp(spv::OpIAdd, type_uint_, base, offset));
+    const spv::Id counter = builder_->createAccessChain(storage, buffer_edram_, id_vector_temp_);
+    // Relaxed device atomics aggregate different pixels. Snapshot ordering is
+    // supplied by the backend's shader-write/transfer-read barrier and fence.
+    builder_->createQuadOp(spv::OpAtomicIAdd, type_uint_, counter, scope, const_uint_0_, count);
+  }
+}
