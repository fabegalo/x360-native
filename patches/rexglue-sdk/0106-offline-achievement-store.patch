+// Offline XAM achievements. Original XDBF metadata and per-XUID unlocks are
+// separate from the optional host achievement facade. BSD-3-Clause.
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <mutex>
+#include <span>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/system/achievement_store.h>
+
+namespace rex::system {
+
+enum class OfflineAchievementResult {
+  kSuccess,
+  kNotFound,
+  kInvalidArgument,
+  kStorageError,
+  kCorruptData,
+  kMetadataMismatch,
+};
+
+struct OfflineAchievementRecord {
+  AchievementInfo info;
+  uint64_t unlock_filetime = 0;
+};
+
+struct OfflineAchievementTotals {
+  uint32_t gamerscore = 0;
+  uint32_t unlocked_count = 0;
+};
+
+class OfflineAchievementStore {
+ public:
+  // Call whenever the local account root changes (including session handoff).
+  // Empty roots disable persistence; no unlock may silently become volatile.
+  void Configure(const std::filesystem::path& user_root, uint32_t language = 0);
+
+  // Only the unmodified resource from the identified executable is imported.
+  // Conflicting metadata for a cached Title ID is an explicit error.
+  OfflineAchievementResult ImportTitle(uint32_t title_id, std::span<const uint8_t> xdbf);
+  OfflineAchievementResult List(uint64_t xuid, uint32_t title_id,
+                                std::vector<OfflineAchievementRecord>& records);
+  // Validate the complete batch, durably replace the profile snapshot, then
+  // return only new unlocks. Duplicate writes are successful and produce no event.
+  OfflineAchievementResult UnlockBatch(uint64_t xuid, uint32_t title_id,
+                                       std::span<const uint32_t> ids,
+                                       std::vector<OfflineAchievementRecord>& newly_unlocked);
+  // Global and optional per-title counters come from the same committed
+  // snapshot, even while another process writes an unlock.
+  OfflineAchievementResult Totals(uint64_t xuid, OfflineAchievementTotals& totals,
+                                  uint32_t title_id = 0,
+                                  OfflineAchievementTotals* title_totals = nullptr);
+  OfflineAchievementResult GetImage(uint32_t title_id, uint32_t image_id,
+                                    std::vector<uint8_t>& image);
+  OfflineAchievementResult TitleName(uint32_t title_id, std::string& name);
+
+ private:
+  std::mutex mutex_;
+  std::filesystem::path root_;
+  uint32_t language_ = 0;
+  // A rejected current resource must not silently use a previous cached copy.
+  std::unordered_map<uint32_t, OfflineAchievementResult> rejected_titles_;
+};
+
+}  // namespace rex::system
