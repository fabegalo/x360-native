+Result<void> XAMState::ImportOriginalAchievements() {
+  const auto module = title_.objects.Get<kernel::ILoadedModule>(title_.modules.GetExecutable().value_or(0));
+  if (!module) return Ok();
+  u32 data = 0, size = 0;
+  if (kernel::XFAILED(module->GetSection(std::format("{:08X}", GetTitleID()), &data, &size))) return Ok();
+  if (!title_.heap.IsGuestRangeAccessible(data, size, kernel::kMemoryProtectRead))
+    return Err(ErrorCategory::kFormat, "original achievement resource is not readable");
+  const auto result = offline_achievement_store_.ImportTitle(GetTitleID(),
+      std::span<const u8>(title_.membase.TranslateVirtual(data), size));
+  if (result != OfflineAchievementResult::kSuccess)
+    return Err(ErrorCategory::kFormat, std::format("original achievement metadata rejected ({})", static_cast<int>(result)));
+  return Ok();
 }
 
