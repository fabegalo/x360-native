 namespace {
 
+// Decode Make quoting before comparing semantic paths, including a quoted parent folder.
+std::string DecodeDepfile(std::string_view text) {
+  std::string decoded;
+  for (size_t i = 0; i < text.size(); ++i) {
+    if (text[i] == '\\' && i + 1 < text.size()) {
+      const char escaped = text[++i];
+      if (escaped != '\n') decoded += escaped;
+    } else if (text[i] == '$' && i + 1 < text.size() && text[i + 1] == '$') {
+      decoded += '$'; ++i;
+    } else decoded += text[i];
+  }
+  return decoded;
+}
+
