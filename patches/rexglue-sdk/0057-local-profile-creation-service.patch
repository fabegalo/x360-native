+class ProfileCreation final : public kernel::IXAMObject {
+ public:
+  static constexpr u32 kTag = 0x50524352;
+  u32 GetTag() const override { return kTag; }
+  u64 xuid = 0;
+  u32 result = 0;
+  std::atomic<bool> consumed{false};
+};
+
+u32 XamProfileCreate_entry(u32 flags, MappedU32 device, u64 input_xuid,
+                          GuestPtrT<LocalAccount> account, [[maybe_unused]] u32 avatar,
+                          [[maybe_unused]] u32 preferences, [[maybe_unused]] u32 unknown,
+                          MappedU32 handle) {
+  if (!device || !account || !handle) return kernel::X_E_INVALIDARG;
+  *handle = 0;
+  if (flags != 1 || input_xuid || account->online_xuid) return 0x80004001u;
+  if (*device > 1) return static_cast<u32>(kernel::XHRESULTFromWin32(kernel::X_ERROR_DEVICE_NOT_CONNECTED));
+  std::string name;
+  for (unsigned i = 0; i < 16; ++i) {
+    const u16 ch = account->name[i];
+    if (!ch) break;
+    if (ch < 32 || ch > 126 || i == 15) return kernel::X_E_INVALIDARG;
+    name.push_back(static_cast<char>(ch));
+  }
+  auto& objects = CurrentTitle().objects;
+  auto added = objects.AddXAMObject(std::make_unique<ProfileCreation>(), {});
+  if (!added) return kernel::X_E_FAIL;
+  auto operation = objects.Get<ProfileCreation>(*added);
+  operation->result = CurrentXAM().GetUserProfile().CreateLocal(name, &operation->xuid);
+  *handle = *added;
+  REXXAM_INFO("Local profile created name={} xuid={:016X} result={}", name, operation->xuid, operation->result);
+  return 0;
+}
+
+u32 XamProfileGetCreationStatus_entry(u32 handle, MappedU64 xuid) {
+  if (!xuid) return kernel::X_E_INVALIDARG;
+  auto operation = CurrentTitle().objects.Get<ProfileCreation>(handle);
+  if (!operation || operation->consumed.exchange(true)) return kernel::X_E_INVALIDARG;
+  *xuid = operation->xuid;
+  const auto result = static_cast<u32>(kernel::XHRESULTFromWin32(operation->result));
+  kernel::CloseOwned(CurrentTitle().objects, handle);
+  return result;
 }
 
