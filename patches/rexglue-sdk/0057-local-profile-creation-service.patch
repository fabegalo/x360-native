+REX_TEST_CASE("retail local profile creation uses a one-shot official handle and preserves the active account", "[kernel][xam][profile-creation]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+    REQUIRE(profile.CreateLocal("First") == 0);
+    const auto first = profile.GetXUID();
+    REQUIRE(profile.SetLocalSession(first) == 0);
+    const auto device = caller.Alloc(4), account = caller.Alloc(380), handle_out = caller.Alloc(4), xuid_out = caller.Alloc(8);
+    caller.Store32(device, 1);
+    const std::string name = "Second";
+    for (size_t i = 0; i < name.size(); ++i) caller.GetBase()[account + 9 + i * 2] = static_cast<u8>(name[i]);
+    auto create = [&](u32 flags, u64 input) { return caller.XAM("XamProfileCreate", {flags, device, input, account, 0, 0, 0, handle_out}); };
+    CHECK(caller.XAM("XamProfileCreate", {1, 0, 0, account, 0, 0, 0, handle_out}) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    CHECK(create(0, 0) == 0x80004001u);
+    CHECK(caller.Load32(handle_out) == 0);
+    CHECK(create(1, 0xE000000000000001ull) == 0x80004001u);
+    caller.Store64(account + 40, 1);
+    CHECK(create(1, 0) == 0x80004001u);
+    caller.Store64(account + 40, 0);
+    caller.Store32(device, 2);
+    CHECK(create(1, 0) == static_cast<u32>(rex::kernel::XHRESULTFromWin32(rex::kernel::X_ERROR_DEVICE_NOT_CONNECTED)));
+    caller.Store32(device, 1);
+    REQUIRE(create(1, 0) == 0);
+    const auto handle = caller.Load32(handle_out);
+    REQUIRE(handle != 0);
+    CHECK(caller.GetRuntime().GetObjectTable().Get(handle));
+    CHECK(caller.XAM("XamProfileGetCreationStatus", {handle, 0}) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    REQUIRE(caller.XAM("XamProfileGetCreationStatus", {handle, xuid_out}) == 0);
+    const auto second = (u64(caller.Load32(xuid_out)) << 32) | caller.Load32(xuid_out + 4);
+    CHECK(second != 0);
+    CHECK(second != first);
+    CHECK(second >> 60 == 0xE);
+    CHECK(profile.FindLocal(second).name == "Second");
+    CHECK(profile.identity().xuid == first);
+    CHECK(profile.GetSigninState() == 1);
+    CHECK_FALSE(caller.GetRuntime().GetObjectTable().Get(handle));
+    caller.Store64(xuid_out, 0xCDCDCDCDCDCDCDCDull);
+    CHECK(caller.XAM("XamProfileGetCreationStatus", {handle, xuid_out}) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    CHECK(caller.Load32(xuid_out) == 0xCDCDCDCD);
+    REQUIRE(create(1, 0) == 0);
+    const auto duplicate = caller.Load32(handle_out);
+    CHECK(caller.XAM("XamProfileGetCreationStatus", {duplicate, xuid_out}) == static_cast<u32>(rex::kernel::XHRESULTFromWin32(rex::kernel::X_ERROR_ALREADY_EXISTS)));
+    CHECK(caller.Load32(xuid_out) == 0);
+    CHECK(caller.Load32(xuid_out + 4) == 0);
+    CHECK_FALSE(caller.GetRuntime().GetObjectTable().Get(duplicate));
+    CHECK(profile.local_profiles().size() == 2);
+    CHECK(profile.identity().xuid == first);
+  });
