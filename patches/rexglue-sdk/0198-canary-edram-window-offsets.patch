+      i32 scissor_top =
+          std::max(static_cast<i32>(regs.Get<xenos::reg::PA_SC_WINDOW_SCISSOR_TL>().tl_y),
+                   static_cast<i32>(regs.Get<xenos::reg::PA_SC_SCREEN_SCISSOR_TL>().tl_y) -
+                       window_y_offset);
+      u32 rows_start_tiles_at_64bpp =
+          static_cast<u32>(scissor_top / tile_height_pixels) * pitch_tiles_at_32bpp * 2;
