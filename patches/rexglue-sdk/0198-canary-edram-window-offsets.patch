+                 static_cast<i32>(regs.Get<xenos::reg::PA_SC_SCREEN_SCISSOR_BR>().br_y) -
+                     window_y_offset);
+    u32 rows_end_tiles_at_32bpp =
+        static_cast<u32>((scissor_bottom + tile_height_pixels - 1) /
+                 tile_height_pixels) *
+        pitch_tiles_at_32bpp;
