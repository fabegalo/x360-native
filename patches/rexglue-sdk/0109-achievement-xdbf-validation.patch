+REX_TEST_CASE("XDBF validation rejects duplicate keys, repeated IDs and malformed capacities before publication", "[kernel][xam][xdbf][xdbf-validation]") {
+  const std::vector<u8> pixels(4);
+  const Entry duplicates[] = {{XDBFSection::kImage, 1, 0, 4}, {XDBFSection::kImage, 1, 0, 4}};
+  auto raw = Database(duplicates, 2, pixels);
+  CHECK_FALSE(XDBFTitleData(raw.data(), raw.size()).IsValid());
+  raw = Database({XDBFSection::kImage, 1, 0, 4}, pixels);
+  REQUIRE(XDBFTitleData(raw.data(), raw.size()).IsValid());
+  for (size_t offset : {size_t{7}, size_t{23}}) {
+    auto bad = raw; bad[offset] = 2;
+    CHECK_FALSE(XDBFTitleData(bad.data(), bad.size()).IsValid());
+  }
+  Bytes content;
+  content.Text("XACH").Put(1, 4).Put(kSectionHeaderSize + 2 * kAchievementSize - 4, 4).Put(2, 2).Zeros(2 * kAchievementSize);
+  raw = Database({XDBFSection::kMetadata, kXachId, 0, static_cast<u32>(content.data.size())}, content.data);
+  CHECK_FALSE(XDBFTitleData(raw.data(), raw.size()).IsValid());
+  content.data[kSectionHeaderSize + kAchievementSize + 1] = 1;
+  raw = Database({XDBFSection::kMetadata, kXachId, 0, static_cast<u32>(content.data.size())}, content.data);
+  CHECK(XDBFTitleData(raw.data(), raw.size()).IsValid());
+  Bytes strings;
+  strings.Text("XSTR").Put(1, 4).Put(kSectionHeaderSize + 2 * (kStringEntrySize + 1) - 4, 4).Put(2, 2);
+  strings.Put(1, 2).Put(1, 2).Text("A").Put(1, 2).Put(1, 2).Text("B");
+  raw = Database({XDBFSection::kStringTable, 1, 0, static_cast<u32>(strings.data.size())}, strings.data);
+  CHECK_FALSE(XDBFTitleData(raw.data(), raw.size()).IsValid());
+  const std::vector<u8> empty = Database({}, 0, {});
+  CHECK(XDBFTitleData(empty.data(), empty.size()).IsValid());
+}
