 XDBFTitleData::XDBFTitleData(const u8* data, size_t data_size)
-    : data_(data), data_size_(data_size) {
-  if (!data || data_size <= sizeof(XDBFHeader)) {
-    data_ = nullptr;
-    return;
-  }
-
+    : data_size_(data_size) {
+  if (!data || data_size < sizeof(XDBFHeader)) return;
   const auto header = memory::load<XDBFHeader>(data);
-  const u32 entry_capacity = memory::load<be_u32>(&header.entry_capacity);
-  const u32 entry_used = memory::load<be_u32>(&header.entry_used);
-  const u32 free_count = memory::load<be_u32>(&header.free_count);
-  const u64 tables_size =
-      u64{sizeof(XDBFEntry)} * entry_capacity + u64{sizeof(XDBFFileLocation)} * free_count;
-  if (memory::load<be_u32>(&header.magic) != kXDBFSignatureXDBF || entry_used > entry_capacity ||
-      tables_size > data_size - sizeof(XDBFHeader)) {
-    data_ = nullptr;
-    return;
-  }
-
-  entry_used_ = entry_used;
-  entries_ = data + sizeof(XDBFHeader);
-  content_offset_ =
-      entries_ + sizeof(XDBFEntry) * entry_capacity + sizeof(XDBFFileLocation) * free_count;
+  const u32 capacity = header.entry_capacity, used = header.entry_used;
+  const u32 free_count = header.free_count;
+  if (header.magic != kXDBFSignatureXDBF || header.version != 0x10000 ||
+      used > capacity || header.free_used > free_count) return;
+  size_t offset = sizeof(XDBFHeader);
+  if (capacity > (data_size - offset) / sizeof(XDBFEntry)) return;
+  const auto* entries = data + offset;
+  offset += size_t{capacity} * sizeof(XDBFEntry);
+  if (free_count > (data_size - offset) / sizeof(XDBFFileLocation)) return;
+  offset += size_t{free_count} * sizeof(XDBFFileLocation);
+  const size_t remaining = data_size - offset;
+  std::set<std::pair<u16, u64>> keys;
+  for (u32 i = 0; i < used; ++i) {
+    const auto entry = memory::load<XDBFEntry>(entries + size_t{i} * sizeof(XDBFEntry));
+    const u16 section_id = entry.section;
+    const u64 id = entry.id;
+    const u32 at = entry.offset, size = entry.size;
+    if (at > remaining || size > remaining - at || !keys.emplace(section_id, id).second) return;
+    const auto* block = data + offset + at;
+    const bool strings = section_id == static_cast<u16>(XDBFSection::kStringTable);
+    if (strings || (section_id == static_cast<u16>(XDBFSection::kMetadata) && id == kXDBFIdXACH)) {
+      if (size < sizeof(XDBFSectionHeader)) return;
+      const auto section = memory::load<XDBFSectionHeader>(block);
+      const u32 section_size = section.size;
+      if (section.version != 1 || section.magic != (strings ? kXDBFSignatureXSTR : kXDBFSignatureXACH) ||
+          section_size < sizeof(XDBFSectionHeader) - 4 || section_size > size - 4) return;
+      // SPA section size excludes its four-byte magic.
+      const size_t section_end = size_t{section_size} + 4;
+      size_t position = sizeof(XDBFSectionHeader);
+      std::set<u16> ids;
+      for (u16 j = 0; j < section.count; ++j) {
+        if (strings) {
+          if (sizeof(XDBFStringTableEntry) > section_end - position) return;
+          const auto string = memory::load<XDBFStringTableEntry>(block + position);
+          position += sizeof(XDBFStringTableEntry);
+          const u16 length = string.string_length;
+          if (length > section_end - position || !ids.insert(string.id).second) return;
+          position += length;
+        } else {
+          if (sizeof(XDBFAchievementTableEntry) > section_end - position) return;
+          const auto achievement = memory::load<XDBFAchievementTableEntry>(block + position);
+          if (!ids.insert(achievement.id).second) return;
+          position += sizeof(XDBFAchievementTableEntry);
+        }
+      }
+    } else if (section_id == static_cast<u16>(XDBFSection::kMetadata) && id == kXDBFIdXSTC) {
+      if (size < sizeof(XDBFXSTC)) return;
+      const auto language = memory::load<XDBFXSTC>(block);
+      if (language.magic != kXDBFSignatureXSTC || language.version != 1 ||
+          language.size < sizeof(XDBFXSTC) - 4 || language.size > size - 4) return;
+    }
+  }
+  entry_used_ = used;
+  entries_ = entries;
+  content_offset_ = data + offset;
+  data_ = data; // Publish only a fully validated resource, including cached disk input.
 }
 
