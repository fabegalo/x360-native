+struct X_CONTENT_AGGREGATE_RECORD {
+  XCONTENT_AGGREGATE_DATA data;
+  be<uint64_t> size;
+  be<uint64_t> creation_time;
+  uint8_t reserved[584 - 0x158];
+};
+static_assert_size(X_CONTENT_AGGREGATE_RECORD, 584);
+using AggregateEnumerator = XStaticEnumerator<X_CONTENT_AGGREGATE_RECORD>;
+
+void AppendAggregate(AggregateEnumerator* e, const XCONTENT_AGGREGATE_DATA& data) {
+  auto* item = e->AppendItem();
+  if (!item) return;
+  std::memset(item, 0, sizeof(*item));
+  item->data = data;
+  std::array<uint8_t, 36> attributes{};
+  if (REX_KERNEL_STATE()->content_manager()->GetContentAttributes(data, attributes.data()) ==
+      X_ERROR_SUCCESS) {
+    item->creation_time = memory::load_and_swap<uint64_t>(attributes.data() + 4);
+    item->size = memory::load_and_swap<uint64_t>(attributes.data() + 28);
+  }
+}
