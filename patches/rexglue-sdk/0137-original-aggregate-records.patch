+std::vector<uint64_t> ContentManager::ListContentOwners(uint32_t device_id) {
+  std::vector<uint64_t> owners;
+  for (const auto& entry : rex::filesystem::ListFiles(DeviceRoot(device_id))) {
+    const auto name = rex::path_to_utf8(entry.name);
+    if (entry.type != rex::filesystem::FileInfo::Type::kDirectory || name.size() != 16) continue;
+    uint64_t xuid = 0;
+    bool hex = true;
+    for (const char c : name) {
+      const int n = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 :
+                    c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+      if (n < 0) { hex = false; break; }
+      xuid = (xuid << 4) | uint64_t(n);
+    }
+    if (hex) owners.push_back(xuid);
+  }
+  std::sort(owners.begin(), owners.end());
+  return owners;
+}
