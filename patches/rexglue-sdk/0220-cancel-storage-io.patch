+std::shared_ptr<ContentManager::TransferRequest> ContentManager::BeginTransfer(uint32_t overlapped) {
+  std::lock_guard lock(transfers_mutex_);
+  auto request = std::make_shared<TransferRequest>();
+  if (!transfers_.emplace(overlapped, request).second) return {};
+  return request;
+}
+
+bool ContentManager::CancelTransfer(uint32_t overlapped, bool wait) {
+  std::shared_ptr<TransferRequest> request;
+  {
+    std::lock_guard lock(transfers_mutex_);
+    const auto it = transfers_.find(overlapped);
+    if (it == transfers_.end()) return false;
+    request = it->second;
+    request->cancelled.store(true, std::memory_order_release);
+  }
+  if (wait) {
+    std::unique_lock lock(request->mutex);
+    request->done.wait(lock, [&] { return request->completed; });
+  }
+  return true;
+}
+
+void ContentManager::FinishTransfer(uint32_t overlapped,
+    const std::shared_ptr<TransferRequest>& request, const std::function<void()>& complete) {
+  {
+    std::lock_guard request_lock(request->mutex);
+    std::lock_guard registry_lock(transfers_mutex_);
+    // Publish completion before allowing the same OVERLAPPED to be reused.
+    complete();
+    transfers_.erase(overlapped);
+    request->completed = true;
+  }
+  request->done.notify_all();
+}
+
