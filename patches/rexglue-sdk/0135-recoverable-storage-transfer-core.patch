+        std::lock_guard lock(recovery_mutex_);
+        recovered_devices_.erase(source.device_id);
+      }
+      NotifyContentChanged();
+      return deleted;
+    }
+  }
+  NotifyContentChanged();
+  return X_ERROR_SUCCESS;
+} catch (const std::filesystem::filesystem_error&) { return X_ERROR_ACCESS_DENIED; }
