+// Staging directories of transfers in progress. With none active, a leftover
+// one comes from an interrupted process and is removed before the next copy.
+// Protect only transfer startup/cleanup, never the copy loop or kernel state.
+static constexpr const char* kTransferStagingDirName = ".x360n-transfer";
+
+// The ready header is a commit intent: it is renamed only after every copied
+// file and the complete header have been closed successfully. Its checksum
+// detects corruption; it is not authentication and never authorizes a path.
+static bool UnlinkedTransferTree(const std::filesystem::path& path) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (!IsUnlinkedStoragePath(path)) return false;
+  if (!fs::exists(path, ec)) return !ec;
+  if (!fs::is_directory(path, ec)) return !ec && fs::is_regular_file(path, ec) && !ec;
+  for (fs::recursive_directory_iterator it(path, ec), end; !ec && it != end; it.increment(ec)) {
+    if (!IsUnlinkedStoragePath(it->path())) return false;
+    if (!it->is_directory(ec) && !it->is_regular_file(ec)) return false;
+    if (ec) return false;
+  }
+  return !ec;
+}
+
+// Restore an uncommitted source retirement without replacing any new content.
+// All conflict checks precede the first rename; a partial rollback is retryable.
+static X_RESULT RestoreRetiredSource(const std::filesystem::path& staging,
+                                    const std::filesystem::path& package,
+                                    const std::filesystem::path& header, uint8_t shape) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  const std::array<std::pair<fs::path, fs::path>, 2> paths{{
+      {staging / "package", package}, {staging / "header", header}}};
+  for (size_t i = 0; i != paths.size(); ++i) {
+    const auto& [from, to] = paths[i];
+    const bool exists = fs::exists(from, ec);
+    if (ec || !IsUnlinkedStoragePath(from) || !IsUnlinkedStoragePath(to)) return X_ERROR_ACCESS_DENIED;
+    // A missing original component must remain absent during restoration.
+    if (shape && !(shape & (1u << i))) {
+      if (exists) return kernel::XResultFromWin32(13);
+      if (fs::exists(to, ec)) return X_ERROR_ALREADY_EXISTS;
+      if (ec) return X_ERROR_ACCESS_DENIED;
+      continue;
+    }
+    if (!exists) continue;
+    if ((i == 0 ? (!fs::is_directory(from, ec) && !fs::is_regular_file(from, ec))
+                : !fs::is_regular_file(from, ec)) || ec)
+      return kernel::XResultFromWin32(13);
+    if (fs::exists(to, ec)) return X_ERROR_ALREADY_EXISTS;
+    if (ec) return X_ERROR_ACCESS_DENIED;
+  }
+  for (const auto& [from, to] : paths) {
+    const bool exists = fs::exists(from, ec);
+    if (ec) return X_ERROR_ACCESS_DENIED;
+    if (!exists) continue;
+    fs::create_directories(to.parent_path(), ec);
+    if (ec || !IsUnlinkedStoragePath(to.parent_path())) return X_ERROR_ACCESS_DENIED;
+    fs::rename(from, to, ec);
+    if (ec) return X_ERROR_ACCESS_DENIED;
+  }
+  return X_ERROR_SUCCESS;
+}
