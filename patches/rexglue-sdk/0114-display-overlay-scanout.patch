+ID3D12Resource* D3D12CommandProcessor::ComposeDisplayOverlay(
+    ID3D12Resource* source, D3D12_SHADER_RESOURCE_VIEW_DESC& source_srv,
+    uint32_t width, uint32_t height, uint32_t display_width, uint32_t display_height) {
+  const auto plane = DecodeDisplayOverlay(*register_file_);
+  if (!plane.valid) return source;
+  const auto& provider = GetD3D12Provider();
+  auto* device = provider.GetDevice();
+  if (!display_overlay_pipeline_) {
+    D3D12_ROOT_PARAMETER params[4]{};
+    params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    params[0].Constants.Num32BitValues = 12;
+    D3D12_DESCRIPTOR_RANGE ranges[3]{};
+    for (uint32_t i = 0; i < 3; ++i) {
+      ranges[i].RangeType = i ? D3D12_DESCRIPTOR_RANGE_TYPE_SRV : D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+      ranges[i].NumDescriptors = 1;
+      ranges[i].BaseShaderRegister = i == 2 ? 1 : 0;
+      params[i + 1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+      params[i + 1].DescriptorTable.NumDescriptorRanges = 1;
+      params[i + 1].DescriptorTable.pDescriptorRanges = &ranges[i];
+    }
+    D3D12_ROOT_SIGNATURE_DESC root{4, params, 0, nullptr, D3D12_ROOT_SIGNATURE_FLAG_NONE};
+    display_overlay_root_signature_.Attach(ui::d3d12::util::CreateRootSignature(provider, root));
+    if (display_overlay_root_signature_) {
+      display_overlay_pipeline_.Attach(ui::d3d12::util::CreateComputePipeline(device,
+          shaders::display_overlay_cs, sizeof(shaders::display_overlay_cs),
+          display_overlay_root_signature_.Get()));
+    }
+    if (!display_overlay_pipeline_) {
+      REXGPU_ERROR("Could not initialize the guest display overlay pipeline");
+      return source;
+    }
+    REXGPU_INFO("Guest D1OVL scanout enabled: surface {:08X}, rectangle {},{}-{},{}",
+                plane.fetch.base_address << 12, plane.x, plane.y, plane.right, plane.bottom);
+  }
+  D3D12_SHADER_RESOURCE_VIEW_DESC overlay_srv{};
+  xenos::TextureFormat format;
+  uint32_t unscaled_width, unscaled_height;
+  auto* overlay = texture_cache_->RequestDisplayTexture(plane.fetch, overlay_srv, format,
+      &unscaled_width, &unscaled_height);
+  if (!overlay) return source;
+  if (display_overlay_texture_ && (display_overlay_texture_->GetDesc().Width != width ||
+                                  display_overlay_texture_->GetDesc().Height != height)) {
+    if (submission_completed_ < display_overlay_submission_) {
+      display_overlay_texture_->AddRef();
+      resources_for_deletion_.emplace_back(display_overlay_submission_, display_overlay_texture_.Get());
+    }
+    display_overlay_texture_.Reset();
+  }
+  constexpr DXGI_FORMAT format_composed = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  if (!display_overlay_texture_) {
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = format_composed;
+    desc.SampleDesc.Count = 1;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+        provider.GetHeapFlagCreateNotZeroed(), &desc, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+        nullptr, IID_PPV_ARGS(&display_overlay_texture_)))) return source;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[3];
+  if (!RequestOneUseSingleViewDescriptors(3, descriptors)) return source;
+  // No descriptor heap changes until the dispatch has been recorded.
+  D3D12_UNORDERED_ACCESS_VIEW_DESC dest{};
+  dest.Format = format_composed;
+  dest.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  device->CreateUnorderedAccessView(display_overlay_texture_.Get(), nullptr, &dest, descriptors[0].first);
+  device->CreateShaderResourceView(source, &source_srv, descriptors[1].first);
+  device->CreateShaderResourceView(overlay, &overlay_srv, descriptors[2].first);
+  PushTransitionBarrier(display_overlay_texture_.Get(), D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                        D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  deferred_command_list_.D3DSetComputeRootSignature(display_overlay_root_signature_.Get());
+  struct Constants {
+    uint32_t size[2];
+    float screen_scale[2];
+    uint32_t rect[4];
+    float offset[2], surface_scale[2];
+  } constants{{width, height}, {float(display_width) / width, float(display_height) / height},
+      {plane.x, plane.y, plane.right, plane.bottom}, {float(plane.offset_x), float(plane.offset_y)},
+      {float(overlay->GetDesc().Width) / unscaled_width, float(overlay->GetDesc().Height) / unscaled_height}};
+  static_assert(sizeof(Constants) == 48);
+  deferred_command_list_.D3DSetComputeRoot32BitConstants(0, 12, &constants, 0);
+  for (uint32_t i = 0; i < 3; ++i)
+    deferred_command_list_.D3DSetComputeRootDescriptorTable(i + 1, descriptors[i].second);
+  SetExternalPipeline(display_overlay_pipeline_.Get());
+  SubmitBarriers();
+  deferred_command_list_.D3DDispatch((width + 15) / 16, (height + 7) / 8, 1);
+  PushTransitionBarrier(display_overlay_texture_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  display_overlay_submission_ = submission_current_;
+  source_srv = {};
+  source_srv.Format = format_composed;
+  source_srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  source_srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  source_srv.Texture2D.MipLevels = 1;
+  return display_overlay_texture_.Get();
 }
 
