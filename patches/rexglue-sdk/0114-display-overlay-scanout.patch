diff --git a/src/graphics/shaders/display_overlay.hlsl b/src/graphics/shaders/display_overlay.hlsl
new file mode 100644
--- /dev/null
+++ b/src/graphics/shaders/display_overlay.hlsl
@@ -0,0 +1,28 @@
+// Guest scanout planes are composed before the existing gamma and FXAA passes.
+cbuffer Constants : register(b0) {
+  uint2 output_size;
+  float2 screen_scale;
+  uint4 screen_rect;
+  float2 surface_offset;
+  float2 surface_scale;
+};
+Texture2D<float4> title : register(t0);
+Texture2D<float4> overlay : register(t1);
+RWTexture2D<float4> output_image : register(u0);
+
+[numthreads(16, 8, 1)]
+void main(uint3 tid : SV_DispatchThreadID) {
+  if (any(tid.xy >= output_size)) return;
+  float4 color = title.Load(int3(tid.xy, 0));
+  float2 screen = (float2(tid.xy) + 0.5) * screen_scale;
+  if (all(screen >= float2(screen_rect.xy)) && all(screen < float2(screen_rect.zw))) {
+    int2 pixel = int2((screen - surface_offset) * surface_scale);
+    uint width, height;
+    overlay.GetDimensions(width, height);
+    if (all(pixel >= 0) && all(pixel < int2(width, height))) {
+      float4 plane = overlay.Load(int3(pixel, 0));
+      color.rgb = lerp(color.rgb, plane.rgb, plane.a);
+    }
+  }
+  output_image[tid.xy] = color;
+}
