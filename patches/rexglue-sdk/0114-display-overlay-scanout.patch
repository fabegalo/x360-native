--- /dev/null
+++ b/include/rex/xenos/display_overlay.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <rex/xenos/register.h>
+
+namespace rex::gpu {
+// D1OVL scanout state emitted by the original display driver. The rectangle's
+// end is exclusive; surface offsets anchor the texture in display coordinates.
+struct DisplayOverlay {
+  bool valid = false;
+  u32 x = 0, y = 0, right = 0, bottom = 0;
+  u32 offset_x = 0, offset_y = 0;
+  xenos::TextureFetch fetch{};
+};
+
+inline DisplayOverlay DecodeDisplayOverlay(const xenos::RegisterFile& regs) {
+  DisplayOverlay out;
+  if (!(regs[std::to_underlying(xenos::Register::D1OVL_ENABLE)] & 1)) return out;
+  const u32 control = regs[std::to_underlying(xenos::Register::D1OVL_CONTROL1)];
+  // Original 32-bit RGB scanout formats. Reject other formats until decoded.
+  const u32 format = (control >> 8) & 7;
+  if (format > 1) return out;
+  const u32 start = regs[std::to_underlying(xenos::Register::D1OVL_START)];
+  const u32 end = regs[std::to_underlying(xenos::Register::D1OVL_END)];
+  out.x = (start >> 16) & 0xFFF;
+  out.y = start & 0xFFF;
+  out.right = (end >> 16) & 0xFFF;
+  out.bottom = end & 0xFFF;
+  out.offset_x = regs[std::to_underlying(xenos::Register::D1OVL_SURFACE_OFFSET_X)] & 0xFFF;
+  out.offset_y = regs[std::to_underlying(xenos::Register::D1OVL_SURFACE_OFFSET_Y)] & 0xFFF;
+  if (out.right <= out.x || out.bottom <= out.y ||
+      out.x < out.offset_x || out.y < out.offset_y) return out;
+  const u32 width = out.right - out.offset_x;
+  const u32 height = out.bottom - out.offset_y;
+  const u32 pitch = regs[std::to_underlying(xenos::Register::D1OVL_PITCH)] & 0x3FFF;
+  const u32 address = regs[std::to_underlying(xenos::Register::D1OVL_SURFACE_ADDRESS)];
+  if (!address || (address & 0xFFF) || !pitch || (pitch & 31) ||
+      pitch < width || pitch > 16352 || !width || !height) return out;
+  out.fetch.type = xenos::FetchConstantType::kTexture;
+  out.fetch.dimension = xenos::DataDimension::k2DOrStacked;
+  out.fetch.tiled = 1;
+  out.fetch.pitch = pitch >> 5;
+  out.fetch.base_address = address >> 12;
+  out.fetch.format = format ? xenos::TextureFormat::k_2_10_10_10 : xenos::TextureFormat::k_8_8_8_8;
+  out.fetch.endianness = xenos::Endian::k8in32;
+  out.fetch.size_2d.width = width - 1;
+  out.fetch.size_2d.height = height - 1;
+  out.fetch.swizzle = 0x688;  // RGBA.
+  out.valid = true;
+  return out;
+}
+}  // namespace rex::gpu
