+
+u32 XamAppLoad_entry(u32 name, u32 user, u32 buffer, u32 buffer_size, u32 overlapped, u32 app_handle) {
+  auto& title = CurrentTitle();
+  const auto readable = kernel::kMemoryProtectRead;
+  const auto writable = readable | kernel::kMemoryProtectWrite;
+  if (overlapped && !title.heap.IsGuestRangeAccessible(overlapped, sizeof(kernel::XOVERLAPPED), writable))
+    return kernel::X_E_INVALIDARG;
+  u32 result = kernel::X_E_FAIL;
+  if (overlapped || app_handle) {
+    result = 0x80004001u;
+  } else if (auto& callback = CurrentXAM().GetSystemUI().system_app_load; callback && name) {
+    std::string module;
+    for (u32 i = 0; i < 260; ++i) {
+      if (u64{name} + i > 0xFFFFFFFFull || !title.heap.IsGuestRangeAccessible(name + i, 1, readable))
+        return kernel::X_E_INVALIDARG;
+      const auto ch = *title.membase.TranslateVirtual<const char*>(name + i);
+      if (!ch) break;
+      module.push_back(ch);
+    }
+    const auto size = buffer ? std::min(buffer_size, 256u) : 0;
+    if (size && !title.heap.IsGuestRangeAccessible(buffer, size, readable)) return kernel::X_E_INVALIDARG;
+    result = callback(module, user, buffer, size);
+  }
+  if (overlapped && kernel::XFAILED(result))
+    title.overlapped_dispatcher.Complete(overlapped, {.result = 1627, .extended_error = result, .length = 0});
+  return result;
+}
