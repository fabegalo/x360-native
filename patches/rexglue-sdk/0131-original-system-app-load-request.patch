+REX_TEST_CASE("original app loading preserves host routing, bounded payload and explicit unsupported completions", "[kernel][xam][original-app-load]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    const auto name = c.AllocString("GamerProfile.xex"), buffer = c.Alloc(512);
+    const auto overlap = c.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    CHECK(c.XAM("XamAppRequestLoad") == 0);
+    CHECK(c.XAM("XamAppLoad", {name, 2, buffer, 512, 0, 0}) == static_cast<u32>(rex::kernel::X_E_FAIL));
+    u32 calls = 0;
+    ui.system_app_load = [&](const std::string& module, u32 user, u32 input, u32 size) {
+      ++calls;
+      CHECK(module == "GamerProfile.xex"); CHECK(user == 2);
+      CHECK(input == buffer); CHECK(size == 256);
+      return 0u;
+    };
+    rex::ScopeGuard clear([&] { ui.system_app_load = {}; });
+    CHECK(c.XAM("XamAppRequestLoad") == 1);
+    CHECK(c.XAM("XamAppLoad", {name, 2, buffer, 512, 0, 0}) == 0);
+    CHECK(calls == 1);
+    CHECK(c.XAM("XamAppLoad", {name, 2, buffer, 512, overlap, 0}) == 0x80004001u);
+    CHECK(c.Load32(overlap) == 1627); CHECK(c.Load32(overlap + 24) == 0x80004001u);
+    CHECK(c.Load32(overlap + 4) == 0);
+    CHECK(c.XAM("XamAppLoad", {name, 2, buffer, 512, 0, 1}) == 0x80004001u);
+    CHECK(c.XAM("XamAppLoad", {0x7F100000, 2, 0, 0, 0, 0}) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    CHECK(c.XAM("XamAppLoad", {name, 2, 0xFFFFFFF0, 256, 0, 0}) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    CHECK(c.XAM("XamAppLoad", {name, 2, 0, 0, 0x7F100000, 0}) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    CHECK(calls == 1);
+    CHECK_FALSE(ui.GetSystemUiSession().visible);
+  });
+}
