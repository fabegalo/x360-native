+REX_TEST_CASE("the shared XAM heap range contract checks every guest page and access bit", "[kernel][guest_memory][xam]") {
+  KernelFixture fixture;
+  auto& memory = fixture.GetRuntime().GetGuestMemory();
+  auto& heap = fixture.GetRuntime().GetGuestHeap();
+  auto allocation = memory.Allocate(0x30000, 0x10000, rex::kernel::GuestProtect::kReadWrite);
+  REQUIRE(allocation.has_value());
+  const auto address = *allocation;
+  rex::ScopeGuard release([&] { CHECK(memory.Free(address).has_value()); });
+  const u32 read = rex::kernel::kMemoryProtectRead, write = read | rex::kernel::kMemoryProtectWrite;
+  CHECK(heap.IsGuestRangeAccessible(address, 0x30000, write));
+  auto* pages = StateOf(fixture.GetRuntime()).GetAddressSpace()->LookupHeap(address);
+  REQUIRE(pages->Protect(address + 0x10000, 0x10000, rex::kernel::kMemoryProtectRead));
+  CHECK(heap.IsGuestRangeAccessible(address, 0x30000, read));
+  CHECK_FALSE(heap.IsGuestRangeAccessible(address, 0x30000, write));
+  CHECK_FALSE(heap.IsGuestRangeAccessible(address, 0, read));
+  CHECK_FALSE(heap.IsGuestRangeAccessible(0, 4, read));
+  CHECK_FALSE(heap.IsGuestRangeAccessible(0xFFFFFFF0, 32, read));
+  REQUIRE(pages->Protect(address + 0x10000, 0x10000, rex::kernel::kMemoryProtectNoAccess));
+  CHECK_FALSE(heap.IsGuestRangeAccessible(address, 0x30000, read));
+}
