+namespace {
+namespace fs = std::filesystem;
+std::mutex picture_store_mutex;
+constexpr std::array<const char*, 5> kPictureNames{
+    "tile_64.png", "tile_32.png", "pp_64.png", "pp_32.png", "settings-v1/4064000F.dat"};
+constexpr size_t kPictureLimit = 16 * 1024 * 1024;
+constexpr size_t kPictureIntentSize = 144;
+uint64_t PictureHash(std::span<const uint8_t> bytes) {
+  uint64_t hash = 14695981039346656037ull;
+  for (const auto byte : bytes) { hash ^= byte; hash *= 1099511628211ull; }
+  return hash;
