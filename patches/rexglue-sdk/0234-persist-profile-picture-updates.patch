+X_RESULT UserProfile::ReadPicture(uint64_t xuid, bool personal, bool small_picture, std::vector<uint8_t>& bytes) try {
+  std::lock_guard lock(picture_store_mutex);
+  const auto package = PackagePath(xuid);
+  if (package.empty()) return 1167;
+  bool changed = false;
+  if (const auto error = PictureRecover(package, changed)) return error;
+  if (changed) if (const auto it = settings_.find(0x4064000F); it != settings_.end()) it->second->loaded_xuid = 0;
+  std::vector<uint8_t> result;
+  const auto error = PictureRead(package / kPictureNames[(personal ? 2 : 0) + unsigned(small_picture)], result, kPictureLimit);
+  if (error) return error == 2 ? X_ERROR_NOT_FOUND : error;
+  if (result.empty()) return 13;
+  bytes = std::move(result);
+  return 0;
+} catch (const fs::filesystem_error& error) { return PictureFsError(error.code()); }
