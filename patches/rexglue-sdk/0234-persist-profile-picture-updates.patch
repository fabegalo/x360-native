+X_RESULT UserProfile::WritePictures(uint64_t xuid, const PictureUpdate& update, bool* committed,
+    const std::function<void(uint32_t)>& checkpoint) try {
+  if (committed) *committed = false;
+  if ((!update.public_picture && !update.personal_picture) || update.large_png.empty() || update.small_png.empty() ||
+      update.large_png.size() > kPictureLimit || update.small_png.size() > kPictureLimit) return 87;
+  const auto profile = FindLocal(xuid);
