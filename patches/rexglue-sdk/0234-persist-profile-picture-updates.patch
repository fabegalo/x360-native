+  if (const auto error = PictureRename(stage / "ready", stage / "committed")) return fail(error);
+  if (committed) *committed = true;
+  if (const auto it = settings_.find(0x4064000F); it != settings_.end()) it->second->loaded_xuid = 0;
+  if (checkpoint) checkpoint(6);
+  return PictureCleanup(stage);
+} catch (const fs::filesystem_error& error) { return PictureFsError(error.code()); }
