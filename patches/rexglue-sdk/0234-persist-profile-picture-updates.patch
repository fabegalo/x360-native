+X_RESULT PictureErrno(int value) {
+  switch (value) {
+    case ENOSPC: return 112;
+    case ENOENT: return 2;
+    case ENOMEM: return 14;
+    case EACCES: case EPERM: return 5;
+    case EEXIST: return 183;
+    case EIO: return 1117;
+    default: return 31;
+  }
+}
+X_RESULT PictureFsError(const std::error_code& error) {
+#if REX_PLATFORM_WIN32
+  if (error.category() == std::system_category()) return uint32_t(error.value());
+#endif
+  return PictureErrno(error.value());
+}
+X_RESULT PictureRead(const fs::path& path, std::vector<uint8_t>& bytes, size_t limit) {
+  if (!IsUnlinkedStoragePath(path)) return 5;
+  std::error_code ec;
+  if (!fs::exists(path, ec)) return ec ? PictureFsError(ec) : 2;
+  if (!fs::is_regular_file(path, ec)) return ec ? PictureFsError(ec) : 5;
+  const auto size = fs::file_size(path, ec);
+  if (ec) return PictureFsError(ec);
+  if (size > limit) return 13;
+  auto* file = rex::filesystem::OpenFile(path, "rb");
+  if (!file) return PictureErrno(errno);
+  std::vector<uint8_t> result(size);
+  const bool read = result.empty() || fread(result.data(), 1, result.size(), file) == result.size();
+  const bool valid = read && fgetc(file) == EOF && !ferror(file);
+  const auto error = valid ? X_RESULT(0) : PictureErrno(errno);
+  const auto closed = fclose(file);
+  if (error) return error;
+  if (closed) return PictureErrno(errno);
+  bytes = std::move(result);
+  return 0;
+}
+// These files are private staging payloads. Public names are replaced only
+// after every payload and the closed, checksummed intent have been written.
+X_RESULT PictureSave(const fs::path& path, std::span<const uint8_t> bytes) {
+  if (!IsUnlinkedStoragePath(path)) return 5;
+  auto* file = rex::filesystem::OpenFile(path, "wb");
+  if (!file) return PictureErrno(errno);
+  X_RESULT result = 0;
+  if ((!bytes.empty() && fwrite(bytes.data(), 1, bytes.size(), file) != bytes.size()) || fflush(file))
+    result = PictureErrno(errno);
+#if REX_PLATFORM_WIN32
+  if (!result && _commit(_fileno(file))) result = PictureErrno(errno);
+#else
+  if (!result && fsync(fileno(file))) result = PictureErrno(errno);
+#endif
+  if (fclose(file) && !result) result = PictureErrno(errno);
+  return result;
+}
+X_RESULT PictureRename(const fs::path& from, const fs::path& to, bool replace = false) {
+  if (!IsUnlinkedStoragePath(from) || !IsUnlinkedStoragePath(to)) return 5;
+#if REX_PLATFORM_WIN32
+  if (!MoveFileExW(from.c_str(), to.c_str(), MOVEFILE_WRITE_THROUGH |
+      (replace ? MOVEFILE_REPLACE_EXISTING : 0))) return GetLastError();
+#else
+  std::error_code ec;
+  if (!replace && fs::exists(to, ec)) return 183;
+  if (ec) return PictureFsError(ec);
+  fs::rename(from, to, ec);
+  if (ec) return PictureFsError(ec);
+#endif
+  return 0;
+}
+X_RESULT PicturePublish(const fs::path& stage, const fs::path& destination,
+                        std::span<const uint8_t> bytes) {
+  if (!IsUnlinkedStoragePath(destination)) return 5;
+  std::error_code ec;
+  fs::create_directories(destination.parent_path(), ec);
+  if (ec) return PictureFsError(ec);
+  const auto result = PictureSave(stage / "publish", bytes);
+  return result ? result : PictureRename(stage / "publish", destination, true);
+}
+X_RESULT PictureValidateStage(const fs::path& stage) {
+  if (!IsUnlinkedStoragePath(stage)) return 5;
+  for (const auto& entry : fs::directory_iterator(stage)) {
+    const auto name = entry.path().filename().string();
+    const bool payload = name.size() == 4 && (name.starts_with("new") || name.starts_with("old")) &&
+        name[3] >= '0' && name[3] <= '4';
+    if (!payload && name != "intent" && name != "ready" && name != "committed" &&
+        name != "rolledback" && name != "publish") return 13;
+    if (!IsUnlinkedStoragePath(entry.path()) || !entry.is_regular_file()) return 5;
+  }
+  return 0;
+}
+X_RESULT PictureCleanup(const fs::path& stage) {
+  if (const auto error = PictureValidateStage(stage)) return error;
+  std::error_code ec;
+  for (const auto& entry : fs::directory_iterator(stage)) {
+    fs::remove(entry.path(), ec);
+    if (ec) return PictureFsError(ec);
+  }
+  fs::remove(stage, ec);
+  return ec ? PictureFsError(ec) : 0;
+}
+X_RESULT PictureRecover(const fs::path& package, bool& changed) {
+  const auto stage = package / ".x360n-picture-update";
+  if (!IsUnlinkedStoragePath(stage)) return 5;
+  std::error_code ec;
+  if (!fs::exists(stage, ec)) return ec ? PictureFsError(ec) : 0;
+  changed = true;
+  if (!fs::is_directory(stage, ec)) return ec ? PictureFsError(ec) : 5;
+  if (const auto error = PictureValidateStage(stage)) return error;
+  const bool ready = fs::exists(stage / "ready", ec);
+  if (ec) return PictureFsError(ec);
+  const bool committed = fs::exists(stage / "committed", ec);
+  if (ec) return PictureFsError(ec);
+  const bool rolledback = fs::exists(stage / "rolledback", ec);
+  if (ec) return PictureFsError(ec);
+  if (unsigned(ready) + unsigned(committed) + unsigned(rolledback) > 1) return 13;
+  if (!ready && !committed && !rolledback) return PictureCleanup(stage);
+  std::vector<uint8_t> intent;
+  const auto marker = stage / (ready ? "ready" : committed ? "committed" : "rolledback");
+  if (const auto error = PictureRead(marker, intent, kPictureIntentSize)) return error;
+  if (intent.size() != kPictureIntentSize || std::memcmp(intent.data(), "X360PIC1", 8) ||
+      Get64(intent.data() + 136) != PictureHash(std::span(intent).first(136))) return 13;
+  const auto mask = memory::load_and_swap<uint32_t>(intent.data() + 8);
+  const auto old_mask = memory::load_and_swap<uint32_t>(intent.data() + 12);
+  if (!mask || (mask & ~31u) || (old_mask & ~mask)) return 13;
+  // After a committed/rolled-back marker, cleanup must never rewrite a public
+  // name: a later caller may already have installed new bytes there.
+  if (!ready) return PictureCleanup(stage);
+  std::array<std::vector<uint8_t>, 5> old, next;
+  std::array<bool, 5> restore{};
+  for (unsigned i = 0; i < 5; ++i) {
+    const auto bit = 1u << i;
+    if (!(mask & bit)) {
+      if (fs::exists(stage / ("new" + std::to_string(i))) || fs::exists(stage / ("old" + std::to_string(i)))) return 13;
+      continue;
+    }
+    const auto* row = intent.data() + 16 + i * 24;
+    const auto check = [&](const fs::path& path, std::vector<uint8_t>& bytes, bool previous) {
+      const auto error = PictureRead(path, bytes, kPictureLimit);
+      if (error) return error;
+      return bytes.size() == memory::load_and_swap<uint32_t>(row + (previous ? 4 : 0)) &&
+          PictureHash(bytes) == Get64(row + (previous ? 16 : 8)) ? X_RESULT(0) : X_RESULT(13);
+    };
+    if (const auto error = check(stage / ("new" + std::to_string(i)), next[i], false)) return error;
+    if (old_mask & bit) {
+      if (const auto error = check(stage / ("old" + std::to_string(i)), old[i], true)) return error;
+    }
+    std::vector<uint8_t> current;
+    const auto error = PictureRead(package / kPictureNames[i], current, kPictureLimit);
+    if (error != 0 && error != 2) return error;
+    if (!error && current != next[i] && (!(old_mask & bit) || current != old[i])) return 183;
+    restore[i] = old_mask & bit ? error == 2 || current != old[i] : error == 0;
+  }
+  for (unsigned i = 0; i < 5; ++i) {
+    if (!(mask & (1u << i))) continue;
+    if (!restore[i]) continue;
+    const auto destination = package / kPictureNames[i];
+    if (old_mask & (1u << i)) {
+      if (const auto error = PicturePublish(stage, destination, old[i])) return error;
+    } else {
+      fs::remove(destination, ec);
+      if (ec) return PictureFsError(ec);
+    }
+  }
+  if (const auto error = PictureRename(stage / "ready", stage / "rolledback")) return error;
+  return PictureCleanup(stage);
+}
