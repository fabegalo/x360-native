+  if (changed) {
+    // Recovery can release staging bytes. Quota must use the post-recovery
+    // snapshot, while ordinary writes retain the first fresh device query.
+    const auto previous_root = device->root;
+    device = kernel_state_->content_manager()->GetDevice(profile.device_id);
+    if (!device || device->root != previous_root) return 1167;
+  }
+  std::array<std::span<const uint8_t>, 5> next;
+  if (update.public_picture) { next[0] = update.large_png; next[1] = update.small_png; }
+  if (update.personal_picture) { next[2] = update.large_png; next[3] = update.small_png; }
+  std::vector<uint8_t> key;
+  if (update.key) {
+    const auto encoded = EncodeSetting(UnicodeSetting(0x4064000F, *update.key));
+    if (!encoded) return 87;
+    key = *encoded; next[4] = key;
+  }
+  std::array<std::vector<uint8_t>, 5> previous;
+  std::array<uint8_t, kPictureIntentSize> intent{};
+  std::memcpy(intent.data(), "X360PIC1", 8);
+  uint32_t mask = 0, old_mask = 0;
+  uint64_t required = kPictureIntentSize, largest = 0, growth = 0;
+  for (unsigned i = 0; i < 5; ++i) {
+    if (next[i].empty()) continue;
+    mask |= 1u << i;
+    const auto error = PictureRead(package / kPictureNames[i], previous[i], kPictureLimit);
+    if (error && error != 2) return error;
+    if (!error) old_mask |= 1u << i;
+    auto* row = intent.data() + 16 + i * 24;
+    memory::store_and_swap<uint32_t>(row, uint32_t(next[i].size()));
+    memory::store_and_swap<uint32_t>(row + 4, uint32_t(previous[i].size()));
+    Put64(row + 8, PictureHash(next[i])); Put64(row + 16, PictureHash(previous[i]));
+    required += next[i].size() + previous[i].size();
+    if (next[i].size() > previous[i].size()) growth += next[i].size() - previous[i].size();
+    largest = std::max<uint64_t>(largest, std::max(next[i].size(), previous[i].size()));
+  }
+  // Snapshots remain until commit. Published names can grow independently;
+  // reserve that growth as well as one publication/rollback temporary file.
+  if (required + growth + largest > device->free_bytes) return 112;
+  memory::store_and_swap<uint32_t>(intent.data() + 8, mask);
+  memory::store_and_swap<uint32_t>(intent.data() + 12, old_mask);
+  Put64(intent.data() + 136, PictureHash(std::span(intent).first(136)));
+  const auto stage = package / ".x360n-picture-update";
+  if (!IsUnlinkedStoragePath(stage)) return 5;
+  std::error_code ec;
+  if (!fs::create_directory(stage, ec)) return ec ? PictureFsError(ec) : 183;
+  auto fail = [&](X_RESULT result) {
+    bool recovered = false;
+    const auto rollback = PictureRecover(package, recovered);
+    if (rollback) REXLOG_ERROR("Profile picture rollback failed: error={}", uint32_t(rollback));
+    if (const auto it = settings_.find(0x4064000F); it != settings_.end()) it->second->loaded_xuid = 0;
+    return result;
+  };
+  for (unsigned i = 0; i < 5; ++i) {
+    if (!(mask & (1u << i))) continue;
+    if (const auto error = PictureSave(stage / ("new" + std::to_string(i)), next[i])) return fail(error);
+    if (old_mask & (1u << i))
+      if (const auto error = PictureSave(stage / ("old" + std::to_string(i)), previous[i])) return fail(error);
