+REX_TEST_CASE("legacy local logon arrays preserve original flags and reject online peers", "[kernel][xam][legacy-logon]") {
+  SignedInProfileFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+    const auto xuid = profile.GetXUID();
+    const auto users = c.Alloc(32), overlap = c.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    c.Store64(users, xuid);
+    for (const u32 flags : {0x23u, 0x420u, 0x424u}) {
+      REQUIRE(profile.SetLocalSession(0) == 0);
+      CHECK(c.XAM("XamUserLogon", {users, flags, overlap}) == 0);
+      CHECK(profile.GetXUID() == xuid);
+      CHECK(profile.GetSigninState() == 1);
+      CHECK(c.Load32(overlap) == 0);
+      CHECK(c.Load32(overlap + 24) == 0);
+    }
+    c.Store64(users + 8, xuid ^ 1);
+    CHECK(c.XAM("XamUserLogon", {users, 0x424, overlap}) == 0x80004001u);
+    CHECK(profile.GetSigninState() == 1);
+    c.Store64(users + 8, 0);
+    CHECK(c.XAM("XamUserLogon", {users, 0x1424, overlap}) == 0x80004001u);
+    CHECK(profile.GetSigninState() == 1);
+  });
+}
+
+REX_TEST_CASE("firmware exits preserve the requested routine and clear stale image handoffs", "[kernel][xam][firmware-exit]") {
+  for (const u32 routine : {1u, 5u, 2u}) {
+    KernelFixture fixture;
+    auto& loader = rex::xam::CurrentXAM().GetLoaderState();
+    loader.launch_path = "stale.xex"; loader.launch_flags = 42;
+    loader.launch_data_present = true; loader.launch_data = {1, 2};
+    bool reported = false, returned = false;
+    auto guard = fixture.GetRuntime().OnTitleExit([&](rex::kernel::TitleExitReason reason) {
+      reported = true;
+      CHECK(reason == rex::kernel::TitleExitReason::kHardExit);
+    });
+    fixture.RunUntilGuestThreadEnds([&](Caller& c) {
+      c.Kernel("HalReturnToFirmware", {routine});
+      returned = true;
+    });
+    CHECK_FALSE(returned); CHECK(reported);
+    CHECK(loader.exit_request == rex::xam::XAMLoaderState::ExitRequest::Firmware);
+    CHECK(loader.firmware_routine == routine);
+    CHECK(loader.launch_path.empty()); CHECK(loader.launch_flags == 0);
+    CHECK_FALSE(loader.launch_data_present); CHECK(loader.launch_data.empty());
+  }
+}
