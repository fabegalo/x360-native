diff --git a/include/rex/xam/loader_state.h b/include/rex/xam/loader_state.h
--- a/include/rex/xam/loader_state.h
+++ b/include/rex/xam/loader_state.h
@@ -13,8 +13,9 @@
 
 /** One title's launch handoff, owned by XAM until DetachTitle. */
 struct XAMLoaderState {
-  enum class ExitRequest { None, Dashboard, Terminate };
+  enum class ExitRequest { None, Dashboard, Terminate, Firmware };
   ExitRequest exit_request = ExitRequest::None;
+  u32 firmware_routine = 0;
   bool launch_data_present = false;
   std::vector<u8> launch_data;
   u32 launch_flags = 0;
diff --git a/src/kernel/xboxkrnl/xboxkrnl_hal.cpp b/src/kernel/xboxkrnl/xboxkrnl_hal.cpp
--- a/src/kernel/xboxkrnl/xboxkrnl_hal.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_hal.cpp
@@ -18,17 +18,28 @@
 #include <rex/kernel/types/status.h>
 #include "kernel/title_state.h"
 #include "kernel/kernel.h"
+#include "kernel/rexkernel_module.h"
+#include <rex/xam/title_lifecycle.h>
+#include <rex/xam/loader_state.h>
 
 namespace rex::kernel::xboxkrnl {
 
 /**
  * Exits the title on a return to firmware.
  *
- * @param routine The reentry routine, which must be 1 (HalRebootRoutine).
+ * @param routine The original firmware reentry routine, retained for the session supervisor.
  */
 void HalReturnToFirmware_entry(u32 routine) {
-  REX_ASSERT(routine == 1);
-  REXKRNL_INFO("Title requested a return to firmware");
+  auto& loader = GetKernelServices()->managers->GetLoaderState();
+  loader.exit_request = rex::xam::XAMLoaderState::ExitRequest::Firmware;
+  loader.firmware_routine = routine;
+  loader.launch_path.clear();
+  loader.launch_flags = 0;
+  loader.launch_data_present = false;
+  loader.launch_data.clear();
+  if (routine != 1 && routine != 5)
+    REXKRNL_WARN("Firmware routine {} is not modeled separately; closing platform", routine);
+  REXKRNL_INFO("Title requested a return to firmware, routine={}", routine);
   kernel::GetCurrentState().ExitTitle(rex::kernel::TitleExitReason::kHardExit);
 }
 
