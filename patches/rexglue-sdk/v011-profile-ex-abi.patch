+REX_TEST_CASE("profile Ex uses original flags in r9 and size pointer in r10", "[kernel][xam][profile-ex-abi]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    const auto ids = c.Alloc(4), size = c.Alloc(4), buffer = c.Alloc(256);
+    c.Store32(ids, kKnownSetting); c.Store32(size, 0); c.Store32(buffer, 0xCAFEBABE);
+    CHECK(c.XAM("XamUserReadProfileSettingsEx", {0, 255, 0, 0, 1, ids, size, 0, buffer, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(c.Load32(size) == 0); CHECK(c.Load32(buffer) == 0xCAFEBABE);
+    CHECK(c.XAM("XamUserReadProfileSettingsEx", {0, 255, 0, 0, 1, ids, 1, size, buffer, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(c.Load32(size) == 0); CHECK(c.Load32(buffer) == 0xCAFEBABE);
+    CHECK(c.XAM("XamUserReadProfileSettingsEx", {0, 255, 0, 0, 1, ids, 0, size, 0, 0}) == rex::kernel::X_ERROR_INSUFFICIENT_BUFFER);
+    CHECK(c.Load32(size) == kHeaderSize + kEntrySize);
+  });
+}
