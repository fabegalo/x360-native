+/** Original-system UI registration and transport, owned by the attached XAM title. */
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <unordered_map>
+#include <rex/types.h>
+
+namespace rex::xam {
+class SystemUIState {
+ public:
+  // The original-system host selects and renders the original module.
+  std::function<u32(u32, u32, u32)> system_ui_request;
+  struct SystemApp { u32 module, slot, callback, resource_id; };
+  u32 RegisterSystemApp(SystemApp app) {
+    if (!app.module || !app.callback) return 1627;
+    std::lock_guard lock(system_apps_mutex_);
+    if (system_apps_.contains(app.slot)) return 1627;
+    system_apps_.emplace(app.slot, app);
+    return 0;
+  }
+  u32 UnregisterSystemApp(u32 module, u32 slot) {
+    std::lock_guard lock(system_apps_mutex_);
+    auto it = system_apps_.find(slot);
+    if (it == system_apps_.end()) return 1627;
+    if (it->second.module == module) system_apps_.erase(it);
+    return 0;
+  }
+  std::optional<SystemApp> FindSystemApp(u32 slot) {
+    std::lock_guard lock(system_apps_mutex_);
+    const auto it = system_apps_.find(slot);
+    if (it == system_apps_.end()) return std::nullopt;
+    return it->second;
+  }
+ private:
+  std::mutex system_apps_mutex_;
+  std::unordered_map<u32, SystemApp> system_apps_;
+};
+}  // namespace rex::xam
