+  std::function<X_HRESULT(uint32_t, uint32_t, uint32_t)> system_ui_request;
+  struct SystemApp { uint32_t module, slot, callback, resource_id; };
+  uint32_t RegisterSystemApp(SystemApp app) {
+    if (!app.module || !app.callback) return 1627;
+    std::lock_guard lock(system_apps_mutex_);
+    if (system_apps_.contains(app.slot)) return 1627;
+    system_apps_.emplace(app.slot, app);
+    return 0;
+  }
+  uint32_t UnregisterSystemApp(uint32_t module, uint32_t slot) {
+    std::lock_guard lock(system_apps_mutex_);
+    auto it = system_apps_.find(slot);
+    if (it == system_apps_.end()) return 1627;
+    if (it->second.module == module) system_apps_.erase(it);
+    return 0; // Original unregister leaves another owner's callback intact.
+  }
+  std::optional<SystemApp> FindSystemApp(uint32_t slot) {
+    std::lock_guard lock(system_apps_mutex_);
+    auto it = system_apps_.find(slot);
+    if (it == system_apps_.end()) return std::nullopt;
+    return it->second;
+  }
