-  exit(0);
+  // Preserve the existing routine 1 host-exit contract and the original
+  // Retail HUD's routine 5 (nice poweroff). Other firmware modes need their
+  // own implementation; never return a fictitious success to guest code.
+  if (routine != 1 && routine != 5)
+    REX_FATAL("Unsupported HalReturnToFirmware routine {}", routine);
+  {
+    auto xam = REX_KERNEL_STATE()->GetKernelModule<rex::kernel::xam::XamModule>("xam.xex");
+    auto& loader = xam->loader_data();
+    loader.exit_request = rex::kernel::xam::XamModule::LoaderData::ExitRequest::Firmware;
+    loader.firmware_routine = routine;
+    loader.launch_path.clear();
+    loader.launch_flags = 0;
+    loader.launch_data_present = false;
+    loader.launch_data.clear();
+  }
+  REXKRNL_INFO("Guest requested firmware exit, routine={}", routine);
+  // Run guest notifications and let ReXApp publish the handoff and tear down
+  // its runtime. exit(0) bypasses both, leaving the supervisor without intent.
+  REX_KERNEL_STATE()->TerminateTitle();
 }
 
