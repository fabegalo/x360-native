+
+REX_TEST_CASE("enumerate: direct mode completes on the caller and preserves original error and count", "[kernel][xam][direct-enumeration]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    u32 handle = 0;
+    int calls = 0;
+    const auto calling_thread = std::this_thread::get_id();
+    REQUIRE(rex::xam::CreateEnumerator(&handle, {0xFF, 0xFB, 0xB000A, 0, 0},
+      rex::xam::EnumeratorObject(1, 4, [&](u32, u8* buffer, u32* count) {
+        CHECK(std::this_thread::get_id() == calling_thread);
+        if (calls++ == 0) {
+          *count = 1;
+          std::memset(buffer, 0xAB, 4);
+          return rex::kernel::X_ERROR_SUCCESS;
+        }
+        *count = 0;
+        return rex::kernel::X_ERROR_NO_MORE_FILES;
+      })) == 0);
+    const auto buffer = c.Alloc(4), io = c.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    CHECK(c.XAM("XamEnumerate", {handle, 1, buffer, 4, 0, io}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(calls == 0);
+    REQUIRE(c.XAM("XamEnumerate", {handle, 2, buffer, 4, 0, io}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(calls == 1);
+    CHECK(c.Load32(buffer) == 0xABABABAB);
+    CHECK(c.LoadAcquire32(io + offsetof(rex::kernel::XOVERLAPPED, result)) == 0);
+    CHECK(c.Load32(io + offsetof(rex::kernel::XOVERLAPPED, length)) == 1);
+    REQUIRE(c.XAM("XamEnumerate", {handle, 2, buffer, 4, 0, io}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(calls == 2);
+    CHECK(c.LoadAcquire32(io + offsetof(rex::kernel::XOVERLAPPED, result)) == rex::kernel::X_ERROR_NO_MORE_FILES);
+    CHECK(c.Load32(io + offsetof(rex::kernel::XOVERLAPPED, extended_error)) == rex::kernel::X_E_NO_MORE_FILES);
+    CHECK(c.Load32(io + offsetof(rex::kernel::XOVERLAPPED, length)) == 0);
+    CHECK(c.Kernel("NtClose", {handle}) == 0);
+  });
+}
