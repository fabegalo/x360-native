+#pragma once
+
+#include <cstdint>
+#include <vector>
+#include "gpu/xenos/draw_state.h"
+
+namespace rex::gpu {
+// GPU before/after snapshots follow Xenia Canary 0bfc8faf7da90c7619123f3d7338965828e03469
+// and 1d8489b44e08f1e85e69a746f24b0d17a0dd6fe8 (AdrianCassar). Never restore untouched export
+// bytes: the guest CPU may have changed them while the draw was in flight.
+inline void PublishMemexportChanges(u8* guest, const u8* before,
+                                   const u8* after, u32 size) {
+  for (u32 i = 0; i < size; ++i) {
+    if (after[i] != before[i]) guest[i] = after[i];
+  }
+}
+
+inline bool GetMemexportReadbackSize(const std::vector<draw_state::MemExportRange>& ranges,
+                                   u32& size) {
+  u64 total = 0;
+  for (const auto& range : ranges) {
+    // Shared memory is 512 MiB. Reject invalid streams instead of overflowing
+    // snapshot allocation or copying outside the GPU buffer.
+    if (range.base_address_dwords >= (static_cast<u32>(1) << 27) ||
+        range.size_bytes > (static_cast<u32>(1) << 29) - (range.base_address_dwords << 2)) {
+      return false;
+    }
+    total += range.size_bytes;
+  }
+  if (total > (UINT32_MAX / 2u) - (16u << 20)) return false;
+  size = static_cast<u32>(total);
+  return true;
+}
+
+inline bool SameMemexportReadbackRanges(const std::vector<draw_state::MemExportRange>& a,
+                                      const std::vector<draw_state::MemExportRange>& b) {
+  if (a.size() != b.size()) return false;
+  for (size_t i = 0; i < a.size(); ++i) {
+    if (a[i].base_address_dwords != b[i].base_address_dwords ||
+        a[i].size_bytes != b[i].size_bytes) return false;
+  }
+  return true;
+}
+}  // namespace rex::gpu
