+namespace {
+uint32_t CachedOriginalTitleName(uint32_t title, uint32_t buffer, uint32_t capacity_address) {
+  using rex::kernel::xam::AchievementGuestSpan;
+  auto* memory = REX_KERNEL_MEMORY();
+  if ((buffer & 1) || (capacity_address & 3) ||
+      !AchievementGuestSpan(memory, capacity_address, 4,
+          rex::memory::kMemoryProtectRead | rex::memory::kMemoryProtectWrite)) return 87;
+  const uint32_t capacity = std::min<uint32_t>(
+      rex::memory::load_and_swap<uint32_t>(memory->TranslateVirtual(capacity_address)), 23);
+  if (!capacity || !AchievementGuestSpan(memory, buffer, capacity * 2,
+                                        rex::memory::kMemoryProtectWrite)) return 87;
+  auto* output = memory->TranslateVirtual<rex::be<uint16_t>*>(buffer);
+  auto* count = memory->TranslateVirtual<rex::be<uint32_t>*>(capacity_address);
+  output[0] = 0;
+  *count = title ? 0 : 1;
+  if (!title) return 87;
+  std::string name;
+  const auto result = REX_KERNEL_STATE()->offline_achievements().TitleName(title, name);
+  const uint32_t error = rex::kernel::xam::OfflineAchievementError(result);
+  if (error) return error;
+  const auto text = rex::string::to_utf16(name);
+  const size_t length = std::min<size_t>(text.size(), capacity - 1);
+  for (size_t i = 0; i < length; ++i) output[i] = text[i];
+  output[length] = 0;
+  *count = static_cast<uint32_t>(length + 1);
+  return 0;
+}
+}
+// Original 17559 exports 816A3D58/816A3A80: r5 is an in/out character
+// capacity, not OVERLAPPED. Cached replies are synchronous; Ex r6 contains
+// lookup flags. Offline misses cannot start a remote fetch or invent a name.
+// Helper 816A35D0 caps the buffer at 23 WCHARs including the terminator.
+extern "C" REX_FUNC(__imp__XamGetCachedTitleName) {
+  ctx.r3.u64 = CachedOriginalTitleName(ctx.r3.u32, ctx.r4.u32, ctx.r5.u32);
+}
+extern "C" REX_FUNC(__imp__XamGetCachedTitleNameEx) {
+  ctx.r3.u64 = CachedOriginalTitleName(ctx.r3.u32, ctx.r4.u32, ctx.r5.u32);
+}
+static rex::ppc::detail::PPCFuncRegistrar cached_title_name_reg(
+    "__imp__XamGetCachedTitleName", &__imp__XamGetCachedTitleName);
+static rex::ppc::detail::PPCFuncRegistrar cached_title_name_ex_reg(
+    "__imp__XamGetCachedTitleNameEx", &__imp__XamGetCachedTitleNameEx);
