diff --git a/tests/unit/kernel/enumerate_test.cpp b/tests/unit/kernel/enumerate_test.cpp
--- a/tests/unit/kernel/enumerate_test.cpp
+++ b/tests/unit/kernel/enumerate_test.cpp
@@ -324,3 +324,24 @@
     CHECK(c.Kernel("NtClose", {handle}) == 0);
   });
 }
+
+
+REX_TEST_CASE("original enumerators validate the count output before advancing their cursor", "[kernel][xam][achievement-ui]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    for (const auto message : {0xB000Au, 0xB0050u}) {
+      u32 handle = 0, calls = 0;
+      REQUIRE(rex::xam::CreateEnumerator(&handle, {0xFF, 0xFB, message, 0, 0},
+        rex::xam::EnumeratorObject(1, 4, [&](u32, u8* buffer, u32* count) {
+          ++calls; *count = 1; std::memset(buffer, 0xAB, 4); return rex::kernel::X_ERROR_SUCCESS;
+        })) == 0);
+      const auto output = c.Alloc(4), count = c.Alloc(4);
+      CHECK(c.XAM("XamEnumerate", {handle, 0, output, 4, 0x7F100000, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+      CHECK(calls == 0);
+      REQUIRE(c.XAM("XamEnumerate", {handle, 0, output, 4, count, 0}) == 0);
+      CHECK(calls == 1); CHECK(c.Load32(count) == 1); CHECK(c.Load32(output) == 0xABABABAB);
+      CHECK(c.Kernel("NtClose", {handle}) == 0);
+    }
+    CHECK(c.XAM("XamEnumerate", {0xBADBAD, 0, 0, 0, 0x7F100000, 0}) == rex::kernel::X_ERROR_INVALID_HANDLE);
+  });
+}
