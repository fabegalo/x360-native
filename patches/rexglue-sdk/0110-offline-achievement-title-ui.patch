+// Original offline XAM contracts. BSD-3-Clause.
+#pragma once
+#include <rex/xam/offline_achievement_store.h>
+#include <rex/kernel/heap.h>
+#include <rex/kernel/types/status.h>
+#include "xam/xam_state.h"
+
+namespace rex::xam {
+inline u32 OfflineAchievementError(OfflineAchievementResult result) {
+  switch (result) {
+    case OfflineAchievementResult::kSuccess: return kernel::X_ERROR_SUCCESS;
+    case OfflineAchievementResult::kNotFound: return kernel::X_ERROR_NOT_FOUND;
+    case OfflineAchievementResult::kInvalidArgument: return kernel::X_ERROR_INVALID_PARAMETER;
+    case OfflineAchievementResult::kStorageError: return kernel::X_ERROR_FUNCTION_FAILED;
+    case OfflineAchievementResult::kCorruptData:
+    case OfflineAchievementResult::kMetadataMismatch: return 13;
+  }
+  return kernel::X_ERROR_FUNCTION_FAILED;
+}
+inline bool AchievementGuestSpan(u32 address, u64 size, u32 access) {
+  return address && size && size <= UINT32_MAX && u64{address} + size <= 0x100000000ull &&
+      CurrentTitle().heap.IsGuestRangeAccessible(address, static_cast<u32>(size), access);
+}
+}  // namespace rex::xam
