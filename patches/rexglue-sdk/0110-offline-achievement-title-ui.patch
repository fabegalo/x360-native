 }
 
+static u32 CachedOriginalTitleName(u32 title, u32 buffer, u32 capacity_address) {
+  if ((buffer & 1) || (capacity_address & 3) ||
+      !AchievementGuestSpan(capacity_address, 4, kernel::kMemoryProtectRead | kernel::kMemoryProtectWrite))
+    return kernel::X_ERROR_INVALID_PARAMETER;
+  auto* count = CurrentTitle().membase.TranslateVirtual<be_u32*>(capacity_address);
+  const u32 capacity = std::min<u32>(*count, 23);
+  if (!capacity || !AchievementGuestSpan(buffer, capacity * 2, kernel::kMemoryProtectWrite))
+    return kernel::X_ERROR_INVALID_PARAMETER;
+  auto* output = CurrentTitle().membase.TranslateVirtual<be_u16*>(buffer);
+  output[0] = 0; *count = title ? 0 : 1;
+  if (!title) return kernel::X_ERROR_INVALID_PARAMETER;
+  std::string name;
+  const auto error = OfflineAchievementError(CurrentXAM().GetOfflineAchievements().TitleName(title, name));
+  if (error) return error;
+  const auto text = rex::string::ToUTF16(name);
+  const auto length = std::min<size_t>(text.size(), capacity - 1);
+  for (size_t i = 0; i < length; ++i) output[i] = text[i];
+  output[length] = 0; *count = static_cast<u32>(length + 1);
+  return kernel::X_ERROR_SUCCESS;
+}
+u32 XamGetCachedTitleName_entry(u32 title, u32 buffer, u32 capacity) {
+  return CachedOriginalTitleName(title, buffer, capacity);
+}
+u32 XamGetCachedTitleNameEx_entry(u32 title, u32 buffer, u32 capacity, [[maybe_unused]] u32 flags) {
+  return CachedOriginalTitleName(title, buffer, capacity);
+}
