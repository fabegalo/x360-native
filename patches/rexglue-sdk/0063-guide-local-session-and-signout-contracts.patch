+REX_TEST_CASE("original profile and Guide requests preserve controller and complete binary payloads", "[kernel][xam][system-ui-transport]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    const auto extra = caller.Alloc(128);
+    for (u32 i = 0; i < 128; ++i) caller.GetBase()[extra + i] = static_cast<u8>(i + 1);
+    unsigned delivered = 0;
+    bool with_extra = false;
+    ui.system_ui_request = [&](u32 message, u32 buffer, u32 bytes) {
+      ++delivered;
+      if (message == 0x2100E) {
+        CHECK(bytes == 136);
+        CHECK(caller.Load32(buffer) == 2);
+        CHECK(caller.Load32(buffer + 4) == 3);
+        for (u32 i = 8; i < 136; ++i) {
+          const auto expected = with_extra && i >= 16 && i < 130 ? static_cast<u8>(i - 15) : 0;
+          CHECK(caller.Load8(buffer + i) == expected);
+        }
+      } else if (message == 0x21015) {
+        CHECK(bytes == 12);
+        CHECK(caller.Load32(buffer) == 0);
+        CHECK(caller.Load32(buffer + 4) == 1);
+        CHECK(caller.Load32(buffer + 8) == 0);
+      } else {
+        CHECK(message == 0x21001);
+        CHECK(bytes == 20);
+        CHECK(caller.Load32(buffer + 4) == 3);
+        CHECK(caller.Load32(buffer + 8) == 1);
+        CHECK(caller.Load32(buffer + 12) == 0x123);
+      }
+      return 0u;
+    };
+    rex::ScopeGuard clear([&] { ui.system_ui_request = {}; });
+    CHECK(caller.XAM("XamShowCreateProfileUI", {2, 3}) == 0);
+    with_extra = true;
+    CHECK(caller.XAM("XamShowCreateProfileUIEx", {2, 3, extra}) == 0);
+    CHECK(caller.XAM("XamShowGuideUI", {1}) == 0);
+    CHECK(caller.XAM("XamShowSigninUIp", {3, 1, 0x123}) == 0);
+    CHECK(delivered == 4);
+    for (const char* name : {"XamShowCreateProfileUI", "XamShowCreateProfileUIEx", "XamShowGuideUI", "XamShowSigninUIp"})
+      CHECK(caller.XAM(name, {4, 3, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(delivered == 4);
+    for (u32 i = 0; i < 128; ++i) CHECK(caller.Load8(extra + i) == static_cast<u8>(i + 1));
+  });
+}
