+REX_TEST_CASE("original local selectors resume their owner and Guide signout cannot sign an account in", "[kernel][xam][system-ui-session]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    auto& xam = rex::xam::CurrentXAM();
+    auto& ui = xam.GetSystemUI();
+    CHECK(caller.XAM("XamHudGetUserIndex") == 255);
+    REQUIRE(ui.RegisterSystemApp({5, 2, 0x1234, 0}) == 0);
+    REQUIRE(ui.BeginSystemUi(5, 2, 0));
+    CHECK(caller.XAM("XamHudGetUserIndex") == 0);
+    const auto device = caller.Alloc(4), overlap = caller.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    CHECK(caller.XAM("XamShowDeviceSelectorUI", {0, 0x10000, 0x40200, 0, 0, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(caller.XAM("XamShowDeviceSelectorUI", {0, 0x10000, 0x40200, 0, device, overlap}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(caller.Load32(device) == 1);
+    CHECK(caller.Load32(overlap) == 0);
+    CHECK_FALSE(ui.ConsumeSystemUiResume(6));
+    CHECK(ui.ConsumeSystemUiResume(5));
+    CHECK_FALSE(ui.ConsumeSystemUiResume(5));
+    CHECK_FALSE(ui.RequestSystemUiResume(6));
+    REQUIRE(xam.GetUserProfile().CreateLocal("Local User") == 0);
+    const auto xuid = xam.GetUserProfile().GetXUID();
+    REQUIRE(xam.GetUserProfile().SetLocalSession(xuid) == 0);
+    const auto users = caller.Alloc(32);
+    caller.Store64(users, xuid ^ 2);
+    CHECK(caller.XAM("XamUserLogon", {users, 0x28, overlap}) == static_cast<u32>(rex::kernel::XHRESULTFromWin32(rex::kernel::X_ERROR_NO_SUCH_USER)));
+    CHECK(xam.GetUserProfile().GetSigninState() == 1);
+    caller.Store64(users, xuid);
+    REQUIRE(caller.XAM("XamUserLogon", {users, 0x28, overlap}) == 0);
+    CHECK(xam.GetUserProfile().GetSigninState() == 0);
+    CHECK(caller.Load32(overlap) == 0);
+    CHECK(caller.XAM("XamUserLogon", {users, 0x28, 0}) == static_cast<u32>(rex::kernel::XHRESULTFromWin32(rex::kernel::X_ERROR_NO_SUCH_USER)));
+    CHECK(xam.GetUserProfile().GetSigninState() == 0);
+    REQUIRE(ui.EndSystemUi(5));
+    CHECK(caller.XAM("XamHudGetUserIndex") == 255);
+  });
