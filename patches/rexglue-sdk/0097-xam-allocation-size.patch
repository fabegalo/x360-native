@@ -362,6 +362,22 @@ u32 XamAllocEx_entry(u32 tag, u32 flags, u32 size, mapped_u32 out_ptr) {
   return ptr ? 0u : 0x8007000Eu;
 }
 
+// Original XAM 1888 818E8770 returns usable byte size in r3 (RtlSizeHeap
+// for virtual storage, MmQueryAllocationSize for physical storage). Query the
+// real guest allocation metadata used by the HLE allocators. SystemHeap uses
+// whole committed pages, so all of allocation_size is usable storage. No
+// additional tracking map or per-allocation instrumentation is necessary.
+u32 XamAllocSize_entry(u32 pointer) {
+  if (!pointer) return 0;
+  auto* heap = REX_KERNEL_MEMORY()->LookupHeap(pointer);
+  if (!heap || uint64_t(pointer) < heap->heap_base() ||
+      uint64_t(pointer) - heap->heap_base() >= heap->heap_size()) return 0;
+  memory::HeapAllocationInfo allocation{};
+  if (!heap->QueryRegionInfo(pointer, &allocation) ||
+      !(allocation.state & memory::kMemoryAllocationCommit) ||
+      allocation.allocation_base != pointer) return 0;
+  return allocation.allocation_size;
+}
 u32 XamFree_entry(mapped_u32 ptr) {
   REX_KERNEL_MEMORY()->SystemHeapFree(ptr.guest_address());
 
@@ -433,3 +449,5 @@ REX_EXPORT(__imp__XamAllocEx, rex::kernel::xam::XamAllocEx_entry)
 
 REX_EXPORT(__imp__XMemAlloc, rex::kernel::xam::XMemAlloc_entry)
 REX_EXPORT(__imp__XMemFree, rex::kernel::xam::XMemFree_entry)
+
+REX_EXPORT(__imp__XamAllocSize, rex::kernel::xam::XamAllocSize_entry)
