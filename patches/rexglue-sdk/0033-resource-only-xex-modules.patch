diff --git a/include/rex/filesystem/xex.h b/include/rex/filesystem/xex.h
--- a/include/rex/filesystem/xex.h
+++ b/include/rex/filesystem/xex.h
@@ -181,4 +181,45 @@
   virtual const void* FindOptHeader(kernel::XEXHeaderKey key) const = 0;
 };
 
+/** Recognizes bounded, unencrypted, data-only DLLs without accepting failed executables. */
+inline bool IsResourceOnly(const IXEXImage& image) {
+  const auto& header = image.GetHeader();
+  const auto bytes = image.GetHeaderBytes();
+  if (static_cast<u32>(header.module_flags) != kernel::kXEXModuleDLLModule ||
+      0x18ull + u64(header.header_count) * sizeof(kernel::XEXOptHeader) > bytes.size())
+    return false;
+  const auto* format = image.GetOptHeader<kernel::XEXOptFileFormatInfo>(kernel::kXEXHeaderFileFormatInfo);
+  if (!format || format->encryption_type != kernel::kXEXEncryptionNone) return false;
+  for (u32 i = 0; i < header.header_count; ++i) {
+    const u32 key = header.headers[i].key;
+    if (key == kernel::kXEXHeaderEntryPoint || key == kernel::kXEXHeaderImportLibraries ||
+        key == kernel::kXEXHeaderTLSInfo) return false;
+  }
+  const auto* resources = image.GetOptHeader<kernel::XEXOptResourceInfo>(kernel::kXEXHeaderResourceInfo);
+  if (!resources) return false;
+  const auto offset = reinterpret_cast<uintptr_t>(resources) - reinterpret_cast<uintptr_t>(bytes.data());
+  if (offset > bytes.size() || bytes.size() - offset < 4) return false;
+  const u32 size = resources->size;
+  if (size < 20 || size > bytes.size() - offset || (size - 4) % 16) return false;
+  const auto& security = image.GetSecurity();
+  const u64 start = image.GetOptHeaderValue(kernel::kXEXHeaderImageBaseAddress).value_or(security.load_address);
+  const u64 end = start + image.GetImageSize();
+  if (!start || end > 0x100000000ull) return false;
+  for (u32 i = 0; i < (size - 4) / 16; ++i) {
+    const auto& resource = resources->resources[i];
+    const u64 address = resource.address;
+    if (!resource.name[0] || !resource.size || address < start || address + u32(resource.size) > end)
+      return false;
+  }
+  const u32 page_size = security.image_flags & kernel::kXEXImagePageSize4KB ? 4096 : 65536;
+  u64 covered = 0;
+  for (const auto& page : security.pages) {
+    if (!page.page_count || (page.type != kernel::kXEXSectionData &&
+                             page.type != kernel::kXEXSectionReadOnlyData)) return false;
+    covered += u64(page.page_count) * page_size;
+    if (covered > image.GetImageSize()) return false;
+  }
+  return covered == image.GetImageSize();
+}
+
 }  // namespace rex::filesystem
