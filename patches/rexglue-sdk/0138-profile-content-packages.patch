+bool UserProfile::InitializeLocal(const std::filesystem::path& root) {
+  {
+    std::lock_guard lock(identity_mutex_);
+    identity_ = {};
+    profiles_.clear();
+    storage_ready_ = false;
+    root_ = root;
+  }
+  if (kernel_state_) kernel_state_->ConfigureOfflineAchievements(root);
+  if (root.empty()) return false;
+  if (kernel_state_) {
+    // Offline achievements live in each profile package, like its GPDs.
+    kernel_state_->offline_achievements().SetProfileFileResolver(
+        [this](uint64_t xuid) { const auto p = PackagePath(xuid); return p.empty() ? p : p / "achievements.dat"; });
+  }
+  return RescanLocal();
 }
+
+bool UserProfile::RescanLocal() {
+  // Storage before identity, as in every other profile mutation.
+  auto storage_lock = rex::thread::global_critical_region::AcquireDirect();
+  std::lock_guard lock(identity_mutex_);
+  if (root_.empty()) return false;
+  auto loaded = ScanDevices();
+  uint64_t selected = identity_.xuid;
+  uint32_t state = identity_.signin_state;
+  if (!storage_ready_) {
+    // session-v1.dat: "X360SS01", big-endian selected XUID, sign-in state.
+    state = 0;
+    selected = 0;
+    const auto session = root_ / "profiles" / "session-v1.dat";
+    std::error_code error;
+    const bool exists = std::filesystem::exists(session, error);
+    if (error) return false;
+    if (exists) {
+      const auto record = ReadSmall(session, 17);
+      if (!record || record->size() != 17 || std::memcmp(record->data(), "X360SS01", 8) ||
+          (*record)[16] > 1)
+        return false;
+      selected = Get64(record->data() + 8);
+      state = (*record)[16];
+    }
+  }
+  auto it = std::find_if(loaded.begin(), loaded.end(), [&](const auto& p) { return p.xuid == selected; });
+  if (it == loaded.end()) {
+    identity_ = loaded.empty() ? Identity{} : loaded.front();
+    identity_.signin_state = 0;
+  } else {
+    identity_ = *it;
+    identity_.signin_state = state;
+  }
+  for (auto& p : loaded) p.signin_state = p.xuid == identity_.xuid ? identity_.signin_state : 0;
+  profiles_ = std::move(loaded);
+  storage_ready_ = true;
+  return true;
+}
+
+bool UserProfile::PersistSession(const Identity& selected) {
+  if (!storage_ready_) { REXSYS_ERROR("Local profile store is not initialized"); return false; }
+  std::vector<uint8_t> record(17, 0);
+  std::memcpy(record.data(), "X360SS01", 8);
+  Put64(record.data() + 8, selected.xuid);
+  record[16] = uint8_t(selected.signin_state ? 1 : 0);
+  if (WriteAtomic(root_ / "profiles" / "session-v1.dat", record)) return true;
+  REXSYS_ERROR("Local profile session write failed");
+  return false;
 }
 
