+std::optional<std::vector<uint8_t>> ReadSmall(const std::filesystem::path& path, size_t limit) {
+  auto* file = rex::filesystem::OpenFile(path, "rb");
+  if (!file) return std::nullopt;
+  std::vector<uint8_t> bytes(limit + 1);
+  const auto size = fread(bytes.data(), 1, bytes.size(), file);
+  const bool bad = ferror(file) != 0;
+  fclose(file);
+  if (bad || size > limit) return std::nullopt;
+  bytes.resize(size);
+  return bytes;
+}
+uint64_t Get64(const uint8_t* p) {
+  uint64_t value = 0;
+  for (int i = 0; i < 8; ++i) value = (value << 8) | p[i];
+  return value;
+}
+void Put64(uint8_t* p, uint64_t value) {
+  for (int i = 0; i < 8; ++i) p[i] = uint8_t(value >> (56 - i * 8));
+}
