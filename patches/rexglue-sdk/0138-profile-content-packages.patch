+  if (package.empty()) return false;
+  std::vector<uint8_t> record(32, 0);
+  std::memcpy(record.data(), "X360PA01", 8);
+  Put64(record.data() + 8, profile.xuid);
+  std::memcpy(record.data() + 16, profile.name.data(), profile.name.size());
