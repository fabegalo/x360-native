+std::vector<UserProfile::Identity> UserProfile::ScanDevices() const {
+  std::vector<Identity> found;
+  std::vector<uint32_t> devices{1};
+  if (kernel_state_ && kernel_state_->content_manager()) {
+    devices.clear();
+    for (const auto& device : kernel_state_->content_manager()->GetDevices())
+      if (device.device_type != DeviceType::ODD) devices.push_back(device.device_id);
+  }
+  for (const auto device : devices) {
+    std::vector<uint64_t> owners;
+    if (kernel_state_ && kernel_state_->content_manager()) {
+      try {
+        owners = kernel_state_->content_manager()->ListContentOwners(device);
+      } catch (const std::filesystem::filesystem_error&) {
+        continue;
+      }
+    } else {
