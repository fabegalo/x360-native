+      for (const auto& entry : std::filesystem::directory_iterator(root_, error)) {
+        const auto name = entry.path().filename().string();
+        if (name.size() == 16) try { owners.push_back(std::stoull(name, nullptr, 16)); } catch (...) {}
+      }
+    }
+    for (const auto xuid : owners) {
+      if (!ValidLocalXuid(xuid)) continue;
+      Identity profile{xuid, {}, 0, device};
+      const auto record = ReadSmall(PackagePathLocked(profile) / "account.dat", 32);
+      if (!record || record->size() != 32 || std::memcmp(record->data(), "X360PA01", 8) ||
+          Get64(record->data() + 8) != xuid || (*record)[31])
+        continue;
+      profile.name = reinterpret_cast<const char*>(record->data() + 16);
+      if (!ValidLocalName(profile.name)) continue;
+      // A copy on another device is the same account; the first device wins.
+      if (std::any_of(found.begin(), found.end(), [&](const auto& p) { return p.xuid == xuid; }))
+        continue;
+      found.push_back(std::move(profile));
+    }
+  }
