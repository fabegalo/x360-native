+// A profile package in use by the signed-in account is locked like open content.
+static bool SignedInProfile(KernelState* kernel_state, const XCONTENT_AGGREGATE_DATA& data) {
+  if (data.content_type != XContentType::kProfile || !kernel_state) return false;
+  const auto account = kernel_state->user_profile()->identity();
+  return account.signin_state && account.device_id == data.device_id &&
+         data.file_name() == fmt::format("{:016X}", account.xuid);
+}
+
+// Profiles are found by scanning the devices; refresh after their packages change.
+static void RefreshProfiles(KernelState* kernel_state, const XCONTENT_AGGREGATE_DATA& data) {
+  if (data.content_type == XContentType::kProfile && kernel_state)
+    kernel_state->user_profile()->RescanLocal();
