 namespace xam {
 
 using namespace rex::kernel;
+
+#pragma pack(push, 4)
+struct LocalAccount {
+  u8 reserved[8];
+  be_u16 name[16];
+  be_u64 online_xuid;
+  u8 online_data[332];
+};
+static_assert(sizeof(LocalAccount) == 380);
+struct LocalProfileRecord {
+  be_u64 xuid;
+  LocalAccount account;
+  be_u32 device;
+};
+static_assert(sizeof(LocalProfileRecord) == 392);
+#pragma pack(pop)
+
+static LocalAccount AccountFor(const UserProfile::Identity& identity) {
+  LocalAccount account{};
+  for (size_t i = 0; i < identity.name.size() && i < 15; ++i)
+    account.name[i] = static_cast<u8>(identity.name[i]);
+  return account;
+}
+
+u32 XamProfileCreateEnumerator_entry(u32 filter, MappedU32 handle) {
+  if (!handle) return kernel::X_ERROR_INVALID_PARAMETER;
+  *handle = 0;
+  if (filter) return kernel::X_ERROR_INVALID_PARAMETER;
+  StaticItemList items(1, sizeof(LocalProfileRecord));
+  const auto identity = CurrentXAM().GetUserProfile().identity();
+  if (identity.xuid) {
+    auto* record = items.Append<LocalProfileRecord>();
+    *record = {};
+    record->xuid = identity.xuid;
+    record->account = AccountFor(identity);
+  }
+  kernel::X_HANDLE value = 0;
+  const auto status = CreateEnumerator(&value, EnumeratorInit{0xFF, 0xFE, 0x23001, 0x23003, 0},
+      EnumeratorObject(1, sizeof(LocalProfileRecord),
+          [items = std::move(items)](u32, u8* output, u32* count) mutable {
+            return items.Write(output, count);
+          }));
+  if (kernel::XFAILED(status)) return kernel::X_ERROR_FUNCTION_FAILED;
+  *handle = value;
+  return kernel::X_ERROR_SUCCESS;
+}
+
+u32 XamProfileEnumerate_entry(u32 handle, u32 flags, MappedVoid buffer, u32 overlapped) {
+  if (flags != 0 && flags != 2) return kernel::X_ERROR_INVALID_PARAMETER;
+  auto e = CurrentTitle().objects.Get<EnumeratorObject>(handle);
+  if (!e) return kernel::X_ERROR_INVALID_HANDLE;
+  const auto* header = CurrentTitle().membase.TranslateVirtual<const X_KENUMERATOR*>(e.GetGuestAddress());
+  if (header->open_message != 0x23001 || e->item_size != sizeof(LocalProfileRecord))
+    return kernel::X_ERROR_INVALID_HANDLE;
+  if (!buffer) return kernel::X_ERROR_INVALID_PARAMETER;
+  u32 count = 0;
+  const auto result = e->write_items(buffer.GetGuestAddress(), buffer.As<u8*>(), &count);
+  if (overlapped) {
+    CurrentTitle().overlapped_dispatcher.Complete(overlapped,
+        {.result = result, .extended_error = static_cast<u32>(kernel::XHRESULTFromWin32(result)), .length = count});
+    return kernel::X_ERROR_IO_PENDING;
+  }
+  return result;
+}
+
+u32 XamProfileFindAccount_entry(u64 xuid, GuestPtrT<LocalAccount> account, MappedU32 device) {
+  if (!account) return kernel::X_ERROR_INVALID_PARAMETER;
+  const auto identity = CurrentXAM().GetUserProfile().identity();
+  if (!identity.xuid || xuid != identity.xuid) return kernel::X_ERROR_NO_SUCH_USER;
+  *account = AccountFor(identity);
+  if (device) *device = 0;
+  return kernel::X_ERROR_SUCCESS;
+}
+
+u32 XamProfileLoadAccountInfo_entry(u32 device, u64 xuid, GuestPtrT<LocalAccount> account) {
+  if (device) return kernel::X_ERROR_DEVICE_NOT_CONNECTED;
+  if (!account) return kernel::X_ERROR_INVALID_PARAMETER;
+  const auto identity = CurrentXAM().GetUserProfile().identity();
+  if (!identity.xuid || xuid != identity.xuid) return kernel::X_ERROR_NO_SUCH_USER;
+  *account = AccountFor(identity);
+  return kernel::X_ERROR_SUCCESS;
+}
 
 u32 EnumerateItems(u32 handle, u32 flags, MappedVoid buffer_ptr, u32* items_returned,
                    u32 overlapped_ptr) {
