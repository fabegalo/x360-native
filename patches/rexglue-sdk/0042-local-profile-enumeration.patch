 // 17559: 8199C630 expands four XUIDs into 392-byte entries before LogonEx.
 // 8199EEC0 replaces the slot array for flags=0 (zero XUID signs that slot out).
-// Other modes involve preview/Live/account payloads and remain unsupported.
+// Original Sign-in 17559 (901186BC-90118720) uses 0x120420 for its
+// normal confirmation. With no bits 4/8 set, XAM follows the same replacement
+// path at 8199E884 -> 8199EEC0. Only this local mode is supported in addition
+// to flags=0; preview, Live and other account modes remain unsupported.
 static uint32_t LocalLogon(mapped_void users, uint32_t flags, uint32_t overlapped,
                            uint32_t stride) {
   if (!users) return uint32_t(X_E_INVALIDARG);
-  if (flags) return 0x80004001u; // E_NOTIMPL
+  if (flags && !(stride == 392 && flags == 0x120420)) return 0x80004001u;
   auto* bytes = users.as<uint8_t*>();
   for (unsigned i = 1; i < 4; ++i) {
     if (rex::memory::load_and_swap<uint64_t>(bytes + i * stride))
       return 0x80004001u; // E_NOTIMPL: never partially apply a multi-user request.
   }
   const auto xuid = rex::memory::load_and_swap<uint64_t>(bytes);
+  if (flags == 0x120420) {
+    // This path must select an existing local identity, never ingest account
+    // data supplied by the caller or silently enable an online account.
+    if (!xuid || rex::memory::load_and_swap<uint64_t>(bytes + 48))
+      return uint32_t(X_E_INVALIDARG);
+  }
   const auto result = REX_KERNEL_STATE()->user_profile()->SetLocalSession(xuid);
   const auto hr = X_HRESULT_FROM_WIN32(result);
   if (overlapped) {
@@ -79,6 +88,27 @@ static uint32_t LocalLogon(mapped_void users, uint32_t flags, uint32_t overlappe
   return hr;
 }
 
+u32 XamUserGetUserIndexMask_entry(u32 flags) {
+  const auto identity = REX_KERNEL_STATE()->user_profile()->identity();
+  return identity.signin_state && (uint32_t(flags) & ~1u) == 0 ? 1 : 0;
+}
+
+u32 XamUserGetIndexFromXUID_entry(u64 xuid, u32 flags, mapped_u32 index) {
+  if (!index) return X_E_INVALIDARG;
+  const auto identity = REX_KERNEL_STATE()->user_profile()->identity();
+  if (!identity.signin_state || !(flags & 1) || !xuid || xuid != identity.xuid)
+    return X_E_NO_SUCH_USER;
+  *index = 0;
+  return X_E_SUCCESS;
+}
+
+u32 XamUserGetDeviceId_entry(u32 user, mapped_u32 device) {
+  if (!device) return X_E_INVALIDARG;
+  *device = 0;  // existing local store is not on a removable content device
+  return user == 0 && REX_KERNEL_STATE()->user_profile()->signin_state()
+      ? X_E_SUCCESS : X_E_NO_SUCH_USER;
+}
