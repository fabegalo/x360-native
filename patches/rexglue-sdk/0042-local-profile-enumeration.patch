+REX_TEST_CASE("retail profile enumeration uses real handles and preserves complete XUIDs", "[kernel][xam][local-profile-enumeration]") {
+  SignedInProfileFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  const auto identity = profile.identity();
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto handle_ptr = caller.Alloc(4), buffer = caller.Alloc(424);
+    const auto account = caller.Alloc(400), device = caller.Alloc(4);
+    std::memset(caller.GetBase() + buffer, 0xCD, 424);
+    CHECK(caller.XAM("XamProfileCreateEnumerator", {1, handle_ptr}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(caller.Load32(handle_ptr) == 0);
+    REQUIRE(caller.XAM("XamProfileCreateEnumerator", {0, handle_ptr}) == 0);
+    const auto handle = caller.Load32(handle_ptr);
+    REQUIRE(handle != 0);
+    CHECK(caller.XAM("XamProfileEnumerate", {handle, 1, buffer, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(caller.XAM("XamProfileEnumerate", {handle, 2, 0, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    REQUIRE(caller.XAM("XamProfileEnumerate", {handle, 2, buffer, 0}) == 0);
+    CHECK(caller.Load32(buffer) == static_cast<u32>(identity.xuid >> 32));
+    CHECK(caller.Load32(buffer + 4) == static_cast<u32>(identity.xuid));
+    CHECK(caller.Load32(buffer + 16) == 0x00550073);
+    CHECK(caller.Load32(buffer + 48) == 0);
+    CHECK(caller.Load32(buffer + 52) == 0);
+    CHECK(caller.Load32(buffer + 388) == 0);
+    for (u32 i = 392; i < 424; ++i) CHECK(caller.Load8(buffer + i) == 0xCD);
+    CHECK(caller.XAM("XamProfileEnumerate", {handle, 0, buffer, 0}) == rex::kernel::X_ERROR_NO_MORE_FILES);
+    REQUIRE(caller.XAM("XamProfileCreateEnumerator", {0, handle_ptr}) == 0);
+    const auto async_handle = caller.Load32(handle_ptr);
+    const auto overlapped = caller.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    CHECK(caller.XAM("XamProfileEnumerate", {async_handle, 0, buffer, overlapped}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(caller.Load32(overlapped) == 0);
+    CHECK(caller.Load32(overlapped + 4) == 1);
+    CHECK(caller.Load32(overlapped + 24) == 0);
+    CHECK(caller.Kernel("NtClose", {async_handle}) == 0);
+    rex::kernel::X_HANDLE foreign = 0;
+    REQUIRE(rex::xam::CreateEnumerator(&foreign, {0xFF, 0xFE, 0x20005, 0x20007, 0},
+        rex::xam::EnumeratorObject(1, 392, [](u32, u8*, u32*) { return rex::kernel::X_ERROR_NO_MORE_FILES; })) == 0);
+    CHECK(caller.XAM("XamProfileEnumerate", {foreign, 2, buffer, 0}) == rex::kernel::X_ERROR_INVALID_HANDLE);
+    CHECK(caller.Kernel("NtClose", {foreign}) == 0);
+    CHECK(profile.GetSigninState() == 1);
+    CHECK(caller.XAM("XamProfileFindAccount", {identity.xuid, account, device}) == 0);
+    CHECK(caller.Load32(account + 8) == 0x00550073);
+    CHECK(caller.XAM("XamProfileFindAccount", {static_cast<u32>(identity.xuid), account, device}) == rex::kernel::X_ERROR_NO_SUCH_USER);
+    CHECK(caller.XAM("XamProfileLoadAccountInfo", {0, identity.xuid, account}) == 0);
+    CHECK(caller.XAM("XamProfileLoadAccountInfo", {1, identity.xuid, account}) == rex::kernel::X_ERROR_DEVICE_NOT_CONNECTED);
+    CHECK(caller.XAM("XamUserGetIndexFromXUID", {identity.xuid, 1, device}) == 0);
+    CHECK(caller.Load32(device) == 0);
+    caller.Store32(device, 0xAABBCCDD);
+    CHECK(caller.XAM("XamUserGetIndexFromXUID", {static_cast<u32>(identity.xuid), 1, device}) == rex::kernel::X_E_NO_SUCH_USER);
+    CHECK(caller.Load32(device) == 0xAABBCCDD);
+    CHECK(caller.XAM("XamUserGetUserIndexMask", {0}) == 1);
+    CHECK(caller.XAM("XamUserGetUserIndexMask", {2}) == 0);
+    const auto request = caller.Alloc(4 * 392);
+    CHECK(caller.XAM("XMemCpy", {request, buffer, 392}) == request);
+    REQUIRE(profile.SetLocalSession(0) == 0);
+    caller.Store64(request + 48, 1);
+    CHECK(caller.XAM("XamUserLogonEx", {request, 0x120420, 0}) == rex::kernel::X_E_INVALIDARG);
+    CHECK(profile.GetSigninState() == 0);
+    caller.Store64(request + 48, 0);
+    CHECK(caller.XAM("XamUserLogonEx", {request, 0x120420, 0}) == 0);
+    CHECK(profile.GetSigninState() == 1);
+    const auto bytes = caller.Alloc(32);
+    std::memset(caller.GetBase() + bytes, 0xCD, 32);
+    CHECK(caller.XAM("XMemSet", {bytes + 4, 0xAB, 8}) == bytes + 4);
+    CHECK(caller.Load8(bytes + 3) == 0xCD);
+    CHECK(caller.Load32(bytes + 4) == 0xABABABAB);
+    CHECK(caller.Load8(bytes + 12) == 0xCD);
+    const auto text = caller.Alloc(12), dest = caller.Alloc(16);
+    caller.Store32(text, 0x004103A9); caller.Store32(text + 4, 0x005A0000);
+    std::memset(caller.GetBase() + dest, 0xCD, 16);
+    CHECK(caller.XAM("lstrcpynW", {dest, text, 3}) == dest);
+    CHECK(caller.Load32(dest) == 0x004103A9);
+    CHECK(caller.Load32(dest + 4) == 0x0000CDCD);
+    CHECK(caller.XAM("lstrcpynW", {dest + 8, text, 0xFFFFFFFFu}) == dest + 8);
+    CHECK(caller.Load32(dest + 8) == 0xCDCDCDCD);
+    CHECK(caller.Kernel("NtClose", {handle}) == 0);
+    CHECK(caller.XAM("XamProfileEnumerate", {handle, 2, buffer, 0}) == rex::kernel::X_ERROR_INVALID_HANDLE);
+  });
