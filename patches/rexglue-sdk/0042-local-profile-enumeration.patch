+u32 LstrcpynW_entry(MappedVoid dest, MappedVoid source, i32 count) {
+  if (count <= 0) return dest.GetGuestAddress();
+  auto* output = dest.As<u8*>();
+  const auto* input = source.As<const u8*>();
+  u32 i = 0;
+  for (; i + 1 < static_cast<u32>(count); ++i) {
+    const auto ch = memory::load_and_swap<u16>(input + i * 2);
+    memory::store_and_swap<u16>(output + i * 2, ch);
+    if (!ch) return dest.GetGuestAddress();
+  }
+  memory::store_and_swap<u16>(output + i * 2, 0);
+  return dest.GetGuestAddress();
+}
 }  // namespace rex::xam
