+REX_TEST_CASE("Native frame contracts gate enhancement without changing guest clocks", "[native-frame][chrono]") {
+  using T = rex::chrono::FrameTiming;
+  using L = rex::chrono::FrameLayout;
+  auto& settings = rex::chrono::GetNativeFrameSettings();
+  REQUIRE(settings.enhanced.Set(false)); REQUIRE(settings.ultrawide.Set(true));
+  rex::ScopeGuard restore([&] {
+    T::Reset(); CHECK(settings.enhanced.Reset()); CHECK(settings.ultrawide.Reset()); CHECK(settings.present_rate.Reset());
+  });
+  T::Reset();
+  const auto scalar = rex::Clock::GetGuestTimeScalar();
+  const auto ratio = rex::Clock::GetGuestTickRatio();
+  L::SetDisplayAspect(3440, 1440);
+  CHECK(L::DisplayAspect().x == 0);
+  const auto before = T::ReadSource();
+  T::NotifySourceFrame(); CHECK(T::ReadSource().sequence == before.sequence);
+  REQUIRE(settings.enhanced.Set(true)); CHECK_FALSE(T::Enhanced());
+  T::ActivateNative(); CHECK(T::Enhanced());
+  CHECK(L::DisplayAspect().x == 3440); CHECK(L::DisplayAspect().y == 1440);
+  REQUIRE(settings.ultrawide.Set(false)); CHECK(L::DisplayAspect().x == 0);
+  CHECK_THROWS_AS(L::SetDisplayAspect(3440, 0), std::invalid_argument);
+  for (rex::u32 fps : {30u, 60u, 120u, 144u, 165u, 240u}) {
+    T::SetGuestVblankRate(2 * fps); CHECK(T::GuestVblankRate() == 2 * fps);
+    CHECK(rex::Clock::GetGuestTimeScalar() == scalar); CHECK(rex::Clock::GetGuestTickRatio() == ratio);
+  }
+  CHECK_THROWS_AS(T::SetGuestVblankRate(481), std::out_of_range);
+  CHECK_THROWS_AS(T::SetGuestVblankRate(29), std::out_of_range);
+  T::NotifySourceFrame(); const auto source = T::ReadSource();
+  CHECK(source.sequence == before.sequence + 1);
+  T::WakeSourceWaiters(); CHECK(T::ReadSource().sequence == source.sequence);
+  CHECK(T::ReadSource().wake != source.wake);
+  T::WaitSource(source, 1000);
+  REQUIRE(settings.present_rate.Set(144)); T::PacePresentation();
+  CHECK(T::ReadSource().sequence == source.sequence);
+  T::Reset(); CHECK_FALSE(T::Enhanced()); CHECK(T::GuestVblankRate() == 0);
+  CHECK(T::ReadSource().sequence == 0); CHECK(L::DisplayAspect().x == 0);
+  CHECK(rex::Clock::GetGuestTimeScalar() == scalar);
+}
