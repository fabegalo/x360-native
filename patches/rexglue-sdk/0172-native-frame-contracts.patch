new file mode 100644
--- /dev/null
+++ b/include/rex/chrono/frame_timing.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <cstdint>
+#include <rex/platform.h>
+#include <rex/setting.h>
+#include <rex/types.h>
+namespace rex::chrono {
+class NativeFrameSettings final : public SettingOwner {
+ public:
+  NativeFrameSettings() : SettingOwner("gpu.native") {}
+  REX_SETTING(bool, enhanced, false, "Enable Native enhancements", kUntilLaunch);
+  REX_SETTING(u32, framerate, 30, "Simulation target for an identity-checked title profile", Range{30, 240}, kUntilLaunch);
+  REX_SETTING(u32, present_rate, 0, "Presentation limit independent of guest simulation and vblank; 0 uncapped", Range{0, 480}, kUntilLaunch);
+  REX_SETTING(bool, ultrawide, false, "Use aspect declared by verified camera and UI producers", kUntilLaunch);
+};
+REX_API NativeFrameSettings& GetNativeFrameSettings();
+
+// One runtime-owned timeline across the title and GPU plugin. No clock scaling,
+// frame generation or synthetic source-frame counts are performed here.
+class REX_API FrameTiming {
+ public:
+  struct Source { uint64_t sequence, tick, wake; double interval; };
+  static bool Enhanced();
+  static void Reset();
+  static void ActivateNative();
+  // Only an identity-checked title host may select a simulation/vblank cadence.
+  // 0 restores the guest video mode. This does not change VdQueryVideoMode.
+  static void SetGuestVblankRate(uint32_t hz);
+  static uint32_t GuestVblankRate();
+  static void PacePresentation();
+  static void NotifySourceFrame();
+  static Source ReadSource();
+  static void WaitSource(Source previous, uint32_t milliseconds);
+  static void WakeSourceWaiters();
+};
+}
