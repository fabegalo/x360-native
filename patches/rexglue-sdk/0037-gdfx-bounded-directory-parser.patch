 const size_t kXESectorSize = 2_KiB;
 
+namespace {
+bool Contains(size_t size, size_t offset, size_t length) {
+  return offset <= size && length <= size - offset;
+}
+
+// Widen before multiplying (also on 32-bit hosts), and only narrow a verified
+// offset. Never construct a pointer before checking the entire span.
+bool SectorRange(size_t size, size_t game_offset, uint32_t sector, size_t length,
+                 size_t* offset) {
+  const uint64_t relative = uint64_t(sector) * kXESectorSize;
+  if (game_offset > size || relative > size - game_offset) return false;
+  *offset = game_offset + static_cast<size_t>(relative);
+  return Contains(size, *offset, length);
+}
