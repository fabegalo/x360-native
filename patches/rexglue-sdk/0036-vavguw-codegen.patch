+bool Build<PPC_INST_VAVGUW>(BuilderContext& ctx) {
+  // Widen before adding; lane-local writes preserve vD aliases.
+  for (int lane = 0; lane < 4; ++lane) {
+    ctx.Println("\t{}.u32[{}] = static_cast<rex::u32>((rex::u64({}.u32[{}]) + "
+                "rex::u64({}.u32[{}]) + 1) >> 1);",
+                ctx.V(ctx.insn.operands[0]), lane, ctx.V(ctx.insn.operands[1]), lane,
+                ctx.V(ctx.insn.operands[2]), lane);
+  }
+  return true;
+}
