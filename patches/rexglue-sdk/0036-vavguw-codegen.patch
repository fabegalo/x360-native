+bool build_vavguw(BuilderContext& ctx) {
+  // Rounded unsigned average. Widen before adding so UINT32_MAX pairs do
+  // not wrap; lane-local writes also preserve vD == vA or vD == vB.
+  for (int lane = 0; lane < 4; ++lane) {
+    ctx.println("\t{}.u32[{}] = static_cast<uint32_t>((uint64_t({}.u32[{}]) + "
+                "uint64_t({}.u32[{}]) + 1) >> 1);",
+                ctx.v(ctx.insn.operands[0]), lane, ctx.v(ctx.insn.operands[1]), lane,
+                ctx.v(ctx.insn.operands[2]), lane);
+  }
+  return true;
+}
