+bool CommandProcessor::PresentSystemFrame(const uint32_t* fetch, const uint16_t* gamma) {
+  const auto saved_fetch = register_file_->GetTextureFetch(0);
+  for (uint32_t i = 0; i < 6; ++i)
+    WriteRegister(std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_00_0) + i, fetch[i]);
+  WriteRegister(std::to_underlying(xenos::Register::DC_LUT_RW_MODE), 0);
+  WriteRegister(std::to_underlying(xenos::Register::DC_LUT_WRITE_EN_MASK), 7);
+  WriteRegister(std::to_underlying(xenos::Register::DC_LUT_RW_INDEX), 0);
+  for (uint32_t i = 0; i < 256; ++i) {
+    WriteRegister(std::to_underlying(xenos::Register::DC_LUT_SEQ_COLOR), gamma[i]);
+    WriteRegister(std::to_underlying(xenos::Register::DC_LUT_SEQ_COLOR), gamma[256 + i]);
+    WriteRegister(std::to_underlying(xenos::Register::DC_LUT_SEQ_COLOR), gamma[512 + i]);
+  }
+  const auto texture = register_file_->GetTextureFetch(0);
+  last_swap_succeeded_ = false;
+  IssueSwap(texture.base_address << 12, texture.size_2d.width + 1,
+            texture.size_2d.height + 1);
+  const uint32_t* saved = reinterpret_cast<const uint32_t*>(&saved_fetch);
+  for (uint32_t i = 0; i < 6; ++i)
+    WriteRegister(std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_00_0) + i, saved[i]);
+  return last_swap_succeeded_;
+}
