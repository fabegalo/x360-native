+bool XenosGraphicsDriverBase::PresentSystemFrame(const u32* fetch, const u16* gamma) {
+  if (!fetch || !gamma || !command_processor_ || !GetHostPresenter()) return false;
+  bool presented = false;
+  command_processor_->CallInThreadAndWait([&] { presented = command_processor_->PresentSystemFrame(fetch, gamma); });
+  return presented;
+}
+
+bool XenosGraphicsDriverBase::WaitForGuestVblank() {
+  std::unique_lock lock(vblank_mutex_);
+  const auto previous = vblank_sequence_, generation = vblank_generation_;
+  return vblank_condition_.wait_for(lock, std::chrono::seconds(2), [&] {
+    return vblank_sequence_ != previous || vblank_generation_ != generation || !vsync_worker_running_;
+  }) && vsync_worker_running_ && vblank_generation_ == generation && vblank_sequence_ != previous;
+}
