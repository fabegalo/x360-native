+u32 VdPersistDisplay_entry(MappedVoid descriptor, MappedU32 previous_buffer) {
+  auto* memory = kernel::GetCurrentState().GetAddressSpace();
+  if ((descriptor && !memory->IsGuestRangeAccessible(descriptor.GetGuestAddress(), 12, kernel::kMemoryProtectRead)) ||
