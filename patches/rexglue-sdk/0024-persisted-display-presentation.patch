+bool GraphicsSystem::PresentSystemFrame(const uint32_t* fetch, const uint16_t* gamma) {
+  if (!command_processor_ || !presenter_) return false;
+  bool result = false;
+  rex::thread::Fence done;
+  command_processor_->CallInThread([&] {
+    result = command_processor_->PresentSystemFrame(fetch, gamma);
+    done.Signal();
+  });
+  done.Wait();
+  return result;
+}
+
+bool GraphicsSystem::WaitForGuestVblank() {
+  std::unique_lock lock(vblank_mutex_);
+  const auto previous = vblank_sequence_;
+  // This bound is failure diagnosis, never successful completion.
+  return vblank_condition_.wait_for(lock, std::chrono::seconds(2), [&] {
+    return vblank_sequence_ != previous || !vsync_worker_running_;
+  }) && vsync_worker_running_ && vblank_sequence_ != previous;
+}
+
 void GraphicsSystem::MarkVblank() {
+  {
+    std::lock_guard lock(vblank_mutex_);
+    ++vblank_sequence_;
+  }
+  vblank_condition_.notify_all();
