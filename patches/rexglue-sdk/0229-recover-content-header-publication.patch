+// The ready header is a commit intent: it is renamed only after every copied
+// file and the complete header have been closed successfully. Its checksum
+// detects corruption; it is not authentication and never authorizes a path.
+static bool UnlinkedTransferTree(const std::filesystem::path& path) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  if (!IsUnlinkedStoragePath(path)) return false;
+  if (!fs::exists(path, ec)) return !ec;
+  if (!fs::is_directory(path, ec)) return !ec && fs::is_regular_file(path, ec) && !ec;
+  for (fs::recursive_directory_iterator it(path, ec), end; !ec && it != end; it.increment(ec)) {
+    if (!IsUnlinkedStoragePath(it->path())) return false;
+    if (!it->is_directory(ec) && !it->is_regular_file(ec)) return false;
+    if (ec) return false;
+  }
+  return !ec;
+}
