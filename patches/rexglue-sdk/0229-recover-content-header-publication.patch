+static X_RESULT RecoverTransferStaging(const ContentDeviceInfo& device) {
+  std::lock_guard lock(staging_mutex_);
+  const auto staging = std::filesystem::absolute(device.root).lexically_normal() / kTransferStagingDirName;
+  const auto active = active_transfers_.find(staging);
+  if (active != active_transfers_.end() && active->second) return X_ERROR_SUCCESS;
+  return RecoverTransferStagingLocked(device);
+}
