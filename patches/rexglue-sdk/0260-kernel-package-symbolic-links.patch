+// Original XAM passes OBJECT_ATTRIBUTES (root -3 is \??) and a counted ANSI output.
+u32 ObTranslateSymbolicLink_entry(GuestPtrT<X_OBJECT_ATTRIBUTES> attributes,
+    GuestPtrT<X_ANSI_STRING> target) {
+  auto* memory = kernel::GetCurrentState().GetAddressSpace();
+  const auto readable = [&](u32 address, u32 size) {
+    return address && memory->IsGuestRangeAccessible(address, size, kMemoryProtectRead);
+  };
+  if (!readable(attributes.GetGuestAddress(), sizeof(X_OBJECT_ATTRIBUTES)) ||
+      !target || !memory->IsGuestRangeAccessible(target.GetGuestAddress(), sizeof(X_ANSI_STRING),
+          kMemoryProtectRead | kMemoryProtectWrite)) return X_STATUS_INVALID_PARAMETER;
+  const auto object = *attributes;
+  if (!readable(object.name_ptr, sizeof(X_ANSI_STRING))) return X_STATUS_INVALID_PARAMETER;
+  const auto name = *memory->TranslateVirtual<X_ANSI_STRING*>(object.name_ptr);
+  if (name.length > name.maximum_length || (name.length && !readable(name.pointer, name.length)))
+    return X_STATUS_INVALID_PARAMETER;
+  if (!name.length) return X_STATUS_OBJECT_NAME_NOT_FOUND;
+  const std::string input(memory->TranslateVirtual<const char*>(name.pointer), name.length);
+  if (input.find('\0') != std::string::npos) return X_STATUS_OBJECT_NAME_INVALID;
+  auto canonical = rex::string::utf8_canonicalize_guest_path(input);
+  if (rex::string::utf8_starts_with(canonical, u8"\\??\\")) canonical.erase(0, 4);
+  auto resolved = kernel::GetCurrentState().GetFileSystem()->ResolveLinks(canonical);
+  if (!resolved) return X_STATUS_OBJECT_NAME_INVALID;
+  if (resolved->empty() || resolved->front() != '\\') return X_STATUS_OBJECT_NAME_NOT_FOUND;
+  if (resolved->size() > target->maximum_length) return X_STATUS_BUFFER_TOO_SMALL;
+  if (!memory->IsGuestRangeAccessible(target->pointer, static_cast<u32>(resolved->size()), kMemoryProtectWrite))
+    return X_STATUS_INVALID_PARAMETER;
+  std::memcpy(memory->TranslateVirtual(target->pointer), resolved->data(), resolved->size());
+  target->length = static_cast<u16>(resolved->size());
+  return X_STATUS_SUCCESS;
+}
