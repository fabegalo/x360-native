+  REX_ASSERT(GetPath() == Path::kHostRenderTargets);
+  REX_ASSERT(depth_target.is_depth);
+  REX_ASSERT(length_tiles <= edram_tile_count_);
+  if (!length_tiles) {
+    return true;
