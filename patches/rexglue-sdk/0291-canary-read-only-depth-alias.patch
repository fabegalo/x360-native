+  auto is_current_in_extent = [&](u32 extent_start,
+                                  u32 extent_end) -> bool {
+    auto it = ownership_ranges_.lower_bound(extent_start);
+    if (it != ownership_ranges_.cbegin()) {
+      auto it_pre = std::prev(it);
+      if (it_pre->second.end_tiles > extent_start) {
+        it = it_pre;
+      }
+    }
+    for (; it != ownership_ranges_.cend() && it->first < extent_end; ++it) {
+      // Empty and invalidated ranges are stale too.
+      if (it->second.depth_bits_target != depth_target) {
+        return false;
+      }
+    }
+    return true;
+  };
+  u32 start_tiles = (depth_target.base_tiles + start_tiles_base_relative) &
+                         (edram_tile_count_ - 1);
+  u32 end_tiles = start_tiles + length_tiles;
+  if (!is_current_in_extent(start_tiles,
+                            std::min(end_tiles, edram_tile_count_))) {
+    return false;
+  }
+  return end_tiles <= edram_tile_count_ ||
+         is_current_in_extent(0, end_tiles & (edram_tile_count_ - 1));
