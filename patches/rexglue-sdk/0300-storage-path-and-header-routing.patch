+REX_TEST_CASE("blocked save storage is an error and committed routing overrides stale headers", "[kernel][xam][save-storage]") {
+  SignedInProfileFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& c) {
+    auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+    const auto title = fixture.GetRoot() / std::format("{:016X}", profile.GetXUID()) / "00000000";
+    std::filesystem::create_directories(title);
+    std::ofstream(title / "00000001", std::ios::binary).write("preserve", 8);
+    const auto root = c.AllocString("SAVE"), data = c.Alloc(sizeof(rex::kernel::XCONTENT_DATA));
+    auto* content = reinterpret_cast<rex::kernel::XCONTENT_DATA*>(c.GetBase() + data);
+    content->device_id = 1; content->content_type = rex::kernel::XContentType::kSavedGame;
+    content->SetFileName("progress");
+    CHECK(c.XAM("XamContentCreate", {0, root, data, 4, 0, 0, 0}) == rex::kernel::X_ERROR_ACCESS_DENIED);
+    const auto size = c.Alloc(4), handle = c.Alloc(4);
+    CHECK(c.XAM("XamContentCreateEnumerator", {0, 1, 1, 0, 4, size, handle}) == rex::kernel::X_ERROR_ACCESS_DENIED);
+    CHECK(std::filesystem::file_size(title / "00000001") == 8);
+    REQUIRE(std::filesystem::remove(title / "00000001"));
+    REQUIRE(c.XAM("XamContentCreate", {0, root, data, 4, 0, 0, 0}) == 0);
+    REQUIRE(c.XAM("XamContentClose", {root, 0}) == 0);
+    const auto header = title / "Headers" / "00000001" / "progress.header";
+    auto bytes = rex::platform::ReadHostFile(header); REQUIRE(bytes);
+    auto* record = reinterpret_cast<rex::kernel::XCONTENT_AGGREGATE_DATA*>(bytes->data());
+    record->xuid = 1; record->title_id = 0xDEADBEEF; record->device_id = 99;
+    record->content_type = rex::kernel::XContentType::kMarketplaceContent; record->SetFileName("foreign");
+    REQUIRE(rex::platform::WriteHostFile(header, *bytes));
+    auto& manager = rex::xam::CurrentXAM().GetContentManager();
+    const auto items = manager.ListContent(1, profile.GetXUID(), rex::kernel::XContentType::kSavedGame, 0);
+    REQUIRE(items.size() == 1);
+    CHECK(static_cast<u64>(items[0].xuid) == profile.GetXUID());
+    CHECK(static_cast<u32>(items[0].title_id) == 0); CHECK(static_cast<u32>(items[0].device_id) == 1);
+    CHECK(items[0].content_type == rex::kernel::XContentType::kSavedGame);
+    CHECK(items[0].GetFileName() == "progress");
+  });
