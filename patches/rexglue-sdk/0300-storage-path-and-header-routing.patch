+void ContentManager::CheckStoragePath(const std::filesystem::path& path) const {
+  for (auto current = path; current != root_path_ && !current.empty(); current = current.parent_path()) {
+    std::error_code error;
+    const auto status = std::filesystem::symlink_status(current, error);
+    if (error && error != std::errc::no_such_file_or_directory)
+      throw std::filesystem::filesystem_error("content storage is inaccessible", current, error);
+    if (std::filesystem::is_symlink(status))
+      throw std::filesystem::filesystem_error("linked content storage", current,
+          std::make_error_code(std::errc::permission_denied));
+    if (current == current.parent_path()) break;
+  }
+}
