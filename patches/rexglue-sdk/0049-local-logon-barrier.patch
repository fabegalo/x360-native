   });
 }
+
+
+REX_TEST_CASE("local retail queries and logon barriers preserve the original ABI", "[kernel][xam][local-console]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    for (const char* name : {"XamIsDataCenterMode", "XamIsNuiAutomationEnabled", "XamUserIsPartialProfile"}) {
+      CHECK(caller.XAM(name, {0xDEADBEEF, 0xFFFFFFFF}) == 0);
+      CHECK(caller.XAM(name, {0}) == 0);
+    }
+    const auto request = caller.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    caller.Store32(request, rex::kernel::X_ERROR_IO_PENDING);
+    caller.Store32(request + 4, 0xCDCDCDCD);
+    caller.Store32(request + 24, 0xCDCDCDCD);
+    CHECK(caller.XAM("XamUserFlushLogonQueue", {0}) == 0);
+    CHECK(caller.XAM("XamUserFlushLogonQueue", {request}) == 0);
+    CHECK(caller.Load32(request) == 0);
+    CHECK(caller.Load32(request + 4) == 0);
+    CHECK(caller.Load32(request + 24) == 0);
+    CHECK(caller.XAM("XGetOverlappedResult", {request, 0, 0}) == 0);
+    CHECK(rex::xam::CurrentXAM().GetUserProfile().GetSigninState() == 0);
+  });
+}
