@@ -65,6 +65,7 @@
 
 // Retail LogonEx expands four XUIDs to 392-byte entries; unsupported modes never partially apply.
 static u32 LocalLogon(MappedVoid users, u32 flags, u32 overlapped, u32 stride) {
+  REXXAM_INFO("LocalLogon request flags={:08X} stride={} overlap={:08X}", flags, stride, overlapped);
   if (!users) return static_cast<u32>(kernel::X_E_INVALIDARG);
   const bool append = stride == 392 && flags == 0x120424;
   if (flags && !(stride == 392 && (flags == 0x120420 || append)) &&
@@ -107,6 +108,13 @@
 }
 u32 XamUserLogonEx_entry(MappedVoid users, u32 flags, u32 overlapped) {
   return LocalLogon(users, flags, overlapped, 392);
+}
+
+u32 XamUserFlushLogonQueue_entry(u32 overlapped) {
+  // Local logon commits synchronously; publish the original barrier completion.
+  if (overlapped) CurrentTitle().overlapped_dispatcher.Complete(overlapped,
+      {.result = 0, .extended_error = 0, .length = 0});
+  return 0;
 }
 
 u32 XamUserGetSigninState_entry(u32 user_index) {
@@ -854,3 +862,5 @@
