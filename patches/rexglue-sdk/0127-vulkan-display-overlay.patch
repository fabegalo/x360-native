+void VulkanCommandProcessor::DestroyDisplayOverlay() {
+  const auto* vd = GetVulkanDevice();
+  const auto& fn = vd->functions(); const auto device = vd->device();
+  ui::vulkan::util::DestroyAndNullHandle(fn.vkDestroyImageView, device, display_overlay_view_);
+  ui::vulkan::util::DestroyAndNullHandle(fn.vkDestroyImage, device, display_overlay_image_);
+  ui::vulkan::util::DestroyAndNullHandle(fn.vkFreeMemory, device, display_overlay_memory_);
+  ui::vulkan::util::DestroyAndNullHandle(fn.vkDestroyPipeline, device, display_overlay_pipeline_);
+  ui::vulkan::util::DestroyAndNullHandle(fn.vkDestroyPipelineLayout, device, display_overlay_pipeline_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(fn.vkDestroyDescriptorPool, device, display_overlay_pool_);
+  ui::vulkan::util::DestroyAndNullHandle(fn.vkDestroyDescriptorSetLayout, device, display_overlay_set_layout_);
+  display_overlay_width_ = display_overlay_height_ = 0;
+  display_overlay_layout_ = VK_IMAGE_LAYOUT_UNDEFINED;
+}
