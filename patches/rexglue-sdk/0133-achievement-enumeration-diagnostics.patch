diff --git a/src/kernel/xam/xam_enum.cpp b/src/kernel/xam/xam_enum.cpp
index 26af8bb..36a47b6 100644
--- a/src/kernel/xam/xam_enum.cpp
+++ b/src/kernel/xam/xam_enum.cpp
@@ -189,7 +189,11 @@ uint32_t xeXamEnumerate(uint32_t handle, uint32_t flags, mapped_void buffer_ptr,
   const auto* header = REX_KERNEL_MEMORY()->TranslateVirtual<X_KENUMERATOR*>(e->guest_object());
   if (header->app_id == 0xFB &&
       (header->open_message == 0xB000A || header->open_message == 0xB0050)) {
-    if (flags) return X_ERROR_INVALID_PARAMETER;
+    if (flags) {
+      REXKRNL_INFO("Achievement/title enumerate message={:05X} rejected flags={:X}",
+                   uint32_t(header->open_message), flags);
+      return X_ERROR_INVALID_PARAMETER;
+    }
   } else {
     assert_true(flags == 0);
   }
@@ -213,6 +217,8 @@ uint32_t xeXamEnumerate(uint32_t handle, uint32_t flags, mapped_void buffer_ptr,
           (header->open_message == 0xB000A || header->open_message == 0xB0050)) {
         const uint64_t required = uint64_t(e->items_per_enumerate()) * e->item_size();
         if (buffer_size < required) {
+          REXKRNL_INFO("Achievement/title enumerate message={:05X} size={} < required {}",
+                       uint32_t(header->open_message), buffer_size, required);
           extended_error = X_HRESULT_FROM_WIN32(X_ERROR_INSUFFICIENT_BUFFER);
           length = 0;
           return X_ERROR_INSUFFICIENT_BUFFER;
@@ -225,6 +231,11 @@ uint32_t xeXamEnumerate(uint32_t handle, uint32_t flags, mapped_void buffer_ptr,
         }
       }
       result = e->WriteItems(buffer_ptr.guest_address(), buffer_ptr.as<uint8_t*>(), &item_count);
+      // One line per achievement/title page, the profile UI's loading step.
+      if (header->app_id == 0xFB &&
+          (header->open_message == 0xB000A || header->open_message == 0xB0050))
+        REXKRNL_INFO("Achievement/title enumerate message={:05X} size={} -> {} items={}",
+                     uint32_t(header->open_message), buffer_size, result, item_count);
     }
     extended_error = X_HRESULT_FROM_WIN32(result);
     length = item_count;
