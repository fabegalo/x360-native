diff --git a/src/gpu/xenos/pipeline/render_target/cache.cpp b/src/gpu/xenos/pipeline/render_target/cache.cpp
--- a/src/gpu/xenos/pipeline/render_target/cache.cpp
+++ b/src/gpu/xenos/pipeline/render_target/cache.cpp
@@ -145,6 +145,25 @@
   if (!write_mask) {
     keep_mask_low = keep_mask_high = ~static_cast<u32>(0);
   }
+}
+
+bool RenderTargetCache::ColorOverlapsDepthStencil(xenos::ColorRenderTargetFormat color_format,
+                                                  u32 color_keep_mask_low,
+                                                  u32 color_keep_mask_high,
+                                                  xenos::reg::RB_DEPTHCONTROL normalized_depth_control) {
+  u32 depth_stencil_used_bits = 0;
+  if (normalized_depth_control.z_enable) {
+    depth_stencil_used_bits |= 0xFFFFFF00u;
+  }
+  if (normalized_depth_control.stencil_enable) {
+    depth_stencil_used_bits |= 0x000000FFu;
+  }
+  u32 color_written_bits = ~color_keep_mask_low;
+  if (xenos::IsColorRenderTargetFormat64bpp(color_format)) {
+    // Conservatively treat either half as overlapping a 32bpp depth sample.
+    color_written_bits |= ~color_keep_mask_high;
+  }
+  return (color_written_bits & depth_stencil_used_bits) != 0;
 }
 
