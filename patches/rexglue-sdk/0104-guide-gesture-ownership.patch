 // Ownership changes once per application, not once per input poll. Capture
 // only the controls actually held at that boundary; never drain the queue.
 // New controls remain available even while an initiating button is held.
+void CaptureOpeningInput(uint32_t user, const X_INPUT_STATE& state) {
+  auto& chord = UiInput().chords[user];
+  uint32_t keys = PadKeysFromState(state);
+  if (chord.pending) {
+    keys |= PadKeyBit(uint16_t(chord.stroke.virtual_key));
+    chord.pending = false;
+  }
+  auto& latch = UiInput().latches[user];
+  // The host may have captured the physical edge before loading the app.
+  // Beginning that app after release must not erase its queued transitions.
+  latch.opening_keys |= keys;
+  latch.keys |= keys;
+  latch.armed = true;
+}
