-    std::lock_guard lock(UiInput().mutex);
-    auto& latch = UiInput().latches[user];
-    latch.opening_keys = keys;
-    latch.keys |= keys;
-    latch.armed = true;
-  }
+    if (backend->GetState(user, &state) == X_ERROR_SUCCESS) CaptureOpeningInput(user, state);
+  }
+}
+bool PollGuideButton(uint32_t user) {
+  auto* backend = input_system();
+  if (!backend || user >= 4) return false;
+  std::lock_guard lock(UiInput().mutex);
+  X_INPUT_STATE state{};
+  if (backend->GetState(user, &state) != X_ERROR_SUCCESS) return false;
+  auto& chord = UiInput().chords[user];
+  const bool pressed = (uint16_t(state.gamepad.buttons) & rex::input::X_INPUT_GAMEPAD_GUIDE) != 0;
+  const bool first = !chord.guide_initialized;
+  const bool edge = !first && pressed && !chord.guide_held;
+  chord.guide_initialized = true;
+  chord.guide_held = pressed;
+  // Even GUIDE held on reconnection owns its accompanying controls. It must
+  // not activate a dashboard item or synthesize another Guide edge.
+  if (pressed && (first || edge)) CaptureOpeningInput(user, state);
+  return edge;
 }
