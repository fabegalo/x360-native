+}
+
+// Snapshot at the actual close boundary, so a later fresh title press is not
+// mistaken for a key held by a UI that has already gone away.
+void CaptureSystemUiClosingInput(uint32_t owner) {
+  auto* backend = input_system();
+  if (!backend) return;
+  std::lock_guard lock(UiInput().mutex);
+  for (uint32_t user = 0; user < 4; ++user) {
+    if (owner != 0xFF && owner != user) continue;
+    X_INPUT_STATE held{};
+    if (backend->GetState(user, &held) != X_ERROR_SUCCESS) continue;
+    CaptureOpeningInput(user, held);
+    TakeSystemUiLatch(UiInput().latches[user], held);
+  }
 }
 
