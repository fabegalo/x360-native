+// State-based drivers need not generate an UP if the opening DOWN was never
+// requested. Once their event queue is empty, released opening controls can
+// relinquish ownership; later presses must work normally.
+void ReleaseIdleOpeningInput(rex::input::InputSystem* backend, uint32_t user) {
+  if (user >= 4 || UiInput().chords[user].pending || !UiInput().latches[user].opening_keys) return;
+  X_INPUT_STATE state{};
+  if (backend->GetState(user, &state) != X_ERROR_SUCCESS) return;
+  auto& latch = UiInput().latches[user];
+  const auto released = latch.opening_keys & ~PadKeysFromState(state);
+  latch.opening_keys &= ~released;
+  latch.keys &= ~released;
 }
 
