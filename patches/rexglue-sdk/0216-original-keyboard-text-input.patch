+bool KeyboardMousePad::SetKeyboardTranslation(bool enabled) {
+  std::lock_guard lock(mutex_);
+  if (keyboard_translation_.exchange(enabled, std::memory_order_relaxed) == enabled) return false;
+  for (size_t i = 0; i < 256; ++i) blocked_keys_[i] |= key_down_[i];
+  std::memset(key_down_, 0, sizeof(key_down_));
+  queue_.clear();
+  mouse_dx_ = mouse_dy_ = 0.0f;
+  pointer_lock_.store(false, std::memory_order_relaxed);
+  return true;
+}
+
 void KeyboardMousePad::Reset() {
   pointer_lock_.store(false, std::memory_order_relaxed);
   std::lock_guard lock(mutex_);
   std::memset(key_down_, 0, sizeof(key_down_));
   mouse_dx_ = mouse_dy_ = 0.0f;
   queue_.clear();
+  std::memset(blocked_keys_, 0, sizeof(blocked_keys_));
+  keyboard_key_ = 0;
+  keyboard_translation_.store(true, std::memory_order_relaxed);
 }
 
