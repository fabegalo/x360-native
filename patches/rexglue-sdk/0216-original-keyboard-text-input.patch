+void MnkInputDriver::SetKeyboardTranslation(bool enabled) {
+  std::lock_guard lock(state_mutex_);
+  if (keyboard_translation_.exchange(enabled, std::memory_order_relaxed) == enabled) return;
+  for (size_t i = 0; i < 256; ++i) blocked_keys_[i] |= key_down_[i];
+  std::memset(key_down_, 0, sizeof(key_down_));
+  keystroke_queue_ = {};
+  if (!attached_window_) return;
+  if (keyboard_text_update_queued_.exchange(true, std::memory_order_relaxed)) return;
+  attached_window_->app_context().CallInUIThreadDeferred([this] {
+    keyboard_text_update_queued_.store(false, std::memory_order_relaxed);
+    ApplyKeyboardTranslationFromUIThread();
+  });
+}
+
+void MnkInputDriver::ApplyKeyboardTranslationFromUIThread() {
+  rex::ui::Window* window;
+  bool text;
+  {
+    std::lock_guard lock(state_mutex_);
+    window = attached_window_;
+    text = !keyboard_translation_.load(std::memory_order_relaxed);
+  }
+  if (!window) return;
+  // The original modal owns PC text before diagnostic overlays. Restore the
+  // normal listener order when vk releases focus.
+  window->AddInputListener(this, text ? std::numeric_limits<size_t>::max() : window_z_order());
+  if (text && !keyboard_text_active_) {
+    previous_text_input_active_ = window->IsTextInputActive();
+    keyboard_text_active_ = true;
+    window->SetTextInputActive(true);
+  } else if (!text && keyboard_text_active_) {
+    keyboard_text_active_ = false;
+    window->SetTextInputActive(previous_text_input_active_);
+  }
+}
+
+// Control keys carry no character. Printable keys arrive via SDL text input,
+// already translated by the PC layout/IME, preserving UTF-16 and accents.
+void MnkInputDriver::EnqueueKeyboardControl(uint16_t key, bool down, bool repeat) {
+  if (key != 8 && key != 9 && key != 13 && key != 27 && !(key >= 33 && key <= 46)) return;
+  X_INPUT_KEYSTROKE stroke{};
+  stroke.virtual_key = key;
+  stroke.flags = down ? X_INPUT_KEYSTROKE_KEYDOWN : X_INPUT_KEYSTROKE_KEYUP;
+  if (repeat) stroke.flags = uint16_t(stroke.flags) | X_INPUT_KEYSTROKE_REPEAT;
+  keystroke_queue_.push(stroke);
+}
+
+void MnkInputDriver::OnKeyChar(rex::ui::KeyEvent& e) {
+  if (keyboard_translation_.load(std::memory_order_relaxed) || !has_focus_ || !is_active()) return;
+  const auto character = uint16_t(e.virtual_key());
+  if (character < 32 || e.is_ctrl_pressed() || e.is_alt_pressed()) return;
+  std::lock_guard lock(state_mutex_);
+  if (keyboard_translation_.load(std::memory_order_relaxed) ||
+      (keyboard_key_ < 256 && blocked_keys_[keyboard_key_])) return;
+  X_INPUT_KEYSTROKE stroke{};
+  stroke.virtual_key = character >= 'a' && character <= 'z' ? character - ('a'-'A') : character;
+  stroke.unicode = character;
+  stroke.flags = X_INPUT_KEYSTROKE_KEYDOWN;
+  keystroke_queue_.push(stroke);
+  e.set_handled(true);
+}
+
 void MnkInputDriver::OnKeyDown(rex::ui::KeyEvent& e) {
   if (!IsEnabled() || !has_focus_)
     return;
   std::lock_guard lock(state_mutex_);
   uint16_t vk = static_cast<uint16_t>(e.virtual_key());
+  if (vk < 256) {
+    // Mode/focus changes never turn a held editing key into a title button.
+    // A fresh DOWN also heals a release missed while the window was unfocused.
+    if (blocked_keys_[vk] && e.prev_state()) return;
+    blocked_keys_[vk] = false;
+    keyboard_key_ = vk;
+  }
+  if (!keyboard_translation_.load(std::memory_order_relaxed)) {
+    if (vk < 256) key_down_[vk] = true;
+    EnqueueKeyboardControl(vk, true, e.prev_state()); e.set_handled(true); return;
+  }
   SetKeyState(vk, true);
 }
 
