+    c.XAM("XamInputSetKeyboardTranslationHud", {1});
+    CHECK(c.XAM("XamInputGetKeystrokeHudEx", {255, 1, stroke}) == rex::kernel::X_ERROR_EMPTY);
+    REQUIRE(ui.EndSystemUi(5));
+  });
+}
