+X_RESULT ContentManager::FlushContent(std::string_view root_name) {
+  auto lock = global_critical_region_.Acquire();
+  auto it = open_packages_.find(string::string_key_case(root_name));
+  if (it == open_packages_.end()) return X_ERROR_FILE_NOT_FOUND;
+  if (!it->second->accessible()) return X_ERROR_ACCESS_DENIED;
+  std::string device;
+  if (!kernel_state_->file_system()->FindSymbolicLink(std::string(root_name) + ':', device))
+    return X_ERROR_FILE_NOT_FOUND;
+  for (const auto& file : kernel_state_->object_table()->GetObjectsByType<XFile>(XObject::Type::File)) {
+    if (rex::string::utf8_starts_with(file->entry()->absolute_path(), device) &&
+        XFAILED(file->Flush())) return X_ERROR_ACCESS_DENIED;
+  }
+  return X_ERROR_SUCCESS;
