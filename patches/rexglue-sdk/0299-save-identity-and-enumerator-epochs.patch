+
+
+REX_TEST_CASE("generic save creation requires the connected identity and its enumerators cannot revive", "[kernel][xam][save-storage]") {
+  SignedInProfileFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& c) {
+    auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+    const auto xuid = profile.GetXUID();
+    const auto root = c.AllocString("SAVE"), data = c.Alloc(sizeof(rex::kernel::XCONTENT_DATA));
+    const auto disposition = c.Alloc(4), size = c.Alloc(4), handle = c.Alloc(4), count = c.Alloc(4);
+    auto* content = reinterpret_cast<rex::kernel::XCONTENT_DATA*>(c.GetBase() + data);
+    content->device_id = 1; content->content_type = rex::kernel::XContentType::kSavedGame;
+    content->SetFileName("progress");
+    const auto create = [&](u32 user, u32 flags) { return c.XAM("XamContentCreate", {user, root, data, flags, disposition, 0, 0}); };
+    REQUIRE(profile.SetLocalSession(0) == 0);
+    CHECK(create(0, 4) == rex::kernel::X_ERROR_NO_SUCH_USER);
+    REQUIRE(profile.SetLocalSession(xuid) == 0);
+    CHECK(create(1, 4) == rex::kernel::X_ERROR_NO_SUCH_USER);
+    for (const char* name : {"../escape", "..", "bad:stream", "trailing.", ""}) {
+      content->SetFileName(name); CHECK(create(0, 4) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    }
+    content->SetFileName("progress"); CHECK(create(0, 0) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    REQUIRE(create(0, 4) == 0); CHECK(c.Load32(disposition) == 1);
+    std::filesystem::create_directories(fixture.GetRoot() / "0000000000000000" / "00000000" / "00000001" / "legacy");
+    REQUIRE(c.XAM("XamContentCreateEnumerator", {0, 1, 1, 0, 4, size, handle}) == 0);
+    const auto enumerator = c.Load32(handle), output = c.Alloc(c.Load32(size));
+    REQUIRE(c.XAM("XamEnumerate", {enumerator, 0, output, c.Load32(size), count, 0}) == 0);
+    CHECK(c.Load32(count) == 1);
+    REQUIRE(profile.SetLocalSession(0) == 0);
+    CHECK(c.XAM("XamEnumerate", {enumerator, 0, output, c.Load32(size), count, 0}) == rex::kernel::X_ERROR_NO_SUCH_USER);
+    REQUIRE(profile.SetLocalSession(xuid) == 0);
+    CHECK(c.XAM("XamEnumerate", {enumerator, 0, output, c.Load32(size), count, 0}) == rex::kernel::X_ERROR_NO_SUCH_USER);
+    CHECK(c.Kernel("NtClose", {enumerator}) == 0);
+    const auto saved = fixture.GetRoot() / std::format("{:016X}", xuid) / "00000000" / "00000001" / "progress";
+    CHECK(std::filesystem::is_directory(saved));
+    CHECK(std::filesystem::is_directory(fixture.GetRoot() / "0000000000000000" / "00000000" / "00000001" / "legacy"));
+  });
+}
