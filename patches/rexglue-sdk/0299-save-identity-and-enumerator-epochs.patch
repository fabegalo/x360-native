+bool ContentManager::ValidName(std::string_view name) {
+  if (name.empty() || name == "." || name == ".." || name.back() == '.' || name.back() == ' ') return false;
+  return std::none_of(name.begin(), name.end(), [](unsigned char ch) {
+    return ch < 32 || ch >= 127 || std::string_view("/\\:*?\"<>|").find(ch) != std::string_view::npos;
+  });
+}
 
