+REX_TEST_CASE("console retail flags persist atomically without replacing corrupt originals", "[kernel][xam][console-store]") {
+  KernelFixture fixture;
+  const auto root = fixture.GetRoot();
+  REQUIRE(std::filesystem::equivalent(root.parent_path(), std::filesystem::temp_directory_path()));
+  REQUIRE(root.filename().string().starts_with("rexglue_kernel_fixture_"));
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto output = caller.Alloc(4), size = caller.Alloc(4);
+    const auto read = [&] { return caller.Kernel("ExGetXConfigSetting", {3, 0xC, output, 4, size}); };
+    REQUIRE(read() == 0);
+    CHECK(caller.Load32(output) == 0x40);
+    CHECK(caller.Load32(size) >> 16 == 4);
+    CHECK(caller.Kernel("ExReadModifyWriteXConfigSettingUlong", {4, 0xC, 0, 0}) == rex::kernel::X_STATUS_INVALID_PARAMETER_1);
+    CHECK(caller.Kernel("ExReadModifyWriteXConfigSettingUlong", {3, 0xD, 0, 0}) == rex::kernel::X_STATUS_INVALID_PARAMETER_2);
+    REQUIRE(caller.Kernel("ExReadModifyWriteXConfigSettingUlong", {3, 0xC, 0xFFFFFFBF, 0x80}) == 0);
+    REQUIRE(read() == 0);
+    CHECK(caller.Load32(output) == 0x80);
+    const auto path = root / "console" / "retail-flags-v1.dat";
+    std::ifstream saved(path, std::ios::binary);
+    const std::string record(std::istreambuf_iterator<char>(saved), {});
+    REQUIRE(record.size() == 12);
+    CHECK(record.substr(0, 8) == "X360XC01");
+    CHECK(static_cast<unsigned char>(record[11]) == 0x80);
+    saved.close();
+    auto staging = path; staging += ".tmp";
+    std::filesystem::create_directory(staging);
+    CHECK(caller.Kernel("ExReadModifyWriteXConfigSettingUlong", {3, 0xC, 0, 0x40}) == rex::kernel::X_STATUS_UNSUCCESSFUL);
+    REQUIRE(read() == 0);
+    CHECK(caller.Load32(output) == 0x80);
+    std::filesystem::remove(staging);
+    std::ofstream(path, std::ios::binary | std::ios::trunc) << "corrupt";
+    caller.Store32(output, 0xCDCDCDCD);
+    CHECK(read() == rex::kernel::X_STATUS_UNSUCCESSFUL);
+    CHECK(caller.Load32(output) == 0xCDCDCDCD);
+    CHECK(caller.Kernel("ExReadModifyWriteXConfigSettingUlong", {3, 0xC, 0, 0x40}) == rex::kernel::X_STATUS_UNSUCCESSFUL);
+    std::ifstream preserved(path, std::ios::binary);
+    CHECK(std::string(std::istreambuf_iterator<char>(preserved), {}) == "corrupt");
+  });
