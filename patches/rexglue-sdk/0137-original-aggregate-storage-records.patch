+std::vector<u64> ContentManager::ListContentOwners(u32 device_id) {
+  std::vector<u64> owners;
+  const auto* device = GetPlaceholderDevice(device_id);
+  if (!device || device->device_type != DeviceType::kHDD) return owners;
+  std::error_code error;
+  std::filesystem::directory_iterator entry(root_path_, error), end;
+  if (error == std::errc::no_such_file_or_directory) return owners;
+  if (error) throw std::filesystem::filesystem_error("content owners", root_path_, error);
+  for (; entry != end; ++entry) {
+    const auto name = rex::string::PathToUTF8(entry->path().filename());
+    if (name.size() != 16 || std::filesystem::is_symlink(entry->symlink_status()) || !entry->is_directory()) continue;
+    u64 owner = 0; bool valid = true;
+    for (const char c : name) {
+      const int digit = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+      if (digit < 0) { valid = false; break; }
+      owner = (owner << 4) | static_cast<u64>(digit);
+    }
+    if (valid) owners.push_back(owner);
+  }
+  std::sort(owners.begin(), owners.end());
+  owners.erase(std::unique(owners.begin(), owners.end()), owners.end());
+  return owners;
 }
 
