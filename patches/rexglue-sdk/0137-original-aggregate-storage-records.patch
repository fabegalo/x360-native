 using namespace rex::kernel;
 
+// Original aggregate ABI: package bytes at 0x148 and creation FILETIME at 0x150.
+struct AggregateRecord {
+  u8 data[sizeof(kernel::XCONTENT_AGGREGATE_DATA)];
+  be_u64 size;
+  be_u64 creation_time;
+  u8 reserved[584 - 0x158];
+};
+static_assert(sizeof(AggregateRecord) == 584);
+static_assert(offsetof(AggregateRecord, size) == 0x148);
+static_assert(offsetof(AggregateRecord, creation_time) == 0x150);
+
+void AppendAggregate(StaticItemList& items, const kernel::XCONTENT_AGGREGATE_DATA& data) {
+  auto* record = items.Append<AggregateRecord>();
+  REX_ASSERT(record != nullptr);
+  *record = {};
+  std::memcpy(record->data, &data, sizeof(data));
+  std::array<u8, 36> attributes{};
+  if (CurrentXAM().GetContentManager().GetContentAttributes(data, attributes.data()) == kernel::X_ERROR_SUCCESS) {
+    record->size = memory::load_and_swap<u64>(attributes.data() + 28);
+    record->creation_time = memory::load_and_swap<u64>(attributes.data() + 4);
+  }
+}
