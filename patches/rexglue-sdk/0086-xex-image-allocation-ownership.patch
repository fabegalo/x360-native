+bool XexModule::AllocateImageMemory(uint32_t size) {
+  auto* heap = memory()->LookupHeap(base_address_);
+  constexpr auto rw = memory::kMemoryProtectRead | memory::kMemoryProtectWrite;
+  // Reserve separately: the legacy combined reserve+commit operation permits
+  // existing reservations. An image must never overwrite another allocation.
+  if (!heap->AllocFixed(base_address_, size, 4096, memory::kMemoryAllocationReserve, rw)) {
+    return false;
+  }
+  image_memory_allocated_ = true;
+  if (!heap->AllocFixed(base_address_, size, 4096, memory::kMemoryAllocationCommit, rw)) {
+    if (heap->Release(base_address_)) image_memory_allocated_ = false;
+    return false;
+  }
+  return true;
+}
