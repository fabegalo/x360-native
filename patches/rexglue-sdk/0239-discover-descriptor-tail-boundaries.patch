+// A descriptor invoker transfers to an external callable loaded from a fixed
+// field, after constructing its this argument. Unlike a switch, this exact
+// data flow has no indexed code table or local labels. Do not split generic bctr.
+bool isDescriptorTailThunk(DecodedBinary& decoded, uint32_t start, uint32_t end) {
+  if (end - start != 28) return false;
+  uint32_t words[8];
+  for (unsigned i = 0; i < 8; ++i) {
+    const auto* instruction = decoded.get(start + i * 4);
+    if (!instruction) return false;
+    words[i] = instruction->code;
+  }
+  const uint32_t descriptor = (words[0] >> 16) & 31;
+  const uint32_t object = (words[2] >> 21) & 31;
+  const uint32_t adjustment = (words[3] >> 21) & 31;
+  const auto scratch = [](uint32_t reg) { return reg >= 9 && reg <= 12; };
+  if (!scratch(descriptor) || !scratch(object) || !scratch(adjustment) ||
+      descriptor == object || descriptor == adjustment || object == adjustment) return false;
+  const auto move = [](uint32_t to, uint32_t from) {
+    return 0x7C000378u | (from << 21) | (to << 16) | (from << 11);
+  };
+  const auto load = [](uint32_t to, uint32_t from, uint32_t offset) {
+    return (32u << 26) | (to << 21) | (from << 16) | offset;
+  };
+  return words[0] == move(descriptor, 4) && words[1] == move(4, 3) &&
+         words[2] == load(object, descriptor, 8) &&
+         words[3] == load(adjustment, descriptor, 4) &&
+         words[4] == load(descriptor, descriptor, 0) &&
+         words[5] == (0x7C000214u | (3u << 21) | (object << 16) | (adjustment << 11)) &&
+         words[6] == (0x7C0903A6u | (descriptor << 21)) && words[7] == 0x4E800420;
+}
