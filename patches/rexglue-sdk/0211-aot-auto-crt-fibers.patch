+std::vector<uint32_t> fiberSwitchPattern() {
+  std::vector<uint32_t> w{0x808D0100,0x80A40164,0x7CC00026,0x7CE802A6,0xF8250030};
+  for(uint32_t r=14;r<=31;++r) w.push_back(0xF8050000|(r<<21)|(0x98+(r-14)*8));
+  w.insert(w.end(),{0x90C50128,0x90E5001C,0xFC00048E});
+  for(uint32_t r=14;r<=31;++r) w.push_back(0xD8050000|(r<<21)|(0x1A8+(r-14)*8));
+  w.insert(w.end(),{0xD8050130,0x39050010,0x39250020,0x39450030});
+  for(uint32_t group=0;group<16;++group) {
+    w.push_back(0x39600650+group*64);
+    for(uint32_t slot=0;slot<4;++slot) {
+      const auto r=64+group*4+slot, base=slot ? 7+slot : 5;
+      w.push_back(0x10005F0B|((r&31)<<21)|(base<<16)|((r&32)>>3));
+    }
+  }
+  w.insert(w.end(),{0x80C30128,0x80E3001C});
+  for(uint32_t r=14;r<=31;++r) w.push_back(0xE8030000|(r<<21)|(0x98+(r-14)*8));
+  w.insert(w.end(),{0x7CCFF120,0x7CE803A6,0xC8030130});
+  for(uint32_t r=14;r<=31;++r) w.push_back(0xC8030000|(r<<21)|(0x1A8+(r-14)*8));
+  w.insert(w.end(),{0xFDFE058E,0x39030010,0x39230020,0x39430030});
+  for(uint32_t group=0;group<16;++group) {
+    w.push_back(0x39600650+group*64);
+    for(uint32_t slot=0;slot<4;++slot) {
+      const auto r=64+group*4+slot, base=slot ? 7+slot : 3;
+      w.push_back(0x10005ACB|((r&31)<<21)|(base<<16)|((r&32)>>3));
+    }
+  }
+  w.insert(w.end(),{0x90640164,0x80A30004,0x80C30008,0x80E3000C,0xE8630030,0x48000000});
+  return w;
+}
+void detectCrtFibers(CodegenContext& ctx) {
+  constexpr const char* names[]{"ConvertThreadToFiber", "ConvertFiberToThread",
+      "CreateFiber", "DeleteFiber", "SwitchToFiber"};
+  // Explicit lifecycle overrides retain their established behavior.
+  for (const auto* name : names) if (ctx.Config().rexcrtFunctions.contains(name)) return;
+  const auto& binary = ctx.binary();
+  const uint64_t imageEnd = uint64_t(binary.baseAddress()) + binary.imageSize();
+  const auto read = [&](uint32_t address, uint32_t& word) {
+    if (address & 3) return false;
+    for (const auto& section : binary.sections()) {
+      if (!section.executable || !section.data || address < section.baseAddress) continue;
+      const uint64_t end = std::min<uint64_t>(uint64_t(section.baseAddress) + section.size, imageEnd);
+      if (uint64_t(address) + 4 > end) continue;
+      word = load_and_swap<uint32_t>(section.data + address - section.baseAddress);
+      return true;
+    }
+    return false;
+  };
+  const auto branch = [](uint32_t pc, uint32_t instruction) {
+    const int32_t displacement = int32_t(instruction << 6) >> 6;
+    return uint32_t(pc + (displacement & ~3));
+  };
+  const auto matches = [&](uint32_t start, const std::vector<uint32_t>& pattern) {
+    if (uint64_t(start) + pattern.size() * 4 > 0x1'0000'0000ull) return false;
+    for (size_t i = 0; i < pattern.size(); ++i) {
+      uint32_t actual = 0;
+      if (!read(start + uint32_t(i * 4), actual)) return false;
+      const uint32_t expected = pattern[i];
+      if (expected == 0x48000001 || expected == 0x48000000) {
+        if ((actual & 0xFC000003) != expected) return false;
+        uint32_t target = 0;
+        if (!read(branch(start + uint32_t(i * 4), actual), target)) return false;
+      } else if (expected == 0x3D600000 || expected == 0x396B0000) {
+        if ((actual & 0xFFFF0000) != expected) return false;
+      } else if (actual != expected) return false;
+    }
+    return true;
+  };
+  const auto lifecycle = fiberLifecyclePattern();
+  const auto context = fiberSwitchPattern();
+  constexpr uint32_t offsets[]{0, 0x90, 0xE0, 0x1C0};
+  for (const auto& section : binary.sections()) {
+    if (!section.executable || !section.data) continue;
+    const uint64_t end = std::min<uint64_t>(uint64_t(section.baseAddress) + section.size, imageEnd);
+    for (uint64_t at = (uint64_t(section.baseAddress) + 3) & ~3ull; at + 0x224 <= end; at += 4) {
+      const auto start = uint32_t(at);
+      uint32_t word = 0;
+      if (!read(start, word) || word != lifecycle[0][0]) continue;
+      bool complete = true;
+      for (size_t i = 0; i < lifecycle.size(); ++i)
+        complete &= matches(start + offsets[i], lifecycle[i]);
+      if (!complete) continue;
+      // DeleteFiber must call this family's ConvertFiberToThread, not another
+      // lookalike. Both wrappers must use the same allocation/free routines.
+      const auto sameCall = [&](uint32_t a, uint32_t b) {
+        uint32_t x = 0, y = 0;
+        return read(a, x) && read(b, y) && branch(a, x) == branch(b, y);
+      };
+      uint32_t unlink = 0;
+      read(start + 0x1C0 + 9 * 4, unlink);
+      if (branch(start + 0x1C0 + 9 * 4, unlink) != start + 0x90 ||
+          !sameCall(start + 16 * 4, start + 0xE0 + 8 * 4) ||
+          !sameCall(start + 0x90 + 10 * 4, start + 0xE0 + 33 * 4) ||
+          !sameCall(start + 0x90 + 10 * 4, start + 0x1C0 + 17 * 4)) continue;
+      uint32_t thunk = 0;
+      if (!read(start + 0x220, thunk) || (thunk & 0xFC000003) != 0x48000000) continue;
+      const auto switchAddress = branch(start + 0x220, thunk);
+      if (!matches(switchAddress, context)) continue;
+      uint32_t high = 0, low = 0;
+      read(start + 0xE0 + 45 * 4, high);
+      read(start + 0xE0 + 48 * 4, low);
+      const uint32_t bootstrap = ((high & 0xFFFF) << 16) + int16_t(low);
+      if (!matches(bootstrap, {0x7FE3FB78, 0x48000001, 0x3860000E, 0x48000001})) continue;
+      for (size_t i = 0; i < lifecycle.size(); ++i) {
+        const auto address = start + offsets[i];
+        ctx.analysisState().crtFiberHooks[address] = fmt::format("rexcrt_{}", names[i]);
+        ctx.graph.addFunction(address, uint32_t(lifecycle[i].size() * 4), FunctionAuthority::HELPER, true);
+      }
+      for (auto address : {start + 0x220, switchAddress}) {
+        ctx.analysisState().crtFiberHooks[address] = "rexcrt_SwitchToFiber";
+        ctx.graph.addFunction(address, address == switchAddress ? uint32_t(context.size() * 4) : 4,
+                              FunctionAuthority::HELPER, true);
+      }
+      REXCODEGEN_DEBUG("Found complete CRT fiber lifecycle at 0x{:08X}", start);
+      at += 0x220;
+    }
+  }
+}
