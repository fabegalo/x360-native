+void DetectCrtFibers(CodegenContext& ctx) {
+  constexpr const char* names[]{"ConvertThreadToFiber", "ConvertFiberToThread",
+      "CreateFiber", "DeleteFiber", "SwitchToFiber"};
+  // Explicit lifecycle overrides retain their established behavior.
+  for (const auto* name : names) if (ctx.GetConfig().shim_functions.contains(name)) return;
+  const auto& binary = ctx.GetBinary();
+  const u64 imageEnd = u64(binary.GetBaseAddress()) + binary.GetImageSize();
+  const auto read = [&](u32 address, u32& word) {
+    if (address & 3) return false;
+    for (const auto& section : binary.GetSections()) {
+      if (!section.executable || !section.data || address < section.base_address) continue;
+      const u64 end = std::min<u64>(u64(section.base_address) + section.size, imageEnd);
+      if (u64(address) + 4 > end) continue;
+      word = memory::load<be_u32>(section.data + address - section.base_address);
+      return true;
+    }
+    return false;
+  };
+  const auto branch = [](u32 pc, u32 instruction) {
+    const i32 displacement = i32(instruction << 6) >> 6;
+    return u32(pc + (displacement & ~3));
+  };
+  const auto matches = [&](u32 start, const std::vector<u32>& pattern) {
+    if (u64(start) + pattern.size() * 4 > 0x1'0000'0000ull) return false;
+    for (size_t i = 0; i < pattern.size(); ++i) {
+      u32 actual = 0;
+      if (!read(start + u32(i * 4), actual)) return false;
+      const u32 expected = pattern[i];
+      if (expected == 0x48000001 || expected == 0x48000000) {
+        if ((actual & 0xFC000003) != expected) return false;
+        u32 target = 0;
+        if (!read(branch(start + u32(i * 4), actual), target)) return false;
+      } else if (expected == 0x3D600000 || expected == 0x396B0000) {
+        if ((actual & 0xFFFF0000) != expected) return false;
+      } else if (actual != expected) return false;
+    }
+    return true;
+  };
+  const auto lifecycle = FiberLifecyclePattern();
+  const auto context = FiberSwitchPattern();
+  constexpr u32 offsets[]{0, 0x90, 0xE0, 0x1C0};
+  for (const auto& section : binary.GetSections()) {
+    if (!section.executable || !section.data) continue;
+    const u64 end = std::min<u64>(u64(section.base_address) + section.size, imageEnd);
+    for (u64 at = (u64(section.base_address) + 3) & ~3ull; at + 0x224 <= end; at += 4) {
+      const auto start = u32(at);
+      u32 word = 0;
+      if (!read(start, word) || word != lifecycle[0][0]) continue;
+      bool complete = true;
+      for (size_t i = 0; i < lifecycle.size(); ++i)
+        complete &= matches(start + offsets[i], lifecycle[i]);
+      if (!complete) continue;
+      // DeleteFiber must call this family's ConvertFiberToThread, not another
+      // lookalike. Both wrappers must use the same allocation/free routines.
+      const auto sameCall = [&](u32 a, u32 b) {
+        u32 x = 0, y = 0;
+        return read(a, x) && read(b, y) && branch(a, x) == branch(b, y);
+      };
+      u32 unlink = 0;
+      read(start + 0x1C0 + 9 * 4, unlink);
+      if (branch(start + 0x1C0 + 9 * 4, unlink) != start + 0x90 ||
+          !sameCall(start + 16 * 4, start + 0xE0 + 8 * 4) ||
+          !sameCall(start + 0x90 + 10 * 4, start + 0xE0 + 33 * 4) ||
+          !sameCall(start + 0x90 + 10 * 4, start + 0x1C0 + 17 * 4)) continue;
+      u32 thunk = 0;
+      if (!read(start + 0x220, thunk) || (thunk & 0xFC000003) != 0x48000000) continue;
+      const auto switchAddress = branch(start + 0x220, thunk);
+      if (!matches(switchAddress, context)) continue;
+      u32 high = 0, low = 0;
+      read(start + 0xE0 + 45 * 4, high);
+      read(start + 0xE0 + 48 * 4, low);
+      const u32 bootstrap = ((high & 0xFFFF) << 16) + i16(low);
+      if (!matches(bootstrap, {0x7FE3FB78, 0x48000001, 0x3860000E, 0x48000001})) continue;
+      for (size_t i = 0; i < lifecycle.size(); ++i) {
+        const auto address = start + offsets[i];
+        ctx.GetAnalysisState().crt_fiber_shims[address] = std::format("rexshim_{}", names[i]);
+        ctx.graph.AddFunction(address, u32(lifecycle[i].size() * 4), FunctionAuthority::kHelper, true);
+      }
+      for (auto address : {start + 0x220, switchAddress}) {
+        ctx.GetAnalysisState().crt_fiber_shims[address] = "rexshim_SwitchToFiber";
+        ctx.graph.AddFunction(address, address == switchAddress ? u32(context.size() * 4) : 4,
+                              FunctionAuthority::kHelper, true);
+      }
+      REXCG_DEBUG("Found complete CRT fiber lifecycle at 0x{:08X}", start);
+      at += 0x220;
+    }
+  }
+}
