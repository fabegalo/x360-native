+
+REX_TEST_CASE("guest capture routes the selected driver and preserves unavailable output", "[gpu][presenter-capture]") {
+  rex::gpu::RawImage image{1, 1, 4, {9, 8, 7, 255}};
+  PlainDriver unsupported;
+  CHECK_FALSE(unsupported.CaptureGuestOutput(image));
+  CHECK(image.data == std::vector<rex::u8>{9, 8, 7, 255});
+  GraphicsApp app("fake");
+  REQUIRE(app.StartApp());
+  auto& graphics = app.GetGraphics();
+  CHECK_FALSE(graphics.CaptureGuestOutput(image));
+  CHECK(image.width == 1);
+  g_fake.capture_available = true;
+  REQUIRE(graphics.CaptureGuestOutput(image));
+  CHECK(image.width == 2);
+  CHECK(image.height == 1);
+  CHECK(image.stride == 12);
+  CHECK(image.data == std::vector<rex::u8>{1, 2, 3, 255, 4, 5, 6, 255});
+  g_fake.capture_available = false;
+  CHECK_FALSE(graphics.CaptureGuestOutput(image));
+  CHECK(image.width == 2);
+  CHECK(image.data == std::vector<rex::u8>{1, 2, 3, 255, 4, 5, 6, 255});
+  app.Shutdown();
+}
