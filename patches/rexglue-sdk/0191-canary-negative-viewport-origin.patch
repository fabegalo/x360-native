+      i32 axis_0_int = static_cast<i32>(std::floor(
+          rex::clamp_float(offset_axis - scale_axis_abs,
+                           static_cast<f32>(axis_1_int) - axis_max_unscaled_float, axis_max_unscaled_float)));
+      u32 axis_extent_int = axis_1_int > 0 ? static_cast<u32>(axis_1_int - axis_0_int) : 0;
+      viewport_info_out.xy_offset[i] = axis_0_int * static_cast<i32>(axis_resolution_scale);
       viewport_info_out.xy_extent[i] = axis_extent_int * axis_resolution_scale;
       f32 ndc_scale_axis;
       f32 ndc_offset_axis;
