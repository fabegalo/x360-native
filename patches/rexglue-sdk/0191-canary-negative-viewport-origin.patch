@@ -207,17 +207,30 @@
     ndc_offset[2] = offset_z;
   } else {
     for (u32 i = 0; i < 2; ++i) {
+      // With resolution scaling, do all viewport XY scissoring in guest pixels
+      // if fractional and for the half-pixel offset - we treat guest pixels as
+      // a whole, and also the half-pixel offset would be irreversible in guest
+      // vertices if we did flooring in host pixels.
+      //
+      // The start may be negative, down to -max, instead of being cropped at
+      // 0 (Xenia Canary 6579cc2a4). With a window offset (predicated tiling in
+      // 4D5307DF draws its right-hand tile at x -608) cropping gave the tiles
+      // different NDC scales and offsets, and in some frames the same geometry
+      // came out as a flat wedge or rectangle in one tile only. Vulkan
+      // guarantees that viewportBoundsRange covers -2 * maxViewportDimensions,
+      // and Direct3D 12 allows -32768. The extent still stays within max.
       u32 axis_resolution_scale = i ? draw_resolution_scale_y : draw_resolution_scale_x;
       f32 offset_axis = offset_base_xy[i] + offset_add_xy[i];
       f32 scale_axis = scale_xy[i];
       f32 scale_axis_abs = std::abs(scale_xy[i]);
       f32 axis_max_unscaled_float = static_cast<f32>(xy_max_unscaled[i]);
-      u32 axis_0_int = static_cast<u32>(
-          rex::clamp_float(offset_axis - scale_axis_abs, 0.0f, axis_max_unscaled_float));
-      u32 axis_1_int = static_cast<u32>(
-          rex::clamp_float(offset_axis + scale_axis_abs, 0.0f, axis_max_unscaled_float));
-      u32 axis_extent_int = axis_1_int - axis_0_int;
-      viewport_info_out.xy_offset[i] = axis_0_int * axis_resolution_scale;
+      i32 axis_1_int = static_cast<i32>(std::floor(
