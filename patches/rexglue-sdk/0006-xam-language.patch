+// Xenia Canary 2372a54105d9: XamGetLanguage uses the configured system
+// language with extended IDs (1..17). ReXGlue's XConfig USER_LANGUAGE
+// already reads user_language. Invalid settings fall back to English;
+// this does not implement font resources or change XGetLanguage.
+u32 XamGetLanguage_entry() {
+  const uint32_t language = REXCVAR_GET(user_language);
+  if (language > 0 && language < 18) return language;
+  REXKRNL_WARN("XamGetLanguage: invalid user_language {}; using English (1)", language);
+  return 1;
+}
