+u32 XAMState::GetLanguageLocaleFallback(u32 language) {
+  // Xenia Canary 2372a54105d9: English is an owned empty string, not a null pointer.
+  static constexpr char16_t strings[18][8] = {
+      u"", u"", u"ja-JP", u"de-DE", u"fr-FR", u"es-ES", u"it-IT", u"ko-KR",
+      u"zh-TW", u"pt-BR", u"zh-CHS", u"pl-PL", u"ru-RU", u"sv-SE", u"tr-TR",
+      u"nb-NO", u"nl-NL", u"zh-CHS"};
+  if (!language || language >= 18) return 0;
+  std::lock_guard lock(language_fallback_mutex_);
+  if (!language_fallback_table_) {
+    const u32 address = AllocHeap(sizeof(strings));
+    if (!address) return 0;
+    auto* dest = title_.membase.TranslateVirtual(address);
+    for (size_t i = 0; i < 18; ++i)
+      for (size_t j = 0; j < 8; ++j)
+        memory::store_and_swap<u16>(dest + i * 16 + j * 2, strings[i][j]);
+    language_fallback_table_ = address;
+  }
+  // AllocHeap registers the block for this title's normal XAM teardown.
+  return language_fallback_table_ + language * 16;
+}
