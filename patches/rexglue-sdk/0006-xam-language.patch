+uint32_t XamModule::GetLanguageLocaleFallback(uint32_t language) {
+  // Xenia Canary 2372a54105d9, XamState::LoadLanguageLocaleFallback.
+  // English is a pointer to an empty string, not a null or residual register.
+  static constexpr char16_t strings[18][8] = {
+      u"", u"", u"ja-JP", u"de-DE", u"fr-FR", u"es-ES", u"it-IT", u"ko-KR",
+      u"zh-TW", u"pt-BR", u"zh-CHS", u"pl-PL", u"ru-RU", u"sv-SE", u"tr-TR",
+      u"nb-NO", u"nl-NL", u"zh-CHS"};
+  if (!language || language >= 18) {
+    REXKRNL_WARN("XamGetLanguageLocaleFallbackString: invalid language {}", language);
+    return 0;
+  }
+  auto lock = global_critical_region_.Acquire();
+  if (!language_fallback_table_) {
+    const uint32_t address = memory_->SystemHeapAlloc(sizeof(strings));
+    if (!address) {
+      REXKRNL_ERROR("XamGetLanguageLocaleFallbackString: allocation failed");
+      return 0;
+    }
+    auto* dest = memory_->TranslateVirtual(address);
+    for (size_t i = 0; i < 18; ++i)
+      for (size_t j = 0; j < 8; ++j)
+        memory::store_and_swap<uint16_t>(dest + i * 16 + j * 2, strings[i][j]);
+    language_fallback_table_ = address;
+  }
+  return language_fallback_table_ + language * 16;
+}
+
+XamModule::~XamModule() {
+  memory_->SystemHeapFree(language_fallback_table_);
+}
 
