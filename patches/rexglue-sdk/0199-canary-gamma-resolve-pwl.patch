+  #define byte_buffer_align4_load4_xe(name, byte_address) \
+      ((name).data[uint(byte_address) >> 2])
+  #define byte_buffer_align4_load8u_xe(name, byte_address) \
+      uint2_xe((name).data[uint(byte_address) >> 2],       \
