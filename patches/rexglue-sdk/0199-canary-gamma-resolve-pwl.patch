+
+    // Keep samples as 10 bit codes until MSAA averaging is done.
+    uint XePWLGammaToLinearCode(uint c) {
+      uint scale = c < 64u ? 1u : c < 96u ? 2u : c < 192u ? 4u : 8u;
+      uint offset = c < 64u ? 0u : c < 96u ? 64u : c < 192u ? 256u : 1024u;
+      uint linear_code = c * scale - offset;
+      return linear_code + ((linear_code * scale) >> 10u);
+    }
+
+    float3_xe XePWLGammaToLinearCode3(float3_xe gamma) {
+      return float3_xe(XePWLGammaToLinearCode(uint(gamma.x * 255.0f + 0.5f)),
+                       XePWLGammaToLinearCode(uint(gamma.y * 255.0f + 0.5f)),
+                       XePWLGammaToLinearCode(uint(gamma.z * 255.0f + 0.5f)));
+    }
+
+    float4_xe XePWLGammaToLinearCode4(float4_xe gamma) {
+      return float4_xe(XePWLGammaToLinearCode(uint(gamma.x * 255.0f + 0.5f)),
+                       XePWLGammaToLinearCode(uint(gamma.y * 255.0f + 0.5f)),
+                       XePWLGammaToLinearCode(uint(gamma.z * 255.0f + 0.5f)),
+                       XePWLGammaToLinearCode(uint(gamma.w * 255.0f + 0.5f)));
+    }
+
+    float XeResolveAveragePWLGamma(float sum, float sample_weight) {
+      // The averaged code goes through the PWL curve again, even when the
+      // destination has more precision than the source.
+      uint m = uint(sum * sample_weight);
+      uint c = m < 64u ? m : m < 128u ? (m + 64u) >> 1u :
+               m < 512u ? (m + 256u) >> 2u : (m + 1024u) >> 3u;
+      c = min(c, 255u);
+      uint n = XePWLGammaToLinearCode(c);
+      // Normalization replicates into 24 fractional bits.
+      return n == 1023u ? 1.0f :
+          float((n << 14u) | (n << 4u) | (n >> 6u)) * (1.0f / 16777216.0f);
+    }
+
+    float3_xe XeResolveAveragePWLGamma3(float3_xe sum, float sample_weight) {
+      return float3_xe(XeResolveAveragePWLGamma(sum.x, sample_weight),
+                       XeResolveAveragePWLGamma(sum.y, sample_weight),
+                       XeResolveAveragePWLGamma(sum.z, sample_weight));
+    }
+
+    float4_xe XeResolveAveragePWLGamma4(float4_xe sum, float sample_weight) {
+      return float4_xe(XeResolveAveragePWLGamma(sum.x, sample_weight),
+                       XeResolveAveragePWLGamma(sum.y, sample_weight),
+                       XeResolveAveragePWLGamma(sum.z, sample_weight),
+                       XeResolveAveragePWLGamma(sum.w, sample_weight));
+    }
+
+    bool XeResolveSourceUsesPWLGamma(XeResolveInfo resolve_info) {
+      return resolve_info.decode_pwl_gamma &&
+             resolve_info.edram_format ==
+                 kXenosColorRenderTargetFormat_8_8_8_8_GAMMA;
+    }
+
+    void XeResolveDecodePWLGammaSource(
+        XeResolveInfo resolve_info, inout_param_xe(float4_xe, pixel)) {
+      // Alpha stays on the normal fixed path.
+      dont_flatten_xe if (XeResolveSourceUsesPWLGamma(resolve_info)) {
+        pixel.rgb = XePWLGammaToLinearCode3(pixel.rgb);
+      }
+    }
+
+    uint2_xe XeResolveColorCopySource2SampleAddressesBytes(
+        XeResolveInfo resolve_info, uint2_xe pixel_index, uint sample_index) {
+      return uint2_xe(
+          XeResolveColorCopySourceSampleAddressBytes(
+              resolve_info, pixel_index, sample_index),
+          XeResolveColorCopySourceSampleAddressBytes(
+              resolve_info, pixel_index + uint2_xe(1u, 0u), sample_index));
