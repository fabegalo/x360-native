+
+  // Gap discovery can publish a callable entry after an earlier scan followed
+  // that address as a local label. Such branches have no unresolved jump.
+  // Reconcile only final, known entries; never guess a target or new boundary.
+  for (const auto& [entry, node] : graph.functions()) {
+    for (const auto& block : node->blocks()) {
+      const auto* data = binary.translate(block.base);
+      if (!data) continue;
+      for (uint32_t offset = 0; offset < block.size; offset += 4) {
+        const auto word = load_and_swap<uint32_t>(data + offset);
+        const auto op = PPC_OP(word);
+        if (op != PPC_OP_B && op != PPC_OP_BC) continue;
+        const auto site = block.base + offset;
+        const int32_t displacement = op == PPC_OP_B ? PPC_BI(word) : PPC_BD(word);
+        const uint32_t target = PPC_BA(word) ? uint32_t(displacement) : site + displacement;
+        const bool call = PPC_BL(word);
+        if ((!call && target == entry) || !graph.isEntryPoint(target)) continue;
+        const auto hasSite = [site](const auto& edges) {
+          return std::any_of(edges.begin(), edges.end(), [site](const auto& edge) { return edge.site == site; });
+        };
+        if (hasSite(node->calls()) || hasSite(node->tailCalls())) continue;
+        graph.addUnresolvedJumpToFunction(entry, site, target, call, op == PPC_OP_BC);
+      }
+    }
+  }
 
   size_t iteration = 0;
   size_t totalResolved = 0;
