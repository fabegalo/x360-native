+// Split a code region into function segments based on terminators (blr, tail calls).
+std::vector<CodeRegion> SplitRegionOnTerminators(
+    const CodeRegion& region, DecodedBinary& decoded,
+    const std::unordered_set<u32>& knownCallables,
+    const std::unordered_set<u32>& pdataEnds,
+    const std::map<u32, u32>& protectedEnds) {
+  std::vector<CodeRegion> segments;
+  u32 segmentStart = region.start;
+
+  for (u32 addr = region.start; addr < region.end; addr += 4) {
+    // An out-of-line return can end a pdata function with b to an earlier
+    // epilogue. Do not let that trailing block hide the following leaf's
+    // entry until its first blr. The original metadata supplies this boundary.
+    if (addr > segmentStart && pdataEnds.contains(addr)) {
+      segments.push_back({segmentStart, addr});
+      segmentStart = addr;
+    }
+    const auto* insn = decoded.FindInsn(addr);
+    if (!insn)
+      break;
+
+    bool shouldSplit = false;
+    const char* reason = nullptr;
+
+    // Check for terminators
+    if (insn->IsReturn()) {
+      shouldSplit = true;
+      reason = "blr";
+    } else if (insn->opcode == Opcode::bcctr &&
+               (IsVirtualTailThunk(decoded, segmentStart, addr) ||
+                IsDescriptorTailThunk(decoded, segmentStart, addr))) {
+      const auto boundary = addr + 4;
+      auto owner = protectedEnds.upper_bound(boundary);
+      // A recognized sequence does not override original metadata or an
+      // explicit config extent, including unreachable holes in that extent.
+      if (owner == protectedEnds.begin() || std::prev(owner)->second <= boundary) {
+        shouldSplit = true;
+        reason = "indirect tail thunk";
+      }
+    } else if (insn->opcode == Opcode::b && insn->branch_target.has_value()) {
+      u32 target = insn->branch_target.value();
+      // Don't split on tail recursion (branch to own segment start)
+      if (target != segmentStart && knownCallables.contains(target)) {
+        shouldSplit = true;
+        reason = "tail call";
+      }
+    }
+
+    if (shouldSplit) {
+      u32 segmentEnd = addr + 4;
+      if (segmentEnd > segmentStart) {
+        segments.push_back({segmentStart, segmentEnd});
+        REXCG_TRACE("GapFill: split segment 0x{:08X}-0x{:08X} ({} at 0x{:08X})", segmentStart,
+                         segmentEnd, reason, addr);
+      }
+      segmentStart = segmentEnd;
+    }
+  }
+
+  // Handle remaining code after last terminator
+  if (segmentStart < region.end) {
+    segments.push_back({segmentStart, region.end});
+  }
+
+  return segments;
+}
