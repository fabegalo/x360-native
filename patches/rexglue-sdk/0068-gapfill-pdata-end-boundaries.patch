+bool IsVirtualTailThunk(DecodedBinary& decoded, u32 start, u32 end) {
+  if (end - start != 12)
+    return false;
+  const auto* object = decoded.FindInsn(start);
+  const auto* slot = decoded.FindInsn(start + 4);
+  const auto* ctr = decoded.FindInsn(start + 8);
+  const auto* branch = decoded.FindInsn(end);
+  if (!object || !slot || !ctr || !branch)
+    return false;
+  const auto scratch = object->D.RT;
+  // MSVC may keep the vtable and its callable in different volatile GPRs.
+  // Match the data flow through both loads and mtctr, not register equality.
+  const auto callable = slot->D.RT;
+  return object->opcode == Opcode::lwz && object->D.RA == 3 && object->D.d == 0 &&
+         (scratch >= 10 && scratch <= 12) &&
+         slot->opcode == Opcode::lwz && slot->D.RA == scratch && (callable >= 10 && callable <= 12) &&
+         static_cast<i16>(slot->D.d) >= 0 && (slot->D.d & 3) == 0 &&
+         ctr->opcode == Opcode::mtctr && ctr->XFX.RT == callable &&
+         static_cast<u32>(branch->code) == 0x4E800420;
+}
+
+// A descriptor invoker transfers to an external callable loaded from a fixed
+// field, after constructing its this argument. Unlike a switch, this exact
+// data flow has no indexed code table or local labels. Do not split generic bctr.
+bool IsDescriptorTailThunk(DecodedBinary& decoded, u32 start, u32 end) {
+  if (end - start != 28) return false;
+  u32 words[8];
+  for (unsigned i = 0; i < 8; ++i) {
+    const auto* instruction = decoded.FindInsn(start + i * 4);
+    if (!instruction) return false;
+    words[i] = instruction->code;
+  }
+  const u32 descriptor = (words[0] >> 16) & 31;
+  const u32 object = (words[2] >> 21) & 31;
+  const u32 adjustment = (words[3] >> 21) & 31;
+  const auto scratch = [](u32 reg) { return reg >= 9 && reg <= 12; };
+  if (!scratch(descriptor) || !scratch(object) || !scratch(adjustment) ||
+      descriptor == object || descriptor == adjustment || object == adjustment) return false;
+  const auto move = [](u32 to, u32 from) {
+    return 0x7C000378u | (from << 21) | (to << 16) | (from << 11);
+  };
+  const auto load = [](u32 to, u32 from, u32 offset) {
+    return (32u << 26) | (to << 21) | (from << 16) | offset;
+  };
+  return words[0] == move(descriptor, 4) && words[1] == move(4, 3) &&
+         words[2] == load(object, descriptor, 8) &&
+         words[3] == load(adjustment, descriptor, 4) &&
+         words[4] == load(descriptor, descriptor, 0) &&
+         words[5] == (0x7C000214u | (3u << 21) | (object << 16) | (adjustment << 11)) &&
+         words[6] == (0x7C0903A6u | (descriptor << 21)) && words[7] == 0x4E800420;
+}
