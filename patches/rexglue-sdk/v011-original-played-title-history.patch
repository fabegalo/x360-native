+REX_TEST_CASE("corrupt played-title histories cannot be overwritten or reported as a valid zero", "[kernel][xam][titles-played]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  REQUIRE(profile.CreateLocal("Keep") == 0);
+  const auto xuid = profile.identity().xuid;
+  REQUIRE(profile.SetLocalSession(xuid) == 0);
+  REQUIRE(profile.RecordTitlePlayed(0x12345678));
+  const auto path = rex::xam::CurrentTitle().user_data_root / "profiles" / std::format("{:016X}", xuid) / "titles-played.dat";
+  auto valid = rex::platform::ReadHostFile(path);
+  REQUIRE(valid); REQUIRE(valid->size() == 16);
+  CHECK(std::string(valid->begin(), valid->begin() + 8) == "X360TP01");
+  for (const auto& damaged : {std::vector<u8>{'b', 'a', 'd'}, [&] { auto v = *valid; v.push_back(0); return v; }(),
+                            [&] { auto v = *valid; v[8] = 0xFF; return v; }()}) {
+    REQUIRE(rex::platform::WriteHostFile(path, damaged, true));
+    CHECK_FALSE(profile.RecordTitlePlayed(0x87654321));
+    const auto after = rex::platform::ReadHostFile(path);
+    REQUIRE(after); CHECK(*after == damaged);
+    const auto* setting = profile.GetSetting(0x10040012);
+    REQUIRE(setting); CHECK(setting->load_failed);
+  }
+  REQUIRE(rex::platform::WriteHostFile(path, *valid, true));
+  REQUIRE(profile.RecordTitlePlayed(0x87654321));
+  CHECK(profile.TitlesPlayed(xuid) == std::vector<u32>{0x12345678, 0x87654321});
+  const auto* setting = profile.GetSetting(0x10040012);
+  REQUIRE(setting); CHECK_FALSE(setting->load_failed);
+}
