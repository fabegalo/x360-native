     LoadSetting(setting);
+  if (setting_id == 0x10040012 && setting->type == Setting::Type::kInt32) {
+    const auto account = identity();
+    std::filesystem::path store;
+    { std::lock_guard lock(identity_mutex_); store = profile_path_; }
+    const auto titles = account.signin_state && !store.empty()
+        ? ReadTitlesPlayed(store, account.xuid) : std::optional<std::vector<uint32_t>>(std::vector<uint32_t>{});
+    setting->load_failed = !titles;
+    if (titles) static_cast<Int32Setting*>(setting)->value = static_cast<int32_t>(titles->size());
+  }
 
   return setting;
 }
