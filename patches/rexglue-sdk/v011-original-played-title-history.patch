+REX_TEST_CASE("played titles remain durable and isolated by full account XUID", "[kernel][xam][titles-played]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  const auto root = rex::xam::CurrentTitle().user_data_root;
+  u64 first = 0, second = 0;
+  REQUIRE(profile.CreateLocal("First", &first) == 0);
+  REQUIRE(profile.CreateLocal("Second", &second) == 0);
+  REQUIRE(profile.SetLocalSession(first) == 0);
+  CHECK_FALSE(profile.RecordTitlePlayed(0));
+  CHECK_FALSE(profile.RecordTitlePlayed(0xFFFE07D1));
+  REQUIRE(profile.RecordTitlePlayed(0x58410A5D));
+  REQUIRE(profile.RecordTitlePlayed(0x4D5309C9));
+  REQUIRE(profile.RecordTitlePlayed(0x58410A5D));
+  CHECK(profile.TitlesPlayed(first) == std::vector<u32>{0x4D5309C9, 0x58410A5D});
+  CHECK(profile.TitlesPlayed(second).empty());
+  auto* setting = profile.GetSetting(0x10040012);
+  REQUIRE(setting); CHECK_FALSE(setting->load_failed);
+  CHECK(static_cast<rex::xam::UserProfile::Int32Setting*>(setting)->value == 2);
+  REQUIRE(profile.SetLocalSession(second) == 0);
+  setting = profile.GetSetting(0x10040012);
+  REQUIRE(setting); CHECK_FALSE(setting->load_failed);
+  CHECK(static_cast<rex::xam::UserProfile::Int32Setting*>(setting)->value == 0);
+  REQUIRE(profile.RecordTitlePlayed(0x12345678));
+  rex::xam::UserProfile reopened;
+  REQUIRE(reopened.InitializeLocal(root));
+  CHECK(reopened.TitlesPlayed(first) == std::vector<u32>{0x4D5309C9, 0x58410A5D});
+  CHECK(reopened.TitlesPlayed(second) == std::vector<u32>{0x12345678});
+  REQUIRE(profile.SetLocalSession(0) == 0);
+  CHECK_FALSE(profile.RecordTitlePlayed(0x12345678));
+  fixture.RunOnGuestThread([&](Caller& c) {
+    for (const auto user : {0u, 1u, 0xFEu, 0xFFu}) {
+      CHECK(c.XAM("XamUserIsGuest", {user}) == 0);
+      CHECK(c.XAM("XamUserGetCachedUserFlags", {user}) == 0);
+    }
+  });
+}
