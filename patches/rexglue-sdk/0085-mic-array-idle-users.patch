diff --git a/include/rex/system/kernel_state.h b/include/rex/system/kernel_state.h
--- a/include/rex/system/kernel_state.h
+++ b/include/rex/system/kernel_state.h
@@ -215,6 +215,25 @@
   util::XdbfGameData title_xdbf() const;
   util::XdbfGameData module_xdbf(object_ref<UserModule> exec_module) const;
 
+  // XAM microphone-array control state, independent of capture-device presence.
+  // The original setter stores the full mask and optionally queues one DPC.
+  // A pending update is coalesced; its consumer observes the newest mask.
+  void SetMicArrayIdleUsers(uint32_t mask, bool request_update) {
+    std::lock_guard lock(mic_array_idle_mutex_);
+    mic_array_idle_users_ = mask;
+    mic_array_idle_update_pending_ |= request_update;
+  }
+  uint32_t GetMicArrayIdleUsers() {
+    std::lock_guard lock(mic_array_idle_mutex_);
+    return mic_array_idle_users_;
+  }
+  std::optional<uint32_t> TakeMicArrayIdleUsersUpdate() {
+    std::lock_guard lock(mic_array_idle_mutex_);
+    if (!mic_array_idle_update_pending_) return std::nullopt;
+    mic_array_idle_update_pending_ = false;
+    return mic_array_idle_users_;
+  }
+
   xam::AppManager* app_manager() const { return app_manager_.get(); }
   xam::ContentManager* content_manager() const { return content_manager_.get(); }
   xam::UserProfile* user_profile() const { return user_profile_.get(); }
@@ -370,6 +389,10 @@
   memory::Memory* memory_;
   runtime::FunctionDispatcher* function_dispatcher_;
   rex::filesystem::VirtualFileSystem* file_system_;
+
+  std::mutex mic_array_idle_mutex_;
+  uint32_t mic_array_idle_users_ = 0;
+  bool mic_array_idle_update_pending_ = false;
 
   std::unique_ptr<xam::AppManager> app_manager_;
   std::unique_ptr<xam::ContentManager> content_manager_;
