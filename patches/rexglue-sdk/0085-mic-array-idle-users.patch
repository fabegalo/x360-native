+u32 XamVoiceSetMicArrayIdleUsers_entry(u32 idle_users, u32 request_update) {
+  // Retail 17559 export 0x48C stores all 32 mask bits, optionally requests a
+  // coalesced control update, and returns success independently of hardware.
+  // This control queue does not claim microphone capture is implemented.
+  REX_KERNEL_STATE()->SetMicArrayIdleUsers(idle_users, request_update != 0);
+  return X_ERROR_SUCCESS;
+}
 
