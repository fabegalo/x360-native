+
+Result<void> TitleContext::NotifyPhysicalWrite(PhysicalRange range) {
+  if (!InPhysical(range.address, range.length)) return std::unexpected(OutOfRange());
+  if (!range.length) return {};
+  kernel::GuestAddressSpace& memory = *StateOf(runtime_).GetAddressSpace();
+  const u64 end = u64{range.address} + range.length;
+  for (const u32 view_base : kPhysicalViewBases) {
+    kernel::BaseHeap* heap = memory.LookupHeap(view_base);
+    if (!heap || heap->GetHeapType() != kernel::HeapType::kGuestPhysical) continue;
+    const u32 origin = memory.GetPhysicalAddress(view_base);
+    const u64 first = std::max<u64>(range.address, origin);
+    const u64 last = std::min<u64>(end, u64{origin} + heap->GetHeapSize());
+    if (first < last) {
+      static_cast<kernel::PhysicalHeap*>(heap)->TriggerCallbacks(
+          view_base + static_cast<u32>(first - origin), static_cast<u32>(last - first), true, true);
     }
   }
   return {};
