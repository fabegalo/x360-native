diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9b3cdf5..33b7da0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -222,10 +222,10 @@ configure_file(
     @ONLY
 )
 
-# Output directories (multi-config appends /<Config>/ automatically)
-set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${REXGLUE_ROOT}/out/${REX_PLATFORM}")
-set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${REXGLUE_ROOT}/out/${REX_PLATFORM}")
-set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${REXGLUE_ROOT}/out/${REX_PLATFORM}")
+# Build-local outputs; explicit configuration also isolates single-config builds.
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/out/${REX_PLATFORM}/$<CONFIG>")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/out/${REX_PLATFORM}/$<CONFIG>")
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/out/${REX_PLATFORM}/$<CONFIG>")
 
 # Sanitizer support for debugging memory corruption and undefined behavior
 if(REXGLUE_ENABLE_SANITIZERS)
diff --git a/cmake/rexglue_helpers.cmake b/cmake/rexglue_helpers.cmake
index 41e6dce..c15fb72 100644
--- a/cmake/rexglue_helpers.cmake
+++ b/cmake/rexglue_helpers.cmake
@@ -101,7 +101,7 @@ function(rexglue_configure_target target_name)
 
     rexglue_apply_target_settings(${target_name})
 
-    if(WIN32)
+    if(WIN32 AND NOT REXGLUE_EXTERNAL_STAGING)
         # Stage runtime DLLs (rexruntime, TracyClient, etc.) next to the host
