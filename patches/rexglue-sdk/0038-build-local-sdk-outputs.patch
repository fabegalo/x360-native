         add_custom_command(TARGET ${target_name} POST_BUILD
@@ -127,7 +127,7 @@ function(rexglue_configure_target target_name)
         endforeach()
     endif()
 
-    if(WIN32)
+    if(WIN32 AND NOT REXGLUE_EXTERNAL_STAGING)
         # FidelityFX is linked PRIVATE by rexui (to avoid propagating DLL
