+bool KernelThread::CanCallGuestFunction(u32 address) const {
+  if (GetCallingThread() != this || !thread_state_) return false;
+  auto* functions = StateOf(*runtime_).GetFunctionDispatcher();
+  return functions && functions->GetFunction(address);
+}
+
+bool KernelThread::CallGuestFunction(u32 address, std::span<u64> args) {
+  if (!CanCallGuestFunction(address)) return false;
+  auto* functions = StateOf(*runtime_).GetFunctionDispatcher();
+  functions->ExecuteTrap(thread_state_.get(), address, args.data(), args.size());
+  return true;
+}
+
+u32 KernelThread::GetTitleProcessType() const {
+  return StateOf(*runtime_).GetProcessType();
+}
+
 u32 KernelThread::GetLastError() {
   return GetGuestObject<X_KTHREAD>()->last_error;
 }
