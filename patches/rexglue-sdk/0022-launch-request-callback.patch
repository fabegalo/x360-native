+  REXXAM_DEBUG("Launch request callback registered: {:08X}", callback);
+}
+
+static u32 PrepareContentLaunch(std::string_view path, u64 file_size) {
+  auto& ui = CurrentXAM().GetSystemUI();
+  ui.launch_request_internal_flags.store(0);
+  const auto callback = ui.launch_request_callback.load();
+  if (!callback) return kernel::X_ERROR_SUCCESS;
+  auto* thread = CurrentTitle().threads.GetCallingThread();
+  if (!thread || thread->GetTitleProcessType() == kernel::kXProcTypeSystem || !thread->CanCallGuestFunction(callback)) return 50;
+  auto opened = CurrentTitle().file_system.Open(path, {.access = filesystem::Access::kReadData});
+  if (!opened) return kernel::X_ERROR_ACCESS_DENIED;
+  const auto read = [&](u32 offset, std::span<u8> bytes) {
+    if (u64{offset} + bytes.size() > file_size) return false;
+    const auto copied = opened->file->Read(bytes, offset);
+    return copied && *copied == bytes.size();
+  };
+  std::array<u8, 24> header{}, execution{};
+  if (!read(0, header) || std::memcmp(header.data(), "XEX2", 4)) return 193;
+  const auto image_offset = memory::load_and_swap<u32>(header.data() + 8);
+  const auto count = memory::load_and_swap<u32>(header.data() + 20);
+  if (image_offset > file_size || image_offset < 24 || count > (image_offset - 24) / 8) return 193;
+  bool found = false;
+  for (u32 i = 0; i < count; ++i) {
+    std::array<u8, 8> option{};
+    if (!read(24 + i * 8, option)) return 193;
+    if (memory::load_and_swap<u32>(option.data()) != 0x00040006) continue;
+    const auto offset = memory::load_and_swap<u32>(option.data() + 4);
+    if (offset < 24 + count * 8 || u64{offset} + execution.size() > image_offset || !read(offset, execution)) return 193;
+    found = true; break;
+  }
+  if (!found) return 193;
+  const auto request = CurrentTitle().heap.SystemHeapAlloc(16);
+  if (!request) return kernel::X_ERROR_NOT_ENOUGH_MEMORY;
+  rex::ScopeGuard release([&] { CurrentTitle().heap.SystemHeapFree(request); });
+  auto* fields = CurrentTitle().membase.TranslateVirtual<be_u32*>(request);
+  fields[0] = memory::load_and_swap<u32>(execution.data() + 12);
+  fields[1] = memory::load_and_swap<u32>(execution.data() + 8);
+  fields[2] = 1; fields[3] = 0;
+  u64 args[] = {request};
+  if (!thread->CallGuestFunction(callback, args)) return 50;
+  ui.launch_request_internal_flags.store(fields[3] ? 0x200 : 0);
+  REXXAM_DEBUG("Launch preparation callback={:08X} title={:08X} base={:08X} display_prepared={}",
+      callback, u32(fields[0]), u32(fields[1]), u32(fields[3]));
+  return kernel::X_ERROR_SUCCESS;
+}
