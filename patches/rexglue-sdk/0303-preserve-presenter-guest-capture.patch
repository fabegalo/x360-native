+#include "gpu/xenos/host/presenter.h"
+namespace {
+class CaptureColorConversion : public rex::gpu::Presenter {
+ public:
+  using Presenter::Packed10bpcRGBTo8bpcBytes;
+};
+}
+REX_TEST_CASE("guest output capture preserves every RGB10 channel without dithering", "[gpu][presenter-capture]") {
+  for (rex::u32 channel = 0; channel < 3; ++channel) {
+    for (rex::u32 value = 0; value < 1024; ++value) {
+      const auto rgba = CaptureColorConversion::Packed10bpcRGBTo8bpcBytes(value << (channel * 10));
+      const auto bytes = std::bit_cast<std::array<rex::u8, 4>>(rgba);
+      for (rex::u32 component = 0; component < 3; ++component)
+        CHECK(bytes[component] == (component == channel ? (value * 255 + 511) / 1023 : 0));
+      CHECK(bytes[3] == 255);
+    }
+  }
+}
