+    const auto* predecessor = decoded.get(target - 4);
+    if (containing && predecessor && predecessor->opcode == Opcode::b &&
+        predecessor->branch_target == target) {
+      for (const auto& block : containing->blocks()) {
+        if (block.base == target) {
+          targets.insert(target);
+          return;
+        }
+      }
+    }
+    if (containing && containing->authority() != FunctionAuthority::GAP_FILL) return;
     bool bounded = false;
     for (uint32_t word = 0; word < 64; ++word) {
       const uint64_t address = uint64_t(target) + word * 4;
