+u32 XamContentGetAttributesInternal_entry(MappedVoid content, MappedVoid attributes, MappedVoid overlapped) {
+  u32 result = kernel::X_ERROR_INVALID_PARAMETER;
+  if (content && attributes) {
+    const auto& data = *content.As<const kernel::XCONTENT_AGGREGATE_DATA*>();
+    const auto* device = rex::xam::GetPlaceholderDevice(data.device_id);
+    if (!device) result = kernel::X_ERROR_DEVICE_NOT_CONNECTED;
+    else if (device->device_type != rex::xam::DeviceType::kHDD) result = kernel::XResultFromWin32(50);
+    else result = CurrentXAM().GetContentManager().GetContentAttributes(data, attributes.As<u8*>());
+  }
+  if (overlapped) {
+    CurrentTitle().overlapped_dispatcher.Complete(overlapped.GetGuestAddress(), {.result = result});
+    return kernel::X_ERROR_IO_PENDING;
+  }
+  return result;
+}
