+u32 ContentManager::GetContentAttributes(const kernel::XCONTENT_AGGREGATE_DATA& data, u8* output) {
+  if (!output) return kernel::X_ERROR_INVALID_PARAMETER;
+  const std::string name(data.file_name_raw, std::find(data.file_name_raw, data.file_name_raw + 42, '\0'));
+  if (name.empty() || name == "." || name == ".." || name.find_first_of("/\\:") != std::string::npos)
+    return kernel::X_ERROR_INVALID_PARAMETER;
+  const auto path = ResolvePackagePath(data.xuid, data);
+  const auto info = title_.file_system_factory.StatHostPath(path);
+  if (!info) {
+    std::error_code error;
+    const bool exists = std::filesystem::exists(path, error);
+    return !error && !exists ? kernel::X_ERROR_FILE_NOT_FOUND : kernel::X_ERROR_ACCESS_DENIED;
+  }
+  u64 size = info->size;
+  if (info->directory) {
+    std::error_code error;
+    std::filesystem::recursive_directory_iterator item(path, error), end;
+    if (error) return kernel::X_ERROR_ACCESS_DENIED;
+    while (item != end) {
+      const bool regular = item->is_regular_file(error);
+      if (error) return kernel::X_ERROR_ACCESS_DENIED;
+      if (regular) {
+        const auto bytes = item->file_size(error);
+        if (error || bytes > UINT64_MAX - size) return kernel::X_ERROR_ACCESS_DENIED;
+        size += bytes;
+      }
+      item.increment(error);
+      if (error) return kernel::X_ERROR_ACCESS_DENIED;
+    }
+  }
+  memory::store_and_swap<u32>(output, info->directory ? 0x10u : 0x80u);
+  memory::store_and_swap<u64>(output + 4, info->create_time);
+  memory::store_and_swap<u64>(output + 12, info->access_time);
+  memory::store_and_swap<u64>(output + 20, info->write_time);
+  memory::store_and_swap<u64>(output + 28, size);
+  return kernel::X_ERROR_SUCCESS;
+}
