+REX_TEST_CASE("content attributes retain packed BE timestamps, recursive byte size and failure completions", "[kernel][xam][content-attributes]") {
+  KernelFixture fixture([](const std::filesystem::path& root) {
+    REQUIRE(std::filesystem::equivalent(root.parent_path(), std::filesystem::temp_directory_path()));
+    REQUIRE(root.filename().string().starts_with("rexglue_kernel_fixture_"));
+    const auto package = root / "0000000000000000" / "584108B7" / "000D0000" / "package";
+    std::filesystem::create_directories(package / "sub");
+    std::ofstream(package / "payload", std::ios::binary).write("actual bytes", 12);
+    std::ofstream(package / "sub" / "more", std::ios::binary).write("abc", 3);
+  });
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto input = caller.Alloc(sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA));
+    auto* data = reinterpret_cast<rex::kernel::XCONTENT_AGGREGATE_DATA*>(caller.GetBase() + input);
+    *data = {};
+    data->device_id = 1;
+    data->title_id = 0x584108B7;
+    data->content_type = static_cast<rex::kernel::XContentType>(0xD0000);
+    data->SetFileName("package");
+    const auto output = caller.Alloc(44), overlap = caller.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    std::memset(caller.GetBase() + output, 0xA5, 44);
+    // Snapshot before traversal: enumerating a directory may update its native access time.
+    const auto path = fixture.GetRoot() / "0000000000000000" / "584108B7" / "000D0000" / "package";
+    const auto info = rex::xam::CurrentTitle().file_system_factory.StatHostPath(path);
+    REQUIRE(info.has_value());
+    REQUIRE(caller.XAM("XamContentGetAttributesInternal", {input, output, 0}) == 0);
+    CHECK(caller.Load32(output) == 0x10);
+    CHECK(caller.Load32(output + 28) == 0);
+    CHECK(caller.Load32(output + 32) == 15);
+    CHECK(caller.Load32(output + 36) == 0xA5A5A5A5);
+    for (const auto& [offset, expected] : {std::pair<u32, u64>{4, info->create_time}, {12, info->access_time}, {20, info->write_time}})
+      CHECK(((u64(caller.Load32(output + offset)) << 32) | caller.Load32(output + offset + 4)) == expected);
+    REQUIRE(caller.XAM("XamContentGetAttributesInternal", {input, output, overlap}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(caller.Load32(overlap) == 0);
+    data->SetFileName("missing");
+    std::memset(caller.GetBase() + output, 0xA5, 44);
+    CHECK(caller.XAM("XamContentGetAttributesInternal", {input, output, overlap}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(caller.Load32(overlap) == rex::kernel::X_ERROR_FILE_NOT_FOUND);
+    for (u32 offset = 0; offset < 44; offset += 4) CHECK(caller.Load32(output + offset) == 0xA5A5A5A5);
+    data->SetFileName("../package");
+    CHECK(caller.XAM("XamContentGetAttributesInternal", {input, output, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    data->device_id = 2;
+    CHECK(caller.XAM("XamContentGetAttributesInternal", {input, output, 0}) == 50);
+    data->device_id = 99;
+    CHECK(caller.XAM("XamContentGetAttributesInternal", {input, output, 0}) == rex::kernel::X_ERROR_DEVICE_NOT_CONNECTED);
+    CHECK(caller.XAM("XamContentGetAttributesInternal", {0, output, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+  });
