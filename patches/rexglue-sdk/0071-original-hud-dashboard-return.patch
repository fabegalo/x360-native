+void AudioSystem::QuiesceTitleCallbacks() {
+  std::unique_lock callback_lock(callback_mutex_);
+  callbacks_quiesced_ = true;
+  if (worker_thread_ && system::XThread::IsInThread(worker_thread_.get())) {
+    // A loader call on the callback thread cannot join itself. It will not
+    // return to guest code; release the dispatch lease before that thread exits.
+    callback_active_ = false;
+    callback_finished_.notify_all();
+  } else {
+    callback_finished_.wait(callback_lock, [this] { return !callback_active_; });
+  }
+  REXAPU_INFO("Audio guest callbacks quiesced before title thread shutdown");
+}
