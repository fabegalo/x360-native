+u32 XamLoaderRebootToDash_entry(mapped_void context) {
+  // Retail 17559 export 0x839 (816A1330): copy the packed 1020-byte
+  // dashboard context before leaving the title. The original HUD owns the
+  // confirmation and supplies reason/user; do not substitute a host menu.
+  constexpr uint32_t size = 1020;
+  const uint32_t address = context.guest_address();
+  if (!address || uint64_t(address) + size > 0x100000000ull)
+    return X_ERROR_INVALID_PARAMETER;
+  for (uint32_t offset = 0; offset < size;) {
+    auto* heap = REX_KERNEL_MEMORY()->LookupHeap(address + offset);
+    rex::memory::HeapAllocationInfo region{};
+    if (!heap || !heap->QueryRegionInfo(address + offset, &region) ||
+        !(region.state & rex::memory::kMemoryAllocationCommit) ||
+        !(region.protect & rex::memory::kMemoryProtectRead))
+      return X_ERROR_INVALID_PARAMETER;
+    offset += std::min(size - offset, 4096u - ((address + offset) & 4095u));
+  }
+  const auto* bytes = static_cast<const uint8_t*>(context.host_address());
+  const auto reason = memory::load_and_swap<uint32_t>(bytes + 4);
+  const auto user = memory::load_and_swap<uint32_t>(bytes + 8);
+  auto& loader = REX_KERNEL_STATE()->GetKernelModule<XamModule>("xam.xex")->loader_data();
+  loader.launch_data.assign(bytes, bytes + size);
+  loader.launch_data_present = true;
+  loader.launch_path.clear();
+  loader.launch_flags = reason == 72 ? 0x100000 : 0;
+  loader.exit_request = XamModule::LoaderData::ExitRequest::Dashboard;
+  REXKRNL_INFO("XamLoaderRebootToDash: reason={} user={:08X} flags={:08X} data_size={}",
+      reason, user, loader.launch_flags, loader.launch_data.size());
+  REX_KERNEL_STATE()->TerminateTitle();
+  return X_ERROR_SUCCESS;
+}
