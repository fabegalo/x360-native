+X_HRESULT DispatchContentTransfer(uint32_t packet, uint32_t length) {
+  auto* kernel = REX_KERNEL_STATE();
+  if (length != 552 || !AchievementGuestSpan(kernel->memory(), packet, length,
+          memory::kMemoryProtectRead) || !XThread::IsInThread()) return X_E_INVALIDARG;
+  auto* base = kernel->memory()->virtual_membase();
+  auto word = [&](uint32_t offset) { return memory::load_and_swap<uint32_t>(base + packet + offset); };
+  const auto flags = word(532);
+  if ((flags & ~7u) || !(flags & 6u)) return X_E_INVALIDARG;
