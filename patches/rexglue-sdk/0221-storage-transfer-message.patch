+  context.r3.u64 = flags & 4 ? packet : 0;
+  context.r4.u64 = flags & 2 ? packet + 8 : 0;
+  context.r5.u64 = packet + 16;
+  context.r6.u64 = word(536);
+  context.r7.u64 = word(540);
+  context.r8.u64 = 0;
+  context.r9.u64 = word(528);
+  const auto result = ContentTransfer(context, base, (flags & 1) != 0);
+  // S_OK acknowledges asynchronous acceptance; only the worker completes I/O.
+  return result == X_ERROR_IO_PENDING ? X_E_SUCCESS : X_HRESULT_FROM_WIN32(result);
+}
