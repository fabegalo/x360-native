diff --git a/tests/unit/filesystem/host_file_test.cpp b/tests/unit/filesystem/host_file_test.cpp
--- a/tests/unit/filesystem/host_file_test.cpp
+++ b/tests/unit/filesystem/host_file_test.cpp
@@ -225,3 +225,30 @@
   REQUIRE_FALSE(handle);
   CHECK(rex::filesystem::CodeOf(handle.error()) == rex::filesystem::FileSystemError::kNotFound);
 }
+
+
+REX_TEST_CASE("atomic host writes replace existing files and preserve committed bytes on failure", "[filesystem][atomic-host-write]") {
+  TempFolder temp;
+  const auto durable = [](const std::filesystem::path& file, std::string_view text) {
+    return rex::platform::WriteHostFile(file, std::span(reinterpret_cast<const u8*>(text.data()), text.size()), true);
+  };
+  const auto path = temp.path / "profile.dat";
+  REQUIRE(durable(path, "original"));
+  REQUIRE(durable(path, "replacement"));
+  auto contents = rex::platform::ReadHostFile(path); REQUIRE(contents);
+  CHECK(std::string(contents->begin(), contents->end()) == "replacement");
+  auto stage = path; stage += ".tmp";
+  REQUIRE(std::filesystem::create_directory(stage));
+  CHECK_FALSE(durable(path, "uncommitted"));
+  contents = rex::platform::ReadHostFile(path); REQUIRE(contents);
+  CHECK(std::string(contents->begin(), contents->end()) == "replacement");
+  CHECK(std::filesystem::is_directory(stage));
+  REQUIRE(std::filesystem::remove(stage));
+  REQUIRE(durable(path, std::string_view{}));
+  CHECK(std::filesystem::file_size(path) == 0);
+  const auto directory = temp.path / "existing-directory";
+  REQUIRE(std::filesystem::create_directory(directory));
+  CHECK_FALSE(durable(directory, "cannot replace a directory"));
+  CHECK(std::filesystem::is_directory(directory));
+  CHECK_FALSE(std::filesystem::exists(temp.path / "existing-directory.tmp"));
+}
