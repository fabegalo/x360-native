-u32 XamShowSigninUI_entry([[maybe_unused]] u32 unk, [[maybe_unused]] u32 unk_mask) {
-  // XN_SYS_SIGNINCHANGED
-  CurrentTitle().notifier.BroadcastNotification(0x0000000A, 1);
-  // XN_SYS_UI with the UI off.
-  CurrentTitle().notifier.BroadcastNotification(0x00000009, 0);
-  return kernel::X_ERROR_SUCCESS;
+static u32 DispatchProfileUi(u32 message, const u32* words, size_t count) {
+  auto& heap = CurrentTitle().heap;
+  const auto bytes = static_cast<u32>(count * 4);
+  const auto buffer = heap.SystemHeapAlloc(bytes);
+  if (!buffer) return 14;
+  rex::ScopeGuard release([&] { heap.SystemHeapFree(buffer); });
+  auto* output = CurrentTitle().membase.TranslateVirtual<be_u32*>(buffer);
+  for (size_t i = 0; i < count; ++i) output[i] = words[i];
+  const auto status = CurrentXAM().GetAppManager().DispatchMessageSync(0xFE, message, buffer, bytes);
+  const u32 result = kernel::XFAILED(status) ? (status == 0x8007000Eu ? 14u : 1627u) : 0u;
+  REXXAM_INFO("Profile UI: app=FE message={:08X} bytes={} dispatch={:08X} result={}; user={} state={}",
+      message, bytes, status, result, CurrentXAM().GetUserProfile().GetName(), CurrentXAM().GetUserProfile().GetSigninState());
+  return result;
+}
+
+u32 XamShowSigninUI_entry(u32 user_count, u32 flags) {
+  const u32 request[] = {0, 0xFF, user_count, flags, 0};
+  return DispatchProfileUi(0x21001, request, 5);
+}
+u32 XamShowGamerCardUI_entry(u32 user_index) {
+  u32 request[544 / 4]{};
+  request[0] = user_index;
+  return DispatchProfileUi(0x21008, request, 544 / 4);
 }
 
