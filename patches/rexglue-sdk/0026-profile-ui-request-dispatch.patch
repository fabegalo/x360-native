-u32 XamShowSigninUI_entry(u32 unk, u32 unk_mask) {
-  // Mask values vary. Probably matching user types? Local/remote?
-
-  // To fix game modes that display a 4 profile signin UI (even if playing
-  // alone):
-  // XN_SYS_SIGNINCHANGED
-  REX_KERNEL_STATE()->BroadcastNotification(0x0000000A, 1);
-  // Games seem to sit and loop until we trigger this notification:
-  // XN_SYS_UI (off)
-  REX_KERNEL_STATE()->BroadcastNotification(0x00000009, 0);
-  return X_ERROR_SUCCESS;
+// Original XAM 17559 wrappers: 816C19C8/816C1868 (signin) and
+// 816C40F0 (gamer card). UI submission is separate from a real user-state change.
+static uint32_t DispatchProfileUi(uint32_t message, const uint32_t* words, size_t count) {
+  auto* kernel = REX_KERNEL_STATE();
+  auto* memory = REX_KERNEL_MEMORY();
+  const auto buffer = memory->SystemHeapAlloc(static_cast<uint32_t>(count * 4));
+  if (!buffer) return 14;
+  auto* out = memory->TranslateVirtual<be<uint32_t>*>(buffer);
+  for (size_t i = 0; i < count; ++i) out[i] = words[i];
+  const auto status = kernel->app_manager()->DispatchMessageSync(0xFE, message, buffer,
+                                                               static_cast<uint32_t>(count * 4));
+  memory->SystemHeapFree(buffer);
+  // 816C16C8 maps a failed system-UI dispatch to 1627 (or 14 for OOM).
+  const uint32_t result = XFAILED(status) ? (status == 0x8007000Eu ? 14u : 1627u) : 0u;
+  REXKRNL_INFO("Profile UI: app=FE message={:08X} bytes={} dispatch={:08X} result={}; user={} state={}",
+               message, count * 4, uint32_t(status), result, kernel->user_profile()->name(),
+               kernel->user_profile()->signin_state());
+  return result;
+}
+
+u32 XamShowSigninUI_entry(u32 user_count, u32 flags) {
+  const uint32_t request[] = {0, 0xFF, user_count, flags, 0};
+  // The UI service must open the original selection and change user state.
+  // Never announce SIGNINCHANGED/UI-closed just to release a title's wait.
+  return DispatchProfileUi(0x21001, request, 5);
+}
+
+u32 XamShowGamerCardUI_entry(u32 user_index) {
+  uint32_t request[544 / 4]{};
+  request[0] = user_index;
+  return DispatchProfileUi(0x21008, request, 544 / 4);
 }
 
