+REX_TEST_CASE("system UI registrations and retail requests preserve the original host boundary", "[kernel][xam][system-ui-transport]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    CHECK(caller.XAM("XamRegisterSysApp", {0, 2, 0x1234, 9}) == 1627);
+    CHECK(caller.XAM("XamRegisterSysApp", {5, 2, 0, 9}) == 1627);
+    REQUIRE(caller.XAM("XamRegisterSysApp", {5, 2, 0x1234, 9}) == 0);
+    CHECK(caller.XAM("XamRegisterSysApp", {6, 2, 0x5678, 10}) == 1627);
+    REQUIRE(ui.FindSystemApp(2).has_value());
+    CHECK(ui.FindSystemApp(2)->module == 5);
+    CHECK(ui.FindSystemApp(2)->callback == 0x1234);
+    CHECK(caller.XAM("XamUnregisterSysApp", {6, 2, 0}) == 0);
+    CHECK(ui.FindSystemApp(2).has_value());
+    CHECK(caller.XAM("XamUnregisterSysApp", {5, 2, 0}) == 0);
+    CHECK_FALSE(ui.FindSystemApp(2).has_value());
+    CHECK(caller.XAM("XamUnregisterSysApp", {5, 2, 0}) == 1627);
+    CHECK(caller.XAM("XamShowSigninUI", {1, 0x123}) == 1627);
+    const auto id = caller.Alloc(4), data = caller.Alloc(4);
+    const auto listener = caller.XAM("XamNotifyCreateListener", {1, 0});
+    REQUIRE(listener != 0);
+    // Consume only the established startup UI pair before testing request delivery.
+    CHECK(caller.XAM("XNotifyGetNext", {listener, 9, id, data}) == 1);
+    CHECK(caller.Load32(data) == 1);
+    CHECK(caller.XAM("XNotifyGetNext", {listener, 9, id, data}) == 1);
+    CHECK(caller.Load32(data) == 0);
+    CHECK(caller.XAM("XNotifyGetNext", {listener, 9, id, data}) == 0);
+    u32 delivered = 0, delivered_buffer = 0;
+    ui.system_ui_request = [&](u32 message, u32 buffer, u32 bytes) {
+      ++delivered; delivered_buffer = buffer;
+      if (message == 0x21001) {
+        CHECK(bytes == 20);
+        CHECK(caller.Load32(buffer) == 0);
+        CHECK(caller.Load32(buffer + 4) == 255);
+        CHECK(caller.Load32(buffer + 8) == 1);
+        CHECK(caller.Load32(buffer + 12) == 0x123);
+        CHECK(caller.Load32(buffer + 16) == 0);
+      } else {
+        CHECK(message == 0x21008);
+        CHECK(bytes == 544);
+        CHECK(caller.Load32(buffer) == 3);
+        for (u32 offset = 4; offset < bytes; offset += 4) CHECK(caller.Load32(buffer + offset) == 0);
+      }
+      return 0u;
+    };
+    rex::ScopeGuard clear([&] { ui.system_ui_request = {}; });
+    CHECK(caller.XAM("XamShowSigninUI", {1, 0x123}) == 0);
+    CHECK(rex::xam::CurrentTitle().heap.QueryAllocationSize(delivered_buffer) == 0);
+    CHECK(caller.XAM("XamShowGamerCardUI", {3}) == 0);
+    CHECK(delivered == 2);
+    CHECK(caller.XAM("XNotifyGetNext", {listener, 0xA, id, data}) == 0);
+    CHECK(caller.XAM("XNotifyGetNext", {listener, 9, id, data}) == 0);
+    CHECK(rex::xam::CurrentXAM().GetUserProfile().GetSigninState() == 0);
+    ui.system_ui_request = [](u32, u32, u32) { return 0x8007000Eu; };
+    CHECK(caller.XAM("XamShowSigninUI", {1, 0}) == 14);
+    ui.system_ui_request = [](u32, u32, u32) { return 0x80004005u; };
+    CHECK(caller.XAM("XamShowSigninUI", {1, 0}) == 1627);
+    CHECK(caller.Kernel("NtClose", {listener}) == 0);
+  });
+}
