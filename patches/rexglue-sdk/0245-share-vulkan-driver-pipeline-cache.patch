+  // The default cache is internally synchronized by Vulkan, so all existing
+  // compilation workers can share driver intermediate results. Do not request
+  // EXTERNALLY_SYNCHRONIZED: that would serialize pipeline creation here.
+  const auto create_cache = reinterpret_cast<PFN_vkCreatePipelineCache>(
