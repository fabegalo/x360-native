+REX_TEST_CASE("achievement toast is idle until unlocked and queued work cannot outlive it", "[ui][hid][toast-idle]") {
+  UIApp app;
+  app.input_drivers = "none";
+  REQUIRE(app.Start());
+  auto& ui = app.GetUI();
+  rex::log::LogCaptureSink capture;
+  rex::ui::ConsoleModel console(REX_SETTINGS(), capture, {});
+  rex::ui::ConsoleDockHost host(ui);
+  rex::IAchievementRegistry* achievements = nullptr;
+  rex::ui::FrameStatsProvider stats = [] { return rex::gpu::FrameStats{}; };
+  rex::ui::ModuleOverlayContext context{{ui, REX_SETTINGS()}, console, host, capture, achievements, stats};
+  class Toast final : public rex::ui::AchievementToastDialog {
+   public:
+    using AchievementToastDialog::AchievementToastDialog;
+    std::chrono::steady_clock::time_point now{};
+    bool Draw(ImGuiIO& io) override { return DrawAt(io, now); }
+  };
+  NullRenderer renderer;
+  CHECK_FALSE(ui.HasDialogs());
+  {
+    Toast toast(context);
+    CHECK_FALSE(toast.NeedsContinuousPaint());
+    CHECK_FALSE(ui.HasDialogs());
+    rex::Achievement achievement{}; achievement.label = "First";
+    std::thread worker([&] { toast.Push(achievement); }); worker.join();
+    CHECK_FALSE(ui.HasDialogs());
+    app.Pump();
+    CHECK(ui.HasDialogs()); CHECK(toast.NeedsContinuousPaint());
+    Frames(app, ui, renderer, 1);
+    achievement.label = "Second"; toast.Push(achievement); app.Pump();
+    toast.now += std::chrono::seconds(5);
+    Frames(app, ui, renderer, 1);
+    CHECK(ui.HasDialogs()); CHECK(toast.NeedsContinuousPaint());
+    toast.now += std::chrono::seconds(5);
+    Frames(app, ui, renderer, 1);
+    CHECK_FALSE(ui.HasDialogs()); CHECK_FALSE(toast.NeedsContinuousPaint());
+    std::thread pending([&] { toast.Push(achievement); }); pending.join();
+  }
+  app.Pump();
+  CHECK_FALSE(ui.HasDialogs());
+  app.Shutdown();
+}
