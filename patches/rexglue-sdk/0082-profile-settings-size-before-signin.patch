+REX_TEST_CASE("profile setting sizing precedes account lookup for both exports", "[kernel][xam][profile-sizing]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    REQUIRE(rex::xam::CurrentXAM().GetUserProfile().GetSigninState() == 0);
+    const auto ids = c.Alloc(4), size = c.Alloc(4), buffer = c.Alloc(256);
+    c.Store32(ids, kKnownSetting);
+    const auto xuid = c.AllocQuad(0xE000000000000001ull);
+    for (const bool ex : {false, true}) {
+      for (const bool by_xuid : {false, true}) {
+        const auto call = [&](u32 output) {
+          if (ex) return c.XAM("XamUserReadProfileSettingsEx",
+              {0, 255, by_xuid ? 1u : 0u, by_xuid ? xuid : 0u, 1, ids, size, 0, output, 0});
+          return c.XAM("XamUserReadProfileSettings",
+              {0, 255, by_xuid ? 1u : 0u, by_xuid ? xuid : 0u, 1, ids, size, output, 0});
+        };
+        c.Store32(size, 0);
+        CHECK(call(0) == rex::kernel::X_ERROR_INSUFFICIENT_BUFFER);
+        CHECK(c.Load32(size) == kHeaderSize + kEntrySize);
+        c.Store32(size, kHeaderSize + kEntrySize - 1);
+        c.Store32(buffer, 0xDEADBEEF);
+        CHECK(call(buffer) == rex::kernel::X_ERROR_INSUFFICIENT_BUFFER);
+        CHECK(c.Load32(buffer) == 0xDEADBEEF);
+        c.Store32(size, 256);
+        CHECK(call(buffer) == rex::kernel::X_ERROR_NOT_LOGGED_ON);
+        CHECK(c.Load32(buffer) == 0xDEADBEEF);
+      }
+    }
+  });
+}
