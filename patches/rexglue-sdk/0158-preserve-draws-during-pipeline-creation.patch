+bool PipelineCache::AwaitPipeline(void* handle) {
+  if (!handle) {
+    return false;
+  }
+  const auto* pipeline = static_cast<const Pipeline*>(handle);
+  if (!pipeline->creation_complete.load(std::memory_order_acquire)) {
+    std::unique_lock<std::mutex> lock(creation_request_lock_);
+    pipeline_creation_done_cond_.wait(lock, [this, pipeline] {
+      return pipeline->creation_complete.load(std::memory_order_acquire) ||
+             creation_threads_shutdown_from_ == 0;
+    });
+  }
+  return pipeline->state.load(std::memory_order_acquire) != nullptr;
+}
