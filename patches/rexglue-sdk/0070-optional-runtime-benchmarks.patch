 // Initialize the counter system (zeroes everything). Safe to call multiple times.
 void Init();
+// Configure before starting workers; disabled in normal execution.
+bool IsEnabled();
+void SetEnabled(bool enabled);
+
+// Wall time summed across calls (including failures), not GPU execution time.
+class ScopedCounterTimer {
+ public:
+  ScopedCounterTimer(CounterId duration, CounterId calls)
+      : duration_(duration), calls_(calls), enabled_(IsEnabled()) {
+    if (enabled_) start_ = std::chrono::steady_clock::now();
+  }
+  ~ScopedCounterTimer() {
+    if (!enabled_) return;
+    IncrementCounter(duration_, std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now() - start_).count());
+    IncrementCounter(calls_);
+  }
+ private:
+  CounterId duration_, calls_;
+  bool enabled_;
+  std::chrono::steady_clock::time_point start_;
+};
 
