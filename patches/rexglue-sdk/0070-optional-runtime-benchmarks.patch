+#if REX_PLATFORM_WIN32
+  FILETIME created{}, exited{}, kernel{}, user{};
+  if (!GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user)) return std::nullopt;
+  const u64 ticks = ((u64{kernel.dwHighDateTime} << 32) | kernel.dwLowDateTime) +
+                    ((u64{user.dwHighDateTime} << 32) | user.dwLowDateTime);
+  return static_cast<i64>(ticks / 10);
+#else
+  const auto ticks = std::clock();
+  if (ticks == static_cast<std::clock_t>(-1)) return std::nullopt;
+  return static_cast<i64>(static_cast<f64>(ticks) * 1000000.0 / CLOCKS_PER_SEC);
+#endif
+}
 
