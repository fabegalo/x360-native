+REX_TEST_CASE("profile rename commits before profile notification and preserves identity epoch", "[kernel][xam][local-profile-session][profile-ui]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  u64 first = 0, second = 0;
+  REQUIRE(profile.CreateLocal("First", &first) == 0);
+  REQUIRE(profile.CreateLocal("Second", &second) == 0);
+  REQUIRE(profile.SetLocalSession(first) == 0);
+  const auto epoch = profile.GetStorageEpoch();
+  fixture.RunOnGuestThread([&](Caller& c) {
+    const auto listener = c.XAM("XamNotifyCreateListener", {1, 0}); REQUIRE(listener);
+    const auto id = c.Alloc(4), data = c.Alloc(4);
+    const auto put_name = [&](std::u16string_view text) {
+      const auto address = c.Alloc(static_cast<u32>((text.size() + 1) * 2));
+      for (u32 i = 0; i <= text.size(); ++i)
+        rex::memory::store_and_swap<u16>(c.GetBase() + address + i * 2, i == text.size() ? 0 : static_cast<u16>(text[i]));
+      return address;
+    };
+    CHECK(c.XAM("XamProfileRenameAccount", {first, 0x7F100000}) == 87);
+    CHECK(c.XAM("XamProfileRenameAccount", {first, put_name(u"second")}) == rex::kernel::X_ERROR_ALREADY_EXISTS);
+    REQUIRE(c.XAM("XamProfileRenameAccount", {first, put_name(u"Renamed")}) == 0);
+    CHECK(profile.GetName() == "Renamed"); CHECK(profile.GetXUID() == first);
+    CHECK(profile.GetStorageEpoch() == epoch);
+    REQUIRE(c.XAM("XNotifyGetNext", {listener, 0xE, id, data}) == 1);
+    CHECK(c.Load32(id) == 0xE); CHECK(c.Load32(data) == 1);
+    REQUIRE(c.XAM("XamProfileRenameAccount", {first, put_name(u"Renamed")}) == 0);
+    CHECK(c.XAM("XNotifyGetNext", {listener, 0xE, id, data}) == 0);
+    std::filesystem::create_directory(rex::xam::CurrentTitle().user_data_root / "profiles" / "local-v2.dat.tmp");
+    CHECK(c.XAM("XamProfileRenameAccount", {first, put_name(u"Rejected")}) == rex::kernel::X_ERROR_FUNCTION_FAILED);
+    CHECK(profile.GetName() == "Renamed"); CHECK(profile.GetStorageEpoch() == epoch);
+    CHECK(c.XAM("XNotifyGetNext", {listener, 0xE, id, data}) == 0);
+    rex::xam::UserProfile reopened;
+    REQUIRE(reopened.InitializeLocal(rex::xam::CurrentTitle().user_data_root));
+    CHECK(reopened.GetName() == "Renamed"); CHECK(reopened.GetXUID() == first);
+    CHECK(c.Kernel("NtClose", {listener}) == 0);
+  });
