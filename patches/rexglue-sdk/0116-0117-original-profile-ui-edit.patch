+u32 XamProfileRenameAccount_entry(u64 xuid, u32 address) {
+  if (!address || (address & 1)) return kernel::X_ERROR_INVALID_PARAMETER;
+  std::string name;
+  for (u32 i = 0; i < 16; ++i) {
+    const u64 at = u64{address} + i * 2;
+    if (at > UINT32_MAX || !CurrentTitle().heap.IsGuestRangeAccessible(static_cast<u32>(at), 2,
+        kernel::kMemoryProtectRead)) return kernel::X_ERROR_INVALID_PARAMETER;
+    const auto character = memory::load_and_swap<u16>(CurrentTitle().membase.TranslateVirtual(static_cast<u32>(at)));
+    if (!character) return CurrentXAM().GetUserProfile().RenameLocal(xuid, name);
+    if (i == 15 || character < 32 || character > 126) return kernel::X_ERROR_INVALID_PARAMETER;
+    name.push_back(static_cast<char>(character));
+  }
+  return kernel::X_ERROR_INVALID_PARAMETER;
 }
 
