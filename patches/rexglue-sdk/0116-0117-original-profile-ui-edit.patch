+REX_TEST_CASE("original profile UI modes retain request layout and full XUID ABI", "[kernel][xam][profile-ui]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& c) {
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    std::array<u32, 136> words{};
+    u32 address = 0, result = 0;
+    int calls = 0;
+    ui.system_ui_request = [&](u32 message, u32 packet, u32 size) {
+      ++calls; CHECK(message == 0x21008); REQUIRE(size == 544);
+      address = packet;
+      for (u32 i = 0; i < words.size(); ++i) words[i] = c.Load32(packet + i * 4);
+      return result;
+    };
+    const u64 xuid = 0xE123456789ABCDEFull;
+    REQUIRE(c.XAM("XamShowGamesUI", {2, xuid}) == 0);
+    CHECK(words[0] == 2); CHECK(words[1] == 1);
+    CHECK(words[2] == 0xE1234567); CHECK(words[3] == 0x89ABCDEF);
+    CHECK(words[4] == 0); CHECK(words[5] == 0);
+    CHECK(std::ranges::all_of(words.begin() + 6, words.end(), [](u32 v) { return v == 0; }));
+    CHECK(rex::xam::CurrentTitle().heap.QueryAllocationSize(address) == 0);
+    REQUIRE(c.XAM("XamShowAvatarAwardGamesUI", {1, xuid}) == 0); CHECK(words[1] == 6); CHECK(words[3] == 0x89ABCDEF);
+    REQUIRE(c.XAM("XamShowEditProfileUI", {0}) == 0); CHECK(words[1] == 3); CHECK(words[2] == 0); CHECK(words[3] == 0);
+    REQUIRE(c.XAM("XamShowAchievementsUI", {0, 0x12345678}) == 0); CHECK(words[1] == 2); CHECK(words[4] == 0x12345678);
+    REQUIRE(c.XAM("XamShowAchievementsUIEx", {0, 42, xuid}) == 0); CHECK(words[2] == 0xE1234567); CHECK(words[4] == 42);
+    REQUIRE(c.XAM("XamShowAchievementDetailsUI", {0, 42, 99}) == 0); CHECK(words[1] == 4); CHECK(words[5] == 99);
+    const int before = calls;
+    CHECK(c.XAM("XamShowGamesUI", {4, xuid}) == 87); CHECK(calls == before);
+    result = 0x8007000E; CHECK(c.XAM("XamShowGamesUI", {0, xuid}) == 14);
+    result = 0x80004005; CHECK(c.XAM("XamShowGamesUI", {0, xuid}) == 1627);
+    ui.system_ui_request = {};
+    CHECK(c.XAM("XamShowGamesUI", {0, xuid}) == 1627);
+  });
+}
