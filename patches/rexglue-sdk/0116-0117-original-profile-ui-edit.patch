+static u32 ShowOriginalProfile(u32 user, u32 title, u64 xuid, u32 mode, u32 achievement) {
+  if (user >= 4) return kernel::X_ERROR_INVALID_PARAMETER;
+  u32 words[544 / 4]{};
+  words[0] = user; words[1] = mode;
+  words[2] = static_cast<u32>(xuid >> 32); words[3] = static_cast<u32>(xuid);
+  words[4] = title; words[5] = achievement;
+  return DispatchProfileUi(0x21008, words, 544 / 4);
+}
