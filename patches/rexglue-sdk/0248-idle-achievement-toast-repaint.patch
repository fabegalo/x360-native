+    std::lock_guard lock(state->mutex);
+    state->queue.push_back({event, std::chrono::steady_clock::now()});
+    if (state->attached || state->wake_pending) return;
+    state->wake_pending = true;
+  }
+  // Always defer, including Push on the UI thread. This avoids attachment
+  // changes within callers' locks, coalesces bursts, and lets destruction
+  // cancel an outstanding wake without retaining a dead drawer/window.
+  app_context_.CallInUIThreadDeferred([state] {
+    AchievementToastDialog* owner;
+    {
+      std::lock_guard lock(state->mutex);
+      state->wake_pending = false;
+      owner = state->owner;
+      if (!owner || state->queue.empty()) return;
+      state->attached = true;
+    }
+    // UI lifetime and dialog-list mutations are serialized on this thread.
+    // Adding the first dialog also requests the initial presenter repaint.
+    owner->imgui_drawer()->AddDialog(owner);
+  });
