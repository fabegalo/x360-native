+    std::lock_guard lock(state_->mutex);
+    auto& queue = state_->queue;
+    while (!queue.empty()) {
+      if (!queue.front().visible_since) {
+        queue.front().visible_since = now;
       }
-      age = std::chrono::duration<float>(now - *queue_.front().visible_since).count();
-      if (age >= kDisplaySeconds) {
-        queue_.pop_front();
+      const auto elapsed = now - *queue.front().visible_since;
+      age = std::chrono::duration<float>(elapsed).count();
