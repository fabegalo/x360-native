+  // Expire on the exact clock duration. A float age of exactly 4.5 s rounds
+  // below kDisplaySeconds, which kept every expired toast for another frame.
+  constexpr auto display_duration = std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+      std::chrono::duration<double>(kDisplaySeconds));
   PendingToast toast;
