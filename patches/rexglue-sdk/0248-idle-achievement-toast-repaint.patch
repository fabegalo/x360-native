  */
 #pragma once
 
+#include <memory>
+#include <utility>
 #include <rex/system/achievement_manager.h>
 #include <rex/ui/imgui_dialog.h>
 
@@ -22,6 +24,19 @@ class AchievementNotificationDialog : public ImGuiDialog {
   // Thread-safe implementations may receive events from guest threads.
   virtual void Push(const rex::system::AchievementEvent& event) = 0;
 
+  // AchievementManager may invoke callbacks on guest threads. Acquire the
+  // dialog only on the UI thread, so a callback can never keep the last strong
+  // reference past UI teardown and destroy the dialog off-thread or after its
+  // drawer. Pending callbacks after teardown simply find an expired weak_ptr.
+  static rex::system::AchievementCallback MakeUICallback(WindowedAppContext& context,
+      std::weak_ptr<AchievementNotificationDialog> notification) {
+    return [notification = std::move(notification), context = &context](const auto& event) {
+      context->CallInUIThreadDeferred([notification, event] {
+        if (auto dialog = notification.lock()) dialog->Push(event);
+      });
+    };
+  }
+
  protected:
   explicit AchievementNotificationDialog(ImGuiDrawer* drawer) : ImGuiDialog(drawer) {}
 };
