 namespace xam {
 using namespace rex::system;
 using namespace rex::system::xam;
+
+// Original content cache callback: one process registration (zero unregisters),
+// reason 0 = added, 1 = removed; the second argument is a 512-byte item.
+// 17559: 8167CCC0, 81684E90, 81685700 and 81686790. Keep original addresses
+// out of runtime dispatch; the registered guest owns cache/UI updates.
+void XamContentRegisterChangeCallback_entry(u32 callback) {
+  REX_KERNEL_STATE()->GetKernelModule<XamModule>("xam.xex")->content_change_callback.store(callback);
+}
+
+static void NotifyContentChange(KernelState* state, uint32_t reason,
+                                const XCONTENT_AGGREGATE_DATA& data) {
+  const auto callback = state->GetKernelModule<XamModule>("xam.xex")->content_change_callback.load();
+  if (!callback) return;
+  auto* thread = XThread::GetCurrentThread(); // XAM exports and transfer workers are guest threads.
+  const auto item = state->memory()->SystemHeapAlloc(512);
+  if (!item) { REXKRNL_ERROR("Content change callback: allocation failed"); return; }
+  struct Guard {
+    memory::Memory* memory; uint32_t address;
+    ~Guard() { memory->SystemHeapFree(address); }
+  } guard{state->memory(), item};
+  auto* bytes = state->memory()->TranslateVirtual<uint8_t*>(item);
+  std::memset(bytes, 0, 512);
+  std::memcpy(bytes, &data, sizeof(data));
+  if (reason == 0) {
+    std::array<uint8_t, 36> attributes{};
+    if (state->content_manager()->GetContentAttributes(data, attributes.data()) == 0) {
+      std::memcpy(bytes + 0x148, attributes.data() + 28, 8);
+      std::memcpy(bytes + 0x150, attributes.data() + 4, 8);
+    }
+  }
+  uint64_t args[] = {reason, item};
+  state->function_dispatcher()->ExecuteTrap(thread->thread_state(), callback, args, 2);
+}
 
