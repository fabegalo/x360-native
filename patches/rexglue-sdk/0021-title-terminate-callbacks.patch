@@ -979,6 +983,33 @@ void KernelState::WaitForThreadsToExit(const std::vector<object_ref<XThread>>& t
 void KernelState::TerminateTitle() {
   REXSYS_DEBUG("KernelState::TerminateTitle");
 
+  // Dispatch while guest synchronization and graphics are still alive. The
+  // original callbacks may wait, remove themselves, or remove a pending callback.
+  // Never hold the global lock across guest code and never cancel waits first.
+  if (XThread::IsInThread()) {
+    auto* thread_state = XThread::GetCurrentThread()->thread_state();
+    for (;;) {
+      TerminateNotification notify;
+      {
+        auto global_lock = global_critical_region_.Acquire();
+        if (terminate_notifications_.empty()) break;
+        // 17559 D3D registers its prepare/shutdown pair at 6E800001/6E800000.
+        auto next = std::max_element(terminate_notifications_.begin(), terminate_notifications_.end(),
+            [](const auto& a, const auto& b) { return a.priority < b.priority; });
+        notify = *next;
+        terminate_notifications_.erase(next);
+      }
+      REXSYS_INFO("Title terminate callback {:08X}, registration={:08X}, priority={:08X}",
+                  notify.guest_routine, notify.guest_registration, notify.priority);
+      if (!function_dispatcher_->GetFunction(notify.guest_routine)) {
+        REX_FATAL("Title terminate callback {:08X} has no recompiled function", notify.guest_routine);
+      }
+      uint64_t args[] = {notify.guest_registration};
+      function_dispatcher_->ExecuteTrap(thread_state, notify.guest_routine, args, 1);
+      REXSYS_INFO("Title terminate callback {:08X} completed", notify.guest_routine);
+    }
+  }
+
   constexpr uint32_t kCooperativeExitTimeoutMs = 200;
 
   // Guest threads poll this flag in the kernel wait primitives
