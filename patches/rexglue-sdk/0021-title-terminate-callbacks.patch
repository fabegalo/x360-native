+void KernelState::RegisterTitleTerminateNotification(uint32_t registration, uint32_t routine,
+                                                     uint32_t priority) {
+  auto global_lock = global_critical_region_.Acquire();
+  // A registration, rather than its function, identifies a callback instance.
+  for (auto& notify : terminate_notifications_) {
+    if (notify.guest_registration == registration) {
+      notify = {registration, routine, priority};
+      return;
     }
   }
+  terminate_notifications_.push_back({registration, routine, priority});
+}
+
+void KernelState::RemoveTitleTerminateNotification(uint32_t registration) {
+  auto global_lock = global_critical_region_.Acquire();
+  std::erase_if(terminate_notifications_, [registration](const auto& notify) {
+    return notify.guest_registration == registration;
+  });
 }
 
