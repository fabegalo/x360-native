+
+REX_TEST_CASE("offline cloud storage capabilities never advertise a remote device", "[kernel][xam][offline-capabilities]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    for (const u32 user : {0u, 3u, 255u, 0xFFFFFFFFu}) {
+      for (const char* name : {"XamNetworkStorageHasUserEnabledStorage", "XamNetworkStorageIsEnabledInLiveHive",
+          "XamNetworkStorageIsSupportedContentType", "XamNetworkStorageIsUserInSync", "XamNetworkStorageUserHasPrivilege"})
+        CHECK(c.XAM(name, {user, 0xFFFFFFFF}) == 0);
+      CHECK(c.XAM("XamNetworkStorageShouldHideFromTitle", {user, 0xFFFFFFFF}) == 1);
+    }
+  });
+}
