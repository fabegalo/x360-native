new file mode 100644
--- /dev/null
+++ b/include/rex/chrono/frame_timing.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <cstdint>
+#include <rex/cvar.h>
+REXCVAR_DECLARE(bool, native_enhanced);
+REXCVAR_DECLARE(uint32_t, native_framerate);
+REXCVAR_DECLARE(uint32_t, native_present_rate);
+namespace rex::chrono {
+// One runtime-owned timeline across the title and GPU plugin. No clock scaling,
+// frame generation or synthetic source-frame counts are performed here.
+class FrameTiming {
+ public:
+  struct Source { uint64_t sequence, tick, wake; double interval; };
+  static bool Enhanced();
+  static void ActivateNative();
+  // Only an identity-checked title host may select a simulation/vblank cadence.
+  // 0 restores the guest video mode. This does not change VdQueryVideoMode.
+  static void SetGuestVblankRate(uint32_t hz);
+  static uint32_t GuestVblankRate();
+  static void PacePresentation();
+  static void NotifySourceFrame();
+  static Source ReadSource();
+  static void WaitSource(Source previous, uint32_t milliseconds);
+  static void WakeSourceWaiters();
+};
+}
