 REXCVAR_DEFINE_BOOL(clock_source_raw, false, "Clock", "Use raw clock source without scaling");
 
+REXCVAR_DEFINE_BOOL(native_enhanced, false, "GPU/Native", "Enable Native enhancements; original timing remains the default")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_UINT32(native_framerate, 30, "GPU/Native", "Title simulation target: 30, 60, 120, 144 or custom 30-240 FPS (requires an identified title profile)")
+    .range(30, 240).lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_UINT32(native_present_rate, 0, "GPU/Native", "Source presentation limit, independent of simulation and guest vblank (0 = uncapped)")
+    .range(0, 480).lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
 namespace rex::chrono {
+namespace {
+std::atomic<uint32_t> title_vblank_rate{0};
+std::atomic<bool> native_active{false};
+std::mutex source_mutex;
+std::condition_variable source_condition;
+FrameTiming::Source source{};
+}
+bool FrameTiming::Enhanced() { return native_active.load(std::memory_order_relaxed) && REXCVAR_GET(native_enhanced); }
+void FrameTiming::ActivateNative() { native_active.store(true, std::memory_order_relaxed); }
+void FrameTiming::SetGuestVblankRate(uint32_t hz) {
+  if (hz && (hz < 30 || hz > 480)) throw std::out_of_range("Title vblank rate must be 30-480 Hz");
+  title_vblank_rate.store(hz, std::memory_order_release);
+}
+uint32_t FrameTiming::GuestVblankRate() { return title_vblank_rate.load(std::memory_order_acquire); }
+void FrameTiming::PacePresentation() {
+  if (!Enhanced()) return;
+  const uint32_t rate = REXCVAR_GET(native_present_rate);
+  if (!rate) return;
+  using HostClock = std::chrono::steady_clock;
+  thread_local HostClock::time_point deadline{};
+  const auto period = std::chrono::duration_cast<HostClock::duration>(std::chrono::duration<double>(1.0 / rate));
+  const auto now = HostClock::now();
+  // Do not burst through missed slots following a load or a GPU stall.
+  if (deadline < now) deadline = now;
+  else std::this_thread::sleep_until(deadline);
+  deadline += period;
+}
+void FrameTiming::NotifySourceFrame() {
+  if (!Enhanced()) return;
+  const uint64_t now = Clock::QueryGuestTickCount();
+  {
+    std::lock_guard lock(source_mutex);
+    if (source.tick && now > source.tick) {
+      const double interval = double(now - source.tick);
+      source.interval = source.interval ? source.interval + (interval - source.interval) / 16.0 : interval;
+    }
+    source.tick = now;
+    ++source.sequence;
+  }
+  source_condition.notify_all();
+}
+FrameTiming::Source FrameTiming::ReadSource() { std::lock_guard lock(source_mutex); return source; }
+void FrameTiming::WaitSource(Source previous, uint32_t milliseconds) {
+  std::unique_lock lock(source_mutex);
+  source_condition.wait_for(lock, std::chrono::milliseconds(milliseconds), [&] {
+    return source.sequence != previous.sequence || source.wake != previous.wake;
+  });
+}
+void FrameTiming::WakeSourceWaiters() {
+  { std::lock_guard lock(source_mutex); ++source.wake; }
+  source_condition.notify_all();
+}
+
 
 // Time scalar applied to all time operations.
 double guest_time_scalar_ = 1.0;
