 namespace rex {
 namespace kernel {
@@ -40,7 +42,9 @@ struct TaskState {
   std::atomic<bool> completed{false};
   std::atomic<uint32_t> result{0x8000000A};
   uint32_t handle = 0;
+  bool host_system = false;
   uint32_t attributes[2] = {};
+  std::mutex attributes_mutex;
 };
 static thread_local TaskState* current_task = nullptr;
 
@@ -115,7 +119,49 @@ u32 XamTaskSchedule_entry(mapped_void callback, u32 context,
 }
 
 u32 XamTaskShouldExit_entry() { return current_task && current_task->cancelled; }
-u32 XamTaskGetCurrentTask_entry() { return current_task ? current_task->handle : 0; }
+u32 XamTaskGetCurrentTask_entry() {
+  if (!current_task) return 0;
+  auto task = LookupTask(current_task->handle);
+  if (!task) return 0;
+  // Original 17559 816B7F30 takes a reference, released by CloseHandle.
+  task->RetainHandle();
+  return task->handle();
+}
+
+// A host-dispatched synchronous system callback is a real task too. Keep its
+// lifetime bounded to the callback, without starting a worker or borrowing the
+// title's TLS. Nested dispatch restores the caller's task and cancellation state.
+uint32_t RunSystemTask(const std::function<uint32_t()>& callback) {
+  auto task = object_ref<Task>(new Task(REX_KERNEL_STATE()));
+  task->state->handle = task->handle();
+  task->state->host_system = true;
+  task->state->attributes[0] = 0x04000000;
+  struct Scope {
+    TaskState* previous;
+    Task* task;
+    ~Scope() { current_task = previous; task->ReleaseHandle(); }
+  } scope{current_task, task.get()};
+  current_task = task->state.get();
+  const auto result = callback();
+  task->state->result = result;
+  task->state->completed = true;
+  return result;
+}
+
+bool IsRuntimeTask(uint32_t handle) { return bool(LookupTask(handle)); }
+
+uint32_t CurrentSystemTask() {
+  return current_task && current_task->host_system ? uint32_t(XamTaskGetCurrentTask_entry()) : 0;
+}
+
+u32 XamTaskGetAttributes_entry(u32 handle, mapped_u32 output) {
+  auto task = LookupTask(handle);
+  if (!task || !output) return X_E_INVALIDARG;
+  std::lock_guard lock(task->state->attributes_mutex);
+  output[0] = task->state->attributes[0];
+  output[1] = task->state->attributes[1];
+  return 0;
+}
