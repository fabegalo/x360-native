+namespace rex::kernel::xam {
+// Run a synchronous host system callback with its own scoped XAM task identity.
+// Must be called on a bound guest thread; restores any enclosing task on return.
+uint32_t RunSystemTask(const std::function<uint32_t()>& callback);
+bool IsRuntimeTask(uint32_t handle);
+// Retained handle only for RunSystemTask; zero for ordinary guest task workers.
+uint32_t CurrentSystemTask();
+}
