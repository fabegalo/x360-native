+// Legacy key material is supplied locally, never embedded in this patch/payload.
+REXCVAR_DEFINE_STRING(xex_keys_file, "", "Runtime", "Local wrapping-key file; defaults to X360N_XEX_KEYS");
+static bool XexMasterKey(bool devkit, bool legacy, uint8_t* key) {
+  if (!legacy) {
+    std::memcpy(key, devkit ? xe_xex2_devkit_key : xe_xex2_retail_key, 16);
+    return true;
+  }
+  auto path = REXCVAR_GET(xex_keys_file);
+  if (path.empty()) if (const char* env = std::getenv("X360N_XEX_KEYS")) path = env;
+  std::ifstream in(std::filesystem::u8path(path));
+  if (!in) { REXLOG_ERROR("Legacy XEX key unavailable: supply --xex_keys_file or X360N_XEX_KEYS"); return false; }
+  const std::string wanted = devkit ? "xex1-devkit" : "xex1-retail";
+  std::set<std::string> seen;
+  std::array<uint8_t, 16> selected{};
+  bool found = false;
+  for (std::string line; std::getline(in, line);) {
+    if (auto comment = line.find('#'); comment != std::string::npos) line.resize(comment);
+    std::istringstream fields(line);
+    std::string name, hex, extra;
+    if (!(fields >> name)) continue;
+    if (!(fields >> hex) || (fields >> extra) || !seen.insert(name).second ||
+        (name != "xex1-retail" && name != "xex1-devkit" && name != "xex2-retail" && name != "xex2-devkit") ||
+        hex.size() != 32 || hex.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos) {
+      REXLOG_ERROR("Invalid local XEX key file (expected unique names and 32 hex digits)");
+      return false;
+    }
+    if (name == wanted) {
+      for (size_t i = 0; i < 16; ++i) selected[i] = uint8_t(std::stoul(hex.substr(2*i, 2), nullptr, 16));
+      found = true;
+    }
+  }
+  if (!found) { REXLOG_ERROR("Local XEX key file is missing {}", wanted); return false; }
+  std::copy(selected.begin(), selected.end(), key);
+  return true;
+}
 
