+class XEXSettings final : public SettingOwner {
+ public:
+  XEXSettings() : SettingOwner("xex") {}
+  REX_SETTING(std::string, keys_file, "", "Local wrapping-key overrides; defaults to X360N_XEX_KEYS",
+              kUntilLaunch, kNoSave);
+};
+
+XEXSettings& XEXOptions() {
+  static XEXSettings settings;
+  return settings;
+}
+
 const Key& MasterKey(XEXKey key) {
   return kMasterKeys[static_cast<size_t>(key)];
+}
+
+Result<Key> ResolveMasterKey(XEXKey key) {
+  if (key == XEXKey::kRetail || key == XEXKey::kDevKit) return MasterKey(key);
+  auto path = XEXOptions().keys_file.Get();
+  if (path.empty()) path = platform::GetEnvironmentValue("X360N_XEX_KEYS").value_or("");
+  if (path.empty()) return MasterKey(key);
+  std::ifstream in{string::to_path(path)};
+  if (!in) return Err<Key>(ErrorCategory::kCrypto, "Local XEX key file cannot be opened");
+  const std::string wanted = key == XEXKey::kRetailXEX1 ? "xex1-retail" : "xex1-devkit";
+  std::set<std::string> seen;
+  Key selected{};
+  bool found = false;
+  for (std::string line; std::getline(in, line);) {
+    if (const auto comment = line.find('#'); comment != std::string::npos) line.resize(comment);
+    std::istringstream fields(line);
+    std::string name, hex, extra;
+    if (!(fields >> name)) continue;
+    if (!(fields >> hex) || (fields >> extra) || !seen.insert(name).second ||
+        (name != "xex1-retail" && name != "xex1-devkit" && name != "xex2-retail" && name != "xex2-devkit") ||
+        hex.size() != 32 || hex.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos)
+      return Err<Key>(ErrorCategory::kCrypto, "Invalid local XEX key file (unique names and 32 hex digits required)");
+    if (name != wanted) continue;
+    for (size_t i = 0; i < selected.size(); ++i)
+      selected[i] = static_cast<u8>(std::stoul(hex.substr(2 * i, 2), nullptr, 16));
+    found = true;
+  }
+  if (!found) return Err<Key>(ErrorCategory::kCrypto, "Local XEX key file is missing " + wanted);
+  return selected;
 }
 
