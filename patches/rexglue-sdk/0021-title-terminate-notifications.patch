+REX_TEST_CASE("terminate callbacks can remove pending registrations and preserve unsigned priority", "[kernel][notify]") {
+  Reset();
+  std::vector<u32> expected;
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& c) {
+    auto* functions = StateOf(c.GetRuntime()).GetFunctionDispatcher();
+    const auto routine = functions->AllocateThunk(&TerminateRoutine, 0);
+    const auto removing = functions->AllocateThunk(&RemovingTerminateRoutine, 0);
+    const auto first = Registration(c, removing, 0xFFFFFFFF);
+    const auto pending = Registration(c, routine, 0x6E800001);
+    const auto last = Registration(c, routine, 0x6E800000);
+    g_remove_registration = pending;
+    c.Kernel("ExRegisterTitleTerminateNotification", {last, 1});
+    expected = {first, last};
+  });
+  StateOf(fixture.GetRuntime()).TerminateTitle();
+  std::lock_guard lock(g_mutex);
