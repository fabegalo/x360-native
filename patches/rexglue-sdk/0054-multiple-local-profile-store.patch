+    const auto xuid = read64(offset);
+    const auto state = record[offset + 8];
+    if (state > 1 || record[offset + 24]) return false;
+    const std::string name(reinterpret_cast<const char*>(record.data() + offset + 9));
+    if (!ValidLocalXuid(xuid) || !ValidLocalName(name)) return false;
