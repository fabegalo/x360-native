+
+
+REX_TEST_CASE("local account collection migrates without replacing the legacy source", "[kernel][xam][local-profile-session]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  const auto root = rex::xam::CurrentTitle().user_data_root;
+  REQUIRE(std::filesystem::equivalent(root.parent_path(), std::filesystem::temp_directory_path()));
+  REQUIRE(root.filename().string().starts_with("rexglue_kernel_fixture_"));
+  u64 first = 0, second = 0;
+  REQUIRE(profile.CreateLocal("First", &first) == 0);
+  REQUIRE(profile.SetLocalSession(first) == 0);
+  std::ifstream source(root / "profiles" / "local-v1.dat", std::ios::binary);
+  const std::string legacy(std::istreambuf_iterator<char>(source), {});
+  REQUIRE(legacy.size() == 33);
+  rex::xam::UserProfile migrated;
+  REQUIRE(migrated.InitializeLocal(root));
+  CHECK(migrated.identity().xuid == first);
+  CHECK(migrated.GetSigninState() == 1);
+  REQUIRE(migrated.CreateLocal("Second", &second) == 0);
+  CHECK(second != first);
+  CHECK(migrated.identity().xuid == first);
+  CHECK(migrated.GetSigninState() == 1);
+  CHECK(migrated.local_profiles().size() == 2);
+  u64 duplicate = 123;
+  CHECK(migrated.CreateLocal("sEcOnD", &duplicate) == rex::kernel::X_ERROR_ALREADY_EXISTS);
+  CHECK(duplicate == 0);
+  REQUIRE(migrated.SetLocalSession(second) == 0);
+  CHECK(migrated.FindLocal(first).signin_state == 0);
+  CHECK(migrated.FindLocal(second).signin_state == 1);
+  REQUIRE(profile.InitializeLocal(root));
+  CHECK(profile.identity().xuid == second);
+  CHECK(profile.GetSigninState() == 1);
+  CHECK(profile.local_profiles().size() == 2);
+  std::ifstream original(root / "profiles" / "local-v1.dat", std::ios::binary);
+  CHECK(std::string(std::istreambuf_iterator<char>(original), {}) == legacy);
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto out = caller.Alloc(4), record = caller.Alloc(392);
+    REQUIRE(caller.XAM("XamProfileCreateEnumerator", {0, out}) == 0);
+    const auto handle = caller.Load32(out);
+    for (const auto xuid : {first, second}) {
+      REQUIRE(caller.XAM("XamProfileEnumerate", {handle, 0, record, 0}) == 0);
+      CHECK(caller.Load32(record) == static_cast<u32>(xuid >> 32));
+      CHECK(caller.Load32(record + 4) == static_cast<u32>(xuid));
+      REQUIRE(caller.XAM("XamProfileFindAccount", {xuid, record + 8, 0}) == 0);
+    }
+    CHECK(caller.XAM("XamProfileEnumerate", {handle, 0, record, 0}) == rex::kernel::X_ERROR_NO_MORE_FILES);
+    CHECK(caller.Kernel("NtClose", {handle}) == 0);
+  });
+  // A failed v2 commit must leave the selected account and legacy source intact.
+  std::filesystem::create_directory(root / "profiles" / "local-v2.dat.tmp");
+  CHECK(profile.SetLocalSession(first) == rex::kernel::X_ERROR_FUNCTION_FAILED);
+  CHECK(profile.identity().xuid == second);
+  CHECK(profile.GetSigninState() == 1);
+  std::filesystem::remove(root / "profiles" / "local-v2.dat.tmp");
+  std::ofstream(root / "profiles" / "local-v2.dat", std::ios::binary | std::ios::trunc) << "invalid v2";
+  CHECK_FALSE(profile.InitializeLocal(root));
+  CHECK(profile.identity().xuid == 0);
+  CHECK(profile.local_profiles().empty());
+  CHECK(profile.CreateLocal("Third") == rex::kernel::X_ERROR_FUNCTION_FAILED);
+  std::ifstream corrupt(root / "profiles" / "local-v2.dat", std::ios::binary);
+  CHECK(std::string(std::istreambuf_iterator<char>(corrupt), {}) == "invalid v2");
+}
