+void KeystrokeSynth::Observe(const rex::hid::PadState& state, u32 now_ms) {
+  const u64 current = static_cast<u64>(state.buttons) | AnalogToKeyfield(state);
+  const u64 changed = current ^ held_;
+  for (bool release : {true, false}) {
+    for (u32 i = 0; i < kKeyForBit.size(); ++i) {
+      const u64 bit = u64{1} << i;
+      if (!(changed & bit) || kKeyForBit[i] == VirtualKey::kNone) continue;
+      const bool pressed = (current & bit) != 0;
+      if (release == pressed) continue;
+      if (pending_.size() == 256) pending_.pop_front();
+      pending_.push_back(MakeKeystroke(kKeyForBit[i], pressed ? kKeystrokeKeyDown : kKeystrokeKeyUp));
+      if (pressed) {
+        repeat_ = Repeat::kWaiting;
+        repeat_index_ = i;
+        repeat_time_ = now_ms;
+      } else if (repeat_index_ == i) {
+        repeat_ = Repeat::kIdle;
+      }
+    }
+  }
+  held_ = current;
+}
