+REX_TEST_CASE("MNK taps and modifier changes keep ordered edges between guest polls", "[hid][mnk-transitions]") {
+  rex::test_ui::UIApp app;
+  app.input_drivers = "none";
+  REQUIRE(app.Start());
+  auto& input = app.GetInput();
+  REQUIRE(input.GetSettings().mnk_mode.Set(true));
+  REQUIRE(REX_SETTINGS().SetText(rex::SettingLayer::kTitle, "hid.keybind_a", "G,H"));
+  REQUIRE(REX_SETTINGS().SetText(rex::SettingLayer::kTitle, "hid.keybind_b", "Shift+G"));
+  auto event = [&](bool down, rex::VirtualKey key) {
+    rex::test_ui::DeliverKey(down ? rex::InputEvent::Type::kKeyDown : rex::InputEvent::Type::kKeyUp, key);
+  };
+  event(true, rex::VirtualKey::kG);
+  event(true, rex::VirtualKey::kShift);
+  event(false, rex::VirtualKey::kShift);
+  event(false, rex::VirtualKey::kG);
+  app.Pump();
+  CHECK(input.GetState(0)->state.buttons == 0);
+  CHECK_FALSE(input.GetKeystroke(0, rex::hid::KeystrokeSource::kKeyboard));
+  const std::pair<rex::VirtualKey, rex::u16> expected[] = {
+    {rex::VirtualKey::kXInputPadA, 1}, {rex::VirtualKey::kXInputPadA, 2},
+    {rex::VirtualKey::kXInputPadB, 1}, {rex::VirtualKey::kXInputPadB, 2},
+    {rex::VirtualKey::kXInputPadA, 1}, {rex::VirtualKey::kXInputPadA, 2}};
+  for (const auto& [key, flags] : expected) {
+    auto stroke = input.GetKeystroke(0, rex::hid::KeystrokeSource::kPad);
+    REQUIRE(stroke);
+    CHECK(stroke->virtual_key == static_cast<rex::u16>(key));
+    CHECK(stroke->flags == flags);
+  }
+  CHECK_FALSE(input.GetKeystroke(0, kAllSources));
+  // Alternate bindings hold a single logical button until the last key is released.
+  event(true, rex::VirtualKey::kG); event(true, rex::VirtualKey::kH);
+  event(false, rex::VirtualKey::kG); event(false, rex::VirtualKey::kH);
+  app.Pump();
+  auto down = input.GetKeystroke(0, rex::hid::KeystrokeSource::kPad);
+  auto up = input.GetKeystroke(0, rex::hid::KeystrokeSource::kPad);
+  REQUIRE(down); REQUIRE(up);
+  CHECK(down->virtual_key == static_cast<rex::u16>(rex::VirtualKey::kXInputPadA));
+  CHECK(down->flags == 1); CHECK(up->flags == 2);
+  CHECK_FALSE(input.GetKeystroke(0, kAllSources));
+  app.Shutdown();
+}
