+// Recognize the complete console CRT jump-buffer ABI, not a short prolog.
+// Every FPR/GPR/VMX slot, CR/LR/SP transfer and terminal instruction must match.
+// Only linked branch displacements and optional dispatch-global operands vary.
+void detectNonlocalJumps(CodegenContext& ctx) {
+  const auto makePattern = [](bool save) {
+    std::vector<uint32_t> words;
+    if (save) words = {0x7C0802A6, 0x7C800026};
+    else words = {0x7C0802A6, 0x9421FFB0, 0x90010008, 0x7C862378, 0x2C040000,
+        0x80030138, 0x2C800000, 0x7C671B78, 0x38A00000, 0x40820008, 0x38C00001,
+        0x408602C0, 0x80670134, 0x80870090, 0x48000001};
+    const uint32_t base = save ? 3 : 7;
+    for (uint32_t reg = 14; reg <= 31; ++reg)
+      words.push_back(((save ? 54u : 50u) << 26) | (reg << 21) |
+                      (base << 16) | ((reg - 14) * 8));
+    for (uint32_t reg = 13; reg <= 31; ++reg)
+      words.push_back(((save ? 62u : 58u) << 26) | (reg << 21) |
+                      (base << 16) | (0x98 + (reg - 13) * 8));
+    for (uint32_t reg = 64; reg <= 127; ++reg) {
+      words.push_back((save ? 0x38A00000 : 0x38600000) | (0x140 + (reg - 64) * 16));
+      words.push_back((save ? 0x10051D0B : 0x100338CB) |
+                      ((reg & 31) << 21) | ((reg & 32) >> 3));
+    }
+    if (save) words.insert(words.end(), {0x90030134, 0x90830130, 0xF8230090,
+        0x38000000, 0x90030138, 0x38600000, 0x4E800020});
+    else words.insert(words.end(), {0x80A70134, 0x80870130, 0x7CA803A6, 0xE8270090,
+        0x7C8FF120, 0x7CC33378, 0x4E800020, 0x80670004, 0x80870000, 0x48000001,
+        0x80670000, 0x80870004, 0x48000001, 0x80010008, 0x7C0803A6, 0x38210050,
+        0x4E800020});
+    return words;
+  };
+  const auto savePattern = makePattern(true);
+  const auto restorePattern = makePattern(false);
+  const auto& binary = ctx.binary();
+  const uint64_t imageEnd = uint64_t(binary.baseAddress()) + binary.imageSize();
+  for (const auto& section : binary.sections()) {
+    if (!section.executable || !section.data || section.baseAddress >= imageEnd) continue;
+    const uint64_t limit = std::min<uint64_t>(section.size, imageEnd - section.baseAddress);
+    const auto read = [&](uint64_t offset) { return load_and_swap<uint32_t>(section.data + offset); };
+    const auto matches = [&](uint64_t offset, const std::vector<uint32_t>& pattern) {
+      if (offset > limit || pattern.size() * 4 > limit - offset) return false;
+      for (size_t word = 0; word < pattern.size(); ++word) {
+        const uint32_t actual = read(offset + word * 4);
+        if (pattern[word] == 0x48000001) {
+          if ((actual & 0xFC000003) != 0x48000001) return false;
+        } else if (actual != pattern[word]) return false;
+      }
+      return true;
+    };
+    for (uint64_t offset = (4 - (section.baseAddress & 3)) & 3; offset + 4 <= limit; offset += 4) {
+      bool prefix = false;
+      if (offset + 20 <= limit && (read(offset) & 0xFFFF0000) == 0x3C800000 &&
+          (read(offset + 4) & 0xFFFF0000) == 0x80040000 && read(offset + 8) == 0x2C000000 &&
+          read(offset + 12) == 0x7C0903A6 && read(offset + 16) == 0x4C820420) prefix = true;
+      if (!prefix && read(offset) != 0x7C0802A6) continue;
+      const bool save = matches(offset + (prefix ? 20 : 0), savePattern);
+      const bool restore = !prefix && matches(offset, restorePattern);
+      if (!save && !restore) continue;
+      const uint32_t address = uint32_t(section.baseAddress + offset);
+      const uint32_t size = uint32_t((save ? savePattern.size() : restorePattern.size()) * 4 + (prefix ? 20 : 0));
+      auto& entries = save ? ctx.analysisState().setJmpAddresses : ctx.analysisState().longJmpAddresses;
+      entries.insert(address);
+      ctx.graph.addFunction(address, size, FunctionAuthority::HELPER, true);
+      REXCODEGEN_DEBUG("Found CRT {} at 0x{:08X}", save ? "setjmp" : "longjmp", address);
+      offset += size - 4;
+    }
+  }
+}
