+REX_TEST_CASE("user preferences use the original XGI bit-mask contract and complete failures", "[kernel][xam][user-preferences]") {
+  SignedInProfileFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+    auto value = std::make_unique<rex::xam::UserProfile::Int32Setting>(0x10040053, 0x3FF);
+    profile.AddSetting(std::move(value));
+    const auto output = c.Alloc(8), request = c.Alloc(12), overlap = c.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    c.Store32(output + 4, 0xDEADBEEF);
+    for (const u32 preference : {1u, 6u, 24u, 32u, 64u, 128u, 256u, 512u}) {
+      const u32 enabled = preference == 6 ? 4 : preference == 24 ? 16 : 0;
+      CHECK(c.XAM("XamUserReadUserPreference", {0, preference, output, 0}) == 0);
+      CHECK(c.Load32(output) == (preference & ~enabled));
+      CHECK(c.Load32(output + 4) == 0xDEADBEEF);
+    }
+    auto unset = std::make_unique<rex::xam::UserProfile::Int32Setting>(0x10040053, 123);
+    unset->is_set = false;
+    profile.AddSetting(std::move(unset));
+    c.Store32(request, 0); c.Store32(request + 4, 6); c.Store32(request + 8, output);
+    CHECK(c.XAM("XMsgInProcessCall", {0xFB, 0xB0082, request, 12}) == 1);
+    CHECK(c.Load32(output) == 0);
+    c.Store32(output, 0xCAFEBABE);
+    CHECK(c.XAM("XamUserReadUserPreference", {0, 0xFFFF, output, 0}) == rex::kernel::X_ERROR_FUNCTION_FAILED);
+    CHECK(c.Load32(output) == 0xCAFEBABE);
+    CHECK(c.XAM("XamUserReadUserPreference", {0, 0xFFFF, output, overlap}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(c.Load32(overlap) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    CHECK(c.XAM("XamUserReadUserPreference", {1, 1, output, 0}) == rex::kernel::X_ERROR_FUNCTION_FAILED);
+    CHECK(c.XAM("XamUserReadUserPreference", {4, 1, output, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(c.XAM("XamUserReadUserPreference", {0, 1, 0x7F100000, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(c.XAM("XamUserReadUserPreference", {0, 1, output, 0xFFFFFFF0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(c.XAM("XMsgInProcessCall", {0xFB, 0xB0082, request, 8}) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    {
+      auto lock = profile.LockSettings();
+      profile.GetSetting(0x10040053)->load_failed = true;
+    }
+    CHECK(c.XAM("XamUserReadUserPreference", {0, 1, output, 0}) == rex::kernel::X_ERROR_FUNCTION_FAILED);
+    CHECK(c.Load32(output) == 0xCAFEBABE);
+  });
