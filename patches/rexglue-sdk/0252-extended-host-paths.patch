 REX_TEST_CASE("Bytes of a multi byte character pass through unchanged", "[base][paths]") {
   CHECK(rex::platform::SanitizeFolderName("caf\xc3\xa9") == "caf\xc3\xa9");
 }
+
+REX_TEST_CASE("host path conversion preserves spelling and Unicode long-path file and log IO", "[host-paths][long-host-path]") {
+  using rex::platform::HostPath;
+  using rex::platform::OrdinaryPath;
+  CHECK(HostPath({}).empty());
+  CHECK(OrdinaryPath({}).empty());
+  const rex::test::TempFolder folder("rex_long_host_path_");
+  auto deep = folder.path;
+  for (unsigned i = 0; i < 7; ++i) deep /= std::string(48, 'a' + i);
+  const auto host = HostPath(deep);
+  rex::ScopeGuard cleanup([&] { std::error_code error; std::filesystem::remove_all(HostPath(folder.path), error); CHECK_FALSE(error); });
+  CHECK(HostPath(host) == host);
+#if REX_PLATFORM_WIN32
+  CHECK(host.native().starts_with(L"\\\\?\\"));
+  CHECK(OrdinaryPath(host) == std::filesystem::absolute(deep).lexically_normal());
+  CHECK(OrdinaryPath(HostPath(L"\\\\server\\share\\folder")) == L"\\\\server\\share\\folder");
+#else
+  CHECK(host == deep);
+  CHECK(OrdinaryPath(host) == host);
+#endif
+  REQUIRE(std::filesystem::create_directories(host));
+  const auto ordinary_file = deep / std::filesystem::path(std::u16string(u"perfil-\u00e7.dat"));
+  auto* file = rex::platform::OpenFile(ordinary_file, "wb");
+  REQUIRE(file != nullptr);
+  CHECK(std::fwrite("bytes", 1, 5, file) == 5);
+  CHECK(std::fclose(file) == 0);
+  file = rex::platform::OpenFile(ordinary_file, "rb");
+  REQUIRE(file != nullptr);
+  char bytes[5]{}; CHECK(std::fread(bytes, 1, 5, file) == 5);
+  CHECK(std::fclose(file) == 0); CHECK(std::string_view(bytes, 5) == "bytes");
+  const auto log = deep / "logs" / "runtime.log";
+  auto sink = rex::log::LogFileSink::Open(log, {});
+  REQUIRE(sink);
+  sink->reset();
+  CHECK(std::filesystem::is_regular_file(HostPath(log)));
+}
