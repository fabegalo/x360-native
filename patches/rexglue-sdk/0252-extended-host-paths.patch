 namespace rex::platform {
 
+std::filesystem::path HostPath(const std::filesystem::path& path) {
+#ifdef _WIN32
+  if (path.empty()) return path;
+  std::error_code ec;
+  // Normalize components before the prefix disables Win32 normalization.
+  const auto name =
+      std::filesystem::absolute(path, ec).lexically_normal().make_preferred().native();
+  if (ec) return path;
+  if (name.starts_with(L"\\\\?\\") || name.starts_with(L"\\\\.\\")) return name;
+  return name.starts_with(L"\\\\") ? L"\\\\?\\UNC\\" + name.substr(2) : L"\\\\?\\" + name;
+#else
+  return path;
+#endif
+}
+
+std::filesystem::path OrdinaryPath(const std::filesystem::path& path) {
+#ifdef _WIN32
+  const auto& name = path.native();
+  if (name.starts_with(L"\\\\?\\UNC\\")) return L"\\\\" + name.substr(8);
+  if (name.starts_with(L"\\\\?\\") && name.size() > 5 && name[5] == L':') return name.substr(4);
+#endif
+  return path;
+}
+
+
+
 std::FILE* OpenFile(const std::filesystem::path& path, const char* mode) {
   if (!mode || !*mode) { errno = EINVAL; return nullptr; }
 #if REX_PLATFORM_WIN32
   std::FILE* file = nullptr;
   const std::wstring wide_mode(mode, mode + std::strlen(mode));
-  _wfopen_s(&file, path.c_str(), wide_mode.c_str());
+  _wfopen_s(&file, HostPath(path).c_str(), wide_mode.c_str());
   return file;
 #else
   return std::fopen(path.c_str(), mode);
