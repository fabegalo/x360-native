+namespace {
+// Retail 17559 0x26C/0x26D (816EEB68/816EEB70 -> 816EEA78) build FE/2000C:
+// optional owner XUID (r3) and destination device (r4) pointers, a 512-byte
+// item whose first 0x148 bytes are XCONTENT_AGGREGATE_DATA, a progress
+// callback (r6) and its context (r7), an extra argument (r8) and OVERLAPPED
+// (r9); copy=0, move=1. Both pointers absent is ERROR_INVALID_PARAMETER.
+// The dashboard (922FF840-922FF8B4) passes a CopyProgressRoutine-style
+// callback (922FDB00): r3/r4 total/transferred, r8 reason (1 = start), the
+// context as ninth argument; nonzero cancels. XAM's FE/2000C handler itself
+// was not traced: a conflict never overwrites (183), space is checked first
+// (112) and a cancellation completes with ERROR_CANCELLED (1223).
+uint32_t ContentTransfer(PPCContext& ctx, uint8_t* base, bool move) {
+  using namespace rex;
+  using namespace rex::system;
+  using namespace rex::system::xam;
+  const uint32_t xuid_ptr = ctx.r3.u32, device_ptr = ctx.r4.u32, item = ctx.r5.u32;
+  const uint32_t callback = ctx.r6.u32, context = ctx.r7.u32, overlapped = ctx.r9.u32;
+  if ((!xuid_ptr && !device_ptr) || !item) return 87;
+  auto* kernel = REX_KERNEL_STATE();
+  XCONTENT_AGGREGATE_DATA source;
+  std::memcpy(&source, base + item, sizeof(source));
+  const uint64_t user = kernel->user_profile()->xuid();
+  const uint64_t owner = xuid_ptr ? memory::load_and_swap<uint64_t>(base + xuid_ptr) : 0;
+  const uint32_t device = device_ptr ? memory::load_and_swap<uint32_t>(base + device_ptr)
+                                     : uint32_t(source.device_id);
+  auto run = [kernel, source, user, owner, device, move, callback, context]() -> uint32_t {
+    ContentManager::TransferProgress progress;
+    if (callback) {
+      progress = [kernel, callback, context, quiet = false](uint64_t done, uint64_t total,
+                                                            bool first) mutable {
+        if (quiet) return true;
+        uint64_t args[] = {total, done, total, done, 1, first ? 1u : 0u, 0, 0, context};
+        const auto reply = uint32_t(kernel->function_dispatcher()->Execute(
+            XThread::GetCurrentThread()->thread_state(), callback, args, 9));
+        quiet = reply == 3;               // PROGRESS_QUIET: no more calls
+        return reply == 0 || reply == 3;  // PROGRESS_CANCEL/STOP end the transfer
+      };
+    }
+    const auto result = kernel->content_manager()->TransferContent(user, source, device, owner,
+                                                                   move, progress);
+    REXKRNL_INFO("Content {} {:08X}/{:08X} device {} -> {}: {}", move ? "move" : "copy",
+                 uint32_t(source.title_id), static_cast<uint32_t>(XContentType(source.content_type)),
+                 uint32_t(source.device_id), device, result);
+    return result;
+  };
+  if (!overlapped) return run();
+  auto* io = kernel->memory()->TranslateVirtual(overlapped);
+  XOverlappedSetResult(io, X_ERROR_IO_PENDING);
+  XOverlappedSetContext(io, XThread::GetCurrentThreadHandle());
+  // A transfer can take minutes: never on the shared deferred-completion queue.
+  auto worker = object_ref<XHostThread>(new XHostThread(kernel, 256 * 1024, 0,
+      [kernel, run, overlapped]() {
+        const auto result = run();
+        kernel->CompleteOverlappedEx(overlapped, result, X_HRESULT_FROM_WIN32(result), 0);
+        return 0;
+      }));
+  if (worker->Create() != X_STATUS_SUCCESS) {
+    kernel->CompleteOverlappedEx(overlapped, X_ERROR_FUNCTION_FAILED,
+                                 X_HRESULT_FROM_WIN32(X_ERROR_FUNCTION_FAILED), 0);
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  return X_ERROR_IO_PENDING;
+}
+}  // namespace
