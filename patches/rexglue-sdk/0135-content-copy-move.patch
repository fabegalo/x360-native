@@ -773,6 +776,158 @@ X_RESULT ContentManager::DeleteContent(uint64_t xuid, const XCONTENT_AGGREGATE_D
   return X_ERROR_FILE_NOT_FOUND;
 } catch (const std::filesystem::filesystem_error&) { return X_ERROR_ACCESS_DENIED; }
 
+// Staging directories of transfers in progress. With none active, a leftover
+// one comes from an interrupted process and is removed before the next copy.
+static std::atomic<int> active_transfers_{0};
+static std::atomic<uint64_t> transfer_sequence_{0};
+static constexpr const char* kTransferStagingDirName = ".x360n-transfer";
+
+X_RESULT ContentManager::TransferContent(uint64_t xuid, const XCONTENT_AGGREGATE_DATA& source,
+                                         uint32_t destination_device, uint64_t destination_xuid,
+                                         bool move, const TransferProgress& progress) try {
+  namespace fs = std::filesystem;
+  constexpr X_RESULT kDiskFull = X_RESULT_FROM_WIN32(112);
+  std::error_code ec;
+  const uint64_t owner =
+      (source.xuid != uint64_t(-1) && source.xuid != 0) ? uint64_t(source.xuid) : xuid;
+  XCONTENT_AGGREGATE_DATA destination = source;
+  destination.device_id = destination_device;
+  destination.xuid = destination_xuid ? destination_xuid : owner;
+  auto device = GetDevice(destination_device);
+  if (!device) return X_ERROR_DEVICE_NOT_CONNECTED;
+  if (device->device_type == DeviceType::ODD) return X_ERROR_ACCESS_DENIED;
+  if (source.title_id == kCurrentlyRunningTitleId) return X_ERROR_INVALID_PARAMETER;
+  fs::path source_path, source_header, destination_path, destination_header;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    if (move && IsContentOpen(source)) return X_ERROR_ACCESS_DENIED;  // as DeleteContent
+    source_path = ResolvePackagePath(xuid, source);
+    source_header = ResolvePackageHeaderPath(source.file_name(), owner, source.title_id,
+                                             source.content_type, source.device_id);
+    destination_path = ResolvePackagePath(destination.xuid, destination);
+    destination_header = ResolvePackageHeaderPath(destination.file_name(), destination.xuid,
+                                                  destination.title_id, destination.content_type,
+                                                  destination_device);
+  }
+  if (!fs::is_directory(source_path, ec)) return X_ERROR_FILE_NOT_FOUND;
+  // Never overwrite: the same item already at the destination is a conflict.
+  if (fs::exists(destination_path, ec) || fs::exists(destination_header, ec))
+    return X_ERROR_ALREADY_EXISTS;
+
+  std::vector<std::pair<fs::path, uint64_t>> files;
+  std::vector<fs::path> directories;
+  uint64_t total = 0;
+  for (fs::recursive_directory_iterator it(source_path, ec), end; !ec && it != end; it.increment(ec)) {
+    if (!IsUnlinkedStoragePath(it->path())) return X_ERROR_ACCESS_DENIED;
+    const auto relative = it->path().lexically_relative(source_path);
+    if (it->is_directory(ec)) { directories.push_back(relative); continue; }
+    if (!it->is_regular_file(ec)) return X_ERROR_ACCESS_DENIED;
+    const auto size = it->file_size(ec);
+    if (ec || size > UINT64_MAX - total) return X_ERROR_ACCESS_DENIED;
+    files.emplace_back(relative, size);
+    total += size;
+  }
+  if (ec) return X_ERROR_ACCESS_DENIED;
+  std::vector<uint8_t> header;
+  if (fs::exists(source_header, ec)) {
+    auto file = rex::filesystem::OpenFile(source_header, "rb");
+    if (!file) return X_ERROR_ACCESS_DENIED;
+    header.resize(size_t(fs::file_size(source_header, ec)));
+    const bool read = !ec && fread(header.data(), 1, header.size(), file) == header.size();
+    fclose(file);
+    if (!read) return X_ERROR_ACCESS_DENIED;
+  }
+  if (header.size() < sizeof(destination)) header.resize(sizeof(destination));
+  std::memcpy(header.data(), &destination, sizeof(destination));
+  total += header.size();
+  {
+    auto snapshot = *device;
+    if (const auto queried = QueryContentDeviceSpace(snapshot)) return queried;
+    if (total > snapshot.free_bytes) return kDiskFull;
+  }
+
+  const auto staging_root = DeviceRoot(destination_device) / kTransferStagingDirName;
+  if (active_transfers_.fetch_add(1) == 0) fs::remove_all(staging_root, ec);
+  struct Active { ~Active() { active_transfers_.fetch_sub(1); } } active;
+  const auto staging = staging_root / fmt::format(
+      "{:016X}-{:08X}", uint64_t(std::chrono::steady_clock::now().time_since_epoch().count()),
+      uint32_t(transfer_sequence_.fetch_add(1)));
+  struct Cleanup {
+    fs::path root, path;
+    ~Cleanup() {
+      std::error_code e;
+      fs::remove_all(path, e);
+      fs::remove(root, e);  // only when no other transfer still stages there
+    }
+  } cleanup{staging_root, staging};
+  const auto staged_package = staging / "package";
+  const auto staged_header = staging / "header";
+  if (!fs::create_directories(staged_package, ec) || !IsUnlinkedStoragePath(staged_package))
+    return X_ERROR_ACCESS_DENIED;
+  for (const auto& dir : directories) {
+    fs::create_directories(staged_package / dir, ec);
+    if (ec) return X_ERROR_ACCESS_DENIED;
+  }
+  uint64_t done = 0;
+  if (progress && !progress(0, total, true)) return X_ERROR_CANCELLED;
+  std::vector<uint8_t> buffer(1024 * 1024);
+  for (const auto& [relative, size] : files) {
+    auto in = rex::filesystem::OpenFile(source_path / relative, "rb");
+    if (!in) return X_ERROR_ACCESS_DENIED;
+    auto out = rex::filesystem::OpenFile(staged_package / relative, "wb");
+    if (!out) { fclose(in); return X_ERROR_ACCESS_DENIED; }
+    bool ok = true, cancelled = false;
+    for (uint64_t left = size; ok && left;) {
+      const size_t chunk = size_t(std::min<uint64_t>(left, buffer.size()));
+      ok = fread(buffer.data(), 1, chunk, in) == chunk && fwrite(buffer.data(), 1, chunk, out) == chunk;
+      left -= chunk;
+      done += chunk;
+      if (ok && progress && !progress(done, total, false)) { cancelled = true; break; }
+    }
+    fclose(in);
+    if (fclose(out)) ok = false;
+    if (cancelled) return X_ERROR_CANCELLED;
+    if (!ok) return X_ERROR_ACCESS_DENIED;
+  }
+  {
+    auto out = rex::filesystem::OpenFile(staged_header, "wb");
+    if (!out) return X_ERROR_ACCESS_DENIED;
+    const bool written = fwrite(header.data(), 1, header.size(), out) == header.size();
+    if (fclose(out) || !written) return X_ERROR_ACCESS_DENIED;
+    done += header.size();
+    if (progress && !progress(done, total, false)) return X_ERROR_CANCELLED;
+  }
+
+  auto global_lock = global_critical_region_.Acquire();
+  if (fs::exists(destination_path, ec) || fs::exists(destination_header, ec))
+    return X_ERROR_ALREADY_EXISTS;
+  if (move && IsContentOpen(source)) return X_ERROR_ACCESS_DENIED;
+  fs::create_directories(destination_path.parent_path(), ec);
+  fs::create_directories(destination_header.parent_path(), ec);
+  if (!IsUnlinkedStoragePath(destination_path.parent_path()) ||
+      !IsUnlinkedStoragePath(destination_header.parent_path()))
+    return X_ERROR_ACCESS_DENIED;
+  fs::rename(staged_package, destination_path, ec);
+  if (ec) return X_ERROR_ACCESS_DENIED;
+  fs::rename(staged_header, destination_header, ec);
+  if (ec) {
+    std::error_code e;
+    fs::remove_all(destination_path, e);
+    return X_ERROR_ACCESS_DENIED;
+  }
+  if (move) {
+    const auto deleted = DeleteContent(xuid, source);
+    if (deleted != X_ERROR_SUCCESS) {
+      // Keep exactly one copy: the source stays, the new destination goes.
+      std::error_code e;
+      fs::remove_all(destination_path, e);
+      fs::remove(destination_header, e);
+      return deleted;
+    }
+  }
+  return X_ERROR_SUCCESS;
+} catch (const std::filesystem::filesystem_error&) { return X_ERROR_ACCESS_DENIED; }
+
 X_RESULT ContentManager::UnmountContent(uint64_t xuid, const XCONTENT_AGGREGATE_DATA& data) {
   ContentPackage* package = nullptr;
   {
