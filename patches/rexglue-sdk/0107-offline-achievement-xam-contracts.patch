-X_HRESULT xeXMsgStartIORequestEx(uint32_t app, uint32_t message, uint32_t overlapped_ptr,
-                                 uint32_t buffer_ptr, uint32_t buffer_length,
-                                 XMSGSTARTIOREQUEST_UNKNOWNARG* unknown);  // xam_msg.cpp
