+static uint32_t ReadOfflineAchievementImage(uint32_t tile_type, uint32_t title_id,
+                                           uint64_t tile_id, uint32_t user_index,
+                                           std::vector<uint8_t>& image) {
+  // XTILETYPE_ACHIEVEMENT = 0, XTILETYPE_GAME_ICON = 1. Profile pictures
+  // have separate namespaces and must never resolve against a game's XDBF.
+  if (tile_type > 1) return X_ERROR_NOT_FOUND;
+  if (tile_id > UINT32_MAX || user_index >= 4) return X_ERROR_INVALID_PARAMETER;
+  auto* ks = REX_KERNEL_STATE();
+  if (user_index != 0 || !ks->user_profile()->signin_state()) return X_ERROR_NO_SUCH_USER;
+  if (!title_id && !ks->GetExecutableModule()) return X_ERROR_INVALID_PARAMETER;
+  return OfflineAchievementError(ks->offline_achievements().GetImage(
+      title_id ? title_id : ks->title_id(), static_cast<uint32_t>(tile_id), image));
+}
