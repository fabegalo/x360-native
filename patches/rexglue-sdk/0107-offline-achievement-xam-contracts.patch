+struct XMSGSTARTIOREQUEST_UNKNOWNARG;
+X_HRESULT xeXMsgStartIORequestEx(uint32_t app, uint32_t message, uint32_t overlapped_ptr,
+                                 uint32_t buffer_ptr, uint32_t buffer_length,
+                                 XMSGSTARTIOREQUEST_UNKNOWNARG* unknown);  // xam_msg.cpp
+
+// Wrapper as in xam.xex 2.0.17559.0 (export 0x4F7 at 0x816B1F68): the read itself
+// is XGI app (0xFB) message 0x000B0082 with {user_index, preference, buffer}.
+// The XGI handler for that message is not implemented here; its failure reaches
+// the caller (and the OVERLAPPED) instead of a residual r3 and no completion.
+u32 XamUserReadUserPreference_entry(u32 user_index, u32 preference, u32 buffer_ptr,
+                                    u32 overlapped_ptr) {
+  if (user_index >= 4 || !buffer_ptr) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+  auto* memory = REX_KERNEL_MEMORY();
+  const uint32_t block_ptr = memory->SystemHeapAlloc(12);
+  if (!block_ptr) {
+    REXKRNL_ERROR("XamUserReadUserPreference: no guest memory for the XGI message");
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  auto* block = memory->TranslateVirtual<be<uint32_t>*>(block_ptr);
+  block[0] = user_index;
+  block[1] = preference;
+  block[2] = buffer_ptr;
+  // The dispatch is synchronous here, so the block can be freed on return.
+  const X_HRESULT result =
+      xeXMsgStartIORequestEx(0xFB, 0x000B0082, overlapped_ptr, block_ptr, 12, nullptr);
+  memory->SystemHeapFree(block_ptr);
+  if (result == static_cast<X_HRESULT>(0x80070001)) {
+    return 259;
+  }
+  if (result == X_ERROR_IO_PENDING || result == X_HRESULT_FROM_WIN32(X_ERROR_IO_PENDING)) {
+    return X_ERROR_IO_PENDING;
+  }
+  return static_cast<int32_t>(result) < 0 ? X_ERROR_FUNCTION_FAILED : X_ERROR_SUCCESS;
+}
