-// 17559: 8199C630 expands four XUIDs into 392-byte entries before LogonEx.
-// 8199EEC0 replaces the slot array for flags=0 (zero XUID signs that slot out).
-// Original Sign-in 17559 (901186BC-90118720) uses 0x120420 for its
-// replacement confirmation and 0x120424 for merge confirmation. The closing
-// snapshot uses Logon(0x63) with four XUIDs. CreateProfile 17559 uses
-// Logon(0x24) to select the newly persisted local identity. Live and additional slots remain
-// unsupported; all supported modes go through the persistent local store.
-static uint32_t LocalLogon(mapped_void users, uint32_t flags, uint32_t overlapped,
-                           uint32_t stride) {
-  REXKRNL_INFO("LocalLogon request flags={:08X} stride={} overlap={:08X}", flags, stride, overlapped);
-  if (!users) return uint32_t(X_E_INVALIDARG);
-  const bool remove = stride == 8 && flags == 0x28;
-  const bool append = stride == 392 && flags == 0x120424;
-  // The older XUID-array ABI is used by original Retail 1888 Sign-in:
-  // 90103550 submits its closing snapshot (0x23), 90105FE8/90106064 its
-  // offline confirmation (0x420/0x424). Online variants remain unsupported.
-  const bool local_array = stride == 8 && (flags == 0x23 || flags == 0x420 || flags == 0x424);
-  if (flags && !(stride == 392 && (flags == 0x120420 || append)) &&
-      !local_array && !(stride == 8 && (flags == 0x63 || flags == 0x24 || remove))) return 0x80004001u;
-  auto* bytes = users.as<uint8_t*>();
-  for (unsigned i = 1; i < 4; ++i) {
-    if (rex::memory::load_and_swap<uint64_t>(bytes + i * stride))
-      return 0x80004001u; // E_NOTIMPL: never partially apply a multi-user request.
-  }
-  const auto xuid = rex::memory::load_and_swap<uint64_t>(bytes);
-  if (flags == 0x120420 || append) {
-    // This path must select an existing local identity, never ingest account
-    // data supplied by the caller or silently enable an online account.
-    if (!xuid || rex::memory::load_and_swap<uint64_t>(bytes + 48))
-      return uint32_t(X_E_INVALIDARG);
-  }
-  // 17559 8199E884 / 8199E8C4: bit 0x4 merges the supplied accounts;
-  // with one local slot this selects the persisted identity without clearing peers.
-  auto* profile = REX_KERNEL_STATE()->user_profile();
-  // Original Guide 913F847C-913F84AC supplies the current XUID and 0x28.
-  // Removal is by identity, never a request to sign that identity back in.
-  const auto active = profile->identity();
-  const auto result = remove && (!xuid || xuid != active.xuid || !active.signin_state)
-      ? X_ERROR_NO_SUCH_USER : profile->SetLocalSession(remove ? 0 : xuid);
-  REXKRNL_INFO("Local logon flags={:08X} xuid={:016X} result={}", flags, xuid, result);
-  const auto hr = X_HRESULT_FROM_WIN32(result);
-  if (overlapped) {
-    // Original LogonEx returns HRESULT acceptance, with result in XOVERLAPPED.
-    REX_KERNEL_STATE()->CompleteOverlappedImmediateEx(overlapped, result, hr, 0);
-  }
-  return hr;
-}
