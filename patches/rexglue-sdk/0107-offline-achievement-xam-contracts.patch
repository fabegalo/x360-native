+// Xbox FILETIME keeps low DWORD first, with each DWORD big endian.
+struct X_ACHIEVEMENT_UNLOCK_TIME {
+  rex::be<uint32_t> unk_0;
+  rex::be<uint32_t> unk_4;
+};
+
+struct X_ACHIEVEMENT_DETAILS {
+  rex::be<uint32_t> id;
+  rex::be<uint32_t> label_ptr;
+  rex::be<uint32_t> description_ptr;
+  rex::be<uint32_t> unachieved_ptr;
+  rex::be<uint32_t> image_id;
+  rex::be<uint32_t> gamerscore;
+  X_ACHIEVEMENT_UNLOCK_TIME unlock_time;
+  rex::be<uint32_t> flags;
+
+  static const size_t kStringBufferSize = 464;
+};
+static_assert_size(X_ACHIEVEMENT_DETAILS, 36);
+
+class XStaticAchievementEnumerator : public XEnumerator {
+ public:
+  struct AchievementDetails {
+    uint32_t id;
+    std::u16string label;
+    std::u16string description;
+    std::u16string unachieved;
+    uint32_t image_id;
+    uint32_t gamerscore;
+    struct {
+      uint32_t unk_0;
+      uint32_t unk_4;
+    } unlock_time;
+    uint32_t flags;
+  };
+
+  XStaticAchievementEnumerator(KernelState* kernel_state, size_t items_per_enumerate,
+                               uint32_t flags)
+      : XEnumerator(kernel_state, items_per_enumerate,
+                    sizeof(X_ACHIEVEMENT_DETAILS) +
+                        (!!(flags & 7) ? X_ACHIEVEMENT_DETAILS::kStringBufferSize : 0)),
+        flags_(flags) {}
+
+  void AppendItem(AchievementDetails item) { items_.push_back(std::move(item)); }
+
+  uint32_t WriteItems(uint32_t buffer_ptr, uint8_t* buffer_data, uint32_t* written_count) override {
+    std::lock_guard lock(mutex_);
+    if (written_count) *written_count = 0;
+    size_t count = std::min(items_.size() - current_item_, items_per_enumerate());
+    if (!count) {
+      return X_ERROR_NO_MORE_FILES;
+    }
+
+    auto details = reinterpret_cast<X_ACHIEVEMENT_DETAILS*>(buffer_data);
+    size_t string_offset = items_per_enumerate() * sizeof(X_ACHIEVEMENT_DETAILS);
+    auto string_buffer =
+        StringBuffer{buffer_ptr + static_cast<uint32_t>(string_offset), &buffer_data[string_offset],
+                     count * X_ACHIEVEMENT_DETAILS::kStringBufferSize};
+    for (size_t i = 0, o = current_item_; i < count; ++i, ++current_item_) {
+      const auto& item = items_[current_item_];
+      details[i].id = item.id;
+      details[i].label_ptr = !!(flags_ & 1) ? AppendString(string_buffer, item.label) : 0;
+      details[i].description_ptr =
+          !!(flags_ & 2) ? AppendString(string_buffer, item.description) : 0;
+      details[i].unachieved_ptr = !!(flags_ & 4) ? AppendString(string_buffer, item.unachieved) : 0;
+      details[i].image_id = item.image_id;
+      details[i].gamerscore = item.gamerscore;
+      details[i].unlock_time.unk_0 = item.unlock_time.unk_0;
+      details[i].unlock_time.unk_4 = item.unlock_time.unk_4;
+      details[i].flags = item.flags;
+    }
+
+    if (written_count) {
+      *written_count = static_cast<uint32_t>(count);
+    }
+
+    return X_ERROR_SUCCESS;
+  }
+
+ private:
+  struct StringBuffer {
+    uint32_t ptr;
+    uint8_t* data;
+    size_t remaining_bytes;
+  };
+
+  uint32_t AppendString(StringBuffer& sb, const std::u16string_view string) {
+    size_t count = string.length() + 1;
+    size_t size = count * sizeof(char16_t);
+    if (size > sb.remaining_bytes) {
+      return 0;
+    }
+    auto ptr = sb.ptr;
+    rex::string::copy_and_swap_truncating(reinterpret_cast<char16_t*>(sb.data), string, count);
+    sb.ptr += static_cast<uint32_t>(size);
+    sb.data += size;
+    sb.remaining_bytes -= size;
+    return ptr;
+  }
+
+ private:
+  uint32_t flags_;
+  std::vector<AchievementDetails> items_;
+  size_t current_item_ = 0;
+  std::mutex mutex_;
+};
+
+u32 XamUserCreateAchievementEnumerator_entry(u32 title_id, u32 user_index, u64 xuid, u32 flags,
+                                             u32 offset, u32 count, mapped_u32 buffer_size_ptr,
+                                             mapped_u32 handle_ptr) {
+  if (!count || !buffer_size_ptr || !handle_ptr || (uint32_t(flags) & ~7u) ||
+      !AchievementGuestSpan(REX_KERNEL_MEMORY(), buffer_size_ptr.guest_address(), 4,
+                            memory::kMemoryProtectWrite) ||
+      !AchievementGuestSpan(REX_KERNEL_MEMORY(), handle_ptr.guest_address(), 4,
+                            memory::kMemoryProtectWrite)) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+  *handle_ptr = 0;
+  if (user_index >= 4) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+
+  size_t entry_size = sizeof(X_ACHIEVEMENT_DETAILS);
+  if (flags & 7) {
+    entry_size += X_ACHIEVEMENT_DETAILS::kStringBufferSize;
+  }
+  if (count > UINT32_MAX / entry_size) return X_ERROR_INVALID_PARAMETER;
+  *buffer_size_ptr = static_cast<uint32_t>(entry_size) * count;
+
+  auto* ks = REX_KERNEL_STATE();
+  const auto identity = ks->user_profile()->identity();
+  if (user_index != 0 || !identity.signin_state) return X_ERROR_NO_SUCH_USER;
+  const uint64_t requested_xuid = xuid ? uint64_t(xuid) : identity.xuid;
+  if (!ks->user_profile()->FindLocal(requested_xuid).xuid) return X_ERROR_NO_SUCH_USER;
+  if (!title_id && !ks->GetExecutableModule()) return X_ERROR_INVALID_PARAMETER;
+  const uint32_t requested_title = title_id ? uint32_t(title_id) : ks->title_id();
+  std::vector<OfflineAchievementRecord> records;
+  const auto error = OfflineAchievementError(
+      ks->offline_achievements().List(requested_xuid, requested_title, records));
+  if (error) return error;
+
+  // The public ABI reserves 464 bytes of UTF-16 strings per record. Reject
+  // metadata that cannot fit rather than assert, truncate, or write past it.
+  std::vector<XStaticAchievementEnumerator::AchievementDetails> details;
+  for (size_t i = std::min<size_t>(offset, records.size()); i < records.size(); ++i) {
+    const auto& record = records[i];
+    const auto& info = record.info;
+    XStaticAchievementEnumerator::AchievementDetails item{
+        info.id, rex::string::to_utf16(info.label), rex::string::to_utf16(info.description),
+        rex::string::to_utf16(info.unachieved_description), info.image_id, info.gamerscore,
+        {static_cast<uint32_t>(record.unlock_filetime),
+         static_cast<uint32_t>(record.unlock_filetime >> 32)},
+        (info.flags & ~0x30000u) | (record.unlock_filetime ? 0x20000u : 0u)};
+    const size_t chars = ((flags & 1) ? item.label.size() + 1 : 0) +
+                         ((flags & 2) ? item.description.size() + 1 : 0) +
+                         ((flags & 4) ? item.unachieved.size() + 1 : 0);
+    if (chars * 2 > X_ACHIEVEMENT_DETAILS::kStringBufferSize) return 13; // ERROR_INVALID_DATA
+    details.push_back(std::move(item));
+  }
+
+  auto e = object_ref<XStaticAchievementEnumerator>(
+      new XStaticAchievementEnumerator(REX_KERNEL_STATE(), count, flags));
+  auto result = e->Initialize(user_index, 0xFB, 0xB000A, 0xB000B, 0);
+  if (XFAILED(result)) {
+    return result;
+  }
+
+  for (auto& item : details) e->AppendItem(std::move(item));
+
+  *handle_ptr = e->handle();
+  return X_ERROR_SUCCESS;
+}
+
+// X_XDBF_GPD_TITLE_PLAYED (40 bytes), followed by WCHAR title_name[64].
+// Layout documented by Xenia Canary xam/xdbf/gpd_info.h and xenumerator.h.
+struct X_OFFLINE_TITLE_PLAYED {
+  be<uint32_t> title_id, achievement_count, unlocked_count, total_score, earned_score;
+  be<uint16_t> online_count;
+  uint8_t avatar_awards[6];
+  be<uint32_t> flags;
+  X_ACHIEVEMENT_UNLOCK_TIME last_played;
+  be<uint16_t> title_name[64];
+};
+static_assert_size(X_OFFLINE_TITLE_PLAYED, 168);
+
+u32 XamUserCreateTitlesPlayedEnumerator_entry(u32 title_id, u32 user_index, u64 xuid,
+                                              u32 offset, u32 count,
+                                              mapped_u32 buffer_size, mapped_u32 handle) {
+  if (!count || count > UINT32_MAX / sizeof(X_OFFLINE_TITLE_PLAYED) || user_index >= 4 ||
+      !buffer_size || !handle ||
+      !AchievementGuestSpan(REX_KERNEL_MEMORY(), buffer_size.guest_address(), 4,
+                            memory::kMemoryProtectWrite) ||
+      !AchievementGuestSpan(REX_KERNEL_MEMORY(), handle.guest_address(), 4,
+                            memory::kMemoryProtectWrite)) return X_ERROR_INVALID_PARAMETER;
+  *handle = 0;
+  *buffer_size = count * sizeof(X_OFFLINE_TITLE_PLAYED);
+  auto* ks = REX_KERNEL_STATE();
+  const auto identity = ks->user_profile()->identity();
+  if (user_index != 0 || !identity.signin_state) return X_ERROR_NO_SUCH_USER;
+  const uint64_t requested_xuid = xuid ? uint64_t(xuid) : identity.xuid;
+  if (!ks->user_profile()->FindLocal(requested_xuid).xuid) return X_ERROR_NO_SUCH_USER;
+  std::vector<X_OFFLINE_TITLE_PLAYED> titles;
+  for (const auto id : ks->user_profile()->TitlesPlayed(requested_xuid)) {
+    std::vector<OfflineAchievementRecord> achievements;
+    const auto result = ks->offline_achievements().List(requested_xuid, id, achievements);
+    // Historical played-title records may predate metadata import. They must
+    // not gain invented names, totals or achievements in this enumerator.
+    if (result == OfflineAchievementResult::kNotFound) continue;
+    if (result != OfflineAchievementResult::kSuccess) return OfflineAchievementError(result);
+    if (achievements.empty()) continue;
+    std::string name;
+    const auto name_result = ks->offline_achievements().TitleName(id, name);
+    if (name_result != OfflineAchievementResult::kSuccess) return OfflineAchievementError(name_result);
+    X_OFFLINE_TITLE_PLAYED record{};
+    record.title_id = id;
+    record.achievement_count = static_cast<uint32_t>(achievements.size());
+    uint64_t total = 0, earned = 0;
+    uint32_t unlocked = 0;
+    for (const auto& achievement : achievements) {
+      total += achievement.info.gamerscore;
+      if (achievement.unlock_filetime) { ++unlocked; earned += achievement.info.gamerscore; }
+    }
+    if (total > UINT32_MAX || earned > UINT32_MAX) return 13;
+    record.total_score = static_cast<uint32_t>(total);
+    record.earned_score = static_cast<uint32_t>(earned);
+    record.unlocked_count = unlocked;
+    record.flags = unlocked ? 1u : 0u;  // Offline earned; no online flag/counter.
+    const auto title_name = rex::string::to_utf16(name);
+    rex::string::copy_and_swap_truncating(reinterpret_cast<char16_t*>(record.title_name),
+                                         title_name, 64);
+    titles.push_back(record);
+  }
+  auto e = make_object<XStaticEnumerator<X_OFFLINE_TITLE_PLAYED>>(ks, count);
+  if (XFAILED(e->Initialize(user_index, 0xFB, 0xB0050, 0xB000B, 0)))
+    return X_ERROR_FUNCTION_FAILED;
+  for (size_t i = std::min<size_t>(offset, titles.size()); i < titles.size(); ++i)
+    *e->AppendItem() = titles[i];
+  *handle = e->handle();
+  return X_ERROR_SUCCESS;
+}
