+// The pinned generic marshaler truncates integer arguments to 32 bits. These
+// three profile contracts carry a complete XUID in a single PPC register.
+extern "C" REX_FUNC(__imp__XamProfileFindAccount) {
+  using namespace rex;
+  using namespace rex::kernel::xam;
+  auto account = ppc_ptr_t<LocalAccount>(ctx.r4.u32 ?
+      reinterpret_cast<LocalAccount*>(base + ctx.r4.u32) : nullptr, ctx.r4.u32);
+  auto device = mapped_u32(ctx.r5.u32 ?
+      reinterpret_cast<be<uint32_t>*>(base + ctx.r5.u32) : nullptr, ctx.r5.u32);
+  ctx.r3.u64 = XamProfileFindAccount_entry(ctx.r3.u64, account, device);
+}
+static rex::ppc::detail::PPCFuncRegistrar profile_find_reg(
+    "__imp__XamProfileFindAccount", &__imp__XamProfileFindAccount);
+extern "C" REX_FUNC(__imp__XamProfileLoadAccountInfo) {
+  using namespace rex;
+  using namespace rex::kernel::xam;
+  auto account = ppc_ptr_t<LocalAccount>(ctx.r5.u32 ?
+      reinterpret_cast<LocalAccount*>(base + ctx.r5.u32) : nullptr, ctx.r5.u32);
+  ctx.r3.u64 = XamProfileLoadAccountInfo_entry(ctx.r3.u32, ctx.r4.u64, account);
+}
+static rex::ppc::detail::PPCFuncRegistrar profile_load_reg(
+    "__imp__XamProfileLoadAccountInfo", &__imp__XamProfileLoadAccountInfo);
+REX_EXPORT(__imp__XamCreateEnumeratorHandle, rex::kernel::xam::XamCreateEnumeratorHandle_entry)
+REX_EXPORT(__imp__XamGetPrivateEnumStructureFromHandle,
+           rex::kernel::xam::XamGetPrivateEnumStructureFromHandle_entry)
+
+extern "C" REX_FUNC(__imp__XamProfileCreate) {
+  using namespace rex::kernel::xam;
+  using namespace rex;
+  auto device = mapped_u32(ctx.r4.u32 ? reinterpret_cast<be<uint32_t>*>(base + ctx.r4.u32) : nullptr, ctx.r4.u32);
+  auto account = ppc_ptr_t<LocalAccount>(ctx.r6.u32 ? reinterpret_cast<LocalAccount*>(base + ctx.r6.u32) : nullptr, ctx.r6.u32);
+  auto handle = mapped_u32(ctx.r10.u32 ? reinterpret_cast<be<uint32_t>*>(base + ctx.r10.u32) : nullptr, ctx.r10.u32);
+  ctx.r3.u64 = CreateLocalProfile(ctx.r3.u32, device, ctx.r5.u64, account, handle);
+}
+REX_EXPORT(__imp__XamProfileGetCreationStatus, rex::kernel::xam::XamProfileGetCreationStatus_entry)
+
+static rex::ppc::detail::PPCFuncRegistrar profile_create_reg("__imp__XamProfileCreate", &__imp__XamProfileCreate);
