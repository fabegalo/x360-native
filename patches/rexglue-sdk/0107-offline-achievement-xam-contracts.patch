-// Original 17559 816C34D8: user, mode, optional 114-byte payload.
-u32 XamShowCreateProfileUIEx_entry(u32 user, u32 mode, mapped_void extra) {
-  if (user >= 4) return X_ERROR_INVALID_PARAMETER;
-  uint32_t request[136 / 4]{};
-  request[0] = user;
-  request[1] = mode;
-  if (extra) {
-    uint8_t bytes[136]{};
-    std::memcpy(bytes + 16, extra.as<uint8_t*>(), 114);
-    for (size_t i = 4; i < 34; ++i)
-      request[i] = rex::memory::load_and_swap<uint32_t>(bytes + i * 4);
-  }
-  return DispatchProfileUi(0x2100E, request, 34);
-}
-u32 XamShowCreateProfileUI_entry(u32 user, u32 mode) {
-  if (user >= 4) return X_ERROR_INVALID_PARAMETER;
-  uint32_t request[136 / 4]{};
-  request[0] = user; request[1] = mode;
-  return DispatchProfileUi(0x2100E, request, 34);
-}
