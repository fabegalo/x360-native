+typedef struct {
+  rex::be<uint32_t> setting_count;
+  rex::be<uint32_t> settings_ptr;
+} X_USER_READ_PROFILE_SETTINGS;
+static_assert_size(X_USER_READ_PROFILE_SETTINGS, 8);
+
+// https://github.com/oukiar/freestyledash/blob/master/Freestyle/Tools/Generic/xboxtools.cpp
+uint32_t XamUserReadProfileSettingsEx(uint32_t title_id, uint32_t user_index, uint32_t xuid_count,
+                                      be<uint64_t>* xuids, uint32_t setting_count,
+                                      be<uint32_t>* setting_ids, uint32_t unk,
+                                      be<uint32_t>* buffer_size_ptr, uint8_t* buffer,
+                                      XAM_OVERLAPPED* overlapped) {
+  if (xuid_count > 1 || (xuid_count != 0) != (xuids != nullptr) || unk || !setting_ids)
+    return X_ERROR_INVALID_PARAMETER;
+
+  // must have at least 1 to 32 settings
+  if (setting_count < 1 || setting_count > 32) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+
+  // buffer size pointer must be valid
+  if (!buffer_size_ptr || !AchievementGuestSpan(REX_KERNEL_MEMORY(),
+      REX_KERNEL_MEMORY()->HostToGuestVirtual(buffer_size_ptr), 4,
+      memory::kMemoryProtectRead | memory::kMemoryProtectWrite) ||
+      !AchievementGuestSpan(REX_KERNEL_MEMORY(), REX_KERNEL_MEMORY()->HostToGuestVirtual(setting_ids),
+                            uint64_t(setting_count) * 4, memory::kMemoryProtectRead) ||
+      (xuids && !AchievementGuestSpan(REX_KERNEL_MEMORY(),
+           REX_KERNEL_MEMORY()->HostToGuestVirtual(xuids), 8, memory::kMemoryProtectRead)) ||
+      (overlapped && !AchievementGuestSpan(REX_KERNEL_MEMORY(),
+           REX_KERNEL_MEMORY()->HostToGuestVirtual(overlapped), sizeof(XAM_OVERLAPPED),
+           memory::kMemoryProtectRead | memory::kMemoryProtectWrite))) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+
+  // if buffer size is non-zero, buffer pointer must be valid
+  auto buffer_size = static_cast<uint32_t>(*buffer_size_ptr);
+  if (buffer_size && !buffer) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+
+  uint32_t needed_header_size = 0;
+  uint32_t needed_data_size = 0;
+  for (uint32_t i = 0; i < setting_count; ++i) {
+    needed_header_size += sizeof(X_USER_PROFILE_SETTING);
+    UserProfile::Setting::Key setting_key;
+    setting_key.value = static_cast<uint32_t>(setting_ids[i]);
+    switch (static_cast<UserProfile::Setting::Type>(setting_key.type)) {
+      case UserProfile::Setting::Type::WSTRING:
+      case UserProfile::Setting::Type::BINARY:
+        needed_data_size += setting_key.size;
+        break;
+      default:
+        break;
+    }
+  }
+  if (xuids) {
+    needed_header_size *= xuid_count;
+    needed_data_size *= xuid_count;
+  }
+  needed_header_size += sizeof(X_USER_READ_PROFILE_SETTINGS);
+
+  uint32_t needed_size = needed_header_size + needed_data_size;
+  if (!buffer || buffer_size < needed_size) {
+    if (!buffer_size) {
+      *buffer_size_ptr = needed_size;
+    }
+    return X_ERROR_INSUFFICIENT_BUFFER;
+  }
+  if (!AchievementGuestSpan(REX_KERNEL_MEMORY(), REX_KERNEL_MEMORY()->HostToGuestVirtual(buffer),
+                            needed_size, memory::kMemoryProtectWrite)) return X_ERROR_INVALID_PARAMETER;
+
+  // A sizing query only depends on setting IDs, including the caller's
+  // any-user index (255). Require an account only when reading its data.
+  const auto& sizing_profile = REX_KERNEL_STATE()->user_profile();
+  if (!sizing_profile->signin_state()) return X_ERROR_NOT_LOGGED_ON;
+  const auto active_identity = sizing_profile->identity();
+  const uint64_t requested_xuid = xuids ? uint64_t(xuids[0]) : active_identity.xuid;
+  if (!requested_xuid || !sizing_profile->FindLocal(requested_xuid).xuid)
+    return X_ERROR_NO_SUCH_USER;
+
+  // Title ID = 0 means us.
+  // 0xfffe07d1 = profile?
+
+  if (!xuids && user_index) {
+    // Only support user 0.
+    if (overlapped) {
+      REX_KERNEL_STATE()->CompleteOverlappedImmediate(
+          REX_KERNEL_MEMORY()->HostToGuestVirtual(overlapped), X_ERROR_NO_SUCH_USER);
+      return X_ERROR_IO_PENDING;
+    }
+    return X_ERROR_NO_SUCH_USER;
+  }
+
+  const auto& user_profile = REX_KERNEL_STATE()->user_profile();
+
+  // Read-only counters come from the committed offline ledger, never from
+  // editable profile settings or the runtime's title-global legacy store.
+  OfflineAchievementTotals totals{};
+  OfflineAchievementTotals title_totals{};
+  bool needs_totals = false;
+  bool needs_title_totals = false;
+  for (uint32_t i = 0; i < setting_count; ++i) {
+    needs_totals |= setting_ids[i] == 0x10040006u || setting_ids[i] == 0x10040013u;
+    needs_title_totals |= setting_ids[i] == 0x10040038u || setting_ids[i] == 0x10040039u;
+  }
+  if (needs_totals || needs_title_totals) {
+    auto* ks = REX_KERNEL_STATE();
+    uint32_t requested_title = title_id;
+    if (needs_title_totals && !requested_title) {
+      if (!ks->GetExecutableModule()) return X_ERROR_INVALID_PARAMETER;
+      requested_title = ks->title_id();
+    }
+    // One locked snapshot prevents a concurrent unlock from making a title's
+    // count or score larger than the global values in the same response.
+    const auto result = ks->offline_achievements().Totals(
+        requested_xuid, totals, requested_title, needs_title_totals ? &title_totals : nullptr);
+    const auto error = OfflineAchievementError(result);
+    if (error) {
+      if (!overlapped) return error;
+      ks->CompleteOverlappedImmediateEx(REX_KERNEL_MEMORY()->HostToGuestVirtual(overlapped),
+                                       error, X_HRESULT_FROM_WIN32(error), 0);
+      return X_ERROR_IO_PENDING;
+    }
+  }
+  // Other settings still belong to the active local identity. Do not expose
+  // that identity's settings when a different persisted XUID was requested.
+  for (uint32_t i = 0; i < setting_count; ++i) {
+    const uint32_t id = setting_ids[i];
+    if (requested_xuid != active_identity.xuid && id != 0x10040006u &&
+        id != 0x10040013u && id != 0x10040012u && id != 0x10040038u && id != 0x10040039u)
+      return X_ERROR_NO_SUCH_USER;
+  }
+
+  // First call asks for size (fill buffer_size_ptr).
+  // Second call asks for buffer contents with that size.
+
+  // TODO(gibbed): setting validity checking without needing a user profile
+  // object.
+  bool any_missing = false;
+  for (uint32_t i = 0; i < setting_count; ++i) {
+    auto setting_id = static_cast<uint32_t>(setting_ids[i]);
+    auto setting = user_profile->GetSetting(setting_id);
+    if (!setting) {
+      any_missing = true;
+      REXKRNL_ERROR(
+          "xeXamUserReadProfileSettingsEx requested unimplemented setting "
+          "{:08X}",
+          setting_id);
+    }
+  }
+  if (any_missing) {
+    // TODO(benvanik): don't fail? most games don't even check!
+    if (overlapped) {
+      REX_KERNEL_STATE()->CompleteOverlappedImmediate(
+          REX_KERNEL_MEMORY()->HostToGuestVirtual(overlapped), X_ERROR_INVALID_PARAMETER);
+      return X_ERROR_IO_PENDING;
+    }
+    return X_ERROR_INVALID_PARAMETER;
+  }
+
+  auto out_header = reinterpret_cast<X_USER_READ_PROFILE_SETTINGS*>(buffer);
+  auto out_setting = reinterpret_cast<X_USER_PROFILE_SETTING*>(&out_header[1]);
+  out_header->setting_count = static_cast<uint32_t>(setting_count);
+  out_header->settings_ptr = REX_KERNEL_MEMORY()->HostToGuestVirtual(out_setting);
+
+  UserProfile::SettingByteStream out_stream(REX_KERNEL_MEMORY()->HostToGuestVirtual(buffer), buffer,
+                                            buffer_size, needed_header_size);
+  for (uint32_t n = 0; n < setting_count; ++n) {
+    uint32_t setting_id = setting_ids[n];
+    auto setting = user_profile->GetSetting(setting_id);
+
+    std::memset(out_setting, 0, sizeof(X_USER_PROFILE_SETTING));
+    out_setting->from = !setting || !setting->is_set ? 0 : setting->is_title_specific() ? 2 : 1;
+    if (xuids) {
+      out_setting->xuid = requested_xuid;
+    } else {
+      out_setting->user_index = static_cast<uint32_t>(user_index);
+    }
+    out_setting->setting_id = setting_id;
+
+    if (setting_id == 0x10040006u || setting_id == 0x10040013u || setting_id == 0x10040012u ||
+        setting_id == 0x10040038u || setting_id == 0x10040039u) {
+      const uint32_t value = setting_id == 0x10040006u ? totals.gamerscore :
+          setting_id == 0x10040013u ? totals.unlocked_count :
+          setting_id == 0x10040038u ? title_totals.gamerscore :
+          setting_id == 0x10040039u ? title_totals.unlocked_count :
+          static_cast<uint32_t>(user_profile->TitlesPlayed(requested_xuid).size());
+      UserProfile::Int32Setting counter(setting_id, static_cast<int32_t>(value));
+      counter.Append(&out_setting->data, &out_stream);
+      out_setting->from = 1;
+    } else if (setting && setting->is_set) {
+      setting->Append(&out_setting->data, &out_stream);
+    }
+    ++out_setting;
+  }
+
+  if (overlapped) {
+    REX_KERNEL_STATE()->CompleteOverlappedImmediate(
+        REX_KERNEL_MEMORY()->HostToGuestVirtual(overlapped), X_ERROR_SUCCESS);
+    return X_ERROR_IO_PENDING;
+  }
+  return X_ERROR_SUCCESS;
+}
