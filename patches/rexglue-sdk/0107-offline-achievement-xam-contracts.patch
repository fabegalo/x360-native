-// Original 17559 816C3580 -> 816C2AF0: Guide request, user at +4.
-u32 XamShowGuideUI_entry(u32 user) {
-  if (user >= 4) return X_ERROR_INVALID_PARAMETER;
-  const uint32_t request[] = {0, user, 0};
-  return DispatchProfileUi(0x21015, request, 3);
-}
