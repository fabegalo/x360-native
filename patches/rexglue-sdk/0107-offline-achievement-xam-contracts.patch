+// Profile enumeration has a fixed one-record ABI, not XamEnumerate's byte
+// buffer length. 17559 signin 90118C7C consumes XUID + 380-byte account +
+// device id (392 bytes); account+8 is WCHAR[16], account+40 is the Live XUID.
+#pragma pack(push, 4)
+struct LocalAccount {
+  uint8_t reserved[8];
+  be<uint16_t> name[16];
+  be<uint64_t> online_xuid;
+  uint8_t online_data[332];
+};
+static_assert_size(LocalAccount, 380);
+struct LocalProfileRecord {
+  be<uint64_t> xuid;
+  LocalAccount account;
+  be<uint32_t> device;
+};
+static_assert_size(LocalProfileRecord, 392);
+#pragma pack(pop)
+
+static LocalAccount AccountFor(const UserProfile::Identity& identity) {
+  LocalAccount account{};
+  for (size_t i = 0; i < identity.name.size() && i < 15; ++i)
+    account.name[i] = static_cast<uint8_t>(identity.name[i]);
+  return account;
+}
+
+u32 XamProfileCreateEnumerator_entry(u32 filter, mapped_u32 handle) {
+  if (!handle) return X_ERROR_INVALID_PARAMETER;
+  *handle = 0;
+  // Sign-in uses 0 (all devices); CreateProfile uses the selected local
+  // storage device (1) to enforce its per-device profile limit.
+  if (filter > 1) return X_ERROR_DEVICE_NOT_CONNECTED;
+  auto e = make_object<XStaticEnumerator<LocalProfileRecord>>(REX_KERNEL_STATE(), 1);
+  auto status = e->Initialize(0xFF, 0xFE, 0x23001, 0x23003, 0);
+  if (XFAILED(status)) return X_ERROR_FUNCTION_FAILED;
+  for (const auto& identity : REX_KERNEL_STATE()->user_profile()->local_profiles()) {
+    auto* record = e->AppendItem();
+    *record = {};
+    record->xuid = identity.xuid;
+    record->account = AccountFor(identity);
+  }
+  *handle = e->handle();
+  REXKRNL_INFO("Local profile enumeration: {} record(s)", e->item_count());
+  return X_ERROR_SUCCESS;
+}
+
+u32 XamProfileEnumerate_entry(u32 handle, u32 flags, mapped_void buffer, u32 overlapped) {
+  // 17559 uses flags=2 for synchronous enumeration; bit 1 selects direct
+  // dispatch in original XAM 816F1134. No buffer-size argument exists here.
+  if (flags != 0 && flags != 2) return X_ERROR_INVALID_PARAMETER;
+  auto e = REX_KERNEL_OBJECTS()->LookupObject<XEnumerator>(handle);
+  if (!e) return X_ERROR_INVALID_HANDLE;
+  auto* header = REX_KERNEL_MEMORY()->TranslateVirtual<X_KENUMERATOR*>(e->guest_object());
+  if (header->open_message != 0x23001 || e->item_size() != sizeof(LocalProfileRecord))
+    return X_ERROR_INVALID_HANDLE;
+  if (!buffer) return X_ERROR_INVALID_PARAMETER;
+  uint32_t count = 0;
+  const auto result = e->WriteItems(buffer.guest_address(), buffer.as<uint8_t*>(), &count);
+  if (overlapped) {
+    REX_KERNEL_STATE()->CompleteOverlappedImmediateEx(overlapped, result,
+        X_HRESULT_FROM_WIN32(result), count);
+    return X_ERROR_IO_PENDING;
+  }
+  return result;
+}
+
+u32 XamProfileFindAccount_entry(u64 xuid, ppc_ptr_t<LocalAccount> account, mapped_u32 device) {
+  if (!account) return X_ERROR_INVALID_PARAMETER;
+  const auto identity = REX_KERNEL_STATE()->user_profile()->FindLocal(xuid);
+  if (!identity.xuid || xuid != identity.xuid) return X_ERROR_NO_SUCH_USER;
+  *account = AccountFor(identity);
+  if (device) *device = 0;
+  return X_ERROR_SUCCESS;
+}
+
+u32 XamProfileLoadAccountInfo_entry(u32 device, u64 xuid, ppc_ptr_t<LocalAccount> account) {
+  if (device) return X_ERROR_DEVICE_NOT_CONNECTED;
+  if (!account) return X_ERROR_INVALID_PARAMETER;
+  const auto identity = REX_KERNEL_STATE()->user_profile()->FindLocal(xuid);
+  if (!identity.xuid || xuid != identity.xuid) return X_ERROR_NO_SUCH_USER;
+  *account = AccountFor(identity);
+  return X_ERROR_SUCCESS;
+}
+
+class ProfileCreation final : public XObject {
+ public:
+  static constexpr Type kObjectType = Type::ProfileCreation;
+  explicit ProfileCreation(KernelState* kernel) : XObject(kernel, kObjectType) {}
+  uint64_t xuid = 0;
+  uint32_t result = 0;
+};
+
+// 17559 816DC468/816DC2B0: flags, device pointer, input XUID, 380-byte
+// account, optional avatar/preferences, and opaque creation handle output.
+// Persistence is synchronous locally; the caller still consumes the result
+// through GetCreationStatus, which releases the completed operation once.
+u32 CreateLocalProfile(uint32_t flags, mapped_u32 device, uint64_t input_xuid,
+                       ppc_ptr_t<LocalAccount> account, mapped_u32 handle) {
+  REXKRNL_INFO("Local profile create flags={:08X} device={} input={:016X}",
+      flags, device ? uint32_t(*device) : 0xFFFFFFFF, input_xuid);
+  if (!device || !account || !handle) return X_E_INVALIDARG;
+  *handle = 0;
+  if (flags != 1 || input_xuid || account->online_xuid) return 0x80004001u;
+  if (*device > 1) return X_HRESULT_FROM_WIN32(X_ERROR_DEVICE_NOT_CONNECTED);
+  std::string name;
+  for (unsigned i = 0; i < 16; ++i) {
+    const uint16_t c = account->name[i];
+    if (!c) break;
+    if (c < 32 || c > 126 || i == 15) return X_E_INVALIDARG;
+    name.push_back(char(c));
+  }
+  auto operation = make_object<ProfileCreation>(REX_KERNEL_STATE());
+  operation->result = REX_KERNEL_STATE()->user_profile()->CreateLocal(name, &operation->xuid);
+  *handle = operation->handle();
+  REXKRNL_INFO("Local profile created name={} xuid={:016X} result={}", name,
+      operation->xuid, operation->result);
+  return 0;
+}
+
+u32 XamProfileGetCreationStatus_entry(u32 handle, mapped_u64 xuid) {
+  if (!xuid) return X_E_INVALIDARG;
+  auto operation = REX_KERNEL_OBJECTS()->LookupObject<ProfileCreation>(handle);
+  if (!operation) return X_E_INVALIDARG;
+  *xuid = operation->xuid;
+  const auto result = X_HRESULT_FROM_WIN32(operation->result);
+  operation->ReleaseHandle();
+  return result;
+}
+
+// https://github.com/LestaD/SourceEngine2007/blob/master/se2007/engine/xboxsystem.cpp#L518
+uint32_t xeXamEnumerate(uint32_t handle, uint32_t flags, mapped_void buffer_ptr,
+                        uint32_t buffer_size, uint32_t* items_returned, uint32_t overlapped_ptr) {
+  auto e = REX_KERNEL_OBJECTS()->LookupObject<XEnumerator>(handle);
+  if (!e) {
+    return X_ERROR_INVALID_HANDLE;
+  }
+
+  const auto* header = REX_KERNEL_MEMORY()->TranslateVirtual<X_KENUMERATOR*>(e->guest_object());
+  if (header->app_id == 0xFB &&
+      (header->open_message == 0xB000A || header->open_message == 0xB0050)) {
+    if (flags) return X_ERROR_INVALID_PARAMETER;
+  } else {
+    assert_true(flags == 0);
+  }
+  if (header->app_id == 0xFB &&
+      (header->open_message == 0xB000A || header->open_message == 0xB0050) && overlapped_ptr &&
+      !AchievementGuestSpan(REX_KERNEL_MEMORY(), overlapped_ptr, sizeof(XAM_OVERLAPPED),
+                            memory::kMemoryProtectRead | memory::kMemoryProtectWrite))
+    return X_ERROR_INVALID_PARAMETER;
+
+  auto run = [e, buffer_ptr, buffer_size](uint32_t& extended_error, uint32_t& length) -> X_RESULT {
+    X_RESULT result;
+    uint32_t item_count = 0;
+    if (!buffer_ptr) {
+      result = X_ERROR_INVALID_PARAMETER;
+    } else {
+      const auto* header = REX_KERNEL_MEMORY()->TranslateVirtual<X_KENUMERATOR*>(e->guest_object());
+      // Achievement/title enumerators reserve fixed-size batches. The generic
+      // legacy path does not pass capacity to WriteItems; enforce it here
+      // without changing older profile enumeration's separate zero-size ABI.
+      if (header->app_id == 0xFB &&
+          (header->open_message == 0xB000A || header->open_message == 0xB0050)) {
+        const uint64_t required = uint64_t(e->items_per_enumerate()) * e->item_size();
+        if (buffer_size < required) {
+          extended_error = X_HRESULT_FROM_WIN32(X_ERROR_INSUFFICIENT_BUFFER);
+          length = 0;
+          return X_ERROR_INSUFFICIENT_BUFFER;
+        }
+        if (!AchievementGuestSpan(REX_KERNEL_MEMORY(), buffer_ptr.guest_address(), required,
+                                  memory::kMemoryProtectWrite)) {
+          extended_error = X_HRESULT_FROM_WIN32(X_ERROR_INVALID_PARAMETER);
+          length = 0;
+          return X_ERROR_INVALID_PARAMETER;
+        }
+      }
+      result = e->WriteItems(buffer_ptr.guest_address(), buffer_ptr.as<uint8_t*>(), &item_count);
+    }
+    extended_error = X_HRESULT_FROM_WIN32(result);
+    length = item_count;
+    return result;
+  };
+
+  if (items_returned) {
+    assert_true(!overlapped_ptr);
+    uint32_t extended_error;
+    uint32_t item_count;
+    X_RESULT result = run(extended_error, item_count);
+    *items_returned = result == X_ERROR_SUCCESS ? item_count : 0;
+    return result;
+  } else if (overlapped_ptr) {
+    assert_true(!items_returned);
+    REX_KERNEL_STATE()->CompleteOverlappedDeferredEx(run, overlapped_ptr);
+    return X_ERROR_IO_PENDING;
+  } else {
+    assert_always();
+    return X_ERROR_INVALID_PARAMETER;
+  }
+}
+
+u32 XamEnumerate_entry(u32 handle, u32 flags, mapped_void buffer, u32 buffer_length,
+                       mapped_u32 items_returned, ppc_ptr_t<XAM_OVERLAPPED> overlapped) {
+  // Validate the count output before WriteItems advances the cursor. Legacy
+  // enumerators retain their existing ABI; these two contracts require four
+  // writable bytes whenever a synchronous count pointer is supplied.
+  if (!overlapped && items_returned) {
+    auto e = REX_KERNEL_OBJECTS()->LookupObject<XEnumerator>(handle);
+    if (e) {
+      const auto* header = REX_KERNEL_MEMORY()->TranslateVirtual<X_KENUMERATOR*>(e->guest_object());
+      if (header->app_id == 0xFB &&
+          (header->open_message == 0xB000A || header->open_message == 0xB0050) &&
+          !AchievementGuestSpan(REX_KERNEL_MEMORY(), items_returned.guest_address(), 4,
+                                memory::kMemoryProtectWrite))
+        return X_ERROR_INVALID_PARAMETER;
+    }
+  }
+  uint32_t dummy = 0;
+  auto result =
+      xeXamEnumerate(handle, flags, buffer, buffer_length,
+                     !overlapped.guest_address() ? &dummy : nullptr, overlapped.guest_address());
+  if (!overlapped && items_returned) {
+    *items_returned = dummy;
+  }
+  return result;
+}
+
+u32 XamCreateEnumeratorHandle_entry(u32 unk1, u32 unk2, u32 unk3, u32 unk4, u32 unk5, u32 unk6,
+                                    u32 unk7, u32 unk8) {
+  return X_ERROR_INVALID_PARAMETER;
+}
+
+u32 XamGetPrivateEnumStructureFromHandle_entry(u32 handle, mapped_u32 out_object_ptr) {
+  auto e = REX_KERNEL_OBJECTS()->LookupObject<XEnumerator>(handle);
+  if (!e) {
+    return X_STATUS_INVALID_HANDLE;
+  }
+
+  // Caller takes the reference.
+  // It's released in ObDereferenceObject.
+  e->RetainHandle();
+
+  if (out_object_ptr.guest_address()) {
+    *out_object_ptr = e->guest_object();
+  }
+
+  return X_STATUS_SUCCESS;
+}
