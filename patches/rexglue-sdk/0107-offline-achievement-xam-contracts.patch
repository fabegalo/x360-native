+static uint32_t CompleteAchievementRead(uint32_t error, uint32_t overlapped) {
+  if (!overlapped) return error;
+  REX_KERNEL_STATE()->CompleteOverlappedImmediateEx(overlapped, error,
+                                                  X_HRESULT_FROM_WIN32(error), 0);
+  return X_ERROR_IO_PENDING;
+}
+
+u32 XamReadTileToTexture_entry(u32 tile_type, u32 title_id, u64 tile_id, u32 user_index,
+                               mapped_void buffer_ptr, u32 stride, u32 height, u32 overlapped_ptr) {
+  if ((overlapped_ptr && !AchievementGuestSpan(REX_KERNEL_MEMORY(), overlapped_ptr,
+          sizeof(XAM_OVERLAPPED), memory::kMemoryProtectRead | memory::kMemoryProtectWrite)) ||
+      !buffer_ptr || !stride || !height ||
+      !AchievementGuestSpan(REX_KERNEL_MEMORY(), buffer_ptr.guest_address(),
+                            uint64_t(stride) * height, memory::kMemoryProtectWrite)) {
+    return X_ERROR_INVALID_PARAMETER;
+  }
+  std::vector<uint8_t> encoded;
+  const auto error = ReadOfflineAchievementImage(tile_type, title_id, tile_id, user_index, encoded);
+  if (error) return CompleteAchievementRead(error, overlapped_ptr);
+  int width = 0, image_height = 0;
+  const auto rgba = ui::DecodeImageRGBA(encoded.data(), encoded.size(), width, image_height);
+  if (rgba.empty() || width <= 0 || image_height <= 0)
+    return CompleteAchievementRead(13, overlapped_ptr);
+  if (uint64_t(width) * 4 > stride || uint32_t(image_height) > height)
+    return CompleteAchievementRead(X_ERROR_INSUFFICIENT_BUFFER, overlapped_ptr);
+  auto* output = buffer_ptr.as<uint8_t*>();
+  std::memset(output, 0, size_t(stride) * height);
+  for (int y = 0; y < image_height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      const auto* pixel = &rgba[(size_t(y) * width + x) * 4];
+      auto* destination = output + size_t(y) * stride + size_t(x) * 4;
+      destination[0] = pixel[3]; destination[1] = pixel[0];
+      destination[2] = pixel[1]; destination[3] = pixel[2];
+    }
+  }
+  return CompleteAchievementRead(X_ERROR_SUCCESS, overlapped_ptr);
+}
+
+// XAM 17559 81670C00 (export 0x2FC) sends these arguments to the XGI tile
+// service as message 000B003A and completes asynchronously when an overlapped
+// is supplied. The two middle arguments are preserved for the Ex ABI.
+u32 XamReadTileEx_entry(u32 tile_type, u32 title_id, u64 tile_id, u32 user_index, u32 unk_r7,
+                        u32 unk_r8, mapped_void buffer_ptr, mapped_u32 buffer_size_ptr,
+                        u32 overlapped_ptr) {
+  REXKRNL_DEBUG("XamReadTileEx type={} title={:08X} tile={:016X} user={}", uint32_t(tile_type),
+                uint32_t(title_id), uint64_t(tile_id), uint32_t(user_index));
+  if ((overlapped_ptr && !AchievementGuestSpan(REX_KERNEL_MEMORY(), overlapped_ptr,
+          sizeof(XAM_OVERLAPPED), memory::kMemoryProtectRead | memory::kMemoryProtectWrite)) ||
+      !buffer_size_ptr || !AchievementGuestSpan(REX_KERNEL_MEMORY(),
+      buffer_size_ptr.guest_address(), 4, memory::kMemoryProtectRead | memory::kMemoryProtectWrite))
+    return X_ERROR_INVALID_PARAMETER;
+  std::vector<uint8_t> image;
+  auto error = ReadOfflineAchievementImage(tile_type, title_id, tile_id, user_index, image);
+  if (!error) {
+    const uint32_t capacity = *buffer_size_ptr;
+    *buffer_size_ptr = static_cast<uint32_t>(image.size());
+    if (!buffer_ptr || capacity < image.size()) error = X_ERROR_INSUFFICIENT_BUFFER;
+    else if (!AchievementGuestSpan(REX_KERNEL_MEMORY(), buffer_ptr.guest_address(), image.size(),
+                                    memory::kMemoryProtectWrite)) error = X_ERROR_INVALID_PARAMETER;
+    else std::memcpy(buffer_ptr.as<uint8_t*>(), image.data(), image.size());
+  }
+  return CompleteAchievementRead(error, overlapped_ptr);
+}
+
+// XAM 17559 81670B68 (export 0x2EF): message 000B0030 with the same tile key.
+u32 XamReadTile_entry(u32 tile_type, u32 title_id, u64 tile_id, u32 user_index,
+                      mapped_void buffer, mapped_u32 buffer_size, u32 overlapped_ptr) {
+  return XamReadTileEx_entry(tile_type, title_id, tile_id, user_index, 0, 0,
+                            buffer, buffer_size, overlapped_ptr);
+}
