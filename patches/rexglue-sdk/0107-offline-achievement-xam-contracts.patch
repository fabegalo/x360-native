new file mode 100644
index 0000000..c2849bb
--- /dev/null
+++ b/include/rex/kernel/xam/offline_achievement_helpers.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <rex/system/offline_achievement_store.h>
+#include <rex/system/xmemory.h>
+#include <rex/system/xtypes.h>
+
+namespace rex::kernel::xam {
+
+inline uint32_t OfflineAchievementError(system::OfflineAchievementResult result) {
+  using Result = system::OfflineAchievementResult;
+  switch (result) {
+    case Result::kSuccess: return X_ERROR_SUCCESS;
+    case Result::kNotFound: return X_ERROR_NOT_FOUND;
+    case Result::kInvalidArgument: return X_ERROR_INVALID_PARAMETER;
+    case Result::kStorageError: return X_ERROR_FUNCTION_FAILED;
+    case Result::kCorruptData:
+    case Result::kMetadataMismatch: return 13;  // ERROR_INVALID_DATA
+  }
+  return X_ERROR_FUNCTION_FAILED;
+}
+
+// Validate each page before dereferencing untrusted guest buffers. A heap
+// match alone does not imply committed/readable memory or prevent wraparound.
+inline bool AchievementGuestSpan(memory::Memory* mem, uint32_t address,
+                                 uint64_t size, uint32_t access) {
+  if (!address || !size || uint64_t(address) + size > 0x1'0000'0000ull) return false;
+  const uint64_t end = uint64_t(address) + size;
+  for (uint64_t page = address; page < end; page = (page & ~0xFFFull) + 0x1000) {
+    auto* heap = mem->LookupHeap(static_cast<uint32_t>(page));
+    memory::HeapAllocationInfo info{};
+    if (!heap || !heap->QueryRegionInfo(static_cast<uint32_t>(page), &info) ||
+        !(info.state & memory::kMemoryAllocationCommit) || (info.protect & access) != access)
+      return false;
+  }
+  return true;
+}
+
+}  // namespace rex::kernel::xam
