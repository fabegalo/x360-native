diff --git a/src/base/exception_context_win.h b/src/base/exception_context_win.h
new file mode 100644
--- /dev/null
+++ b/src/base/exception_context_win.h
@@ -0,0 +1,67 @@
+// Copyright 2015 Ben Vanik. All rights reserved.
+// Released under the BSD license; see LICENSE in the SDK root.
+// Adapted for ReXGlue and x360-native: shared Windows native context mapping.
+#pragma once
+
+#include <cstring>
+#include <rex/bit.h>
+#include <rex/platform/exception_handler.h>
+#include "platform_win.h"
+
+namespace rex::platform::detail {
+inline HostThreadContext CaptureWindowsContext(const CONTEXT& native) {
+  HostThreadContext context{};
+#if REX_ARCH_AMD64
+  context.rip = native.Rip;
+  context.eflags = native.EFlags;
+  std::memcpy(context.int_registers, &native.Rax, sizeof(context.int_registers));
+  std::memcpy(context.xmm_registers, &native.Xmm0, sizeof(context.xmm_registers));
+#elif REX_ARCH_ARM64
+  static_assert(sizeof(context.x) == sizeof(native.X));
+  static_assert(sizeof(context.v) == sizeof(native.V));
+  std::memcpy(context.x, native.X, sizeof(context.x));
+  context.sp = native.Sp;
+  context.pc = native.Pc;
+  context.pstate = native.Cpsr;
+  context.fpsr = native.Fpsr;
+  context.fpcr = native.Fpcr;
+  std::memcpy(context.v, native.V, sizeof(context.v));
+#endif
+  return context;
+}
+
+inline void ApplyWindowsContext(CONTEXT& native, const Exception& exception) {
+  const auto& context = *exception.GetThreadContext();
+  u32 index;
+#if REX_ARCH_AMD64
+  native.Rip = context.rip;
+  native.EFlags = context.eflags;
+  u16 integers = exception.GetModifiedIntRegisters();
+  while (rex::bit_scan_forward(integers, &index)) {
+    integers &= ~(UINT16_C(1) << index);
+    (&native.Rax)[index] = context.int_registers[index];
+  }
+  u16 vectors = exception.GetModifiedXMMRegisters();
+  while (rex::bit_scan_forward(vectors, &index)) {
+    vectors &= ~(UINT16_C(1) << index);
+    std::memcpy(&native.Xmm0 + index, &context.xmm_registers[index], sizeof(VectorRegister));
+  }
+#elif REX_ARCH_ARM64
+  native.Pc = context.pc;
+  native.Sp = context.sp;
+  native.Cpsr = static_cast<DWORD>(context.pstate);
+  native.Fpsr = context.fpsr;
+  native.Fpcr = context.fpcr;
+  u32 integers = exception.GetModifiedXRegisters();
+  while (rex::bit_scan_forward(integers, &index)) {
+    integers &= ~(UINT32_C(1) << index);
+    native.X[index] = context.x[index];
+  }
+  u32 vectors = exception.GetModifiedVRegisters();
+  while (rex::bit_scan_forward(vectors, &index)) {
+    vectors &= ~(UINT32_C(1) << index);
+    std::memcpy(&native.V[index], &context.v[index], sizeof(VectorRegister));
+  }
+#endif
+}
+}  // namespace rex::platform::detail
