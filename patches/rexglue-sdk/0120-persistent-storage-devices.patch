+// Every ancestor is checked, including the configured environment root. In
+// particular, Windows junctions are reparse points even when is_symlink is false.
+bool IsUnlinkedStoragePath(const std::filesystem::path& path) {
+  if (path.empty()) return false;
+  for (auto p = std::filesystem::absolute(path).lexically_normal(); !p.empty();) {
+    std::error_code ec;
+    const auto status = std::filesystem::symlink_status(p, ec);
+    if (ec && ec != std::errc::no_such_file_or_directory) return false;
+    if (std::filesystem::is_symlink(status)) return false;
+#ifdef _WIN32
+    const auto attrs = GetFileAttributesW(p.c_str());
+    if (attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_REPARSE_POINT)) return false;
+#endif
+    auto parent = p.parent_path();
+    if (parent == p) break;
+    p = parent;
+  }
+  return true;
+}
+
+X_RESULT QueryContentDeviceSpace(ContentDeviceInfo& device) {
+  std::error_code ec;
+  if (!IsUnlinkedStoragePath(device.root) || !std::filesystem::is_directory(device.root, ec))
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  const auto space = std::filesystem::space(device.root, ec);
+  if (ec) return X_ERROR_ACCESS_DENIED;
+  uint64_t used = 0;
+  if (device.capacity_limit) {
+    std::filesystem::recursive_directory_iterator it(device.root, ec), end;
+    if (ec) return X_ERROR_ACCESS_DENIED;
+    for (; it != end; it.increment(ec)) {
+      if (ec || !IsUnlinkedStoragePath(it->path())) return X_ERROR_ACCESS_DENIED;
+      // Secondary volumes have independent accounting; never count them in HDD.
+      if (device.device_id == 1 && it->path() == device.root / "storage") {
+        it.disable_recursion_pending(); continue;
+      }
+      if (it->is_regular_file(ec)) {
+        const auto size = it->file_size(ec);
+        if (ec || size > UINT64_MAX - used) return X_ERROR_ACCESS_DENIED;
+        used += size;
+      }
+      if (ec) return X_ERROR_ACCESS_DENIED;
+    }
+    if (ec) return X_ERROR_ACCESS_DENIED;
+  }
+  const auto available = space.available > device.reserve_bytes ? space.available - device.reserve_bytes : 0;
+  device.total_bytes = device.capacity_limit ? std::min(device.capacity_limit, space.capacity) : space.capacity;
+  const auto remaining = device.total_bytes > used ? device.total_bytes - used : 0;
+  device.free_bytes = device.capacity_limit
+      ? std::min(available, remaining > device.reserve_bytes ? remaining - device.reserve_bytes : 0) : available;
+  if (device.device_type == DeviceType::ODD) device.free_bytes = 0;
+  return X_ERROR_SUCCESS;
+}
+
+// Content mounts use the same volume accounting as XAM, including quota checks
+// for growth. Ordinary unlimited volumes add no scan to the I/O hot path.
+class ContentVolumeDevice : public filesystem::HostPathDevice {
+ public:
+  ContentVolumeDevice(std::string_view mount, const std::filesystem::path& path,
+                      ContentDeviceInfo volume)
+      : HostPathDevice(mount, path, false, true), volume_(std::move(volume)) {}
+  bool is_accessible() const override {
+    std::error_code ec;
+    return IsUnlinkedStoragePath(volume_.root) && std::filesystem::is_directory(volume_.root, ec);
+  }
+  X_STATUS QueryVolumeSize(uint64_t& total, uint64_t& free) const override {
+    auto snapshot = volume_;
+    const auto result = QueryContentDeviceSpace(snapshot);
+    if (result) return X_STATUS_UNSUCCESSFUL;
+    total = snapshot.total_bytes; free = snapshot.free_bytes;
+    return X_STATUS_SUCCESS;
+  }
+  bool has_capacity_limit() const override { return volume_.capacity_limit || volume_.reserve_bytes; }
+  X_STATUS CheckGrowth(uint64_t bytes) const override {
+    if (!bytes || !has_capacity_limit()) return X_STATUS_SUCCESS;
+    auto snapshot = volume_;
+    if (QueryContentDeviceSpace(snapshot)) return X_STATUS_ACCESS_DENIED;
+    // STATUS_DISK_FULL maps to Win32 ERROR_DISK_FULL in the pinned kernel table.
+    return bytes <= snapshot.free_bytes ? X_STATUS_SUCCESS : X_STATUS(0xC000007Fu);
+  }
+ private:
+  ContentDeviceInfo volume_;
+};
