 namespace rex::filesystem {
 
+X_STATUS HostPathDevice::QueryVolumeSize(uint64_t& total, uint64_t& available) const {
+  std::error_code ec;
+  const auto space = std::filesystem::space(host_path_, ec);
+  if (ec) return X_STATUS_UNSUCCESSFUL;
+  total = space.capacity;
+  available = read_only_ ? 0 : space.available;
+  return X_STATUS_SUCCESS;
+}
+uint32_t HostPathDevice::total_allocation_units() const {
+  uint64_t total = 0, available = 0;
+  return QueryVolumeSize(total, available) ? 0 : uint32_t(std::min<uint64_t>(total / 512, UINT32_MAX));
+}
+uint32_t HostPathDevice::available_allocation_units() const {
+  uint64_t total = 0, available = 0;
+  return QueryVolumeSize(total, available) ? 0 : uint32_t(std::min<uint64_t>(available / 512, UINT32_MAX));
+}
