+std::optional<ContentDeviceInfo> ContentManager::GetDevice(uint32_t id) const {
+  if (!devices_valid_) return std::nullopt;
+  const auto it = std::find_if(devices_.begin(), devices_.end(), [&](const auto& d) { return d.device_id == id; });
+  if (it == devices_.end()) return std::nullopt;
+  auto snapshot = *it;
+  if (QueryContentDeviceSpace(snapshot)) return std::nullopt;
+  return snapshot;
+}
