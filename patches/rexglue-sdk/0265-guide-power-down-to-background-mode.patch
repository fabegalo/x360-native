+REX_TEST_CASE("Guide background power down uses the existing firmware shutdown lifecycle", "[kernel][xam][firmware-exit]") {
+  KernelFixture fixture;
+  bool returned = false;
+  fixture.RunUntilGuestThreadEnds([&](Caller& c) {
+    c.Kernel("HalPowerDownToBackgroundMode");
+    returned = true;
+  });
+  CHECK_FALSE(returned);
+  const auto& loader = rex::xam::CurrentXAM().GetLoaderState();
+  CHECK(loader.exit_request == rex::xam::XAMLoaderState::ExitRequest::Firmware);
+  CHECK(loader.firmware_routine == 5);
+}
