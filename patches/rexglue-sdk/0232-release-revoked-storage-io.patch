diff --git a/src/filesystem/provider.cpp b/src/filesystem/provider.cpp
--- a/src/filesystem/provider.cpp
+++ b/src/filesystem/provider.cpp
@@ -16,6 +16,25 @@
 Provider::Provider(MountEntry entry) : entry_(std::move(entry)) {}
 
 Provider::~Provider() = default;
+
+void Provider::Revoke() {
+  std::lock_guard lock(mutex_);
+  revoked_.store(true, std::memory_order_release);
+  for (auto* stream : open_streams_) stream->Revoke();
+}
+
+void Provider::RegisterStream(NodeStream& stream) {
+  if (!HasFlags(entry_.flags, MountFlags::kRevokeOnUnmount)) return;
+  std::lock_guard lock(mutex_);
+  open_streams_.push_back(&stream);
+  if (revoked_.load(std::memory_order_acquire)) stream.Revoke();
+}
+
+void Provider::UnregisterStream(NodeStream& stream) {
+  if (!HasFlags(entry_.flags, MountFlags::kRevokeOnUnmount)) return;
+  std::lock_guard lock(mutex_);
+  std::erase(open_streams_, &stream);
+}
 
 Node* Provider::Resolve(std::string_view path) {
   return root_->ResolvePath(path);
