 const Key& MasterKey(XEXKey key) {
+#if defined(REX_STATIC_BASE)
+  // Desktop distribution permits only the public XEX2 defaults; XEX1 uses local keys.
+  static constexpr std::array<Key, 2> content_keys = {kMasterKeys[0], kMasterKeys[1]};
+  static constexpr Key absent{};
+  const auto index = static_cast<size_t>(key);
+  return index < content_keys.size() ? content_keys[index] : absent;
+#else
   return kMasterKeys[static_cast<size_t>(key)];
+#endif
 }
 
 Result<Key> ResolveMasterKey(XEXKey key) {
   if (key == XEXKey::kRetail || key == XEXKey::kDevKit) return MasterKey(key);
   auto path = XEXOptions().keys_file.Get();
   if (path.empty()) path = platform::GetEnvironmentValue("X360N_XEX_KEYS").value_or("");
+#if defined(REX_STATIC_BASE)
+  if (path.empty()) return Err<Key>(ErrorCategory::kCrypto, "XEX1 requires a local wrapping-key file");
+#else
   if (path.empty()) return MasterKey(key);
+#endif
   std::ifstream in{string::to_path(path)};
   if (!in) return Err<Key>(ErrorCategory::kCrypto, "Local XEX key file cannot be opened");
   const std::string wanted = key == XEXKey::kRetailXEX1 ? "xex1-retail" : "xex1-devkit";
