diff --git a/tests/unit/kernel/xam_test.cpp b/tests/unit/kernel/xam_test.cpp
--- a/tests/unit/kernel/xam_test.cpp
+++ b/tests/unit/kernel/xam_test.cpp
@@ -1341,3 +1341,32 @@
   CHECK(loader.exit_request == rex::xam::XAMLoaderState::ExitRequest::Firmware);
   CHECK(loader.firmware_routine == 5);
 }
+
+
+REX_TEST_CASE("original app stack close remains distinct from self close until the owner unloads", "[kernel][xam][system-ui-session]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    CHECK(c.XAM("XamAppUnloadStack", {0}) == 1627);
+    REQUIRE(ui.RegisterSystemApp({5, 2, 0x1234, 0}) == 0);
+    REQUIRE(ui.BeginSystemUi(5, 2, 0));
+    REQUIRE(ui.SetSystemUiVisible(5));
+    CHECK(c.XAM("XamAppUnloadStack", {1}) == 87);
+    CHECK_FALSE(ui.GetSystemUiSession().close_requested);
+    CHECK(c.XAM("XamAppUnloadSelf") == 0);
+    CHECK(ui.GetSystemUiSession().close_requested);
+    CHECK_FALSE(ui.GetSystemUiSession().close_stack_requested);
+    CHECK(c.XAM("XamAppUnloadStack", {0}) == 0);
+    CHECK(ui.GetSystemUiSession().close_stack_requested);
+    CHECK(ui.GetSystemUiSession().visible);
+    CHECK(c.XAM("XamAppUnloadSelf") == 0);
+    CHECK(ui.GetSystemUiSession().close_stack_requested);
+    CHECK_FALSE(ui.EndSystemUi(6));
+    REQUIRE(ui.EndSystemUi(5));
+    CHECK_FALSE(ui.GetSystemUiSession().close_stack_requested);
+    REQUIRE(ui.BeginSystemUi(5, 2, 0));
+    CHECK_FALSE(ui.GetSystemUiSession().close_requested);
+    CHECK_FALSE(ui.GetSystemUiSession().close_stack_requested);
+    REQUIRE(ui.EndSystemUi(5));
+  });
+}
