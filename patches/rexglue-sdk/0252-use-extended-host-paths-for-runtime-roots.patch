 namespace rex {
 namespace filesystem {
 
+std::filesystem::path HostPath(const std::filesystem::path& path) {
+#ifdef _WIN32
+  if (path.empty()) return path;
+  std::error_code ec;
+  // GetFullPathNameW resolves '.', '..' and '/' before the prefix disables it.
+  const auto name =
+      std::filesystem::absolute(path, ec).lexically_normal().make_preferred().native();
+  if (ec) return path;
+  if (name.starts_with(L"\\\\?\\") || name.starts_with(L"\\\\.\\")) return name;
+  return name.starts_with(L"\\\\") ? L"\\\\?\\UNC\\" + name.substr(2) : L"\\\\?\\" + name;
+#else
+  return path;
+#endif
+}
+
+std::filesystem::path OrdinaryPath(const std::filesystem::path& path) {
+#ifdef _WIN32
+  const auto& name = path.native();
+  if (name.starts_with(L"\\\\?\\UNC\\")) return L"\\\\" + name.substr(8);
+  if (name.starts_with(L"\\\\?\\") && name.size() > 5 && name[5] == L':') return name.substr(4);
+#endif
+  return path;
+}
