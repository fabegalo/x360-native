+REX_TEST_CASE_METHOD(StepFixture, "setup and launch failures preserve app drivers and window until shutdown", "[ui][title_app][setup-ownership]") {
+  rex::ScopeGuard reset_attach([] { rex::test::g_counts.fail_graphics_attach = false; });
+  const auto invalid_host = +[](PPCContext&, rex::u8*) {};
+  const PPCFuncMapping invalid_mappings[] = {{0x00010000, invalid_host}, {0, nullptr}};
+  for (const unsigned failure : {0u, 1u, 2u}) {
+    CAPTURE(failure);
+    rex::test::g_counts.Reset();
+    auto image = rex::test::MakeTitleImage();
+    if (failure == 1) image.func_mappings = invalid_mappings;
+    else if (failure == 0) image.code_base = 0xFFFF0000;
+    StepApp app(image);
+    rex::test::g_counts.fail_graphics_attach = failure == 2;
+    REQUIRE(app.Start());
+    REQUIRE(app.GetUI().HasWindow());
+    REQUIRE(app.GetGraphics().HasDriver());
+    CHECK_FALSE(app.LaunchTitle());
+    // Official setup validates image tables before graphics attachment; failed attach owns no title state.
+    CHECK(rex::test::g_counts.graphics_attach == (failure == 2 ? 1 : 0));
+    CHECK(rex::test::g_counts.graphics_detach == 0);
+    CHECK(rex::test::g_counts.graphics_shutdown == 0);
+    CHECK(rex::test::g_counts.input_shutdown == 0);
+    CHECK(app.GetGraphics().HasDriver());
+    CHECK(app.GetUI().HasWindow());
+    CHECK(REX_RUNTIME() == nullptr);
+    CHECK(app.Shutdown() == 1);
+    CHECK(rex::test::g_counts.graphics_shutdown == 1);
+    CHECK(rex::test::g_counts.input_shutdown == 1);
+    CHECK(rex::test::g_counts.ui_close == 1);
+    CHECK_FALSE(rex::test::g_counts.ui_closed_with_runtime.load());
+    CHECK_FALSE(app.GetUI().HasWindow());
+    CHECK(app.Shutdown() == 1);
+    CHECK(rex::test::g_counts.graphics_shutdown == 1);
+  }
+}
