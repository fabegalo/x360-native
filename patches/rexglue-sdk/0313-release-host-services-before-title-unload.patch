+rex::ScopeGuard TitleState::OnTitleUnload(rex::MoveOnlyFunction<void()> callback) {
+  u64 serial;
+  {
+    std::lock_guard lock(title_exit_mutex_);
+    title_unload_callback_ = std::move(callback);
+    serial = ++title_unload_serial_;
+  }
+  return rex::ScopeGuard([this, serial] {
+    std::lock_guard lock(title_exit_mutex_);
+    if (title_unload_serial_ == serial) title_unload_callback_ = nullptr;
   });
