+f32 ShaderInterpreter::ReduceFloatPrecision(f32 value,
+                                              u32 mantissa_bits) {
+  REX_ASSERT(mantissa_bits > 0 && mantissa_bits < 23);
+
+  u32 value_bits;
+  std::memcpy(&value_bits, &value, sizeof(value_bits));
+
+  if ((value_bits & UINT32_C(0x7F800000)) == UINT32_C(0x7F800000)) {
+    return value;
+  }
+
+  u32 truncate_bits = 23 - mantissa_bits;
+  u32 discarded_mask = (static_cast<u32>(1) << truncate_bits) - 1;
+  u32 truncated_bits = value_bits & ~discarded_mask;
+  u32 rounded_bits = truncated_bits + (static_cast<u32>(1) << truncate_bits);
+
+  // Don't let this rounding turn a finite host result into infinity.
+  if ((rounded_bits & UINT32_C(0x7F800000)) == UINT32_C(0x7F800000)) {
+    rounded_bits = truncated_bits;
+  }
+
+  u32 round_bit = static_cast<u32>(1) << (truncate_bits - 1);
+  u32 result_bits = (value_bits & discarded_mask) >= round_bit
+                             ? rounded_bits
+                             : truncated_bits;
+  f32 result;
+  std::memcpy(&result, &result_bits, sizeof(result));
+  return result;
+}
