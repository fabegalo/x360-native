-REX_EXPORT_STUB(__imp__XCustomGetBannerImage);
+// No custom banner provider is implemented. Return an explicit failed HRESULT,
+// never an unchanged output-pointer register interpreted as successful image data.
+// The only known caller (Retail 1888 HUD 913E31E8) passes one stack word in r3
+// and reads it only when r3 >= 0, keeping its own fallback artwork otherwise.
+// Guest memory is not written: other callers' argument layouts are unverified.
+extern "C" REX_FUNC(__imp__XCustomGetBannerImage) {
+  ctx.r3.u64 = ctx.r3.u32 ? 0x80004001u : 0x80070057u;
+}
