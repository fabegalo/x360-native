+  // The result is the length of the matching prefix in BYTES, not words.
+  // 17559 tests its four passcode bytes against zero and expects exactly 4.
+  // as_array uses guest-endian elements; stop at the first differing ULONG.
+  uint32_t matched = 0;
+  const auto words = source.as_array<uint32_t>();
+  while (matched < length && uint32_t(words[matched / 4]) == pattern) {
+    matched += 4;
+  }
+  return matched;
 }

