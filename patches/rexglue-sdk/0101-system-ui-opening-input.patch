+// Both HUD ABIs use the same ownership rule, including delayed transitions
+// and repeats. Stop at the first unrelated event and preserve its payload.
+uint32_t GetSystemUiKeystroke(rex::input::InputSystem* backend, uint32_t user,
+                              X_INPUT_KEYSTROKE* stroke) {
+  if (!backend) return X_ERROR_DEVICE_NOT_CONNECTED;
+  for (;;) {
+    const auto result = backend->GetKeystroke(user, 1, stroke);
+    if (result != X_ERROR_SUCCESS || !NoteSystemUiKeystroke(*stroke)) return result;
+  }
+}
