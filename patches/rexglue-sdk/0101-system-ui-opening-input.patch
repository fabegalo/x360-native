+  if (window_ms <= 0 || user >= 4) return backend->GetKeystroke(user, flags, stroke);
+  std::lock_guard chord_lock(guide_chord_mutex);
+  auto& chord = guide_chords[user];
+  if (!chord.pending) {
+    const auto result = backend->GetKeystroke(user, flags, stroke);
+    const uint16_t key_flags = uint16_t(stroke->flags);
+    if (result != X_ERROR_SUCCESS || !ChordButton(uint16_t(stroke->virtual_key)) ||
+        !(key_flags & rex::input::X_INPUT_KEYSTROKE_KEYDOWN) ||
+        (key_flags & (rex::input::X_INPUT_KEYSTROKE_KEYUP | rex::input::X_INPUT_KEYSTROKE_REPEAT)))
+      return result;
+    chord = {true, *stroke, std::chrono::steady_clock::now()};
+  }
+  X_INPUT_STATE held{};
+  const bool connected = backend->GetState(user, &held) == X_ERROR_SUCCESS;
+  const uint16_t buttons = connected ? uint16_t(held.gamepad.buttons) : 0;
+  if (buttons & rex::input::X_INPUT_GAMEPAD_GUIDE) {
+    // The chord is a Guide press: neither the title nor the HUD receives
+    // its controls. Their repeats and key-ups are dropped until release.
+    const uint32_t keys = PadKeysFromState(held) | PadKeyBit(uint16_t(chord.stroke.virtual_key));
+    chord.pending = false;
+    std::lock_guard lock(system_ui_latch_mutex);
+    auto& latch = system_ui_latches[user];
+    latch.keys |= keys;
+    latch.opening_keys |= keys;
+    latch.armed = true;
+    return X_ERROR_EMPTY;
+  }
+  const auto elapsed = std::chrono::steady_clock::now() - chord.since;
+  if ((buttons & ChordButton(uint16_t(chord.stroke.virtual_key))) &&
+      elapsed < std::chrono::milliseconds(window_ms))
+    return X_ERROR_EMPTY;
+  chord.pending = false;
+  *stroke = chord.stroke;
