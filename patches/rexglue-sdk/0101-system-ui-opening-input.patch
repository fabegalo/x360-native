+// Some controllers report the Guide only as BACK+START: GUIDE appears with the
+// second button, after the first already produced a key-down that the
+// foreground title or open HUD would act on. With guide_chord_ms > 0, that
+// first BACK/START key-down waits until GUIDE appears (the chord then belongs
+// to the system UI until released), the key is released, or the window ends.
+// Later keystrokes stay queued behind it, so order is preserved.
+struct GuideChord {
+  bool pending = false;
+  X_INPUT_KEYSTROKE stroke{};
+  std::chrono::steady_clock::time_point since{};
+};
+std::mutex guide_chord_mutex;  // serializes fetches through the chord stage
+GuideChord guide_chords[4];
+
+uint16_t ChordButton(uint16_t virtual_key) {
+  return virtual_key == 0x5814 ? uint16_t(rex::input::X_INPUT_GAMEPAD_START)
+       : virtual_key == 0x5815 ? uint16_t(rex::input::X_INPUT_GAMEPAD_BACK) : 0;
+}
