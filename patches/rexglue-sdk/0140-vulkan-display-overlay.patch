+void VulkanCommandProcessor::DestroyDisplayOverlay() {
+  const auto* vd = GetVulkanDevice();
+  const auto& fn = vd->GetFunctions(); const auto device = vd->GetDevice();
+  gpu::vulkan::objects::DestroyAndNullHandle(fn.vkDestroyImageView, device, display_overlay_view_);
+  gpu::vulkan::objects::DestroyAndNullHandle(fn.vkDestroyImage, device, display_overlay_image_);
+  gpu::vulkan::objects::DestroyAndNullHandle(fn.vkFreeMemory, device, display_overlay_memory_);
+  gpu::vulkan::objects::DestroyAndNullHandle(fn.vkDestroyPipeline, device, display_overlay_pipeline_);
+  gpu::vulkan::objects::DestroyAndNullHandle(fn.vkDestroyPipelineLayout, device, display_overlay_pipeline_layout_);
+  gpu::vulkan::objects::DestroyAndNullHandle(fn.vkDestroyDescriptorPool, device, display_overlay_pool_);
+  gpu::vulkan::objects::DestroyAndNullHandle(fn.vkDestroyDescriptorSetLayout, device, display_overlay_set_layout_);
+  display_overlay_width_ = display_overlay_height_ = 0;
+  display_overlay_layout_ = VK_IMAGE_LAYOUT_UNDEFINED;
+}
