+namespace rex::xam {
+
+/** One title's launch handoff, owned by XAM until DetachTitle. */
+struct XAMLoaderState {
+  enum class ExitRequest { None, Dashboard, Terminate };
+  ExitRequest exit_request = ExitRequest::None;
+  bool launch_data_present = false;
+  std::vector<u8> launch_data;
+  u32 launch_flags = 0;
+  std::string launch_path;
+};
+
+}  // namespace rex::xam
