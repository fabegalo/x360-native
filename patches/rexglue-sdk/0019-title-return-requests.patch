+
+REX_TEST_CASE("title return distinguishes dashboard, termination and explicit image handoffs", "[kernel][xam][title-return]") {
+  for (const u32 kind : {0u, 1u, 2u}) {
+    KernelFixture fixture;
+    auto& loader = rex::xam::CurrentXAM().GetLoaderState();
+    loader.launch_path = "stale.xex";
+    loader.launch_flags = 0x1234;
+    loader.launch_data_present = true;
+    loader.launch_data = {1, 2, 3};
+    loader.exit_request = rex::xam::XAMLoaderState::ExitRequest::Terminate;
+    bool returned = false;
+    fixture.RunUntilGuestThreadEnds([&](Caller& c) {
+      if (kind == 1) c.XAM("XamLoaderTerminateTitle");
+      else c.XAM("XamLoaderLaunchTitle", {kind == 2 ? c.AllocString("") : 0, 0x20});
+      returned = true;
+    });
+    CHECK_FALSE(returned);
+    CHECK(loader.launch_data_present);
+    CHECK(loader.launch_data == std::vector<u8>{1, 2, 3});
+    using Exit = rex::xam::XAMLoaderState::ExitRequest;
+    CHECK(loader.exit_request == (kind == 0 ? Exit::Dashboard : kind == 1 ? Exit::Terminate : Exit::None));
+    CHECK(loader.launch_flags == (kind == 1 ? 0 : 0x20));
+    if (kind == 2) CHECK(loader.launch_path == "game:\\default.xex");
+    else CHECK(loader.launch_path.empty());
+  }
+}
