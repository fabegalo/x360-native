+REX_TEST_CASE("drain waits for queued samples to leave a partial device pull", "[apu][audio-drain]") {
+  Run({{"apu.driver", "fake"}, {"apu.peak_limit", "0"}}, [](rex::apu::IAudioSystem& audio) {
+    g_device.pull.SetPaused(true);
+    std::this_thread::sleep_for(std::chrono::milliseconds(30));
+    (void)g_device.Take();
+    g_device.pull.SetRequest(kPeriodFrames / 2);
+    std::atomic<unsigned> credited{0};
+    const auto stream = audio.OpenStream([&] { ++credited; });
+    REQUIRE(stream);
+    REQUIRE(audio.Submit(*stream, Constant(0.25f)));
+    std::atomic<bool> returned{false}, succeeded{false};
+    std::jthread drain([&] {
+      succeeded = audio.DrainStream(*stream).has_value();
+      returned = true;
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    CHECK_FALSE(returned.load());
+    g_device.pull.SetPaused(false);
+    REQUIRE(WaitFor([&] { return returned.load(); }));
+    drain.join();
+    REQUIRE(succeeded.load());
+    CHECK(credited.load() == 1);
+    REQUIRE(WaitFor([&] { return g_device.GetBlockCount() >= 4; }));
+    size_t samples = 0;
+    for (const auto& block : g_device.Take()) for (const auto sample : block) {
+      if (sample != 0.0f) {
+        CHECK(Near(sample, 0.25f, 1e-6f));
+        ++samples;
+      }
+    }
+    CHECK(samples == rex::apu::kAudioFrameSamples);
+    audio.CloseStream(*stream);
+    CHECK_FALSE(audio.DrainStream(*stream));
+    CHECK_FALSE(audio.DrainStream(rex::apu::AudioStreamID{0}));
+  });
+}
+
+REX_TEST_CASE("a stalled audio drain fails without discarding its queued frame", "[apu][audio-drain]") {
+  Run({{"apu.driver", "fake"}}, [](rex::apu::IAudioSystem& audio) {
+    g_device.pull.SetPaused(true);
+    std::this_thread::sleep_for(std::chrono::milliseconds(30));
+    const auto stream = audio.OpenStream([] {});
+    REQUIRE(stream);
+    REQUIRE(audio.Submit(*stream, Constant(0.125f)));
+    const auto failed = audio.DrainStream(*stream);
+    CHECK_FALSE(failed);
+    CHECK(audio.GetStats().queued_frames == 1);
+    g_device.pull.SetPaused(false);
+    REQUIRE(audio.DrainStream(*stream));
+    CHECK(audio.GetStats().queued_frames == 0);
+    audio.CloseStream(*stream);
+  });
+}
+
+REX_TEST_CASE("stopping the mixer drains submitted frames from open streams", "[apu][audio-drain]") {
+  g_device.Reset();
+  std::atomic<unsigned> credited{0};
+  AudioApp app({{"apu.driver", "fake"}, {"apu.peak_limit", "0"}});
+  app.body = [&](rex::apu::IAudioSystem& audio) {
+    const auto stream = audio.OpenStream([&] { ++credited; });
+    REQUIRE(stream);
+    for (unsigned i = 0; i < 3; ++i) REQUIRE(audio.Submit(*stream, Constant(0.25f)));
+  };
+  REQUIRE(app.Start());
+  app.Finish();
+  CHECK(credited.load() == 3);
+  size_t samples = 0;
+  for (const auto& block : g_device.Take()) for (const auto sample : block)
+    if (sample != 0.0f) ++samples;
+  CHECK(samples == 3 * rex::apu::kAudioFrameSamples);
+}
