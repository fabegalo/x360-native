+Result<void> AudioSystem::DrainStream(rex::apu::AudioStreamID stream) {
+  State& s = *state_;
+  const u32 index = static_cast<u32>(stream);
+  if (!index || index > kMaxStreams)
+    return Err(ErrorCategory::kNotFound, "unknown audio stream");
+  std::unique_lock lock(s.mutex);
+  Slot& slot = s.slots[index - 1];
+  const u32 generation = slot.generation;
+  const bool ready = s.drained.wait_for(lock, std::chrono::seconds(2), [&] {
+    return !slot.open || slot.generation != generation || s.stop.load() ||
+           (slot.queue.empty() && !slot.in_flight);
+  });
+  if (!slot.open || slot.generation != generation)
+    return Err(ErrorCategory::kNotFound, "audio stream closed during drain");
+  if (!ready || s.stop.load())
+    return Err(ErrorCategory::kRuntime, "audio stream drain timed out or mixer stopped");
+  return Ok();
 }
 
