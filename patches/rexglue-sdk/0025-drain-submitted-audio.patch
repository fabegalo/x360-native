diff --git a/src/apu/sdl3/sdl3_audio_driver.cpp b/src/apu/sdl3/sdl3_audio_driver.cpp
--- a/src/apu/sdl3/sdl3_audio_driver.cpp
+++ b/src/apu/sdl3/sdl3_audio_driver.cpp
@@ -99,6 +99,30 @@
 
 void SDL3AudioDriver::CloseDevice() {
   if (stream_) {
+    // Detaching waits for a running pull callback, then prevents endless silence during flush.
+    if (!SDL_SetAudioStreamGetCallback(stream_, nullptr, nullptr)) {
+      REXAPU_WARN("audio shutdown: could not detach callback: {}", SDL_GetError());
+    } else {
+      bool drained = SDL_FlushAudioStream(stream_);
+      const u64 deadline = SDL_GetTicks() + 2000;
+      while (drained) {
+        const int queued = SDL_GetAudioStreamQueued(stream_);
+        const int available = SDL_GetAudioStreamAvailable(stream_);
+        if (queued < 0 || available < 0) { drained = false; break; }
+        if (!queued && !available) break;
+        if (SDL_GetTicks() >= deadline) { drained = false; break; }
+        SDL_Delay(1);
+      }
+      if (drained) {
+        SDL_AudioSpec format{};
+        int device_frames = 0;
+        if (SDL_GetAudioDeviceFormat(SDL_GetAudioStreamDevice(stream_), &format, &device_frames) &&
+            format.freq > 0 && device_frames > 0)
+          SDL_Delay(static_cast<u32>((static_cast<u64>(device_frames) * 1000 + format.freq - 1) / format.freq));
+      } else {
+        REXAPU_WARN("audio shutdown: drain failed/timed out; remaining audio discarded: {}", SDL_GetError());
+      }
+    }
     SDL_DestroyAudioStream(stream_);
     stream_ = nullptr;
   }
