+
+Result<std::filesystem::path> FileSystem::ResolveHostPath(std::string_view path) {
+  std::lock_guard lock(mutex_);
+  const auto mount_lock = LockMount(path);
+  REX_TRY(Resolved resolved, ResolveMount(path));
+  if (!resolved.provider->IsAccessible()) {
+    return Err<std::filesystem::path>(BuildError(FileSystemError::kAccessDenied,
+                                               "the volume is disconnected"));
+  }
+  REX_TRY(Node * node, ResolveNode(path));
+  auto* host = dynamic_cast<HostNode*>(node);
+  if (!host) {
+    return Err<std::filesystem::path>(BuildError(FileSystemError::kUnsupported,
+                                               "the guest path has no host file"));
+  }
+  return host->GetHostPath();
 }
 
