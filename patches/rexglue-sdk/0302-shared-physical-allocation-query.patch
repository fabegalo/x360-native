+REX_TEST_CASE("physical allocation queries preserve all aliases and reject inaccessible pages", "[kernel][title_context][physical-range-query]") {
+  rex::test::KernelFixture fixture;
+  auto& memory = *StateOf(fixture.GetRuntime()).GetAddressSpace();
+  rex::kernel::TitleContext context(fixture.GetRuntime());
+  CHECK_FALSE(context.IsPhysicalRangeAllocated({0, 0}));
+  CHECK_FALSE(context.IsPhysicalRangeAllocated({0x1FFFFFF0, 0x20}));
+  CHECK_FALSE(context.IsPhysicalRangeAllocated({0xFFFFFFF0, 0x20}));
+  for (auto [address, size] : std::array<std::pair<rex::u32, rex::u32>, 3>{
+      std::pair{0xE2000000u, 4096u}, {0xA4000000u, 65536u}, {0xC8000000u, 16u << 20}}) {
+    auto* heap = memory.LookupHeap(address);
+    REQUIRE(heap);
+    const auto physical = memory.GetPhysicalAddress(address);
+    CHECK_FALSE(context.IsPhysicalRangeAllocated({physical, size}));
+    REQUIRE(heap->AllocFixed(address, size, size,
+        rex::kernel::kMemoryAllocationReserve | rex::kernel::kMemoryAllocationCommit,
+        rex::kernel::kMemoryProtectRead | rex::kernel::kMemoryProtectWrite));
+    CHECK(context.IsPhysicalRangeAllocated({physical, size}));
+    CHECK(context.IsPhysicalRangeAllocated({physical + 1, size - 2}));
+    REQUIRE(heap->Protect(address, size, rex::kernel::kMemoryProtectNoAccess));
+    CHECK_FALSE(context.IsPhysicalRangeAllocated({physical, size}));
+  }
+}
