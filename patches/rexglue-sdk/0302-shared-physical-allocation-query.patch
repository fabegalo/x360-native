+bool GuestAddressSpace::IsPhysicalRangeAllocated(u32 address, u32 length) {
+  const u64 end = u64{address} + length;
+  if (!length || end > 0x20000000ull) return false;
+  for (u64 page = address & ~u64{4095}; page < end; page += 4096) {
+    bool allocated = false;
+    for (const u32 base : {0xE0000000u, 0xA0000000u, 0xC0000000u}) {
+      auto* heap = LookupHeap(base);
+      if (!heap || heap->GetHeapType() != HeapType::kGuestPhysical) continue;
+      const u32 origin = GetPhysicalAddress(base);
+      if (page < origin || page >= u64{origin} + heap->GetHeapSize()) continue;
+      u32 protect = 0;
+      if (heap->QueryProtect(base + static_cast<u32>(page - origin), &protect) && protect) {
+        allocated = true;
+        break;
+      }
+    }
+    if (!allocated) return false;
+  }
+  return true;
+}
