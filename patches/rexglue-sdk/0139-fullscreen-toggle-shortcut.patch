 void ReXApp::OnKeyDown(ui::KeyEvent& e) {
+  if (ui::IsFullscreenToggleKey(e)) {
+    // Only the first press toggles; held-key repeats are consumed.
+    if (!e.prev_state() && window_) ToggleFullscreen(*window_);
+    e.set_handled(true);
+    return;
+  }
   rex::ui::ProcessKeyEvent(e);
 }
 
