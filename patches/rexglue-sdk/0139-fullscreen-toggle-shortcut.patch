 namespace rex {
 
+namespace {
+// Alt+Enter and F11 toggle fullscreen, as in most PC games. Inside the
+// persistent session frame (parent_window) the frame owns fullscreen, so it is
+// asked to toggle (message WM_APP + 0x362); a standalone title toggles itself.
+void ToggleFullscreen(ui::Window& window) {
+#if REX_PLATFORM_WIN32
+  const auto parent = std::strtoull(rex::cvar::GetFlagByName("parent_window").c_str(), nullptr, 0);
+  if (parent) {
+    PostMessageW(reinterpret_cast<HWND>(uintptr_t(parent)), WM_APP + 0x362, 0, 0);
+    return;
+  }
+#endif
+  window.SetFullscreen(!window.IsFullscreen());
+}
+}  // namespace
+
 // --- ReXApp ---
 
