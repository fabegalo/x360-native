+// ObTranslateSymbolicLink(OBJECT_ATTRIBUTES* name, ANSI_STRING* target): follows every symbolic
+// link in the name and writes the final object path. XAM 17559 (8167FCD8) passes root -3 (\??)
+// for names without a leading backslash.
+u32 ObTranslateSymbolicLink_entry(ppc_ptr_t<X_OBJECT_ATTRIBUTES> attributes,
+                                  ppc_ptr_t<X_ANSI_STRING> target) {
+  auto* memory = REX_KERNEL_MEMORY();
+  auto name = rex::string::utf8_canonicalize_guest_path(util::TranslateAnsiPath(
+      memory, memory->TranslateVirtual<X_ANSI_STRING*>(attributes->name_ptr)));
+  if (rex::string::utf8_starts_with(name, u8"\\??\\")) {
+    name = name.substr(4);
+  }
+  std::string resolved;
+  if (!REX_KERNEL_FS()->ResolveSymbolicLink(name, resolved)) {
+    if (name.empty() || name[0] != '\\') {
+      REXKRNL_WARN("ObTranslateSymbolicLink({}) - not found", name);
+      return X_STATUS_OBJECT_NAME_NOT_FOUND;
+    }
+    resolved = name;  // already an object path
+  }
+  REXKRNL_DEBUG("ObTranslateSymbolicLink({}) -> {}", name, resolved);
+  if (resolved.size() > target->maximum_length) {
+    return X_STATUS_BUFFER_TOO_SMALL;
+  }
+  std::memcpy(memory->TranslateVirtual(target->pointer), resolved.data(), resolved.size());
+  target->length = static_cast<uint16_t>(resolved.size());
+  return X_STATUS_SUCCESS;
+}
