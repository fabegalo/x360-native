+void XeCryptMd5_entry(mapped_void input_1, u32 input_1_size, mapped_void input_2, u32 input_2_size,
+                      mapped_void input_3, u32 input_3_size, mapped_void output, u32 output_size) {
+  uint8_t digest[16] = {};
+#if !REX_PLATFORM_WIN32
+  bool ok = false;
+#else
+  BCRYPT_HASH_HANDLE hash = nullptr;
+  bool ok = BCRYPT_SUCCESS(BCryptCreateHash(BCRYPT_MD5_ALG_HANDLE, &hash, nullptr, 0, nullptr, 0, 0));
+  for (auto [input, size] : {std::pair{input_1, input_1_size}, std::pair{input_2, input_2_size},
+                             std::pair{input_3, input_3_size}}) {
+    if (ok && input && size) {
+      ok = BCRYPT_SUCCESS(BCryptHashData(hash, input.as<uint8_t*>(), size, 0));
+    }
+  }
+  ok = ok && BCRYPT_SUCCESS(BCryptFinishHash(hash, digest, sizeof(digest), 0));
+  if (hash) {
+    BCryptDestroyHash(hash);
+  }
+#endif
+  if (!ok) {
+    REXKRNL_ERROR("XeCryptMd5: BCrypt MD5 failed");
+  }
+  std::copy_n(digest, std::min<size_t>(sizeof(digest), output_size), output.as<uint8_t*>());
+}
