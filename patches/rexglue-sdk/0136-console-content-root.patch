+REX_TEST_CASE("successive runtimes use the same console hard drive without moving profile roots", "[kernel][title][console-content-root]") {
+  const rex::test::TempFolder disk("rex_console_content_");
+  rex::kernel::XCONTENT_AGGREGATE_DATA data{};
+  data.device_id = 1; data.xuid = 0; data.title_id = 0x12345678;
+  data.content_type = rex::kernel::XContentType::kArcadeTitle;
+  data.SetFileName("shared-package"); data.SetDisplayName(u"Generic content");
+  for (unsigned cycle = 0; cycle < 2; ++cycle) {
+    rex::test::LoadedTitle loaded({}, false, [&] {
+      REQUIRE(rex::kernel::GetTitlePaths().content_root.Set(disk.path));
+    });
+    rex::ScopeGuard restore([] { CHECK(rex::kernel::GetTitlePaths().content_root.Reset()); });
+    CHECK(rex::xam::CurrentTitle().user_data_root != disk.path);
+    auto& content = loaded.runtime.GetContentManager();
+    if (!cycle) {
+      REQUIRE(content.CreateContent("package", 0, data));
+      REQUIRE(content.CloseContent("package"));
+    }
+    auto items = content.ListContent(1, 0, rex::kernel::XContentType::kArcadeTitle, 0x12345678);
+    REQUIRE(items.size() == 1);
+    CHECK(items[0].GetFileName() == "shared-package");
+    CHECK(static_cast<rex::u32>(items[0].title_id) == 0x12345678);
+  }
+  CHECK(std::filesystem::is_directory(disk.path / "0000000000000000/12345678/000D0000/shared-package"));
+}
