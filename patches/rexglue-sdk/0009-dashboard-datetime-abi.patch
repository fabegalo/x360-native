+// Xenia Canary 2372a541: old dashboards pass locale, FILETIME, buffer, bytes;
+// new dashboards pass FILETIME, buffer, bytes. Decode before mapping pointers.
+// Raw registers also preserve all 64 FILETIME bits (the typed integer argument
+// translator in this SDK revision reads only the low 32 bits).
+void FormatDashboardDateTime(PPCContext& ctx, uint8_t* base, bool time_only) {
+  auto valid_time = [](uint64_t value) {
+    return value >= 125911584000000000ull && value <= 157469184000000000ull;
+  };
+  const bool legacy = valid_time(ctx.r4.u64);
+  const uint64_t filetime = legacy ? ctx.r4.u64 : ctx.r3.u64;
+  const uint32_t address = legacy ? ctx.r5.u32 : ctx.r4.u32;
+  const uint32_t bytes = legacy ? ctx.r6.u32 : ctx.r5.u32;
+  if (!valid_time(filetime) || !address) {
+    REXKRNL_WARN("XamFormat{}String: invalid FILETIME or null output", time_only ? "Time" : "Date");
+    return;
+  }
+  const uint32_t characters = bytes / sizeof(char16_t);
+  if (!characters) return;
 #if REX_PLATFORM_WIN32
-static SYSTEMTIME xeGetLocalSystemTime(uint64_t filetime) {
-  FILETIME t;
-  t.dwHighDateTime = filetime >> 32;
-  t.dwLowDateTime = (uint32_t)filetime;
-
-  SYSTEMTIME st;
-  SYSTEMTIME local_st;
-  FileTimeToSystemTime(&t, &st);
-  SystemTimeToTzSpecificLocalTime(NULL, &st, &local_st);
-  return local_st;
-}
-#endif
