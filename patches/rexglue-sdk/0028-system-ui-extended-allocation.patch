+u32 GuestAddressSpace::QueryAllocationSize(u32 address) {
+  if (!address) return 0;
+  auto* heap = LookupHeap(address);
+  if (!heap || u64(address) < heap->GetHeapBase() ||
+      u64(address) - heap->GetHeapBase() >= heap->GetHeapSize()) return 0;
+  HeapAllocation allocation{};
+  if (!heap->QueryRegionInfo(address, &allocation) ||
+      !(allocation.state & kMemoryAllocationCommit) || allocation.allocation_base != address)
+    return 0;
+  return allocation.allocation_size;
+}
