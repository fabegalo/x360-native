diff --git a/src/kernel/xam/xam_info.cpp b/src/kernel/xam/xam_info.cpp
index a0d7667..32e233e 100644
--- a/src/kernel/xam/xam_info.cpp
+++ b/src/kernel/xam/xam_info.cpp
@@ -310,6 +310,21 @@ u32 XamAlloc_entry(u32 unk, u32 size, mapped_u32 out_ptr) {
   return X_ERROR_SUCCESS;
 }
 
+u32 XamAllocEx_entry(u32 tag, u32 flags, u32 size, mapped_u32 out_ptr) {
+  if (!out_ptr) return 0x80070057u;
+  *out_ptr = 0;
+  // Original 17559 816E67E8: tag, allocation flags, byte size, output pointer.
+  // The system UI CRT (9011C7A8) requests flags=0. Other allocation classes,
+  // notably bit 0x40000000, use different original heaps and remain unsupported.
+  if (flags != 0) {
+    REXKRNL_WARN("XamAllocEx: unsupported flags {:08X}, tag {:08X}", uint32_t(flags), uint32_t(tag));
+    return 0x80004001u;
+  }
+  const auto ptr = REX_KERNEL_MEMORY()->SystemHeapAlloc(size);
+  *out_ptr = ptr;
+  return ptr ? 0u : 0x8007000Eu;
+}
+
 u32 XamFree_entry(mapped_u32 ptr) {
   REX_KERNEL_MEMORY()->SystemHeapFree(ptr.guest_address());
 
@@ -375,3 +390,5 @@ REX_EXPORT(__imp__XamFree, rex::kernel::xam::XamFree_entry)
 REX_EXPORT(__imp__XamQueryLiveHiveW, rex::kernel::xam::XamQueryLiveHiveW_entry)
 REX_EXPORT(__imp__XamLoaderGetDvdTrayState, rex::kernel::xam::XamLoaderGetDvdTrayState_entry)
 REX_EXPORT(__imp__XamSwapDisc, rex::kernel::xam::XamSwapDisc_entry)
+
+REX_EXPORT(__imp__XamAllocEx, rex::kernel::xam::XamAllocEx_entry)
