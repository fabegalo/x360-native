+REX_TEST_CASE("The content factory exposes bounded delta copy and zero operations", "[sdk][filesystem][module][content-delta]") {
+  rex::ModuleGroup group;
+  REQUIRE(group.Load("rexfilesystem")); REQUIRE(group.Connect());
+  auto* files = group.Get<rex::filesystem::IFileSystemFactory>(); REQUIRE(files);
+  std::array<rex::u8, 8> image{1, 2, 3, 4, 5, 6, 7, 8};
+  std::array<rex::u8, 12> patch{};
+  auto entry = [&](rex::u32 source, rex::u32 destination, rex::u16 length, rex::u16 compressed) {
+    rex::memory::store_and_swap<rex::u32>(patch.data(), source);
+    rex::memory::store_and_swap<rex::u32>(patch.data() + 4, destination);
+    rex::memory::store_and_swap<rex::u16>(patch.data() + 8, length);
+    rex::memory::store_and_swap<rex::u16>(patch.data() + 10, compressed);
+  };
+  entry(0, 4, 4, 1);
+  REQUIRE(files->ApplyLZXDelta(patch, 32768, image) == 0);
+  CHECK(image == std::array<rex::u8, 8>{1, 2, 3, 4, 1, 2, 3, 4});
+  entry(0, 0, 2, 0);
+  REQUIRE(files->ApplyLZXDelta(patch, 32768, image) == 0);
+  CHECK(image == std::array<rex::u8, 8>{0, 0, 3, 4, 1, 2, 3, 4});
+  const auto previous = image;
+  for (auto [source, destination, compressed] : std::array<std::array<rex::u32, 3>, 3>{
+           std::array<rex::u32, 3>{0, 7, 1}, {7, 0, 1}, {0, 0, 2}}) {
+    entry(source, destination, 4, rex::u16(compressed));
+    CHECK(files->ApplyLZXDelta(patch, 32768, image) == 1);
+    CHECK(image == previous);
+  }
+}
