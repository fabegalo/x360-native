+
+  if (!fetch.num_format) {
+    scale_bits |= UINT32_C(1) << 24;
+  }
+
+  u32 last_stored_component = 0;
+  for (u32 i = 1; i < 4; ++i) {
+    if (format_info.component_bits[i]) {
+      last_stored_component = i;
+    }
+  }
+
+  for (u32 i = 0; i < 4; ++i) {
+    u32 source_component = (fetch.swizzle >> (i * 3)) & 0b111;
+    if (source_component >= xenos::REXGPU_SWIZZLE_0) {
+      continue;
+    }
+    source_component = std::min(source_component, last_stored_component);
+
+    xenos::TextureSign sign =
+        xenos::TextureSign((swizzled_signs >> (i * 2)) & 0b11);
+
+    u8 width = format_info.component_bits[source_component];
+    if (!width || width > 16) {
+      continue;
+    }
+
+    bool carries_width = true;
+    if (sign == xenos::TextureSign::kGamma) {
+      if (fetch.num_format) {
+        continue;
+      }
+      carries_width = false;
+    } else if (!fetch.num_format && sign == xenos::TextureSign::kUnsigned) {
+      carries_width = point_sampled && width >= 4 && width <= 6;
+    }
+
+    u32 component_scale = static_cast<u32>(sign) << 4;
+    if (carries_width) {
+      component_scale |= static_cast<u32>(width - 1);
+    }
+
+    scale_bits |= component_scale << (i * 6);
+  }
+
+  return scale_bits;
+}
+
+void RemapWide1DTexture(u32& width, u32& height, u32& pitch,
+                       u32& max_level) {
+  if (width < xenos::kTexture2DCubeMaxWidthHeight) return;
+  const u32 row_width = xenos::kTexture2DCubeMaxWidthHeight;
+  height = std::min((width + row_width) / row_width, xenos::kTexture1DWideMaxRows) - 1;
+  width = row_width - 1;
+  max_level = 0;
+  pitch = row_width >> 5;
+}
+
 }  // namespace rex::xenos
