--- a/tests/unit/filesystem/file_system_test.cpp
+++ b/tests/unit/filesystem/file_system_test.cpp
@@ -382,3 +382,35 @@
   CHECK_FALSE(created);
   CHECK_FALSE(std::filesystem::exists(fixture.GetTemp() / "game" / "new.txt"));
 }
+
+
+REX_TEST_CASE("revocable mounts deny stale streams without reviving them on a new mount", "[filesystem][mount-revocation]") {
+  Fixture fixture;
+  WriteHost(fixture.GetTemp() / "save.bin", "original");
+  WriteHost(fixture.GetTemp() / "folder" / "child.bin", "child");
+  auto& fs = fixture.GetFileSystem();
+  fixture.MountTemp(kRoot, MountFlags::kWritable | MountFlags::kRevokeOnUnmount);
+  auto old = fixture.Open("\\Device\\Test\\save.bin", {.access = Access::kReadAccess | Access::kWriteAccess});
+  auto root = fixture.Open("\\Device\\Test\\folder");
+  auto walk = root.file->List(""); REQUIRE(walk);
+  CHECK(old.file->IsAccessible());
+  REQUIRE(old.file->Flush());
+  REQUIRE(fs.Unmount(kRoot));
+  CHECK_FALSE(old.file->IsAccessible());
+  std::array<u8, 8> bytes{};
+  auto denied = old.file->Read(bytes, 0); REQUIRE_FALSE(denied);
+  CHECK(CodeOf(denied.error()) == FileSystemError::kAccessDenied);
+  CHECK_FALSE(old.file->Write(bytes, 0)); CHECK_FALSE(old.file->SetLength(0));
+  CHECK_FALSE(old.file->Flush()); CHECK_FALSE(old.file->SetAttributes(rex::filesystem::FileAttributes::kNone));
+  CHECK_FALSE(fs.Rename(*old.file, "replacement.bin", false));
+  CHECK_FALSE(old.file->SetTimes({})); CHECK_FALSE(old.file->View());
+  CHECK_FALSE(root.file->List("")); CHECK_FALSE((*walk)->Next());
+  CHECK_FALSE(fs.OpenRelative(*root.file, "child.bin", {}));
+  REQUIRE(fs.Mount({std::string(kRoot), ProviderType::kHostDirectory, fixture.GetTemp(), MountFlags::kWritable, {}}));
+  auto fresh = fixture.Open("\\Device\\Test\\save.bin");
+  CHECK(ReadText(*fresh.file) == "original"); CHECK_FALSE(old.file->IsAccessible());
+  old.file->SetDeleteOnClose(true); old.file.reset();
+  CHECK(std::filesystem::exists(fixture.GetTemp() / "save.bin"));
+  REQUIRE(fs.Unmount(kRoot));
+  CHECK(fresh.file->IsAccessible()); CHECK(ReadText(*fresh.file) == "original");
+}
