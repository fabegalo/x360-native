+REX_TEST_CASE("revoked mount handles retain NT error codes and never revive after remount", "[kernel][files][filesystem][mount-revocation]") {
+  KernelFixture fixture([](const std::filesystem::path& root) {
+    WriteScratch(root, "data.bin", 8);
+    std::filesystem::create_directories(root / "scratch" / "folder");
+  });
+  namespace fs = rex::filesystem;
+  MountScratch(fixture, fs::MountFlags::kWritable | fs::MountFlags::kRevokeOnUnmount);
+  fixture.RunOnGuestThread([&](Caller& c) {
+    auto* system = StateOf(fixture.GetRuntime()).GetFileSystem();
+    const auto out = c.Alloc(4), copy = c.Alloc(4), status = c.Alloc(8), data = c.Alloc(256), offset = c.AllocQuad(0);
+    REQUIRE(c.Kernel("NtCreateFile", {out, kReadWriteAccess, c.AllocAttributes("scratch:\\data.bin"), status, 0, 0, 3, 1, 0x20}) == 0);
+    const auto original = c.Load32(out);
+    REQUIRE(c.Kernel("NtDuplicateObject", {original, copy, 0}) == 0);
+    const auto duplicate = c.Load32(copy);
+    REQUIRE(c.Kernel("NtClose", {original}) == 0);
+    REQUIRE(c.Kernel("NtCreateFile", {out, 0x80100000, c.AllocAttributes("scratch:\\folder"), status, 0, 0, 3, 1, 1}) == 0);
+    const auto directory = c.Load32(out);
+    REQUIRE(system->Unmount("\\Device\\Scratch"));
+    c.Store32(data, 0xDEADBEEF);
+    c.Store32(status, 0xCAFEBABE); c.Store32(status + 4, 0xCAFEBABE);
+    CHECK(c.Kernel("NtReadFile", {duplicate, 0, 0, 0, status, data, 4, offset}) == rex::kernel::X_STATUS_ACCESS_DENIED);
+    // Immediate NT read errors leave IOSB untouched, like the official EOF/error regressions.
+    CHECK(c.Load32(status) == 0xCAFEBABE); CHECK(c.Load32(status + 4) == 0xCAFEBABE);
+    CHECK(c.Load32(data) == 0xDEADBEEF);
+    CHECK(c.Kernel("NtWriteFile", {duplicate, 0, 0, 0, status, data, 4, offset}) == rex::kernel::X_STATUS_ACCESS_DENIED);
+    CHECK(c.Kernel("NtFlushBuffersFile", {duplicate, status}) == rex::kernel::X_STATUS_ACCESS_DENIED);
+    CHECK(c.Kernel("NtQueryInformationFile", {duplicate, status, data, 8, 14}) == rex::kernel::X_STATUS_INVALID_HANDLE);
+    CHECK(c.Kernel("NtSetInformationFile", {duplicate, status, data, 8, 14}) == rex::kernel::X_STATUS_INVALID_HANDLE);
+    CHECK(c.Kernel("NtQueryDirectoryFile", {directory, 0, 0, 0, status, data, 256, 0, 0}) == rex::kernel::X_STATUS_ACCESS_DENIED);
+    REQUIRE(system->Mount({"\\Device\\Scratch", fs::ProviderType::kHostDirectory, fixture.GetRoot() / "scratch", fs::MountFlags::kWritable, {}}));
+    CHECK(c.Kernel("NtReadFile", {duplicate, 0, 0, 0, status, data, 4, offset}) == rex::kernel::X_STATUS_ACCESS_DENIED);
+    REQUIRE(c.Kernel("NtCreateFile", {out, kReadWriteAccess, c.AllocAttributes("scratch:\\data.bin"), status, 0, 0, 3, 1, 0x20}) == 0);
+    const auto fresh = c.Load32(out);
+    CHECK(c.Kernel("NtReadFile", {fresh, 0, 0, 0, status, data, 4, offset}) == 0);
+    CHECK(c.Load32(data) == 0x78787878);
+    CHECK(c.Kernel("NtClose", {fresh}) == 0); CHECK(c.Kernel("NtClose", {duplicate}) == 0);
+    CHECK(c.Kernel("NtClose", {directory}) == 0);
+  });
