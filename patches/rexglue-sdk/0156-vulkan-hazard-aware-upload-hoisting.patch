new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/vulkan/upload_hazard_tracker.h
@@ -0,0 +1,69 @@
+// Page hazards for transfers recorded before a render pass.
+// Derived from Forza Horizon ReImagined 0036 (MIT); see the project's notices.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstddef>
+#include <vector>
+
+namespace rex::gpu::vulkan {
+
+class UploadHazardTracker {
+ public:
+  void Reset(u32 page_count) {
+    page_count_ = page_count;
+    pages_.assign((static_cast<size_t>(page_count) + 63) / 64, 0);
+    stamps_.assign(pages_.size(), 0);
+    serial_ = 0;
+  }
+
+  u64 BeginPass() {
+    if (!++serial_) {
+      std::fill(stamps_.begin(), stamps_.end(), 0);
+      ++serial_;
+    }
+    return serial_;
+  }
+
+  bool Intersects(u32 first, u32 count) const {
+    if (!count) return false;
+    // Invalid intervals must not accidentally authorize reordering.
+    if (first >= page_count_ || count > page_count_ - first) return true;
+    const u32 last = first + count - 1;
+    for (u32 word = first >> 6; word <= (last >> 6); ++word) {
+      if (stamps_[word] == serial_ && (pages_[word] & Mask(first, last, word))) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void Mark(u32 first, u32 count) {
+    if (!count || first >= page_count_) return;
+    count = std::min(count, page_count_ - first);
+    const u32 last = first + count - 1;
+    for (u32 word = first >> 6; word <= (last >> 6); ++word) {
+      if (stamps_[word] != serial_) {
+        stamps_[word] = serial_;
+        pages_[word] = 0;
+      }
+      pages_[word] |= Mask(first, last, word);
+    }
+  }
+
+ private:
+  static u64 Mask(u32 first, u32 last, u32 word) {
+    u64 mask = ~static_cast<u64>(0);
+    if (word == (first >> 6)) mask &= ~static_cast<u64>(0) << (first & 63);
+    if (word == (last >> 6)) mask &= ~static_cast<u64>(0) >> (63 - (last & 63));
+    return mask;
+  }
+
+  u32 page_count_ = 0;
+  u64 serial_ = 0;
+  std::vector<u64> pages_;
+  std::vector<u64> stamps_;
+};
+
+}  // namespace rex::gpu::vulkan
