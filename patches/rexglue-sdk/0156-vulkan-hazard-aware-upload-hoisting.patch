new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/upload_hazard_tracker.h
@@ -0,0 +1,69 @@
+// Page hazards for transfers recorded before a render pass.
+// Derived from Forza Horizon ReImagined 0036 (MIT); see the project's notices.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstddef>
+#include <vector>
+
+namespace rex::graphics::vulkan {
+
+class UploadHazardTracker {
+ public:
+  void Reset(uint32_t page_count) {
+    page_count_ = page_count;
+    pages_.assign((size_t(page_count) + 63) / 64, 0);
+    stamps_.assign(pages_.size(), 0);
+    serial_ = 0;
+  }
+
+  uint64_t BeginPass() {
+    if (!++serial_) {
+      std::fill(stamps_.begin(), stamps_.end(), 0);
+      ++serial_;
+    }
+    return serial_;
+  }
+
+  bool Intersects(uint32_t first, uint32_t count) const {
+    if (!count) return false;
+    // Invalid intervals must not accidentally authorize reordering.
+    if (first >= page_count_ || count > page_count_ - first) return true;
+    const uint32_t last = first + count - 1;
+    for (uint32_t word = first >> 6; word <= (last >> 6); ++word) {
+      if (stamps_[word] == serial_ && (pages_[word] & Mask(first, last, word))) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void Mark(uint32_t first, uint32_t count) {
+    if (!count || first >= page_count_) return;
+    count = std::min(count, page_count_ - first);
+    const uint32_t last = first + count - 1;
+    for (uint32_t word = first >> 6; word <= (last >> 6); ++word) {
+      if (stamps_[word] != serial_) {
+        stamps_[word] = serial_;
+        pages_[word] = 0;
+      }
+      pages_[word] |= Mask(first, last, word);
+    }
+  }
+
+ private:
+  static uint64_t Mask(uint32_t first, uint32_t last, uint32_t word) {
+    uint64_t mask = ~uint64_t(0);
+    if (word == (first >> 6)) mask &= ~uint64_t(0) << (first & 63);
+    if (word == (last >> 6)) mask &= ~uint64_t(0) >> (63 - (last & 63));
+    return mask;
+  }
+
+  uint32_t page_count_ = 0;
+  uint64_t serial_ = 0;
+  std::vector<uint64_t> pages_;
+  std::vector<uint64_t> stamps_;
+};
+
+}  // namespace rex::graphics::vulkan
