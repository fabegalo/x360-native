+void ContentManager::RetireStaleSaves() {
+  std::lock_guard lock(mutex_);
+  const auto epoch = user_profile_.GetStorageEpoch();
+  std::erase_if(open_packages_, [epoch](const auto& item) {
+    return item.second->GetPackageContentData().content_type == kernel::XContentType::kSavedGame &&
+           item.second->GetStorageEpoch() != epoch;
+  });
