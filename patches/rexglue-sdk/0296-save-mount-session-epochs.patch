+
+
+REX_TEST_CASE("save mount generations retire on logout and profile switch while shared content stays mounted", "[kernel][xam][save-storage]") {
+  SignedInProfileFixture fixture;
+  fixture.RunOnGuestThread([](Caller&) {
+    namespace fs = rex::filesystem;
+    auto& xam = rex::xam::CurrentXAM();
+    auto& profile = xam.GetUserProfile();
+    auto& manager = xam.GetContentManager();
+    auto& system = rex::xam::CurrentTitle().file_system;
+    const auto first = profile.GetXUID();
+    u64 second = 0; REQUIRE(profile.CreateLocal("Second", &second) == 0);
+    rex::kernel::XCONTENT_AGGREGATE_DATA save{};
+    save.device_id = 1; save.title_id = 0x12345678;
+    save.xuid = first; save.content_type = rex::kernel::XContentType::kSavedGame;
+    save.SetFileName("progress");
+    REQUIRE(manager.CreateContent("SAVE", first, save));
+    auto old = system.Open("SAVE:\\payload.bin", {.disposition = fs::Disposition::kCreate, .access = fs::Access::kReadAccess | fs::Access::kWriteAccess});
+    REQUIRE(old); const std::array<u8, 4> bytes{1, 2, 3, 4};
+    REQUIRE(old->file->Write(bytes, 0)); REQUIRE(old->file->Flush());
+    auto shared = save; shared.xuid = 0; shared.content_type = rex::kernel::XContentType::kMarketplaceContent;
+    shared.SetFileName("shared"); REQUIRE(manager.CreateContent("DLC", 0, shared));
+    auto common = system.Open("DLC:\\payload.bin", {.disposition = fs::Disposition::kCreate, .access = fs::Access::kReadAccess | fs::Access::kWriteAccess});
+    REQUIRE(common); REQUIRE(common->file->Write(bytes, 0));
+    const auto epoch = profile.GetStorageEpoch();
+    REQUIRE(profile.SetLocalSession(first) == 0); CHECK(profile.GetStorageEpoch() == epoch);
+    REQUIRE(profile.SetLocalSession(0) == 0); CHECK(profile.GetStorageEpoch() == epoch + 1);
+    CHECK_FALSE(system.FindLink("SAVE:")); CHECK_FALSE(old->file->IsAccessible());
+    CHECK(common->file->IsAccessible());
+    REQUIRE(profile.SetLocalSession(first) == 0);
+    REQUIRE(manager.OpenContent("SAVE", first, save));
+    auto fresh = system.Open("SAVE:\\payload.bin", {}); REQUIRE(fresh);
+    std::array<u8, 4> output{}; REQUIRE(fresh->file->Read(output, 0)); CHECK(output == bytes);
+    CHECK_FALSE(old->file->Read(output, 0));
+    REQUIRE(profile.SetLocalSession(second) == 0);
+    CHECK_FALSE(fresh->file->IsAccessible()); CHECK(common->file->IsAccessible());
+    REQUIRE(profile.SetLocalSession(first) == 0);
+    REQUIRE(manager.OpenContent("SAVE", first, save));
+    auto closed = system.Open("SAVE:\\payload.bin", {}); REQUIRE(closed);
+    REQUIRE(manager.CloseContent("SAVE")); CHECK_FALSE(closed->file->IsAccessible());
+    CHECK_FALSE(system.FindLink("SAVE:"));
+    REQUIRE(manager.CloseContent("DLC"));
+  });
+}
