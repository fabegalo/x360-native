diff --git a/src/kernel/xam/xam_info.cpp b/src/kernel/xam/xam_info.cpp
--- a/src/kernel/xam/xam_info.cpp
+++ b/src/kernel/xam/xam_info.cpp
@@ -317,15 +317,10 @@
   return X_ERROR_SUCCESS;
 }
 
-u32 XamAlloc_entry(u32 unk, u32 size, mapped_u32 out_ptr) {
-  assert_true(unk == 0);
-
-  // Allocate from the heap. Not sure why XAM does this specially, perhaps
-  // it keeps stuff in a separate heap?
-  uint32_t ptr = REX_KERNEL_MEMORY()->SystemHeapAlloc(size);
-  *out_ptr = ptr;
-
-  return X_ERROR_SUCCESS;
+u32 XamAllocEx_entry(u32 tag, u32 flags, u32 size, mapped_u32 out_ptr);
+// Original 17559 816E67A0 forwards the allocation class with tag zero.
+u32 XamAlloc_entry(u32 flags, u32 size, mapped_u32 out_ptr) {
+  return XamAllocEx_entry(0, flags, size, out_ptr);
 }
 
 // XAM 17559 816E69E0 selects physical allocation with bit 31; otherwise it
@@ -351,9 +346,11 @@
   // Original 17559 816E67E8: tag, allocation flags, byte size, output pointer.
   // The CRT requests flags=0. HUD 816935E0 requests 0x01000000,
   // selecting the system virtual pool (816E5F10 -> 816E5E40, pool 1).
-  // Both use owned guest virtual storage here; original pool quotas are not
-  // modeled. Physical/special classes such as 0x40000000 remain unsupported.
-  if (flags != 0 && flags != 0x01000000u) {
+  // Image cache 81691B98 requests 0x20000000: 816E67E8 takes the
+  // virtual path through 816E5F10, and 816E5E40 selects pool 3. Keep owned
+  // guest virtual storage, as for the existing pool 1; quotas are not modeled.
+  // Physical/special classes such as 0x40000000 remain unsupported here.
+  if (flags != 0 && flags != 0x01000000u && flags != 0x20000000u) {
     REXKRNL_WARN("XamAllocEx: unsupported flags {:08X}, tag {:08X}", uint32_t(flags), uint32_t(tag));
     return 0x80004001u;
   }
