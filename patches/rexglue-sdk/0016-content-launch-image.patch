+REX_TEST_CASE("content launch validates its mounted image before publishing a transition", "[kernel][xam][content-launch]") {
+  KernelFixture fixture([](const std::filesystem::path& root) {
+    REQUIRE(std::filesystem::equivalent(root.parent_path(), std::filesystem::temp_directory_path()));
+    REQUIRE(root.filename().string().starts_with("rexglue_kernel_fixture_"));
+    std::filesystem::create_directories(root / "0000000000000000" / "584108B7" / "000D0000" / "package");
+  });
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto input = caller.Alloc(sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA));
+    auto* data = reinterpret_cast<rex::kernel::XCONTENT_AGGREGATE_DATA*>(caller.GetBase() + input);
+    *data = {};
+    data->device_id = 1; data->title_id = 0x584108B7;
+    data->content_type = static_cast<rex::kernel::XContentType>(0xD0000);
+    data->SetFileName("missing");
+    CHECK(caller.XAM("XamContentLaunchImageInternalEx", {input, 0, 0}) == rex::kernel::X_ERROR_FILE_NOT_FOUND);
+    data->SetFileName("package");
+    CHECK(caller.XAM("XamContentLaunchImageInternalEx", {input, 0, 1}) == 50);
+    CHECK(caller.XAM("XamContentLaunchImageInternalEx", {input, 0, 0}) == rex::kernel::X_ERROR_FILE_NOT_FOUND);
+    CHECK_FALSE(rex::xam::CurrentTitle().file_system.Stat("XSYSLAUNCH:\\default.xex").has_value());
+    CHECK(rex::xam::CurrentXAM().GetLoaderState().launch_path.empty());
+    CHECK(caller.XAM("XamContentLaunchImageInternalEx", {input, caller.AllocString("../default.xex"), 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+  });
+}
+
+REX_TEST_CASE("content launch hands the mounted path to the existing title termination flow", "[kernel][xam][content-launch]") {
+  KernelFixture fixture([](const std::filesystem::path& root) {
+    REQUIRE(std::filesystem::equivalent(root.parent_path(), std::filesystem::temp_directory_path()));
+    REQUIRE(root.filename().string().starts_with("rexglue_kernel_fixture_"));
+    const auto package = root / "0000000000000000" / "584108B7" / "000D0000" / "package";
+    std::filesystem::create_directories(package);
+    // This case verifies the launch request only; no executable image is loaded or run.
+    std::ofstream(package / "default.xex", std::ios::binary).write("fixture", 7);
+  });
+  bool returned = false;
+  fixture.RunUntilGuestThreadEnds([&](Caller& caller) {
+    const auto input = caller.Alloc(sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA));
+    auto* data = reinterpret_cast<rex::kernel::XCONTENT_AGGREGATE_DATA*>(caller.GetBase() + input);
+    *data = {};
+    data->device_id = 1; data->title_id = 0x584108B7;
+    data->content_type = static_cast<rex::kernel::XContentType>(0xD0000);
+    data->SetFileName("package");
+    caller.XAM("XamContentLaunchImageInternalEx", {input, 0, 0});
+    returned = true;
+  });
+  CHECK_FALSE(returned);
+  CHECK(rex::xam::CurrentXAM().GetLoaderState().launch_path == "XSYSLAUNCH:\\default.xex");
+  CHECK(rex::xam::CurrentXAM().GetLoaderState().launch_flags == 0);
+}
