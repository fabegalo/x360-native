+// Original XAM 17559 0x294 -> 816EFED0: open the aggregate package under
+// XSYSLAUNCH, then pass the requested image and flags to the loader.
+u32 XamContentLaunchImageInternalEx_entry(mapped_void content, mapped_string image, u32 flags) {
+  if (!content) return X_ERROR_INVALID_PARAMETER;
+  const auto& data = *content.as<XCONTENT_AGGREGATE_DATA*>();
+  const auto* device = GetDummyDeviceInfo(data.device_id);
+  if (!device) return X_ERROR_DEVICE_NOT_CONNECTED;
+  if (device->device_type != DeviceType::HDD) return X_RESULT_FROM_WIN32(50);
+  // Other loader modes need their own semantics; don't silently drop flags.
+  if (flags != 0) {
+    REXKRNL_ERROR("Content launch flags {:08X} not implemented", uint32_t(flags));
+    return X_RESULT_FROM_WIN32(50);
+  }
+  const std::string package(data.file_name_raw,
+      std::find(data.file_name_raw, data.file_name_raw + 42, '\0'));
+  if (package.empty() || package == "." || package == ".." ||
+      package.find_first_of("/\\:") != std::string::npos) return X_ERROR_INVALID_PARAMETER;
+  const std::string name = image && !image.value().empty() ? std::string(image.value()) : "default.xex";
+  if (name.empty() || name == "." || name == ".." ||
+      name.find_first_of("/\\:") != std::string::npos) return X_ERROR_INVALID_PARAMETER;
+  auto* state = REX_KERNEL_STATE();
+  auto* manager = state->content_manager();
+  uint32_t license = 0;
+  auto result = manager->OpenContent("XSYSLAUNCH", data.xuid, data, license);
+  if (result != X_ERROR_SUCCESS) return result;
+  const std::string path = "XSYSLAUNCH:\\" + name;
+  auto* entry = state->file_system()->ResolvePath(path);
+  if (!entry || (entry->attributes() & filesystem::kFileAttributeDirectory)) {
+    manager->CloseContent("XSYSLAUNCH");
+    return X_ERROR_FILE_NOT_FOUND;
+  }
+  auto xam = state->GetKernelModule<XamModule>("xam.xex");
+  xam->loader_data().launch_path = path;
+  xam->loader_data().launch_flags = flags;
+  REXKRNL_INFO("Content launch requested: title={:08X}, path={}, flags={:08X}",
+              uint32_t(data.title_id), path, uint32_t(flags));
+  state->TerminateTitle();
+  return X_ERROR_SUCCESS;  // TerminateTitle does not return on a guest thread.
+}
+
 }  // namespace xam
