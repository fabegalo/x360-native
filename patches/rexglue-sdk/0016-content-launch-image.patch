+u32 XamContentLaunchImageInternalEx_entry(MappedVoid content, MappedString image, u32 flags) {
+  if (!content) return kernel::X_ERROR_INVALID_PARAMETER;
+  const auto& data = *content.As<const kernel::XCONTENT_AGGREGATE_DATA*>();
+  const auto* device = rex::xam::GetPlaceholderDevice(data.device_id);
+  if (!device) return kernel::X_ERROR_DEVICE_NOT_CONNECTED;
+  if (device->device_type != rex::xam::DeviceType::kHDD || flags) return kernel::XResultFromWin32(50);
+  const std::string package(data.file_name_raw, std::find(data.file_name_raw, data.file_name_raw + 42, '\0'));
+  if (package.empty() || package == "." || package == ".." || package.find_first_of("/\\:") != std::string::npos)
+    return kernel::X_ERROR_INVALID_PARAMETER;
+  const std::string name = image && !image.GetValue().empty() ? std::string(image.GetValue()) : "default.xex";
+  if (name.empty() || name == "." || name == ".." || name.find_first_of("/\\:") != std::string::npos)
+    return kernel::X_ERROR_INVALID_PARAMETER;
+  auto& manager = CurrentXAM().GetContentManager();
+  auto opened = manager.OpenContent("XSYSLAUNCH", data.xuid, data);
+  if (!opened) return kernel::ToXResult(opened);
+  const std::string path = "XSYSLAUNCH:\\" + name;
+  auto entry = CurrentTitle().file_system.Stat(path);
+  if (!entry || rex::HasFlags(entry->attributes, rex::filesystem::FileAttributes::kDirectory)) {
+    if (auto closed = manager.CloseContent("XSYSLAUNCH"); !closed)
+      REXXAM_WARN("Failed to close rejected content launch: {}", closed.error().message);
+    return kernel::X_ERROR_FILE_NOT_FOUND;
+  }
+  auto& loader = CurrentXAM().GetLoaderState();
+  loader.launch_path = path;
+  loader.launch_flags = flags;
+  REXXAM_INFO("Content launch requested: title={:08X}, path={}, flags={:08X}",
+      static_cast<u32>(data.title_id), path, flags);
+  CurrentTitle().exit.TerminateTitle();
+  return kernel::X_ERROR_SUCCESS;
+}
