 }
+
+
+REX_TEST_CASE("the first system notification listener receives initial storage availability once", "[kernel][xam][storage-notification]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto id = caller.Alloc(4), data = caller.Alloc(4);
+    const auto first = caller.XAM("XamNotifyCreateListener", {1, 0});
+    REQUIRE(first != 0);
+    CHECK(caller.XAM("XNotifyGetNext", {first, 0xB, id, data}) == 1);
+    CHECK(caller.Load32(id) == 0xB);
+    CHECK(caller.Load32(data) == 0);
+    CHECK(caller.XAM("XNotifyGetNext", {first, 0xB, id, data}) == 0);
+    const auto second = caller.XAM("XamNotifyCreateListener", {1, 0});
+    REQUIRE(second != 0);
+    CHECK(caller.XAM("XNotifyGetNext", {second, 0xB, id, data}) == 0);
+    CHECK(caller.XAM("XNotifyGetNext", {first, 0xA, id, data}) == 0);
+    CHECK(caller.Kernel("NtClose", {first}) == 0);
+    CHECK(caller.Kernel("NtClose", {second}) == 0);
+  });
+}
