diff --git a/src/kernel/notification_broadcaster.cpp b/src/kernel/notification_broadcaster.cpp
--- a/src/kernel/notification_broadcaster.cpp
+++ b/src/kernel/notification_broadcaster.cpp
@@ -34,6 +34,8 @@
     has_notified_startup_ = true;
     listener.Enqueue(0x00000009, 1);
     listener.Enqueue(0x00000009, 0);
+    // Available content devices trigger initial enumeration; this does not complete it.
+    listener.Enqueue(0x0000000B, 0);
     // Sign-in changes follow successful durable profile transactions.
     listener.Enqueue(0x00000012, 0);
     listener.Enqueue(0x00000012, 0);
diff --git a/tests/unit/kernel/xam_test.cpp b/tests/unit/kernel/xam_test.cpp
--- a/tests/unit/kernel/xam_test.cpp
+++ b/tests/unit/kernel/xam_test.cpp
@@ -754,3 +754,23 @@
     CHECK(std::string(std::istreambuf_iterator<char>(preserved), {}) == "corrupt");
