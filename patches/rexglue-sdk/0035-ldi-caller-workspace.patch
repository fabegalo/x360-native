+// LDI caller-owned workspace profile used by XAM 17559's avatar stream.
+// Observed ABI: (block_bytes*, {window_bytes, partition_bytes}*, alloc, free,
+// workspace, workspace_bytes*, context*). Both sizes are 32 KiB in this profile.
+// Only independent blocks with an explicit Reset between them are implemented.
+// Nonzero status is failure; finer proprietary error-code parity is not claimed.
+namespace {
+constexpr u32 kLdiMagic = 0x4C444931, kLdiWindow = 0x8000, kLdiWorkspace = 0x9800;
+bool LdiContext(MappedU32 context) {
+  return context && context.AsArray<u32>()[0] == kLdiMagic && context.AsArray<u32>()[1] == context.GetGuestAddress();
+}
+bool LdiRange(u32 address, u32 size) {
+  return address && u64(address) + size <= 0x100000000ull;
+}
+bool LdiOverlaps(u32 a, u32 n, u32 b, u32 m) {
+  return u64(a) < u64(b) + m && u64(b) < u64(a) + n;
+}
+}  // namespace
+
+u32 LDICreateDecompression_entry(MappedU32 block_bytes, MappedU32 config, u32 alloc,
+                                 u32 free, MappedU32 workspace, MappedU32 workspace_bytes,
+                                 MappedU32 context_out) {
+  if (!context_out) return 1;
+  *context_out = 0;
+  if (!block_bytes || !config || !workspace_bytes || alloc || free ||
+      *block_bytes != kLdiWindow || config.AsArray<u32>()[0] != kLdiWindow || config.AsArray<u32>()[1] != kLdiWindow)
+    return 1;
+  const u32 available = *workspace_bytes;
+  *workspace_bytes = kLdiWorkspace;
+  if (!workspace || (workspace.GetGuestAddress() & 15) || available < kLdiWorkspace ||
+      !LdiRange(workspace.GetGuestAddress(), kLdiWorkspace) ||
+      LdiOverlaps(workspace.GetGuestAddress(), kLdiWorkspace, context_out.GetGuestAddress(), 4))
+    return 1;
+  workspace.AsArray<u32>()[0] = kLdiMagic;
+  workspace.AsArray<u32>()[1] = workspace.GetGuestAddress();
+  workspace.AsArray<u32>()[2] = 0;  // Ready for an independent frame.
+  workspace.AsArray<u32>()[3] = kLdiWindow;
+  *context_out = workspace.GetGuestAddress();
+  return 0;
+}
+
+u32 LDIDecompress_entry(MappedU32 context, MappedVoid source, u32 source_bytes,
+                        MappedVoid destination, MappedU32 output_bytes) {
+  if (!output_bytes || !LdiContext(context)) return 1;
+  const u32 requested = *output_bytes;
+  // Do not silently discard history on a second call: this profile requires Reset.
+  if (context.AsArray<u32>()[2] != 0 || !requested || requested > kLdiWindow || !source_bytes ||
+      source_bytes > kLdiWorkspace || !source || !destination ||
+      !LdiRange(source.GetGuestAddress(), source_bytes) ||
+      !LdiRange(destination.GetGuestAddress(), requested) ||
+      LdiOverlaps(context.GetGuestAddress(), 16, output_bytes.GetGuestAddress(), 4) ||
+      LdiOverlaps(context.GetGuestAddress(), 16, destination.GetGuestAddress(), requested))
+    return 1;
+  *output_bytes = 0;
+  context.AsArray<u32>()[2] = 1;  // Reset is also required after a failed decode.
+  std::array<u8, kLdiWindow> decoded{};
+  if (GetKernelServices()->file_system->DecompressLZX(
+        {source.As<const u8*>(), source_bytes}, {decoded.data(), requested}, kLdiWindow, {})) return 1;
+  std::memcpy(destination.GetHostPtr(), decoded.data(), requested);
+  *output_bytes = requested;
+  return 0;
+}
+
+u32 LDIResetDecompression_entry(MappedU32 context) {
+  if (!LdiContext(context)) return 1;
+  context.AsArray<u32>()[2] = 0;
+  return 0;
+}
+
+u32 LDIDestroyDecompression_entry(MappedU32 context) {
+  if (!LdiContext(context)) return 1;
+  // Storage belongs to the caller. No host pointer or persistent host allocation.
+  for (u32 i = 0; i < 4; ++i) context.AsArray<u32>()[i] = 0;
+  return 0;
+}
