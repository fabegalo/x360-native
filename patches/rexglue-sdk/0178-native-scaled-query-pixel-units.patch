+bool DxbcShaderTranslator::ROV_BeginSampleCountScaleGuard() {
+  if ((draw_resolution_scale_x_ == 1 && draw_resolution_scale_y_ == 1) ||
+      (GetDxbcShaderModification().value & Modification::kNativeVisibilityQuery)) return false;
+  // Match the top-left subpixel published in canonical guest-memory resolves.
+  // Reports retain guest-pixel units; visibility still considers all subpixels.
+  const uint32_t temp = PushSystemTemp();
+  a_.OpFToU(dxbc::Dest::R(temp, 0b0011), dxbc::Src::V1D(in_reg_ps_position_));
+  a_.OpUDiv(dxbc::Dest::Null(), dxbc::Dest::R(temp, 0b0011), dxbc::Src::R(temp),
+             dxbc::Src::LU(draw_resolution_scale_x_, draw_resolution_scale_y_, 1, 1));
+  a_.OpOr(dxbc::Dest::R(temp, 0b0001), dxbc::Src::R(temp, dxbc::Src::kXXXX),
+          dxbc::Src::R(temp, dxbc::Src::kYYYY));
+  a_.OpIf(false, dxbc::Src::R(temp, dxbc::Src::kXXXX));
+  PopSystemTemp();
+  return true;
+}
