+extern "C" REX_FUNC(__imp__XamShowOptionsUI) {
+  if (ctx.r3.u32 >= 4) { ctx.r3.u64 = 87; return; }
+  auto* memory = REX_KERNEL_MEMORY();
+  const auto request = memory->SystemHeapAlloc(12);
+  if (!request) { ctx.r3.u64 = 14; return; }
+  auto* words = memory->TranslateVirtual<rex::be<uint32_t>*>(request);
+  words[0] = 0; words[1] = ctx.r3.u32; words[2] = 6;
+  const auto status = REX_KERNEL_STATE()->app_manager()->DispatchMessageSync(0xFE, 0x21015, request, 12);
+  memory->SystemHeapFree(request);
+  ctx.r3.u64 = static_cast<int32_t>(status) < 0 ? (status == 0x8007000Eu ? 14u : 1627u) : 0u;
+}
