diff --git a/src/gpu/xenos/pipeline/render_target/scaled_resolve.h b/src/gpu/xenos/pipeline/render_target/scaled_resolve.h
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/pipeline/render_target/scaled_resolve.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <rex/xenos/register.h>
+namespace rex::gpu {
+// Preserve unscaled, single-sample, gamma, fixed16 and non-RGB565 pipelines.
+inline bool UseScaledRgb565Resolve(bool scaled, bool depth, u32 source,
+    xenos::MSAASamples samples, const xenos::reg::RB_COPY_DEST_INFO& dest) {
+  return scaled && !depth && samples != xenos::MSAASamples::k1X &&
+      dest.copy_dest_format == xenos::ColorFormat::k_5_6_5 &&
+      dest.copy_dest_number == xenos::SurfaceNumberFormat::kUnsignedRepeatingFraction &&
+      (source == static_cast<u32>(xenos::ColorRenderTargetFormat::k_8_8_8_8) ||
+       source == static_cast<u32>(xenos::ColorRenderTargetFormat::k_16_16_16_16_FLOAT));
+}
+}  // namespace rex::gpu
