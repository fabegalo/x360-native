--- /dev/null
+++ b/include/rex/graphics/pipeline/render_target/scaled_resolve.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <rex/graphics/registers.h>
+namespace rex::graphics {
+// Preserve unscaled, single-sample, gamma, fixed16 and non-RGB565 pipelines.
+inline bool UseScaledRgb565Resolve(bool scaled, bool depth, uint32_t source,
+    xenos::MsaaSamples samples, const reg::RB_COPY_DEST_INFO& dest) {
+  return scaled && !depth && samples != xenos::MsaaSamples::k1X &&
+      dest.copy_dest_format == xenos::ColorFormat::k_5_6_5 &&
+      dest.copy_dest_number == xenos::SurfaceNumberFormat::kUnsignedRepeatingFraction &&
+      (source == uint32_t(xenos::ColorRenderTargetFormat::k_8_8_8_8) ||
+       source == uint32_t(xenos::ColorRenderTargetFormat::k_16_16_16_16_FLOAT));
+}
+}  // namespace rex::graphics
