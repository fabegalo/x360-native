+// Exact addresses in the pinned SDK EDRAM layout. Four pixels share Y/tile work.
+    uint4_xe XeResolveScaleQuotient4(uint4_xe v, uint scale) {
+      uint4_xe result = v;
+      dont_flatten_xe if (scale == 2u || scale == 4u) {
+        result = v >> (scale >> 1u);
+      } else if (scale == 3u) {
+        result = v / 3u;
+      } else if (scale != 1u) {
+        result = v / scale;
+      }
+      return result;
+    }
+    uint XeResolveScaleQuotient(uint v, uint scale) {
+      uint result = v;
+      dont_flatten_xe if (scale == 2u || scale == 4u) {
+        result = v >> (scale >> 1u);
+      } else if (scale == 3u) {
+        result = v / 3u;
+      } else if (scale != 1u) {
+        result = v / scale;
+      }
+      return result;
+    }
+    uint4_xe XeResolveColorCopySource4SampleAddressesBytes(
+        XeResolveInfo info, uint2_xe pixel_index, uint sample_index) {
+      uint sx = info.resolution_scale.x, sy = info.resolution_scale.y;
+      uint bpp = info.edram_format_ints_log2;
+      uint mx = uint(info.edram_msaa_samples >= kXenosMsaaSamples_4X);
+      uint my = uint(info.edram_msaa_samples >= kXenosMsaaSamples_2X);
+      uint4_xe hx = uint_x4_xe(pixel_index.x + info.edram_offset_scaled.x) +
+                   uint4_xe(0u, 1u, 2u, 3u);
+      uint hy = max(pixel_index.y, info.half_pixel_offset_fill_source.y) +
+                info.edram_offset_scaled.y;
+      uint4_xe gx = XeResolveScaleQuotient4(hx, sx);
+      uint gy = XeResolveScaleQuotient(hy, sy);
+      uint4_xe subx = hx - gx * sx;
+      uint suby = hy - gy * sy;
+      uint4_xe word_x = gx << (mx + bpp);
+      uint4_xe tile_x = word_x / 80u;
+      uint tile_y = gy >> 4u;
+      uint pixel_row = gy & 15u;
+      dont_flatten_xe if (my != 0u) {
+        tile_y = gy >> 3u;
+        pixel_row = (gy & 7u) << 1u;
+      }
+      uint row = pixel_row * sy + suby + (sample_index & 1u) * sy;
+      uint4_xe tile = (uint_x4_xe(info.edram_base_tiles + tile_y * info.edram_pitch_tiles) +
+                      tile_x) & uint_x4_xe(2047u);
+      uint4_xe local_x = (word_x - tile_x * 80u) * sx + (subx << bpp) +
+                         uint_x4_xe(((sample_index >> 1u) * sx) << bpp);
+      return (tile * (1280u * sx * sy) + uint_x4_xe(row * 80u * sx) + local_x) << 2u;
+    }
