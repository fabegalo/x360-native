+std::filesystem::path UserProfile::DeviceRoot(uint32_t device_id) const {
+  if (!content_)
+    return device_id == 1 ? root_ : std::filesystem::path{};
+  try {
+    return content_->DeviceRoot(device_id);
+  } catch (const std::filesystem::filesystem_error&) {
+    return {};  // disconnected device
+  }
