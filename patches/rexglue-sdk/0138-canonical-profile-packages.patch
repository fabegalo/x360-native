+bool UserProfile::ImportLegacyProfileData(const Identity& profile) const {
+  const auto package = PackagePathLocked(profile);
+  if (package.empty()) return false;
+  const auto copy_file = [&](const std::filesystem::path& source, const std::filesystem::path& target) {
+    std::error_code error;
+    if (!std::filesystem::exists(source, error)) return !error;
+    if (!IsUnlinkedStoragePath(source) || !IsUnlinkedStoragePath(target) || !std::filesystem::is_regular_file(source, error) || error) return false;
+    if (std::filesystem::exists(target, error)) {
+      if (error || !std::filesystem::is_regular_file(target, error) || error) return false;
+      const auto digest = rex::HashFile(source);
+      return !digest.empty() && digest == rex::HashFile(target);
+    }
+    std::filesystem::create_directories(target.parent_path(), error);
+    return !error && std::filesystem::copy_file(source, target, std::filesystem::copy_options::none, error) && !error;
+  };
+  const auto legacy = root_ / "profiles" / XuidName(profile.xuid);
+  const auto settings = legacy / "settings-v1";
+  std::error_code error;
+  if (std::filesystem::exists(settings, error)) {
+    if (!IsUnlinkedStoragePath(settings)) return false;
+    for (std::filesystem::directory_iterator it(settings, error), end; !error && it != end; it.increment(error)) {
+      if (!copy_file(it->path(), package / "settings-v1" / it->path().filename())) return false;
+    }
+  }
+  if (error || !copy_file(legacy / "titles-played.dat", package / "titles-played.dat")) return false;
+  // Import only private local state; never copy the shared executable metadata cache or originals.
+  return copy_file(root_ / "offline-achievements-v1" / "profiles" / (XuidName(profile.xuid) + ".dat"), package / "achievements.dat");
+}
