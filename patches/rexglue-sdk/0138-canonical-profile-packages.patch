+bool UserProfile::InitializeLocal(const std::filesystem::path& requested_root) {
+  auto storage_lock = LockSettings();
+  bool initialized = false;
+  rex::ScopeGuard fail_closed([&] {
+    if (initialized) return;
+    std::lock_guard lock(identity_mutex_);
+    identity_ = {}; profiles_.clear(); storage_ready_ = false;
+  });
+  {
+    std::lock_guard lock(identity_mutex_);
+    identity_ = {}; profiles_.clear(); storage_ready_ = false;
+    root_ = requested_root.empty() ? std::filesystem::path{} : platform::HostPath(requested_root);
+    profile_path_ = root_ / "profiles" / "session-v1.dat";
+  }
+  if (root_.empty() || !IsUnlinkedStoragePath(root_)) return false;
+  std::error_code error;
+  const bool committed = std::filesystem::exists(profile_path_, error);
+  if (error) return false;
+  const bool legacy = std::filesystem::exists(root_ / "profiles" / "local-v2.dat", error) ||
+      std::filesystem::exists(root_ / "profiles" / "local-v1.dat", error);
+  if (error) return false;
+  if (!committed && legacy) {
+    // This parser still rejects malformed v2 and never falls back to v1 or volatile identity.
+    if (!LoadLegacyProfiles(root_)) return false;
+    const auto selected = identity();
+    const auto profiles = local_profiles();
+    for (const auto& existing : ScanDevices()) {
+      const auto known = std::find_if(profiles.begin(), profiles.end(), [&](const auto& p) {
+        return p.xuid == existing.xuid && p.name == existing.name;
+      });
+      if (known == profiles.end()) return false; // Do not resurrect an archived identity or replace an unrelated package.
+    }
+    for (const auto& profile : profiles) {
+      const auto account = PackagePathLocked(profile) / "account.dat";
+      if (std::filesystem::exists(account, error)) {
+        const auto previous = ReadSmall(account, 32);
+        if (!previous || previous->size() != 32 || std::memcmp(previous->data(), "X360PA01", 8) ||
+            Get64(previous->data() + 8) != profile.xuid ||
+            std::string(reinterpret_cast<const char*>(previous->data() + 16), strnlen(reinterpret_cast<const char*>(previous->data() + 16), 16)) != profile.name)
+          return false;
+      }
+      if (error || !WritePackage(profile) || !ImportLegacyProfileData(profile)) {
+        std::lock_guard lock(identity_mutex_);
+        identity_ = {}; profiles_.clear(); storage_ready_ = false;
+        return false;
+      }
+    }
+    if (!PersistSession(selected)) {
+      std::lock_guard lock(identity_mutex_);
+      identity_ = {}; profiles_.clear(); storage_ready_ = false;
+      return false;
+    }
+    // The session commits migration; legacy files remain untouched as the recovery source.
+    { std::lock_guard lock(identity_mutex_); storage_ready_ = false; }
+  }
+  initialized = RescanLocal();
+  return initialized;
+}
+
+bool UserProfile::RescanLocal() {
+  auto storage_lock = LockSettings();
+  std::unique_lock lock(identity_mutex_);
+  if (root_.empty()) return false;
+  auto loaded = ScanDevices();
+  const auto previous = identity_;
+  u64 selected = identity_.xuid;
+  u32 state = identity_.signin_state;
+  if (!storage_ready_) {
+    state = 0; selected = 0;
+    std::error_code error;
+    const auto session = root_ / "profiles" / "session-v1.dat";
+    if (std::filesystem::exists(session, error)) {
+      const auto record = ReadSmall(session, 17);
+      if (!record || record->size() != 17 || std::memcmp(record->data(), "X360SS01", 8) || (*record)[16] > 1) return false;
+      selected = Get64(record->data() + 8); state = (*record)[16];
+      if ((!selected && state) || (selected && !ValidLocalXuid(selected))) return false;
+    }
+    if (error) return false;
+  }
+  const auto found = std::find_if(loaded.begin(), loaded.end(), [&](const auto& p) { return p.xuid == selected; });
+  identity_ = found == loaded.end() ? (loaded.empty() ? Identity{} : loaded.front()) : *found;
+  identity_.signin_state = found == loaded.end() ? 0 : state;
+  for (auto& p : loaded) p.signin_state = p.xuid == identity_.xuid ? identity_.signin_state : 0;
+  profiles_ = std::move(loaded); storage_ready_ = true;
+  const bool changed = previous.xuid != identity_.xuid || previous.signin_state != identity_.signin_state || previous.device_id != identity_.device_id;
+  if (changed) {
+    ++storage_epoch_;
+    for (auto& setting : setting_list_) { setting->loaded_xuid = 0; setting->loaded_title_id = 0; }
+  }
+  const auto notify = session_changed_;
+  lock.unlock();
+  if (changed && notify) notify();
+  return true;
+}
+
+bool UserProfile::PersistSession(const Identity& selected) {
+  if (!storage_ready_) return false;
+  std::vector<u8> bytes(17, 0);
+  std::memcpy(bytes.data(), "X360SS01", 8);
+  Put64(bytes.data() + 8, selected.xuid);
+  bytes[16] = u8(selected.signin_state ? 1 : 0);
+  return WriteAtomic(root_ / "profiles" / "session-v1.dat", bytes);
 }
 
