+
+std::filesystem::path UserProfile::PackagePathLocked(const Identity& profile) const {
+  const auto device = DeviceRoot(profile.device_id);
+  if (device.empty()) return {};
+  return device / XuidName(profile.xuid) / std::format("{:08X}", kProfileTitle) / "00010000" /
+         XuidName(profile.xuid);
+}
+
+std::filesystem::path UserProfile::PackagePath(uint64_t xuid) const {
+  std::lock_guard lock(identity_mutex_);
+  for (const auto& p : profiles_) if (p.xuid == xuid) return PackagePathLocked(p);
+  return {};
+}
+
+// account.dat: "X360PA01", big-endian XUID, NUL-padded gamertag (16 bytes).
+bool UserProfile::WritePackage(const Identity& profile) const {
+  const auto package = PackagePathLocked(profile);
+  if (package.empty()) return false;
+  std::vector<uint8_t> record(32, 0);
+  std::memcpy(record.data(), "X360PA01", 8);
+  Put64(record.data() + 8, profile.xuid);
+  std::memcpy(record.data() + 16, profile.name.data(), profile.name.size());
+  if (!WriteAtomic(package / "account.dat", record)) return false;
+  if (!content_) return true;
+  XCONTENT_AGGREGATE_DATA data{};
+  data.device_id = profile.device_id;
+  data.content_type = XContentType::kProfile;
+  data.SetDisplayName(std::u16string(profile.name.begin(), profile.name.end()));
+  data.SetFileName(XuidName(profile.xuid));
+  data.xuid = profile.xuid;
+  data.title_id = kProfileTitle;
+  return content_->WriteContentHeaderFile(profile.xuid, data).has_value();
+}
