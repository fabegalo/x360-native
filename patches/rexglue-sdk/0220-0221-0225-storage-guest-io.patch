 ContentManager::~ContentManager() = default;
 
+Result<std::shared_ptr<ContentManager::TransferRequest>> ContentManager::BeginTransfer(u32 overlapped) {
+  std::lock_guard lock(transfers_mutex_);
+  if (transfers_stopped_) return Err<std::shared_ptr<TransferRequest>>(kernel::XResultError(kernel::X_ERROR_CANCELLED));
+  auto request = std::make_shared<TransferRequest>();
+  if (!transfers_.emplace(overlapped, request).second) return Err<std::shared_ptr<TransferRequest>>(kernel::XResultError(kernel::X_ERROR_IO_PENDING));
+  return request;
+}
+
+bool ContentManager::CancelTransfer(u32 overlapped, bool wait) {
+  std::shared_ptr<TransferRequest> request;
+  {
+    std::lock_guard lock(transfers_mutex_);
+    const auto it = transfers_.find(overlapped);
+    if (it == transfers_.end()) return false;
+    request = it->second;
+    request->cancelled.store(true, std::memory_order_release);
+  }
+  // A progress callback cannot wait for the worker it is currently executing on.
+  if (wait && request->worker_handle.load(std::memory_order_acquire) !=
+                  title_.threads.GetCallingThread()->GetHandle()) {
+    for (;;) {
+      { std::lock_guard lock(request->mutex); if (request->completed) break; }
+      title_.threads.SleepCurrentThread(std::chrono::milliseconds(1));
+    }
+  }
+  return true;
+}
+
+void ContentManager::CancelAllTransfers() {
+  std::lock_guard lock(transfers_mutex_);
+  transfers_stopped_ = true;
+  for (const auto& [overlapped, request] : transfers_) request->cancelled.store(true, std::memory_order_release);
+}
+
+void ContentManager::FinishTransfer(u32 overlapped, const std::shared_ptr<TransferRequest>& request,
+    const std::function<void()>& complete) {
+  rex::ScopeGuard release([&] {
+    std::lock_guard request_lock(request->mutex);
+    std::lock_guard registry_lock(transfers_mutex_);
+    const auto it = transfers_.find(overlapped);
+    if (it != transfers_.end() && it->second == request) transfers_.erase(it);
+    request->completed = true;
+  });
+  // A new submission cannot reuse the OVERLAPPED before completion publication.
+  complete();
+}
