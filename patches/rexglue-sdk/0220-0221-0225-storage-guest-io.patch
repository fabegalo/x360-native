+  auto& title = CurrentTitle();
+  if (length != 552 || !packet || !title.heap.IsGuestRangeAccessible(packet, length, kMemoryProtectRead))
+    return X_E_INVALIDARG;
+  const auto word = [&](u32 offset) { return memory::load_and_swap<u32>(title.membase.TranslateVirtual(packet + offset)); };
+  const auto flags = word(532);
+  if ((flags & ~7u) || !(flags & 6u)) return X_E_INVALIDARG;
+  // Meaning of this extra service argument remains unverified.
+  if (word(544)) return XHRESULTFromWin32(50);
+  const auto result = ContentTransfer(flags & 4 ? packet : 0, flags & 2 ? packet + 8 : 0,
+      packet + 16, word(536), word(540), word(528), (flags & 1) != 0);
+  return result == X_ERROR_IO_PENDING ? X_E_SUCCESS : XHRESULTFromWin32(result);
+}
