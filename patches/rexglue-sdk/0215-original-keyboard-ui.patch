+  words[3] = initial; words[4] = title; words[5] = description;
+  words[6] = output; words[7] = overlap;
+  if (branded) words[8] = brand;
+  io->result = X_ERROR_IO_PENDING;
+  io->context = XThread::IsInThread() ? XThread::GetCurrentThreadHandle() : 0;
+  const auto status = state->app_manager()->DispatchMessageSync(
+      0xFE, branded ? 0x21010 : 0x21005, request, size);
+  mem->SystemHeapFree(request);
+  if (XFAILED(status)) {
+    XThread::SetLastError(status);
+    const uint32_t error = uint32_t(status) == 0x8007000Eu ? 14 : X_ERROR_FUNCTION_FAILED;
