+// Original XAM 17559 exports 816C1F38 / 816C1FC0. vk.xex owns
+// editing, validation, cancellation and XMsgCompleteIORequest. Caller strings
+// and output remain valid until that completion, as required by this async API.
+static uint32_t SubmitOriginalKeyboard(uint32_t user, uint32_t flags,
+    uint32_t initial, uint32_t title, uint32_t description, uint32_t output,
+    uint32_t capacity, uint32_t overlap, uint32_t brand = 0, bool branded = false) {
+  constexpr auto rw = kernel::kMemoryProtectRead | kernel::kMemoryProtectWrite;
+  if (!overlap || !MessageBoxSpan(overlap, sizeof(kernel::XOVERLAPPED), rw))
+    return X_ERROR_INVALID_PARAMETER;
+  auto* io = CurrentTitle().membase.TranslateVirtual<kernel::XOVERLAPPED*>(overlap);
+  const auto invalid = [&] {
+    io->extended_error = X_ERROR_INVALID_PARAMETER;
+    return uint32_t(X_ERROR_INVALID_PARAMETER);
+  };
+  if ((user >= 4 && user != 0xFF) || !capacity ||
+      !MessageBoxSpan(output, uint64_t(capacity) * 2, kernel::kMemoryProtectWrite))
+    return invalid();
+  // Validate optional UTF-16 input without converting to narrow strings or
+  // silently accepting inaccessible guest memory. The original editor decides
+  // how much fits in the output, whose capacity includes its terminator.
+  for (const auto source : {initial, title, description}) {
+    if (!source) continue;
+    uint64_t at = source;
+    for (;;) {
+      if (at > UINT32_MAX || !MessageBoxSpan(uint32_t(at), 2, kernel::kMemoryProtectRead))
+        return invalid();
+      if (!memory::load_and_swap<uint16_t>(CurrentTitle().membase.TranslateVirtual<u8*>(uint32_t(at)))) break;
+      at += 2;
+    }
+  }
+  const uint32_t size = branded ? 36 : 32;
+  const auto request = CurrentTitle().heap.SystemHeapAlloc(size);
+  if (!request) return 14;
+  auto* words = CurrentTitle().membase.TranslateVirtual<be_u32*>(request);
+  words[0] = user; words[1] = capacity; words[2] = flags;
+  words[3] = initial; words[4] = title; words[5] = description;
+  words[6] = output; words[7] = overlap;
+  if (branded) words[8] = brand;
+  io->result = X_ERROR_IO_PENDING;
+  io->context = SystemUICallerContext();
+  const auto status = CurrentXAM().GetAppManager().DispatchMessageSync(
+      0xFE, branded ? 0x21010 : 0x21005, request, size);
+  CurrentTitle().heap.SystemHeapFree(request);
+  if (XFAILED(status)) {
+    if (auto* caller = CurrentTitle().threads.GetCallingThread()) caller->SetLastError(status);
+    const uint32_t error = uint32_t(status) == 0x8007000Eu ? 14 : X_ERROR_FUNCTION_FAILED;
+    CurrentTitle().overlapped_dispatcher.Complete(overlap, {.result = error, .extended_error = static_cast<u32>(status), .length = 0, .preserve_context = true});
+    return error;
+  }
+  return X_ERROR_IO_PENDING;
+}
+
+u32 XamShowKeyboardUI_entry(u32 user, u32 flags, MappedWString initial,
+    MappedWString title, MappedWString description, MappedWString output,
+    u32 capacity, MappedVoid overlap) {
+  return SubmitOriginalKeyboard(user, flags, initial.GetGuestAddress(), title.GetGuestAddress(),
+      description.GetGuestAddress(), output.GetGuestAddress(), capacity, overlap.GetGuestAddress());
+}
+
+u32 XamShowBrandedKeyboardUI_entry(u32 user, u32 flags, MappedU32 brand,
+    MappedWString initial, MappedWString title, MappedWString description,
+    MappedWString output, u32 capacity, MappedVoid overlap) {
+  if (!brand || !MessageBoxSpan(brand.GetGuestAddress(), 4,
+      kernel::kMemoryProtectRead | kernel::kMemoryProtectWrite)) return X_ERROR_INVALID_PARAMETER;
+  const uint32_t value = *brand;
+  *brand = 0; // Original 816C1FEC consumes the brand descriptor word.
+  return SubmitOriginalKeyboard(user, flags | 0x08000000u, initial.GetGuestAddress(), title.GetGuestAddress(),
+      description.GetGuestAddress(), output.GetGuestAddress(), capacity, overlap.GetGuestAddress(), value, true);
 }
 
