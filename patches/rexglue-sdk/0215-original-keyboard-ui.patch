+REX_TEST_CASE("original keyboard requests retain caller strings and outputs until actual completion", "[ui][xam][keyboard-request]") {
+  rex::test::KernelFixture fixture;
+  fixture.RunOnGuestThread([&](rex::test::Caller& c) {
+    std::vector<rex::u32> request;
+    rex::u32 packet = 0, message = 0;
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    ui.system_ui_request = [&](rex::u32 msg, rex::u32 buffer, rex::u32 size) -> rex::kernel::X_HRESULT {
+      message = msg; packet = buffer;
+      CHECK(size == (msg == 0x21010 ? 36 : 32));
+      request.clear();
+      for (rex::u32 offset = 0; offset < size; offset += 4) request.push_back(c.Load32(buffer + offset));
+      return 0;
+    };
+    const auto initial = PutWide(c, fixture.GetRuntime(), u"Inicial"), title = PutWide(c, fixture.GetRuntime(), u"Title");
+    const auto output = c.Alloc(32), io = c.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    c.Store32(output, 0xCAFEBABE);
+    REQUIRE(c.XAM("XamShowKeyboardUI", {0, 0, initial, title, 0, output, 16, io}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(message == 0x21005); REQUIRE(request.size() == 8);
+    CHECK(request[0] == 0); CHECK(request[1] == 16); CHECK(request[2] == 0);
+    CHECK(request[3] == initial); CHECK(request[4] == title); CHECK(request[6] == output); CHECK(request[7] == io);
+    CHECK(c.Load32(io) == rex::kernel::X_ERROR_IO_PENDING); CHECK(c.Load32(output) == 0xCAFEBABE);
+    CHECK(rex::xam::CurrentTitle().heap.QueryAllocationSize(packet) == 0);
+    const std::u16string typed = u"Olá";
