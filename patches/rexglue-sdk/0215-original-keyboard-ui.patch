+u32 XamShowKeyboardUI_entry(u32 user, u32 flags, mapped_wstring initial,
+    mapped_wstring title, mapped_wstring description, mapped_wstring output,
+    u32 capacity, mapped_void overlap) {
+  return SubmitOriginalKeyboard(user, flags, initial.guest_address(), title.guest_address(),
+      description.guest_address(), output.guest_address(), capacity, overlap.guest_address());
+}
+
+u32 XamShowBrandedKeyboardUI_entry(u32 user, u32 flags, mapped_u32 brand,
+    mapped_wstring initial, mapped_wstring title, mapped_wstring description,
+    mapped_wstring output, u32 capacity, mapped_void overlap) {
+  auto* mem = REX_KERNEL_MEMORY();
+  if (!brand || !MessageBoxSpan(mem, brand.guest_address(), 4,
+      memory::kMemoryProtectRead | memory::kMemoryProtectWrite)) return X_ERROR_INVALID_PARAMETER;
+  const uint32_t value = *brand;
+  *brand = 0; // Original 816C1FEC consumes the brand descriptor word.
+  return SubmitOriginalKeyboard(user, flags | 0x08000000u, initial.guest_address(), title.guest_address(),
+      description.guest_address(), output.guest_address(), capacity, overlap.guest_address(), value, true);
 }
 
