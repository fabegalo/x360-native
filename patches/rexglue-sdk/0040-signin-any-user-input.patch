diff --git a/include/rex/xam/system_ui.h b/include/rex/xam/system_ui.h
--- a/include/rex/xam/system_ui.h
+++ b/include/rex/xam/system_ui.h
@@ -31,7 +31,7 @@
   bool BeginSystemUi(u32 module, u32 slot, u32 user) {
     std::lock_guard lock(system_apps_mutex_);
     auto it = system_apps_.find(slot);
-    if (system_ui_.module || user >= 4 || it == system_apps_.end() ||
+    if (system_ui_.module || (user >= 4 && user != 0xFF) || it == system_apps_.end() ||
         it->second.module != module) return false;
     system_ui_ = {module, user};
     return true;
@@ -48,7 +48,8 @@
   }
   bool EnableSystemUiInput(u32 user, bool enable) {
     std::lock_guard lock(system_apps_mutex_);
-    if (!system_ui_.module || user != system_ui_.user) return false;
+    if (!system_ui_.module || (user != system_ui_.user &&
+        !(system_ui_.user == 0xFF && user < 4))) return false;
     system_ui_.input_enabled = enable;
     return true;
   }
diff --git a/src/xam/xam_input.cpp b/src/xam/xam_input.cpp
--- a/src/xam/xam_input.cpp
+++ b/src/xam/xam_input.cpp
@@ -48,7 +48,7 @@
 
 bool SystemUiOwnsInput(u32 user) {
   const auto ui = CurrentXAM().GetSystemUI().GetSystemUiSession();
-  return ui.visible && ui.user == user;
+  return ui.visible && (ui.user == user || ui.user == 0xFF);
 }
 
 u32 NormalizeUser(u32 user_index, u32 flags) {
@@ -131,7 +131,7 @@
   if (!input || actual_user_index >= rex::hid::IInputSystem::kMaxUsers) {
     return kernel::X_ERROR_DEVICE_NOT_CONNECTED;
   }
-  if (SystemUiOwnsInput(actual_user_index)) {
+  if (!(flags & 0x80000000u) && SystemUiOwnsInput(actual_user_index)) {
     if (input_state) *input_state = {};
     return kernel::X_ERROR_SUCCESS;
   }
@@ -211,10 +211,28 @@
 u32 XamInputGetKeystrokeHud_entry(u32 user, GuestPtrT<X_INPUT_KEYSTROKE> stroke) {
   if (!stroke) return kernel::X_ERROR_BAD_ARGUMENTS;
   const auto ui = CurrentXAM().GetSystemUI().GetSystemUiSession();
-  if (!ui.visible || !ui.input_enabled || user != ui.user) return kernel::X_ERROR_EMPTY;
+  if (!ui.visible || !ui.input_enabled || (user != ui.user && !(ui.user == 0xFF && user < 4))) return kernel::X_ERROR_EMPTY;
   auto* input = GetInput();
   if (!input) return kernel::X_ERROR_DEVICE_NOT_CONNECTED;
   return TakeInputKeystroke(*input, user, 1, *stroke);
+}
+
+u32 XamInputGetKeystrokeHudEx_entry(u32 user, [[maybe_unused]] u32 flags,
+                                   GuestPtrT<X_INPUT_KEYSTROKE> stroke) {
+  if (!stroke || (user >= 4 && user != 0xFF)) return kernel::X_ERROR_BAD_ARGUMENTS;
+  const auto ui = CurrentXAM().GetSystemUI().GetSystemUiSession();
+  if (!ui.visible || !ui.input_enabled || (ui.user != 0xFF && user != ui.user)) return kernel::X_ERROR_EMPTY;
+  auto* input = GetInput();
+  if (!input) return kernel::X_ERROR_DEVICE_NOT_CONNECTED;
+  const u32 first = user == 0xFF ? 0 : user;
+  const u32 end = user == 0xFF ? 4 : user + 1;
+  for (u32 index = first; index < end; ++index) {
+    u32 selected = index;
+    const auto result = TakeInputKeystroke(*input, selected, 1, *stroke);
+    if (result == kernel::X_ERROR_SUCCESS) return result;
+    if (result != kernel::X_ERROR_EMPTY && result != kernel::X_ERROR_DEVICE_NOT_CONNECTED) return result;
+  }
+  return kernel::X_ERROR_EMPTY;
 }
 
 }  // namespace xam
@@ -233,3 +251,5 @@
 REX_XAM_BODY(__imp__XamInputGetDeviceStats, rex::xam::XamInputGetDeviceStats_entry)
 
 REX_XAM_BODY(__imp__XamInputGetKeystrokeHud, rex::xam::XamInputGetKeystrokeHud_entry)
+
+REX_XAM_BODY(__imp__XamInputGetKeystrokeHudEx, rex::xam::XamInputGetKeystrokeHudEx_entry)
