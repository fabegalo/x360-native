--- a/src/kernel/xam/xam_input.cpp
+++ b/src/kernel/xam/xam_input.cpp
@@ -42,7 +42,7 @@ rex::input::InputSystem* input_system() {
 bool SystemUiOwnsInput(uint32_t user) {
   auto xam = REX_KERNEL_STATE()->GetKernelModule<XamModule>("xam.xex");
   const auto ui = xam->GetSystemUiSession();
-  return ui.visible && ui.user == user;
