--- a/include/rex/kernel/xam/module.h
+++ b/include/rex/kernel/xam/module.h
@@ -49,7 +49,7 @@ class XamModule : public system::KernelModule {
   bool BeginSystemUi(uint32_t module, uint32_t slot, uint32_t user) {
     std::lock_guard lock(system_apps_mutex_);
     auto it = system_apps_.find(slot);
-    if (system_ui_.module || user >= 4 || it == system_apps_.end() ||
+    if (system_ui_.module || (user >= 4 && user != 0xFF) || it == system_apps_.end() ||
