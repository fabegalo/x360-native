     system_ui_ = {module, user};
     return true;
@@ -66,7 +66,8 @@ class XamModule : public system::KernelModule {
   }
   bool EnableSystemUiInput(uint32_t user, bool enable) {
     std::lock_guard lock(system_apps_mutex_);
-    if (!system_ui_.module || user != system_ui_.user) return false;
