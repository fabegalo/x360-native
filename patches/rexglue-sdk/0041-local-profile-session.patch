+REX_TEST_CASE("XAM local identity is durable before a local session is published", "[kernel][xam][local-profile-session]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  CHECK(profile.identity().xuid == 0);
+  CHECK(profile.GetSigninState() == 0);
+  CHECK(profile.GetType() == 0);
+  for (const char* invalid : {"", " trailing", "trailing ", "0123456789ABCDEF"})
+    CHECK(profile.CreateLocal(invalid) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+  REQUIRE(profile.CreateLocal("Local User") == 0);
+  const auto identity = profile.identity();
+  CHECK(identity.xuid != 0);
+  CHECK(profile.GetSigninState() == 0);
+  rex::xam::UserProfile reopened;
+  REQUIRE(reopened.InitializeLocal(rex::xam::CurrentTitle().user_data_root));
+  CHECK(reopened.identity().xuid == identity.xuid);
+  CHECK(reopened.GetName() == "Local User");
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto users = caller.Alloc(4 * 392), output = caller.Alloc(40);
+    const auto listener = caller.XAM("XamNotifyCreateListener", {1, 0});
+    REQUIRE(listener != 0);
+    const auto notification_id = caller.Alloc(4), notification_data = caller.Alloc(4);
+    const auto take_signin = [&] {
+      return caller.XAM("XNotifyGetNext", {listener, 0xA, notification_id, notification_data});
+    };
+    CHECK(take_signin() == 0);
+    const auto overlapped = caller.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    CHECK(caller.XAM("XamUserGetSigninState", {0}) == 0);
+    CHECK(caller.XAM("XamUserGetXUID", {0, 1, output}) == rex::kernel::X_E_NO_SUCH_USER);
+    caller.Store64(users, identity.xuid ^ 2);
+    CHECK(caller.XAM("XamUserLogon", {users, 0, overlapped}) ==
+          static_cast<u32>(rex::kernel::XHRESULTFromWin32(rex::kernel::X_ERROR_NO_SUCH_USER)));
+    CHECK(caller.Load32(overlapped) == rex::kernel::X_ERROR_NO_SUCH_USER);
+    CHECK(caller.Load32(overlapped + 4) == 0);
+    CHECK(caller.Load32(overlapped + 24) ==
+          static_cast<u32>(rex::kernel::XHRESULTFromWin32(rex::kernel::X_ERROR_NO_SUCH_USER)));
+    CHECK(take_signin() == 0);
+    caller.Store64(users, identity.xuid);
+    CHECK(caller.XAM("XamUserLogon", {users, 0, overlapped}) == 0);
+    CHECK(caller.Load32(overlapped) == 0);
+    CHECK(caller.Load32(overlapped + 24) == 0);
+    CHECK(take_signin() == 1);
+    CHECK(caller.Load32(notification_data) == 1);
+    CHECK(caller.XAM("XamUserLogon", {users, 0, 0}) == 0);
+    CHECK(take_signin() == 0);
+    CHECK(caller.XAM("XamUserGetSigninState", {0}) == 1);
+    CHECK(caller.XAM("XamUserGetXUID", {0, 1, output}) == 0);
+    CHECK(caller.Load32(output) == static_cast<u32>(identity.xuid >> 32));
+    CHECK(caller.Load32(output + 4) == static_cast<u32>(identity.xuid));
+    CHECK(caller.XAM("XamUserGetXUID", {0, 2, output}) == rex::kernel::X_E_NO_SUCH_USER);
+    CHECK(caller.XAM("XamUserIsOnlineEnabled", {0}) == 0);
+    CHECK(caller.XAM("XamUserGetMembershipTier", {0}) == 0);
+    caller.Store64(users + 392, identity.xuid);
+    CHECK(caller.XAM("XamUserLogonEx", {users, 0, 0}) == 0x80004001u);
+    CHECK(profile.GetSigninState() == 1);
+    CHECK(take_signin() == 0);
+    caller.Store64(users + 392, 0);
+    caller.Store64(users, 0);
+    CHECK(caller.XAM("XamUserLogonEx", {users, 1, 0}) == 0x80004001u);
+    CHECK(profile.GetSigninState() == 1);
+    CHECK(caller.XAM("XamUserLogonEx", {users, 0, 0}) == 0);
+    CHECK(profile.GetSigninState() == 0);
+    CHECK(take_signin() == 1);
+    CHECK(take_signin() == 0);
+    CHECK(caller.Kernel("NtClose", {listener}) == 0);
+  });
+  REQUIRE(reopened.InitializeLocal(rex::xam::CurrentTitle().user_data_root));
+  CHECK(reopened.GetSigninState() == 0);
+  CHECK(reopened.identity().xuid == identity.xuid);
+}
