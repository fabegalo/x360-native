+namespace {
+bool ValidLocalName(const std::string& name) {
+  // Initial local contract: printable ASCII, 1-15 bytes, no edge spaces.
+  return !name.empty() && name.size() <= 15 && name.front() != ' ' && name.back() != ' ' &&
+         std::all_of(name.begin(), name.end(), [](unsigned char c) { return c >= 32 && c <= 126; });
+}
+bool ValidLocalXuid(uint64_t xuid) {
+  return (xuid & 0xFFF0000000000000ull) == 0xE000000000000000ull &&
+         (xuid & 0x000FFFFFFFFFFFFFull) != 0;
+}
+}
+
+UserProfile::Identity UserProfile::identity() const {
+  std::lock_guard lock(identity_mutex_);
+  return identity_;
+}
+
+bool UserProfile::InitializeLocal(const std::filesystem::path& root) {
+  std::lock_guard lock(identity_mutex_);
+  identity_ = {};
+  storage_ready_ = false;
+  if (root.empty()) return false;
+  profile_path_ = root / "profiles" / "local-v1.dat";
+  std::error_code error;
+  const bool exists = std::filesystem::exists(profile_path_, error);
+  if (error) return false;
+  if (!exists) { storage_ready_ = true; return true; }
+  // Fixed-size record: magic/version, big-endian XUID, sign-in byte, name[16].
+  // No unbounded parser allocation and no silent replacement of corrupt data.
+  std::array<uint8_t, 33> record{};
+  auto* file = rex::filesystem::OpenFile(profile_path_, "rb");
+  if (!file) return false;
+  const auto read = fread(record.data(), 1, record.size(), file);
+  const auto trailing = fgetc(file);
+  const bool bad = ferror(file) != 0;
+  fclose(file);
+  if (read != record.size() || trailing != EOF || bad ||
+      std::memcmp(record.data(), "X360LP01", 8) || record[16] > 1 || record[32]) return false;
+  uint64_t xuid = 0;
+  for (unsigned i = 8; i < 16; ++i) xuid = (xuid << 8) | record[i];
+  const std::string name(reinterpret_cast<const char*>(record.data() + 17));
+  if (!ValidLocalXuid(xuid) || !ValidLocalName(name)) return false;
+  for (size_t i = 17 + name.size(); i < record.size(); ++i) if (record[i]) return false;
+  identity_ = {xuid, name, record[16]};
+  storage_ready_ = true;
+  return true;
+}
+
+bool UserProfile::PersistIdentity(const Identity& next) {
+  if (!storage_ready_) { REXSYS_ERROR("Local profile store is not initialized"); return false; }
+  std::error_code error;
+  std::filesystem::create_directories(profile_path_.parent_path(), error);
+  if (error) { REXSYS_ERROR("Local profile directory: {}", error.message()); return false; }
+  std::array<uint8_t, 33> record{};
+  std::memcpy(record.data(), "X360LP01", 8);
+  for (unsigned i = 0; i < 8; ++i) record[8 + i] = uint8_t(next.xuid >> (56 - i * 8));
+  record[16] = uint8_t(next.signin_state);
+  std::memcpy(record.data() + 17, next.name.data(), next.name.size());
+  auto temporary = profile_path_;
+  temporary += ".tmp";
+  auto* file = rex::filesystem::OpenFile(temporary, "wb");
+  if (!file) { REXSYS_ERROR("Local profile staging open failed: {}", errno); return false; }
+  bool ok = fwrite(record.data(), 1, record.size(), file) == record.size() && fflush(file) == 0;
+#if REX_PLATFORM_WIN32
+  if (ok) ok = _commit(_fileno(file)) == 0;
+#else
+  if (ok) ok = fsync(fileno(file)) == 0;
+#endif
+  if (!ok) REXSYS_ERROR("Local profile flush failed: {}", errno);
+  if (fclose(file)) { REXSYS_ERROR("Local profile close failed: {}", errno); ok = false; }
+  if (ok) {
+#if REX_PLATFORM_WIN32
+    ok = MoveFileExW(temporary.c_str(), profile_path_.c_str(),
+                    MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+    if (!ok) REXSYS_ERROR("Local profile replace failed: {}", GetLastError());
+#else
+    std::filesystem::rename(temporary, profile_path_, error);
+    ok = !error;
+#endif
+  }
+  if (!ok) std::filesystem::remove(temporary, error);
+  return ok;
+}
+
+uint32_t UserProfile::CreateLocal(const std::string& name) {
+  std::lock_guard lock(identity_mutex_);
+  if (!ValidLocalName(name)) return X_ERROR_INVALID_PARAMETER;
+  if (identity_.xuid) return X_ERROR_ALREADY_EXISTS;
+  // Identity is generated once and survives every subsequent session.
+  uint64_t random = 0;
+  try {
+    std::random_device source;
+    random = (uint64_t(source()) << 32) | source();
+  } catch (const std::exception& error) {
+    REXSYS_ERROR("Local profile identity generation: {}", error.what());
+    return X_ERROR_FUNCTION_FAILED;
+  }
+  Identity next{0xE000000000000000ull | ((random & 0x000FFFFFFFFFFFFFull) | 1), name, 0};
+  if (!PersistIdentity(next)) return X_ERROR_FUNCTION_FAILED;
+  identity_ = std::move(next);
+  return X_ERROR_SUCCESS;
+}
+
+uint32_t UserProfile::SetLocalSession(uint64_t xuid) {
+  std::lock_guard lock(identity_mutex_);
+  if (!identity_.xuid || (xuid && xuid != identity_.xuid)) return X_ERROR_NO_SUCH_USER;
+  const uint32_t state = xuid ? 1 : 0;
+  if (identity_.signin_state == state) return X_ERROR_SUCCESS;
+  auto next = identity_;
+  next.signin_state = state;
+  if (!PersistIdentity(next)) return X_ERROR_FUNCTION_FAILED;
+  identity_ = std::move(next);
+  // Publication follows durable replacement; failures and repeats emit nothing.
+  if (kernel_state_) kernel_state_->BroadcastNotification(0xA, 1);
+  return X_ERROR_SUCCESS;
+}
+
