+// Retail LogonEx expands four XUIDs to 392-byte entries; unsupported modes never partially apply.
+static u32 LocalLogon(MappedVoid users, u32 flags, u32 overlapped, u32 stride) {
+  if (!users) return static_cast<u32>(kernel::X_E_INVALIDARG);
+  if (flags) return 0x80004001u;
+  auto* bytes = users.As<u8*>();
+  for (unsigned i = 1; i < 4; ++i)
+    if (memory::load_and_swap<u64>(bytes + i * stride)) return 0x80004001u;
+  const auto xuid = memory::load_and_swap<u64>(bytes);
+  const auto result = CurrentXAM().GetUserProfile().SetLocalSession(xuid);
+  const auto hr = static_cast<u32>(kernel::XHRESULTFromWin32(result));
+  if (overlapped) CurrentTitle().overlapped_dispatcher.Complete(overlapped,
+      {.result = result, .extended_error = hr, .length = 0});
+  return hr;
+}
+u32 XamUserLogon_entry(MappedVoid users, u32 flags, u32 overlapped) {
+  return LocalLogon(users, flags, overlapped, 8);
+}
+u32 XamUserLogonEx_entry(MappedVoid users, u32 flags, u32 overlapped) {
+  return LocalLogon(users, flags, overlapped, 392);
+}
