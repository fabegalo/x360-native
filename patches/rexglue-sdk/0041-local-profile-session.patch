+REX_TEST_CASE("XAM profile corruption and failed publication preserve the original store", "[kernel][xam][local-profile-session]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  const auto root = rex::xam::CurrentTitle().user_data_root;
+  REQUIRE(std::filesystem::equivalent(root.parent_path(), std::filesystem::temp_directory_path()));
+  REQUIRE(root.filename().string().starts_with("rexglue_kernel_fixture_"));
+  std::ofstream(root / "profiles", std::ios::binary) << "blocked";
+  CHECK(profile.CreateLocal("Local User") == rex::kernel::X_ERROR_FUNCTION_FAILED);
+  CHECK(profile.identity().xuid == 0);
+  std::filesystem::remove(root / "profiles");
+  std::filesystem::create_directory(root / "profiles");
+  std::ofstream(root / "profiles" / "local-v1.dat", std::ios::binary) << "corrupt";
+  CHECK_FALSE(profile.InitializeLocal(root));
+  CHECK(profile.CreateLocal("Local User") == rex::kernel::X_ERROR_FUNCTION_FAILED);
+  CHECK(profile.GetSigninState() == 0);
+  std::ifstream in(root / "profiles" / "local-v1.dat", std::ios::binary);
+  CHECK(std::string(std::istreambuf_iterator<char>(in), {}) == "corrupt");
+}
