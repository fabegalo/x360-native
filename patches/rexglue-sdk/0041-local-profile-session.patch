+// 17559: 8199C630 expands four XUIDs into 392-byte entries before LogonEx.
+// 8199EEC0 replaces the slot array for flags=0 (zero XUID signs that slot out).
+// Other modes involve preview/Live/account payloads and remain unsupported.
+static uint32_t LocalLogon(mapped_void users, uint32_t flags, uint32_t overlapped,
+                           uint32_t stride) {
+  if (!users) return uint32_t(X_E_INVALIDARG);
+  if (flags) return 0x80004001u; // E_NOTIMPL
+  auto* bytes = users.as<uint8_t*>();
+  for (unsigned i = 1; i < 4; ++i) {
+    if (rex::memory::load_and_swap<uint64_t>(bytes + i * stride))
+      return 0x80004001u; // E_NOTIMPL: never partially apply a multi-user request.
+  }
+  const auto xuid = rex::memory::load_and_swap<uint64_t>(bytes);
+  const auto result = REX_KERNEL_STATE()->user_profile()->SetLocalSession(xuid);
+  const auto hr = X_HRESULT_FROM_WIN32(result);
+  if (overlapped) {
+    // Original LogonEx returns HRESULT acceptance, with result in XOVERLAPPED.
+    REX_KERNEL_STATE()->CompleteOverlappedImmediateEx(overlapped, result, hr, 0);
   }
-  return signin_state;
+  return hr;
+}
