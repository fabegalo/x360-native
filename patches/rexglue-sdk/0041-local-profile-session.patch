+REX_TEST_CASE("host C streams preserve Unicode names and binary byte values", "[base][host-file-mode]") {
+  rex::test::TempFolder folder("rex_host_mode_");
+  const auto path = folder.path / std::filesystem::path(u"perfil-\u65E5\u00E3.dat");
+  const std::vector<u8> expected{0, 10, 13, 26, 255};
+  {
+    auto* file = rex::platform::OpenFile(path, "wb");
+    REQUIRE(file != nullptr);
+    rex::ScopeGuard close([&] { std::fclose(file); });
+    REQUIRE(std::fwrite(expected.data(), 1, expected.size(), file) == expected.size());
+  }
+  {
+    auto* file = rex::platform::OpenFile(path, "rb");
+    REQUIRE(file != nullptr);
+    rex::ScopeGuard close([&] { std::fclose(file); });
+    std::vector<u8> actual(expected.size());
+    REQUIRE(std::fread(actual.data(), 1, actual.size(), file) == actual.size());
+    CHECK(actual == expected);
+    CHECK(std::fgetc(file) == EOF);
+  }
+  CHECK(rex::platform::OpenFile(path, nullptr) == nullptr);
+  CHECK(rex::platform::OpenFile(path, "") == nullptr);
+  CHECK(rex::platform::OpenFile(folder.path / "missing", "rb") == nullptr);
+}
