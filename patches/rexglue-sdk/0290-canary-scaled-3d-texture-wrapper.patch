diff --git a/src/gpu/xenos/d3d12/texture_cache.cpp b/src/gpu/xenos/d3d12/texture_cache.cpp
--- a/src/gpu/xenos/d3d12/texture_cache.cpp
+++ b/src/gpu/xenos/d3d12/texture_cache.cpp
@@ -1863,6 +1863,10 @@
   desc.Alignment = 0;
   desc.Width = GetKey().GetWidth();
   desc.Height = GetKey().GetHeight();
+  if (GetKey().scaled_resolve) {
+    desc.Width *= d3d12_cache.GetDrawResolutionScaleX();
+    desc.Height *= d3d12_cache.GetDrawResolutionScaleY();
+  }
   desc.DepthOrArraySize = 1;
   desc.MipLevels = 1;
   desc.Format = d3d12_cache.GetDXGIResourceFormat(GetKey());
