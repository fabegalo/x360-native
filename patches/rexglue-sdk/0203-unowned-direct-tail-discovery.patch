 namespace detail {
 
 [[nodiscard]] Result<void> GapFill(CodegenContext& ctx, IProgressReporter* reporter) {
   (void)reporter;
+  DiscoverReferencedEntries(ctx);
+  DiscoverUnownedTailTargets(ctx);
   GapFillCodeRegions(ctx);
   CleanupAbsorbedGapFills(ctx);
+  DiscoverReferencedEntries(ctx);
+  CleanupAbsorbedGapFills(ctx);
+  DiscoverUnownedTailTargets(ctx);
 
   return Ok();
 }
