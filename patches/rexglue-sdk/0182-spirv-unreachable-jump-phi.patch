 #include <rex/graphics/pipeline/shader/spirv_builder.h>
 
 namespace rex::graphics {
+
+void SpirvBuilder::RemoveUnreachableDecorations() {
+  std::unordered_set<spv::Id> omitted_definitions;
+  for (const auto* function : module.getFunctions()) {
+    std::unordered_set<const spv::Block*> emitted_blocks;
+    spv::inReadableOrder(function->getEntryBlock(),
+        [&emitted_blocks](spv::Block* block, spv::ReachReason, spv::Block*) {
+          emitted_blocks.insert(block);
+        });
+    for (const auto* block : function->getBlocks()) {
+      if (emitted_blocks.contains(block)) {
+        continue;
+      }
+      for (const auto& instruction : block->getInstructions()) {
+        if (instruction->getResultId()) {
+          omitted_definitions.insert(instruction->getResultId());
+        }
+      }
+    }
+  }
+  decorations.erase(std::remove_if(decorations.begin(), decorations.end(),
+      [&omitted_definitions](const std::unique_ptr<spv::Instruction>& decoration) {
+        return omitted_definitions.contains(decoration->getIdOperand(0));
+      }), decorations.end());
+}
 
