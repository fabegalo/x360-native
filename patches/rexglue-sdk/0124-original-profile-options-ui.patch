+REX_TEST_CASE("profile options request the original Guide page and propagate dispatch errors", "[kernel][xam][profile-options]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    CHECK(c.XAM("XamShowOptionsUI", {2}) == 1627);
+    u32 calls = 0;
+    ui.system_ui_request = [&](u32 message, u32 buffer, u32 bytes) {
+      ++calls;
+      CHECK(message == 0x21015);
+      CHECK(bytes == 12);
+      CHECK(c.Load32(buffer) == 0);
+      CHECK(c.Load32(buffer + 4) == 2);
+      CHECK(c.Load32(buffer + 8) == 6);
+      return 0u;
+    };
+    rex::ScopeGuard clear([&] { ui.system_ui_request = {}; });
+    CHECK(c.XAM("XamShowOptionsUI", {2}) == 0);
+    CHECK(c.XAM("XamShowOptionsUI", {4}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(calls == 1);
+    ui.system_ui_request = [](u32, u32, u32) { return 0x8007000Eu; };
+    CHECK(c.XAM("XamShowOptionsUI", {2}) == 14);
+    ui.system_ui_request = [](u32, u32, u32) { return 0x80004005u; };
+    CHECK(c.XAM("XamShowOptionsUI", {2}) == 1627);
+    CHECK(rex::xam::CurrentXAM().GetUserProfile().GetSigninState() == 0);
+    CHECK_FALSE(ui.GetSystemUiSession().visible);
+  });
+}
