 void MnkInputDriver::SetKeyState(uint16_t vk, bool down) {
   if (vk < 256) {
+    bool previous[256];
+    std::memcpy(previous, key_down_, sizeof(previous));
     key_down_[vk] = down;
+    QueueButtonTransitions(previous);
+  }
+}
+
+void MnkInputDriver::QueueButtonTransitions(const bool (&previous)[256]) {
+  // GetState polling alone loses taps between polls. Deliver actual configured
+  // button transitions to GetKeystroke consumers too (e.g. the dashboard).
+  // Compare complete chords, so modifier changes and alternate bindings work.
+  struct Binding { VirtualKey pad; const std::string* keys; };
+  const Binding bindings[] = {
+      {VirtualKey::kXInputPadA, &REXCVAR_GET(keybind_a)},
+      {VirtualKey::kXInputPadB, &REXCVAR_GET(keybind_b)},
+      {VirtualKey::kXInputPadX, &REXCVAR_GET(keybind_x)},
+      {VirtualKey::kXInputPadY, &REXCVAR_GET(keybind_y)},
+      {VirtualKey::kXInputPadLShoulder, &REXCVAR_GET(keybind_left_shoulder)},
+      {VirtualKey::kXInputPadRShoulder, &REXCVAR_GET(keybind_right_shoulder)},
+      {VirtualKey::kXInputPadLThumbPress, &REXCVAR_GET(keybind_lstick_press)},
+      {VirtualKey::kXInputPadRThumbPress, &REXCVAR_GET(keybind_rstick_press)},
+      {VirtualKey::kXInputPadBack, &REXCVAR_GET(keybind_back)},
+      {VirtualKey::kXInputPadStart, &REXCVAR_GET(keybind_start)},
+      {VirtualKey::kXInputPadDpadUp, &REXCVAR_GET(keybind_dpad_up)},
+      {VirtualKey::kXInputPadDpadDown, &REXCVAR_GET(keybind_dpad_down)},
+      {VirtualKey::kXInputPadDpadLeft, &REXCVAR_GET(keybind_dpad_left)},
+      {VirtualKey::kXInputPadDpadRight, &REXCVAR_GET(keybind_dpad_right)},
+      {VirtualKey::kXInputPadLTrigger, &REXCVAR_GET(keybind_left_trigger)},
+      {VirtualKey::kXInputPadRTrigger, &REXCVAR_GET(keybind_right_trigger)},
+  };
+  // Release old chords before pressing new ones, like the SDL pad driver.
+  for (bool down : {false, true}) {
+    for (const auto& binding : bindings) {
+      const bool was = IsBindPressed(previous, *binding.keys);
+      const bool now = IsBindPressed(key_down_, *binding.keys);
+      if (was != now && now == down) {
+        EnqueueKeystroke(static_cast<uint16_t>(binding.pad), down);
+      }
+    }
   }
 }
 
