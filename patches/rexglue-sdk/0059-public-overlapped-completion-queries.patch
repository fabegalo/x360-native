+REX_TEST_CASE("public overlapped queries honor nonblocking requests and completed results", "[kernel][xam][overlapped-query]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto request = caller.Alloc(sizeof(rex::kernel::XOVERLAPPED)), length = caller.Alloc(4);
+    caller.Store32(length, 0xCDCDCDCD);
+    CHECK(caller.XAM("XGetOverlappedResult", {0, length, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    CHECK(caller.XAM("XGetOverlappedExtendedError", {0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+    caller.Store32(request, rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(caller.XAM("XGetOverlappedResult", {request, length, 0}) == rex::kernel::X_ERROR_IO_INCOMPLETE);
+    CHECK(caller.Load32(length) == 0xCDCDCDCD);
+    CHECK(caller.XAM("XGetOverlappedResult", {request, length, 1}) == rex::kernel::X_ERROR_IO_INCOMPLETE);
+    CHECK(caller.XAM("XGetOverlappedExtendedError", {request}) == rex::kernel::X_ERROR_IO_INCOMPLETE);
+    caller.Store32(request + 12, 0x12345678);
+    CHECK(caller.XAM("XGetOverlappedResult", {request, length, 1}) == rex::kernel::X_ERROR_INVALID_HANDLE);
+    caller.Store32(request + 12, 0);
+    CHECK(caller.XAM("XMsgCompleteIORequest", {request, rex::kernel::X_ERROR_ACCESS_DENIED, 0x81234567, 99}) == 0);
+    CHECK(caller.XAM("XGetOverlappedResult", {request, length, 0}) == rex::kernel::X_ERROR_ACCESS_DENIED);
+    CHECK(caller.Load32(length) == 99);
+    CHECK(caller.XAM("XGetOverlappedExtendedError", {request}) == 0x81234567);
+    const auto event_out = caller.Alloc(4);
+    REQUIRE(caller.Kernel("NtCreateEvent", {event_out, 0, 0, 1}) == 0);
+    const auto event = caller.Load32(event_out);
+    caller.Store32(request + 12, event);
+    REQUIRE(caller.XAM("XMsgCompleteIORequest", {request, 0, 0, 123}) == 0);
+    REQUIRE(caller.Kernel("NtClearEvent", {event}) == 0);
+    caller.Store32(request, rex::kernel::X_ERROR_IO_PENDING);
+    const auto worker = caller.Spawn([=](Caller& other) {
+      CHECK(other.XAM("XMsgCompleteIORequest", {request, 0, 0, 456}) == 0);
+    });
+    REQUIRE(worker != 0);
+    CHECK(caller.XAM("XGetOverlappedResult", {request, length, 1}) == 0);
+    CHECK(caller.Load32(length) == 456);
+    CHECK(caller.Kernel("NtWaitForSingleObjectEx", {worker, 0, 0, 0}) == 0);
+    CHECK(caller.Kernel("NtClose", {worker}) == 0);
+    CHECK(caller.Kernel("NtClose", {event}) == 0);
+    caller.Store32(length, 0xCDCDCDCD);
+    CHECK(caller.XAM("XamGetCurrentDemand", {length, 0}) == 0);
+    CHECK(caller.Load32(length) == 0);
+    CHECK(caller.XAM("XamGetCurrentDemand", {0, 0}) == 0);
+  });
+}
