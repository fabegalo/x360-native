+u32 XGetOverlappedExtendedError_entry(GuestPtrT<kernel::XOVERLAPPED> overlapped) {
+  if (!overlapped) return kernel::X_ERROR_INVALID_PARAMETER;
+  return CurrentTitle().overlapped_dispatcher.Observe([&]() -> u32 {
+    return overlapped->result == kernel::X_ERROR_IO_PENDING ? kernel::X_ERROR_IO_INCOMPLETE
+        : static_cast<u32>(overlapped->extended_error);
+  });
+}
+
+u32 XGetOverlappedResult_entry(GuestPtrT<kernel::XOVERLAPPED> overlapped,
+                              MappedU32 length, u32 wait) {
+  if (!overlapped) return kernel::X_ERROR_INVALID_PARAMETER;
+  auto read_result = [&] {
+    return CurrentTitle().overlapped_dispatcher.Observe([&]() -> u32 { return overlapped->result; });
+  };
+  if (read_result() == kernel::X_ERROR_IO_PENDING) {
+    if (!wait || !overlapped->event) return kernel::X_ERROR_IO_INCOMPLETE;
+    const auto event = static_cast<u32>(overlapped->event);
+    auto pinned = CurrentTitle().objects.Get<kernel::EventObject>(event);
+    if (!pinned) return kernel::X_ERROR_INVALID_HANDLE;
+    const auto status = CurrentTitle().threads.GetObjectWaiter().WaitGuestObject(event, 0, 0, 0, nullptr);
+    if (kernel::XFAILED(status)) return kernel::xboxkrnl::RtlNtStatusToDosError(status);
+  }
+  return CurrentTitle().overlapped_dispatcher.Observe([&]() -> u32 {
+    if (length) *length = overlapped->length;
+    return overlapped->result;
+  });
+}
+
 }  // namespace xam
