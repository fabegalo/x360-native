+// Original 17559 exports 81722390/817223B8. Unlike Xam's internal
+// helper the public query honors wait=false and exposes extended_error.
+u32 XGetOverlappedExtendedError_entry(ppc_ptr_t<XAM_OVERLAPPED> overlapped) {
+  if (!overlapped) return X_ERROR_INVALID_PARAMETER;
+  return overlapped->result == X_ERROR_IO_PENDING ? X_ERROR_IO_INCOMPLETE
+                                                : uint32_t(overlapped->extended_error);
+}
+u32 XGetOverlappedResult_entry(ppc_ptr_t<XAM_OVERLAPPED> overlapped,
+                               mapped_u32 length, u32 wait) {
+  if (!overlapped) return X_ERROR_INVALID_PARAMETER;
+  if (overlapped->result == X_ERROR_IO_PENDING) {
+    if (!wait || !overlapped->event) return X_ERROR_IO_INCOMPLETE;
+    auto event = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(overlapped->event);
+    if (!event) return X_ERROR_INVALID_HANDLE;
+    const auto status = event->Wait(0, 0, 0, nullptr);
+    if (XFAILED(status)) return xboxkrnl::xeRtlNtStatusToDosError(status);
+  }
+  if (length) *length = overlapped->length;
+  return overlapped->result;
+}
+
