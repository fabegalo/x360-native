       auto at_pos = sym.name.find('@');
@@ -486,12 +487,29 @@ VoidResult registerEntryPoints(CodegenContext& ctx) {
         }
       }
 
-      if (resolvedName.empty()) {
+      const bool resolved = !resolvedName.empty();
+      if (!resolved) {
         REXCODEGEN_ERROR("Cannot resolve ordinal {} from {}", ordinal, lib_name);
         resolvedName = fmt::format("sub_{:X}", sym.address);
         unresolvedCount++;
       }
 
+      // patch 0003: a symbol at address 0 is an import record with a value slot and no
+      // thunk; there is no guest code to map. Address 0 also ends PPCFuncMappings, so a
+      // function there left every recompiled function unregistered at runtime. A known
+      // function import without a thunk is a validation error (code may call it through
+      // the slot, which nothing fills); an unresolved one is already reported above.
+      if (sym.address == 0) {
+        if (resolved) {
+          ctx.errors.Add(AnalysisErrors::Category::ImportWithoutThunk, 0,
+                         fmt::format("import {} ({}) has a value slot and no thunk", sym.name,
+                                     resolvedName));
+        }
+        REXCODEGEN_ERROR("Import {} has no thunk; not registered as a function", sym.name);
+        unthunkedCount++;
+        continue;
+      }
+
       auto* node = graph.addImportFunction(sym.address, resolvedName);
       if (node && node->canDiscover()) {
         node->discoverAsImport();
@@ -503,8 +521,9 @@ VoidResult registerEntryPoints(CodegenContext& ctx) {
     }
 
     REXCODEGEN_TRACE(
-        "Analyze: loaded {} imports ({} resolved, {} unresolved, {} variables skipped)",
-        importCount, resolvedCount, unresolvedCount, variableCount);
+        "Analyze: loaded {} imports ({} resolved, {} unresolved, {} variables skipped, {} without "
+        "thunk)",
+        importCount, resolvedCount, unresolvedCount, variableCount, unthunkedCount);
   }
 
   // Register save/restore helpers
diff --git a/src/system/xex_module.cpp b/src/system/xex_module.cpp
index 0726516..18178d1 100644
--- a/src/system/xex_module.cpp
+++ b/src/system/xex_module.cpp
@@ -1120,6 +1120,38 @@ bool XexModule::SetupLibraryImports(const std::string_view name,
     }
   }
 
+  // patch 0003: one library can be split over several import library records, and
+  // the value slot (type 0) and the thunk (type 1) of one function import can fall in
+  // different records (dash.xex 2.0.17559.0, xam 0x8E2). Complete the half-filled
+  // entry of the earlier record instead of keeping two halves: the half without a
+  // thunk became an import symbol at address 0 (PopulateBinaryData), which the
+  // codegen mapped as a function there. Two halves of the same kind, or entries
+  // complete on both sides, stay separate.
+  for (auto& earlier : import_libs_) {
+    if (earlier.name != library_info.name) {
+      continue;
+    }
+    for (auto& prev : earlier.imports) {
+      auto it = import_map.find(static_cast<uint16_t>(prev.ordinal));
+      if (it == import_map.end()) {
+        continue;
+      }
+      const auto& cur = it->second;
+      const bool slot_then_thunk =
+          prev.value_address && !prev.thunk_address && !cur.value_address && cur.thunk_address;
+      const bool thunk_then_slot =
+          !prev.value_address && prev.thunk_address && cur.value_address && !cur.thunk_address;
+      if (!slot_then_thunk && !thunk_then_slot) {
+        continue;
+      }
+      prev.value_address |= cur.value_address;
+      prev.thunk_address |= cur.thunk_address;
+      REXLOG_DEBUG("Paired import {}:{:#x} across import library records (slot {:08X}, thunk {:08X})",
+                   base_name, prev.ordinal, prev.value_address, prev.thunk_address);
+      import_map.erase(it);
+    }
+  }
+
   // Convert map to vector (sorted by ordinal for consistent output)
   std::vector<uint16_t> ordinals;
   ordinals.reserve(import_map.size());
