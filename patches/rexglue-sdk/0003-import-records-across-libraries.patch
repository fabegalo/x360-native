diff --git a/src/kernel/xex_module.cpp b/src/kernel/xex_module.cpp
--- a/src/kernel/xex_module.cpp
+++ b/src/kernel/xex_module.cpp
@@ -372,6 +372,38 @@
     }
   }
 
+  // Pair complementary records of the same library, preserving complete duplicates.
+  for (auto& earlier : import_libs_) {
+    if (earlier.name != import_library.name) {
+      continue;
+    }
+    for (auto& prev : earlier.imports) {
+      auto it = import_map.find(static_cast<u16>(prev.ordinal));
+      if (it == import_map.end()) {
+        continue;
+      }
+      const auto& cur = it->second;
+      const bool slot_then_thunk =
+          prev.value_address && !prev.thunk_address && !cur.value_address && cur.thunk_address;
+      const bool thunk_then_slot =
+          !prev.value_address && prev.thunk_address && cur.value_address && !cur.thunk_address;
+      if (!slot_then_thunk && !thunk_then_slot) {
+        continue;
+      }
+      prev.value_address |= cur.value_address;
+      prev.thunk_address |= cur.thunk_address;
+      REXSYS_DEBUG("Paired import {}:{:#x} across import library records (slot {:08X}, thunk {:08X})",
+                   base_name, prev.ordinal, prev.value_address, prev.thunk_address);
+      if (kernel) {
+        const auto* exp = rex::kernel::FindByOrdinal(kernel->exports, prev.ordinal);
+        if (exp && exp->type == rex::kernel::ExportType::kFunction)
+          *GetAddressSpace()->TranslateVirtual<be_u32*>(prev.value_address) = prev.thunk_address;
+      }
+      import_map.erase(it);
+    }
+  }
+
+
   std::vector<u16> ordinals;
   ordinals.reserve(import_map.size());
   for (const auto& [ordinal, import_info] : import_map) {
