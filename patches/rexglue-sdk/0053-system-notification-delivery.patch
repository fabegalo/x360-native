+
+REX_TEST_CASE("system notification exports preserve private IDs and official waitable mask/version filtering", "[kernel][xam][notification-delivery]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto matching = caller.XAM("XamNotifyCreateListener", {2, 0});
+    const auto filtered = caller.XAM("XamNotifyCreateListener", {4, 0});
+    const auto version1 = caller.XAM("XamNotifyCreateListener", {2, 1});
+    REQUIRE(matching != 0);
+    REQUIRE(filtered != 0);
+    REQUIRE(version1 != 0);
+    const auto id = caller.Alloc(4), parameter = caller.Alloc(4), timeout = caller.AllocQuad(0);
+    CHECK(caller.Kernel("NtWaitForSingleObjectEx", {matching, 0, 0, timeout}) == rex::kernel::X_STATUS_TIMEOUT);
+    caller.XAM("XNotifyBroadcast", {0x82000011, 0xFFFFFFFF});
+    CHECK(caller.Kernel("NtWaitForSingleObjectEx", {matching, 0, 0, timeout}) == 0);
+    CHECK(caller.Kernel("NtWaitForSingleObjectEx", {filtered, 0, 0, timeout}) == rex::kernel::X_STATUS_TIMEOUT);
+    REQUIRE(caller.XAM("XNotifyGetNext", {matching, 0, id, parameter}) == 1);
+    CHECK(caller.Load32(id) == 0x82000011);
+    CHECK(caller.Load32(parameter) == 0xFFFFFFFF);
+    CHECK(caller.Kernel("NtWaitForSingleObjectEx", {matching, 0, 0, timeout}) == rex::kernel::X_STATUS_TIMEOUT);
+    CHECK(caller.XAM("XNotifyGetNext", {filtered, 0, id, parameter}) == 0);
+    caller.XAM("XNotifyBroadcast", {0x82010011, 42});
+    CHECK(caller.XAM("XNotifyGetNext", {matching, 0x82010011, id, parameter}) == 0);
+    REQUIRE(caller.XAM("XNotifyGetNext", {version1, 0x82010011, id, parameter}) == 1);
+    CHECK(caller.Load32(id) == 0x82010011);
+    CHECK(caller.Load32(parameter) == 42);
+    for (const auto handle : {matching, filtered, version1}) CHECK(caller.Kernel("NtClose", {handle}) == 0);
+  });
+}
