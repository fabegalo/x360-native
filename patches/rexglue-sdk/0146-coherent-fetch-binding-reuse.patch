+  // Adapted from Forza Horizon 1: ReImagined, cb676f7, patch 0032 (MIT).
+  struct FetchConstantChanges {
+    u32 first = UINT32_MAX;
+    u32 last = 0;
+    explicit operator bool() const { return first != UINT32_MAX; }
+  };
+  FetchConstantChanges WriteFetchConstantsFromMem(u32 start_index,
+                                                 const u32* base,
+                                                 u32 count) {
+    REX_ASSERT(start_index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_00_0));
+    REX_ASSERT(start_index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_31_5) + 1);
+    REX_ASSERT(count <= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_31_5) + 1 - start_index);
+    FetchConstantChanges changed;
+    for (u32 i = 0; i < count; ++i) {
+      const u32 value = memory::load_and_swap<u32>(base + i);
+      const u32 index = start_index + i;
+      if (values[index] != value) {
+        values[index] = value;
+        if (!changed) changed.first = index;
+        changed.last = index;
+      }
+    }
+    return changed;
+  }
