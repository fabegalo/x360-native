+  // Fetch descriptors have no register-write side effects. Return only the
+  // changed dwords (inclusive); memory residency is invalidated independently.
+  // Adapted from Forza Horizon 1: ReImagined, cb676f7, patch 0032 (MIT).
+  struct FetchConstantChanges {
+    uint32_t first = UINT32_MAX;
+    uint32_t last = 0;
+    explicit operator bool() const { return first != UINT32_MAX; }
+  };
+  FetchConstantChanges WriteFetchConstantsFromMem(uint32_t start_index,
+                                                 const uint32_t* base,
+                                                 uint32_t count) {
+    assert_true(start_index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0);
+    assert_true(start_index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5 + 1);
+    assert_true(count <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5 + 1 - start_index);
+    FetchConstantChanges changed;
+    for (uint32_t i = 0; i < count; ++i) {
+      const uint32_t value = memory::load_and_swap<uint32_t>(base + i);
+      const uint32_t index = start_index + i;
+      if (values[index] != value) {
+        values[index] = value;
+        if (!changed) changed.first = index;
+        changed.last = index;
+      }
+    }
+    return changed;
+  }
