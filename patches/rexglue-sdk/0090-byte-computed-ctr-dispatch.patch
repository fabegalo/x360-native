 //=============================================================================
 // Jump Table Detection
 //=============================================================================
+namespace {
+
+// A byte load followed by a constant-base add has a finite destination domain
+// even when the number of table slots is unknowable. Recognize the actual
+// def-use chain (including the exact rotate/mask), without reading table data.
+// Keep this matcher local and conservative: only nops may separate definitions.
+std::optional<JumpTable> detectByteDispatch(DecodedBinary& decoded, uint32_t bctr,
+                                          uint32_t start, uint32_t end) {
+  using namespace rex::codegen::ppc;
+  uint32_t cursor = bctr;
+  auto previous = [&]() -> const Instruction* {
+    while (cursor >= start + 4) {
+      cursor -= 4;
+      const auto* insn = decoded.get(cursor);
+      if (!insn || static_cast<uint32_t>(insn->code) != 0x60000000)
+        return insn;
+    }
+    return nullptr;
+  };
+  const auto* ctr = previous();
+  if (!ctr || ctr->opcode != Opcode::mtctr) return std::nullopt;
+  const auto* sum = previous();
+  if (!sum || sum->opcode != Opcode::add || sum->XO.RT != ctr->XFX.RT)
+    return std::nullopt;
+  const auto* low = previous();
+  if (!low || low->opcode != Opcode::addi || low->D.RT == 0 || low->D.RA != low->D.RT)
+    return std::nullopt;
+  const uint8_t baseReg = low->D.RT;
+  uint8_t offsetReg;
+  if (sum->XO.RA == baseReg) offsetReg = sum->XO.RB;
+  else if (sum->XO.RB == baseReg) offsetReg = sum->XO.RA;
+  else return std::nullopt;
+  if (offsetReg == baseReg) return std::nullopt;
+  const auto* high = previous();
+  if (!high || high->opcode != Opcode::lis || high->D.RT != baseReg)
+    return std::nullopt;
+  const uint32_t base = (uint32_t(high->D.UIMM()) << 16) + int16_t(low->D.d);
+  const auto* value = previous();
+  uint32_t shift = 0, mask = 0xFFFFFFFF;
+  if (value && value->opcode == Opcode::rlwinm && value->M.RA == offsetReg) {
+    // A record-form rotate changes CR; it is still executed by the emitter.
+    shift = value->M.SH;
+    mask = 0;
+    for (unsigned bit = 0; bit < 32; ++bit) {
+      const bool included = value->M.MB <= value->M.ME
+          ? bit >= value->M.MB && bit <= value->M.ME
+          : bit >= value->M.MB || bit <= value->M.ME;
+      if (included) mask |= 0x80000000u >> bit;
+    }
+    offsetReg = value->M.RS;
+    value = previous();
+  }
+  if (!value || value->opcode != Opcode::lbzx || value->X.RT != offsetReg)
+    return std::nullopt;
+
+  JumpTable jt{};
+  jt.bctrAddress = bctr;
+  jt.dispatchByTarget = true;
+  // These are possible branch destinations derived from PPC semantics, not
+  // invented table entries. Never extend ownership into the next function.
+  for (uint32_t byte = 0; byte < 256; ++byte) {
+    const uint32_t rotated = shift ? (byte << shift) | (byte >> (32 - shift)) : byte;
+    const uint32_t target = (base + (rotated & mask)) & ~3u;
+    if (target >= start && target < end) {
+      const auto* insn = decoded.get(target);
+      if (insn && static_cast<uint32_t>(insn->code) != 0 &&
+          static_cast<uint32_t>(insn->code) != 0xFFFFFFFF)
+        jt.targets.push_back(target);
+    }
+  }
+  std::sort(jt.targets.begin(), jt.targets.end());
+  jt.targets.erase(std::unique(jt.targets.begin(), jt.targets.end()), jt.targets.end());
+  return jt;
+}
