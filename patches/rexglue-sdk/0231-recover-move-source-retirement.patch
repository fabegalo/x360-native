+// Restore an uncommitted source retirement without replacing any new content.
+// All conflict checks precede the first rename; a partial rollback is retryable.
+static X_RESULT RestoreRetiredSource(const std::filesystem::path& staging,
+                                    const std::filesystem::path& package,
+                                    const std::filesystem::path& header) {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  const std::array<std::pair<fs::path, fs::path>, 2> paths{{
+      {staging / "package", package}, {staging / "header", header}}};
+  for (size_t i = 0; i != paths.size(); ++i) {
+    const auto& [from, to] = paths[i];
+    const bool exists = fs::exists(from, ec);
+    if (ec || !IsUnlinkedStoragePath(from) || !IsUnlinkedStoragePath(to)) return X_ERROR_ACCESS_DENIED;
+    if (!exists) continue;
+    if ((i == 0 ? !fs::is_directory(from, ec) : !fs::is_regular_file(from, ec)) || ec)
+      return X_RESULT_FROM_WIN32(13);
+    if (fs::exists(to, ec)) return X_ERROR_ALREADY_EXISTS;
+    if (ec) return X_ERROR_ACCESS_DENIED;
+  }
+  for (const auto& [from, to] : paths) {
+    const bool exists = fs::exists(from, ec);
+    if (ec) return X_ERROR_ACCESS_DENIED;
+    if (!exists) continue;
+    fs::create_directories(to.parent_path(), ec);
+    if (ec || !IsUnlinkedStoragePath(to.parent_path())) return X_ERROR_ACCESS_DENIED;
+    fs::rename(from, to, ec);
+    if (ec) return X_ERROR_ACCESS_DENIED;
+  }
+  return X_ERROR_SUCCESS;
+}
