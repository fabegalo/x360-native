+// Moves retire their source only after publishing a complete destination.
+// The ready intent allows rollback until both source names have been hidden.
+// The retired intent commits their removal; restart cleans only private bytes.
+static X_RESULT RetireMovedSource(const ContentDeviceInfo& device,
+                                 const XCONTENT_AGGREGATE_DATA& data,
+                                 const std::filesystem::path& package,
+                                 const std::filesystem::path& header,
+                                 const ContentManager::TransferCheckpoint& checkpoint,
+                                 bool& removed) try {
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  removed = false;
+  if (!IsUnlinkedStoragePath(package) || !IsUnlinkedStoragePath(header)) return X_ERROR_ACCESS_DENIED;
+  if (!fs::is_directory(package, ec)) return ec ? X_ERROR_ACCESS_DENIED : X_ERROR_FILE_NOT_FOUND;
+  const auto root = fs::absolute(device.root).lexically_normal() / kTransferStagingDirName;
+  X_RESULT recovered = X_ERROR_SUCCESS;
+  {
+    std::lock_guard lock(staging_mutex_);
+    auto& active = active_transfers_[root];
+    if (!active) recovered = RecoverTransferStagingLocked(device);
+    ++active;
+  }
+  struct Active {
+    fs::path root;
+    ~Active() {
+      std::lock_guard lock(staging_mutex_);
+      const auto it = active_transfers_.find(root);
+      if (--it->second == 0) active_transfers_.erase(it);
+    }
+  } active{root};
+  if (recovered) return recovered;
+  const auto staging = root / fmt::format("retire-{:016X}-{:08X}",
+      uint64_t(std::chrono::steady_clock::now().time_since_epoch().count()),
+      uint32_t(transfer_sequence_.fetch_add(1)));
+  struct Cleanup {
+    fs::path root, path;
+    bool keep = false;
+    ~Cleanup() {
+      if (keep || path.parent_path() != root || !UnlinkedTransferTree(path)) return;
+      std::error_code e;
+      fs::remove_all(path, e);
+      fs::remove(root, e);
+    }
+  } cleanup{root, staging};
+  if (!fs::create_directories(staging, ec) || !IsUnlinkedStoragePath(staging))
+    return X_ERROR_ACCESS_DENIED;
+  const auto journal = staging / "journal";
+  auto* file = rex::filesystem::OpenFile(journal, "wb");
+  if (!file) return X_ERROR_ACCESS_DENIED;
+  const bool written = fwrite(&data, 1, sizeof(data), file) == sizeof(data);
+  const bool closed = fclose(file) == 0;
+  if (!written || !closed) return X_ERROR_ACCESS_DENIED;
+  const auto digest = rex::hash_bytes(std::string_view(
+      reinterpret_cast<const char*>(&data), sizeof(data)));
+  const auto prepared = staging / ("retire-" + digest + ".ready");
+  const auto committed = staging / ("retired-" + digest + ".ready");
+  fs::rename(journal, prepared, ec);
+  if (ec) return X_ERROR_ACCESS_DENIED;
+  if (checkpoint) checkpoint(ContentManager::TransferStage::SourcePrepared);
+  auto rollback = [&] {
+    const auto result = RestoreRetiredSource(staging, package, header);
+    cleanup.keep = result != X_ERROR_SUCCESS;
+    return X_ERROR_ACCESS_DENIED;
+  };
+  cleanup.keep = true;
+  fs::rename(package, staging / "package", ec);
+  if (ec) return rollback();
+  if (checkpoint) checkpoint(ContentManager::TransferStage::SourcePackageRetired);
+  const bool header_exists = fs::exists(header, ec);
+  if (ec) return rollback();
+  if (header_exists) {
+    fs::rename(header, staging / "header", ec);
+    if (ec) return rollback();
+  }
+  if (checkpoint) checkpoint(ContentManager::TransferStage::SourceHeaderRetired);
+  fs::rename(prepared, committed, ec);
+  if (ec) return rollback();
+  removed = true;
+  if (checkpoint) checkpoint(ContentManager::TransferStage::SourceRetired);
+  // A failed physical cleanup remains private and recoverable, never a
+  // partially deleted save in the public catalog. Report the actual error.
+  if (!UnlinkedTransferTree(staging)) return X_ERROR_ACCESS_DENIED;
+  fs::remove_all(staging, ec);
+  if (ec) return X_ERROR_ACCESS_DENIED;
+  cleanup.keep = false;
+  return X_ERROR_SUCCESS;
+} catch (const std::filesystem::filesystem_error&) { return X_ERROR_ACCESS_DENIED; }
