-// https://www.se7ensins.com/forums/threads/working-xshowmessageboxui.844116/
+// Shared guest-memory guards for this bounded request. A heap reservation is
+// not evidence that its pages are committed or have the requested access.
+static bool MessageBoxSpan(memory::Memory* mem, uint32_t address, uint64_t size,
+                           uint32_t access) {
+  if (!address || !size || uint64_t(address) + size > 0x1'0000'0000ull) return false;
+  const uint64_t end = uint64_t(address) + size;
+  for (uint64_t page = address; page < end; page = (page & ~0xFFFull) + 0x1000) {
+    auto* heap = mem->LookupHeap(static_cast<uint32_t>(page));
+    memory::HeapAllocationInfo info{};
+    if (!heap || !heap->QueryRegionInfo(static_cast<uint32_t>(page), &info) ||
+        !(info.state & memory::kMemoryAllocationCommit) || (info.protect & access) != access)
+      return false;
+  }
+  return true;
+}
+
+static bool CopyMessageBoxText(memory::Memory* mem, uint32_t source,
+                               uint8_t* output, uint32_t capacity) {
+  if (!source) return true; // Optional title/body; destination is already zeroed.
+  for (uint32_t i = 0; i + 1 < capacity; ++i) {
+    const uint64_t at = uint64_t(source) + uint64_t(i) * 2;
+    if (at > UINT32_MAX || !MessageBoxSpan(mem, uint32_t(at), 2, memory::kMemoryProtectRead))
+      return false;
+    const auto value = memory::load_and_swap<uint16_t>(mem->TranslateVirtual(uint32_t(at)));
+    if (!value) break;
+    memory::store_and_swap<uint16_t>(output + i * 2, value);
+  }
+  return true;
+}
