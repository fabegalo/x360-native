+namespace {
+constexpr size_t kMaxTitlesPlayed = 4096;
+std::filesystem::path TitlesPlayedPath(const std::filesystem::path& store, uint64_t xuid) {
+  return store.parent_path() / fmt::format("{:016X}", xuid) / "titles-played.dat";
+}
+}
+
+std::vector<uint32_t> UserProfile::TitlesPlayed(uint64_t xuid) const {
+  std::filesystem::path store;
+  {
+    std::lock_guard lock(identity_mutex_);
+    if (!storage_ready_ || !ValidLocalXuid(xuid)) return {};
+    store = profile_path_;
+  }
+  // "X360TP01", big-endian count, then sorted unique big-endian title IDs.
+  std::vector<uint32_t> titles;
+  auto* file = rex::filesystem::OpenFile(TitlesPlayedPath(store, xuid), "rb");
+  if (!file) return titles;
+  std::array<uint8_t, 12> header{};
+  bool ok = fread(header.data(), 1, header.size(), file) == header.size() &&
+            !std::memcmp(header.data(), "X360TP01", 8);
+  const uint32_t count = ok ? (uint32_t(header[8]) << 24) | (uint32_t(header[9]) << 16) |
+                                  (uint32_t(header[10]) << 8) | header[11] : 0;
+  ok = ok && count <= kMaxTitlesPlayed;
+  for (uint32_t i = 0; ok && i < count; ++i) {
+    std::array<uint8_t, 4> id{};
+    ok = fread(id.data(), 1, id.size(), file) == id.size();
+    const uint32_t title = (uint32_t(id[0]) << 24) | (uint32_t(id[1]) << 16) |
+                           (uint32_t(id[2]) << 8) | id[3];
+    ok = ok && title && (titles.empty() || title > titles.back());
+    if (ok) titles.push_back(title);
+  }
+  ok = ok && fgetc(file) == EOF;
+  fclose(file);
+  if (!ok) {
+    REXSYS_ERROR("Local profile {:016X}: invalid titles played record", xuid);
+    return {};
+  }
+  return titles;
+}
+
+bool UserProfile::RecordTitlePlayed(uint32_t title_id) {
+  const auto account = identity();
+  if (!account.signin_state || !title_id || (title_id >> 16) == 0xFFFE) return false;
+  auto titles = TitlesPlayed(account.xuid);
+  const auto position = std::lower_bound(titles.begin(), titles.end(), title_id);
+  if (position != titles.end() && *position == title_id) return true;
+  if (titles.size() >= kMaxTitlesPlayed) return false;
+  titles.insert(position, title_id);
+  std::filesystem::path destination;
+  {
+    std::lock_guard lock(identity_mutex_);
+    if (!storage_ready_) return false;
+    destination = TitlesPlayedPath(profile_path_, account.xuid);
+  }
+  std::error_code error;
+  std::filesystem::create_directories(destination.parent_path(), error);
+  if (error) return false;
+  std::vector<uint8_t> record(12 + titles.size() * 4);
+  std::memcpy(record.data(), "X360TP01", 8);
+  auto put32 = [&](size_t offset, uint32_t value) {
+    for (unsigned i = 0; i < 4; ++i) record[offset + i] = uint8_t(value >> (24 - i * 8));
+  };
+  put32(8, uint32_t(titles.size()));
+  for (size_t i = 0; i < titles.size(); ++i) put32(12 + i * 4, titles[i]);
+  auto temporary = destination;
+  temporary += ".tmp";
+  auto* file = rex::filesystem::OpenFile(temporary, "wb");
+  if (!file) return false;
+  bool ok = fwrite(record.data(), 1, record.size(), file) == record.size() && fflush(file) == 0;
+  if (fclose(file)) ok = false;
+  if (ok) {
+    std::filesystem::rename(temporary, destination, error);
+    ok = !error;
+  }
+  if (!ok) std::filesystem::remove(temporary, error);
+  if (ok) REXSYS_INFO("Local profile {:016X}: title {:08X} played", account.xuid, title_id);
+  return ok;
+}
