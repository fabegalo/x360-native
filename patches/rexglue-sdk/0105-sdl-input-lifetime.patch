diff --git a/tests/unit/hid/sdl3_input_test.cpp b/tests/unit/hid/sdl3_input_test.cpp
--- a/tests/unit/hid/sdl3_input_test.cpp
+++ b/tests/unit/hid/sdl3_input_test.cpp
@@ -11,6 +11,9 @@
 #include "rex_test.h"
 
 #include <vector>
+#include <algorithm>
+#include <thread>
+#include <SDL3/SDL.h>
 
 #include <rex/driver.h>
 #include <rex/driver_context.h>
@@ -103,3 +106,64 @@
 
   driver->Shutdown();
 }
+
+
+REX_TEST_CASE_METHOD(Fixture, "SDL virtual hotplug ignores duplicate arrivals and retires detached state", "[hid][sdl3][sdl-lifetime]") {
+  auto driver = Create();
+  REQUIRE(driver);
+  TrackingContext context;
+  REQUIRE(driver->Initialize(context));
+  rex::ScopeGuard shutdown([&] { driver->Shutdown(); context.RunPosted(); });
+  SDL_VirtualJoystickDesc desc{};
+  SDL_INIT_INTERFACE(&desc);
+  desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+  desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+  desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+  desc.button_mask = (1u << SDL_GAMEPAD_BUTTON_COUNT) - 1;
+  desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1;
+  desc.vendor_id = 0x1234; desc.product_id = 0x5678;
+  desc.name = "ReXGlue migration virtual pad";
+  const auto instance = SDL_AttachVirtualJoystick(&desc);
+  REQUIRE(instance != 0);
+  bool attached = true;
+  rex::ScopeGuard detach([&] { if (attached) SDL_DetachVirtualJoystick(instance); });
+  context.RunPosted();
+  std::vector<rex::hid::PadDevice> devices;
+  driver->EnumerateDevices(devices);
+  auto ours = [](const auto& d) { return d.info.vendor == 0x1234 && d.info.product == 0x5678; };
+  REQUIRE(std::ranges::count_if(devices, ours) == 1);
+  const auto id = std::ranges::find_if(devices, ours)->id;
+  SDL_Event duplicate{};
+  duplicate.type = SDL_EVENT_GAMEPAD_ADDED;
+  duplicate.gdevice.which = instance;
+  REQUIRE(SDL_PushEvent(&duplicate));
+  driver->EnumerateDevices(devices);
+  CHECK(std::ranges::count_if(devices, ours) == 1);
+  REQUIRE(driver->GetDeviceState(id));
+  // The pending pump is coalesced before guest threads start polling.
+  driver->GetDeviceRevision();
+  std::thread first([&] { for (int i = 0; i < 64; ++i) (void)driver->GetDeviceState(id); });
+  std::thread second([&] { for (int i = 0; i < 64; ++i) (void)driver->GetDeviceState(id); });
+  const bool removed = SDL_DetachVirtualJoystick(instance);
+  first.join(); second.join();
+  REQUIRE(removed); attached = false;
+  driver->EnumerateDevices(devices);
+  CHECK(std::ranges::count_if(devices, ours) == 0);
+  CHECK_FALSE(driver->GetDeviceState(id));
+  CHECK_FALSE(driver->GetDeviceCapabilities(id));
+  CHECK_FALSE(driver->SetDeviceVibration(id, {}));
+}
+
+REX_TEST_CASE_METHOD(Fixture, "SDL pending UI work is safe after driver destruction and shutdown is repeatable", "[hid][sdl3][sdl-lifetime]") {
+  TrackingContext context;
+  auto driver = Create();
+  REQUIRE(driver->Initialize(context));
+  CHECK(driver->GetDeviceRevision() != 0);
+  REQUIRE_FALSE(context.posted.empty());
+  driver->Shutdown(); driver->Shutdown();
+  CHECK(driver->GetDeviceRevision() == 0);
+  CHECK_FALSE(driver->GetDeviceState(rex::hid::PadDeviceID{1}));
+  driver.reset();
+  context.RunPosted();
+  CHECK(context.posted.empty());
+}
