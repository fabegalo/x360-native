+REX_TEST_CASE("profile removal archives committed identities and keeps original user data recoverable", "[kernel][xam][local-profile-session][profile-removal]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  const auto root = rex::xam::CurrentTitle().user_data_root;
+  u64 first = 0, second = 0;
+  REQUIRE(profile.CreateLocal("First", &first) == 0);
+  REQUIRE(profile.SetLocalSession(first) == 0);
+  REQUIRE(profile.CreateLocal("Second", &second) == 0);
+  const auto v1 = root / "profiles" / "local-v1.dat", v2 = root / "profiles" / "local-v2.dat";
+  REQUIRE(std::filesystem::exists(v1)); REQUIRE(std::filesystem::exists(v2));
+  const auto data = root / "preserved-user-data.bin";
+  { std::ofstream out(data, std::ios::binary); out << "save and profile data"; }
+  const auto epoch = profile.GetStorageEpoch();
+  fixture.RunOnGuestThread([&](Caller& c) {
+    CHECK(c.XAM("XamProfileDelete", {2, second}) == static_cast<u32>(rex::kernel::XHRESULTFromWin32(rex::kernel::X_ERROR_DEVICE_NOT_CONNECTED)));
+    REQUIRE(c.XAM("XamProfileDelete", {0, second}) == 0);
+    CHECK(c.XAM("XamProfileDelete", {0, second}) == static_cast<u32>(rex::kernel::XHRESULTFromWin32(rex::kernel::X_ERROR_NO_SUCH_USER)));
+  });
+  CHECK(profile.identity().xuid == first); CHECK(profile.GetSigninState() == 1);
+  CHECK(profile.GetStorageEpoch() == epoch);
+  std::vector<std::filesystem::path> archives;
+  for (const auto& entry : std::filesystem::directory_iterator(root / "profiles" / "deleted")) archives.push_back(entry.path());
+  REQUIRE(archives.size() == 1);
+  CHECK(std::filesystem::file_size(archives.front()) == 20 + 2 * 25);
+  REQUIRE(profile.RemoveLocal(first) == 0);
+  CHECK(profile.identity().xuid == 0); CHECK(profile.GetSigninState() == 0);
+  CHECK(profile.GetStorageEpoch() > epoch);
+  CHECK(profile.local_profiles().empty());
+  CHECK(std::filesystem::file_size(v2) == 20);
+  CHECK(std::filesystem::file_size(v1) == 33);
+  CHECK(std::filesystem::file_size(data) == 21);
+  rex::xam::UserProfile reopened;
+  REQUIRE(reopened.InitializeLocal(root));
+  CHECK(reopened.local_profiles().empty()); CHECK(reopened.identity().xuid == 0);
+  REQUIRE(reopened.CreateLocal("New") == 0);
+  CHECK(reopened.local_profiles().size() == 1);
+  CHECK(reopened.GetName() == "New");
+}
+
+REX_TEST_CASE("failed profile removal preserves the committed identity and sign-in epoch", "[kernel][xam][local-profile-session][profile-removal]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  const auto root = rex::xam::CurrentTitle().user_data_root;
+  REQUIRE(profile.CreateLocal("Keep") == 0);
+  const auto xuid = profile.identity().xuid;
+  REQUIRE(profile.SetLocalSession(xuid) == 0);
+  const auto epoch = profile.GetStorageEpoch();
+  const auto recovery = root / "profiles" / "deleted";
+  { std::ofstream out(recovery); out << "blocked"; }
+  CHECK(profile.RemoveLocal(xuid) == rex::kernel::X_ERROR_FUNCTION_FAILED);
+  CHECK(std::filesystem::file_size(recovery) == 7);
+  CHECK(profile.identity().xuid == xuid); CHECK(profile.GetSigninState() == 1);
+  CHECK(profile.GetStorageEpoch() == epoch);
+  std::filesystem::remove(recovery);
+  std::filesystem::create_directory(root / "profiles" / "local-v2.dat.tmp");
+  CHECK(profile.RemoveLocal(xuid) == rex::kernel::X_ERROR_FUNCTION_FAILED);
+  CHECK(profile.identity().xuid == xuid); CHECK(profile.GetSigninState() == 1);
+  CHECK(profile.GetStorageEpoch() == epoch);
+  rex::xam::UserProfile reopened;
+  REQUIRE(reopened.InitializeLocal(root));
+  CHECK(reopened.identity().xuid == xuid); CHECK(reopened.GetSigninState() == 1);
+}
