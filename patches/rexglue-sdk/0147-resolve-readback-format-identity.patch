diff --git a/include/rex/graphics/readback_resolve_key.h b/include/rex/graphics/readback_resolve_key.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/readback_resolve_key.h
@@ -0,0 +1,40 @@
+// Resolve readback identity adapted from Forza Horizon 1: ReImagined,
+// cb676f7, patch 0048. Copyright (c) 2026 Dyotson and contributors (MIT).
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <rex/graphics/register_file.h>
+
+namespace rex::graphics {
+// Equality retains all fields: hashing a range and its format into a uint64_t
+// alone would allow unrelated resolves to alias after a hash collision.
+struct ReadbackResolveKey {
+  uint32_t address;
+  uint32_t length;
+  uint32_t signature;
+  bool operator==(const ReadbackResolveKey&) const = default;
+};
+struct ReadbackResolveKeyHash {
+  size_t operator()(const ReadbackResolveKey& key) const {
+    const uint64_t range = (uint64_t(key.address) << 32) | key.length;
+    return std::hash<uint64_t>{}(range ^ (uint64_t(key.signature) * UINT64_C(0x9E3779B97F4A7C15)));
+  }
+};
+inline ReadbackResolveKey MakeReadbackResolveKey(const RegisterFile& regs,
+                                                uint32_t address, uint32_t length) {
+  const auto control = regs.Get<reg::RB_COPY_CONTROL>();
+  const auto dest = regs.Get<reg::RB_COPY_DEST_INFO>();
+  // Keep a distinct history for depth and color, and for each destination
+  // representation. EDRAM location, exponent bias and source dimensions may
+  // vary between successive frames of the same pass and are not identity.
+  const uint32_t signature = uint32_t(control.copy_src_select >= 4) |
+      (uint32_t(dest.copy_dest_format) << 1) |
+      (uint32_t(dest.copy_dest_number) << 7) |
+      (uint32_t(dest.copy_dest_endian) << 10) |
+      (uint32_t(dest.copy_dest_swap) << 13) |
+      (uint32_t(dest.copy_dest_array) << 14) |
+      (uint32_t(dest.copy_dest_slice) << 15);
+  return {address, length, signature};
+}
+}  // namespace rex::graphics
