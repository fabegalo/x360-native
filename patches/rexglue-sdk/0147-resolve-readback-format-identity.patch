diff --git a/src/gpu/xenos/readback_resolve_key.h b/src/gpu/xenos/readback_resolve_key.h
new file mode 100644
--- /dev/null
+++ b/src/gpu/xenos/readback_resolve_key.h
@@ -0,0 +1,40 @@
+// Resolve readback identity adapted from Forza Horizon 1: ReImagined,
+// cb676f7, patch 0048. Copyright (c) 2026 Dyotson and contributors (MIT).
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <rex/xenos/register.h>
+
+namespace rex::gpu {
+// Equality retains all fields: hashing a range and its format into a uint64_t
+// alone would allow unrelated resolves to alias after a hash collision.
+struct ReadbackResolveKey {
+  u32 address;
+  u32 length;
+  u32 signature;
+  bool operator==(const ReadbackResolveKey&) const = default;
+};
+struct ReadbackResolveKeyHash {
+  size_t operator()(const ReadbackResolveKey& key) const {
+    const u64 range = (static_cast<u64>(key.address) << 32) | key.length;
+    return std::hash<u64>{}(range ^ (static_cast<u64>(key.signature) * UINT64_C(0x9E3779B97F4A7C15)));
+  }
+};
+inline ReadbackResolveKey MakeReadbackResolveKey(const xenos::RegisterFile& regs,
+                                                u32 address, u32 length) {
+  const auto control = regs.Get<xenos::reg::RB_COPY_CONTROL>();
+  const auto dest = regs.Get<xenos::reg::RB_COPY_DEST_INFO>();
+  // Keep a distinct history for depth and color, and for each destination
+  // representation. EDRAM location, exponent bias and source dimensions may
+  // vary between successive frames of the same pass and are not identity.
+  const u32 signature = static_cast<u32>(control.copy_src_select >= 4) |
+      (static_cast<u32>(dest.copy_dest_format) << 1) |
+      (static_cast<u32>(dest.copy_dest_number) << 7) |
+      (static_cast<u32>(dest.copy_dest_endian) << 10) |
+      (static_cast<u32>(dest.copy_dest_swap) << 13) |
+      (static_cast<u32>(dest.copy_dest_array) << 14) |
+      (static_cast<u32>(dest.copy_dest_layer) << 15);
+  return {address, length, signature};
+}
+}  // namespace rex::gpu
