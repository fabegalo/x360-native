-      if (main_switch_next_pc_phi_operands_.empty()) {
-        main_switch_next_pc_phi_operands_.push_back(builder_->makeIntConstant(-1));
-      }
-      std::unique_ptr<spv::Instruction> main_loop_pc_next_op = std::make_unique<spv::Instruction>(
