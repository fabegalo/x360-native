+    if (SystemUiOwnsInput(index)) { status = X_ERROR_EMPTY; continue; }
+    const auto result = GetTitleKeystroke(backend, index, flags, stroke);
+    if (result == X_ERROR_SUCCESS) return result;
+    if (result == X_ERROR_EMPTY) status = result;
+    else if (result != X_ERROR_DEVICE_NOT_CONNECTED) return result;
+  }
+  return status;
