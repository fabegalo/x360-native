+uint32_t QueryTitleKeystroke(rex::input::InputSystem* backend, uint32_t user, uint32_t flags,
+                            X_INPUT_KEYSTROKE* stroke) {
+  if (user >= 4 && user != 0xFF) return X_ERROR_BAD_ARGUMENTS;
