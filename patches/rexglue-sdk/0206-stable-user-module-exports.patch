+uint32_t FunctionDispatcher::ResolveUserExport(uint32_t guest_address, uint32_t caller_address) {
+  std::lock_guard<std::recursive_mutex> lock(dispatch_mutex_);
+  auto* func = GetFunction(guest_address);
+  if (!guest_address || !caller_address || !func) return guest_address;
+  auto* caller = FindModuleByAddress(caller_address);
+  if (!caller) return AllocateThunk(func, caller_address);  // retains the invalid-caller error
+  if (caller->host_function_table || caller == FindModuleByAddress(guest_address))
+    return guest_address;
+  if (auto found = caller->user_export_thunks.find(guest_address);
+      found != caller->user_export_thunks.end()) return found->second;
+  uint32_t thunk = 0;
+  if (!caller->free_user_export_thunks.empty()) {
+    thunk = caller->free_user_export_thunks.back();
+    if (!SetFunction(thunk, func)) return 0;
+    caller->free_user_export_thunks.pop_back();
+  } else {
+    thunk = AllocateThunk(func, caller_address);
+  }
+  if (thunk) caller->user_export_thunks.emplace(guest_address, thunk);
+  return thunk;
+}
