+REX_TEST_CASE("avatar mini creator requests the original application and preserves request flags", "[kernel][xam][profile-ui][minicreator]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& c) {
+    auto& ui = rex::xam::CurrentXAM().GetSystemUI();
+    u32 result = 0, address = 0;
+    ui.system_ui_request = [&](u32 message, u32 packet, u32 size) {
+      CHECK(message == 0x21018); CHECK(size == 8);
+      address = packet;
+      CHECK(c.Load32(packet) == 0xFF); CHECK(c.Load32(packet + 4) == 0x12345678);
+      return result;
+    };
+    REQUIRE(c.XAM("XamShowAvatarMiniCreatorUI", {0xFF, 0x12345678}) == 0);
+    CHECK(rex::xam::CurrentTitle().heap.QueryAllocationSize(address) == 0);
+    result = 0x8007000E;
+    CHECK(c.XAM("XamShowAvatarMiniCreatorUI", {0xFF, 0x12345678}) == 14);
+    result = 0x80004005;
+    CHECK(c.XAM("XamShowAvatarMiniCreatorUI", {0xFF, 0x12345678}) == 1627);
+    ui.system_ui_request = {};
+    CHECK(c.XAM("XamShowAvatarMiniCreatorUI", {0, 0}) == 1627);
+  });
+}
