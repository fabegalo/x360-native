+Result<void> ContentManager::DeleteContent(u64 xuid, const kernel::XCONTENT_AGGREGATE_DATA& data) {
+  const u32 error = DeleteContent(xuid, data, nullptr);
+  return error ? Err(kernel::XResultError(error)) : Ok();
+}
+
+u32 ContentManager::DeleteContent(u64 xuid, const kernel::XCONTENT_AGGREGATE_DATA& data,
+    bool* source_removed, const TransferCheckpoint& checkpoint) try {
+  if (source_removed) *source_removed = false;
+  auto storage_lock = user_profile_.LockSettings();
+  const auto volume = GetDevice(data.device_id);
+  if (!volume) return kernel::X_ERROR_DEVICE_NOT_CONNECTED;
+  auto normalized = data;
+  normalized.xuid = data.xuid != u64(-1) && data.xuid != 0 ? u64(data.xuid) : xuid;
+  normalized.title_id = data.title_id == kernel::kRunningTitleID ? GetTitleID() : u32(data.title_id);
+  if (IsContentOpen(normalized) || SignedInProfile(normalized)) return kernel::X_ERROR_ACCESS_DENIED;
+  const auto package = ResolvePackagePath(xuid, normalized);
+  const auto header = ResolveHeaderPathFor(xuid, normalized);
+  bool ignored_removed = false;
+  bool& removed = source_removed ? *source_removed : ignored_removed;
+  u32 result = RetireContent(*volume, normalized, package, header, checkpoint, removed, false);
+  if (result) {
+    std::lock_guard lock(recovery_mutex_);
+    recovered_devices_.erase(data.device_id);
+  }
+  if (removed) {
+    {
+      std::lock_guard lock(mutex_);
+      // Keep the official package manifest and enable-state cleanup; source originals stay external.
+      std::error_code error;
+      std::filesystem::remove(ResolveManifestPath(normalized.xuid, normalized), error);
+      if (error && !result) result = kernel::X_ERROR_ACCESS_DENIED;
+      auto& entries = LoadEnableEntriesLocked();
+      if (std::erase_if(entries, [&](const EnableEntry& entry) {
+            return entry.title_id == normalized.title_id && entry.content_type == normalized.content_type &&
+                   entry.file_name == normalized.GetFileName();
+          })) SaveEnableEntriesLocked();
+    }
+    NotifyContentChanged();
+  }
+  return result;
+} catch (const std::filesystem::filesystem_error&) { return kernel::X_ERROR_ACCESS_DENIED; }
 
