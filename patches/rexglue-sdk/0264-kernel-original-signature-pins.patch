+// Original XAM 17559 signatures that verify without the user's kernel keys. Each
+// pin is SHA-256 of what the console verifies (XeKeysVerifyRSASignature: be32 key,
+// SHA-1 digest, signature; XeCryptBnQwBeSigVerify: hash, salt, signature) and was
+// confirmed with the real key ([xekeys-rsa][local]). A pin hashes a public
+// signature, never a key; any other input still needs the local key.
+constexpr const char* kOriginalSignatures[] = {
+    "e40330da3bf59e45f2e6c0e424da5ba6d3490a47ed3b90a01a89d7ba9187ed7e",  // system.manifest, key 0
+    // systemext PIRS FFFE07DF/00008000/FFFE07DF0000000N, key 0 (8167C370)
+    "80ebf34b1b47a9e628d4e5f2a7816961026abb7dc41ecd8d32ef9c9eb6169d74",  // N = 1
+    "e6df769885110be0472e06e4dd9afb9db648ed123e54c8ea3c568a655ea0c830",  // N = 2
+    "6722b7d02384fc68d5b801069c9e66f12f5f67098e2e88800e50c04ab5480dc9",  // N = 6
+    "255c1dcc0aaf08ff0a100e8ab18dfbfe4f106dd7399cb66ad03ec8a112e698da",  // N = 8
+    "f1fca352f2fc82e3c4b05309b4d0ae2337b0a62ad8bc4f5313ad91b9839d0d61",  // XenonSCLatin.xtt
+    "e3d65944c825307a3254eefb33acf44855643d563aae444957c49aa5d33e9e7e",  // XenonCLatin.xtt
+    "4ad8564e1c1dc0db28833be7f550bf171d0714225e41ebe37d9cc450e5a18b48",  // XenonJKLatin.xtt
+    "374ac750b323f719a79d97ba7cc888218c863e3af87b0de2e4e5e5c3ddd55d68",  // SegoeXbox-Light.xtt
+};
+
+bool IsOriginalSignature(std::initializer_list<std::pair<const void*, size_t>> parts) {
+  EXCRYPT_SHA256_STATE sha{};
+  ExCryptSha256Init(&sha);
+  for (const auto& [data, size] : parts) ExCryptSha256Update(&sha, static_cast<const u8*>(data), size);
+  std::array<u8, 32> digest{};
+  ExCryptSha256Final(&sha, digest.data(), digest.size());
+  std::string hash;
+  for (const u8 byte : digest) hash += std::format("{:02x}", byte);
+  const bool pinned = std::find(std::begin(kOriginalSignatures), std::end(kOriginalSignatures), hash) !=
+                      std::end(kOriginalSignatures);
+  // The hash names the signature to pin once a local key confirms it.
+  if (!pinned) REXKRNL_INFO("Kernel signature {} is not pinned", hash);
+  return pinned;
+}
