+    "e6df769885110be0472e06e4dd9afb9db648ed123e54c8ea3c568a655ea0c830",  // N = 2
+    "6722b7d02384fc68d5b801069c9e66f12f5f67098e2e88800e50c04ab5480dc9",  // N = 6
+    "255c1dcc0aaf08ff0a100e8ab18dfbfe4f106dd7399cb66ad03ec8a112e698da",  // N = 8
+    "f1fca352f2fc82e3c4b05309b4d0ae2337b0a62ad8bc4f5313ad91b9839d0d61",  // XenonSCLatin.xtt
+    "e3d65944c825307a3254eefb33acf44855643d563aae444957c49aa5d33e9e7e",  // XenonCLatin.xtt
+    "4ad8564e1c1dc0db28833be7f550bf171d0714225e41ebe37d9cc450e5a18b48",  // XenonJKLatin.xtt
+    "374ac750b323f719a79d97ba7cc888218c863e3af87b0de2e4e5e5c3ddd55d68",  // SegoeXbox-Light.xtt
+};
+
+bool IsOriginalSignature(std::initializer_list<std::pair<const void*, size_t>> parts) {
+  sha256::SHA256 sha;
+  for (const auto& [data, size] : parts) sha.add(data, size);
+  const auto hash = sha.getHash();
+  const bool pinned = std::find(std::begin(kOriginalSignatures), std::end(kOriginalSignatures), hash) !=
+                      std::end(kOriginalSignatures);
+  // The hash names the signature to pin once a local key confirms it.
+  if (!pinned) REXKRNL_INFO("Kernel signature {} is not pinned", hash);
+  return pinned;
+}
