+u32 ContentManager::GetContentMetadata(const kernel::XCONTENT_AGGREGATE_DATA& data, u8* output) try {
+  if (!output || !ValidName(data.GetFileName())) return kernel::X_ERROR_INVALID_PARAMETER;
+  const auto type = std::to_underlying(static_cast<kernel::XContentType>(data.content_type));
+  if (type != 0x4000 && type != 0x7000 && type != 0x80000 && type != 0xD0000) return kernel::XResultFromWin32(50);
+  const auto path = ResolvePackagePath(data.xuid, data) / "default.xex";
+  auto* file = platform::OpenFile(path, "rb");
+  if (!file) return kernel::X_ERROR_FILE_NOT_FOUND;
+  rex::ScopeGuard close([&] { std::fclose(file); });
+  const auto size = std::filesystem::file_size(path);
+  const auto read = [&](u32 offset, void* bytes, size_t count) {
+    return u64{offset} + count <= size && !std::fseek(file, offset, SEEK_SET) && std::fread(bytes, 1, count, file) == count;
+  };
+  std::array<u8, 24> header{};
+  if (!read(0, header.data(), header.size()) || std::memcmp(header.data(), "XEX2", 4)) return 13;
+  const auto image = memory::load_and_swap<u32>(header.data() + 8);
+  const auto count = memory::load_and_swap<u32>(header.data() + 20);
+  if (image < 24 || image > size || count > (image - 24) / 8) return 13;
+  filesystem::XContentMetadata metadata{};
+  bool found = false;
+  for (u32 i = 0; i < count; ++i) {
+    std::array<be_u32, 2> option{};
+    if (!read(24 + i * 8, option.data(), sizeof(option))) return 13;
+    if (option[0] != 0x40006) continue;
+    const u32 offset = option[1];
+    if (found || offset < 24 + count * 8 || u64{offset} + 24 > image || !read(offset, &metadata.execution_info, 24)) return 13;
+    found = true;
+  }
+  if (!found || metadata.execution_info.title_id != data.title_id) return 13;
+  std::array<u8, 36> attributes{};
+  if (const auto result = GetContentAttributes(data, attributes.data())) return result;
+  metadata.content_type = data.content_type; metadata.metadata_version = 2;
+  metadata.content_size = memory::load_and_swap<u64>(attributes.data() + 28); metadata.profile_id = data.xuid;
+  std::u16string display;
+  for (const auto& unit : data.display_name_raw.code_units) {
+    const u16 value = memory::load_and_swap<u16>(&unit); if (!value) break; display.push_back(static_cast<char16_t>(value));
+  }
+  for (u32 language = 1; language <= filesystem::XContentMetadata::kNumLanguagesV2; ++language)
+    metadata.SetDisplayName(static_cast<kernel::XLanguage>(language), display);
+  metadata.SetTitleName(display);
+  std::memcpy(output, &metadata, sizeof(metadata));
+  return kernel::X_ERROR_SUCCESS;
+} catch (const std::filesystem::filesystem_error&) { return kernel::X_ERROR_ACCESS_DENIED; }
