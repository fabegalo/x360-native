+// Retail 17559 export 0x26E (816EF338): aggregate, 0x93D6 metadata, overlapped.
+u32 XamContentGetMetaDataInternal_entry(mapped_void content, mapped_void metadata,
+                                      mapped_void overlapped) {
+  X_RESULT result = X_ERROR_INVALID_PARAMETER;
+  if (content && metadata) {
+    const auto& data = *content.as<XCONTENT_AGGREGATE_DATA*>();
+    const auto* device = GetDummyDeviceInfo(data.device_id);
+    if (!device) result = X_ERROR_DEVICE_NOT_CONNECTED;
+    else if (device->device_type != DeviceType::HDD) result = X_RESULT_FROM_WIN32(50);
+    else result = REX_KERNEL_STATE()->content_manager()->GetContentMetadata(
+        data, metadata.as<uint8_t*>());
+    REXKRNL_INFO("Content metadata: title={:08X} type={:08X} name={} result={:08X}",
+                uint32_t(data.title_id), uint32_t(data.content_type.get()), data.file_name(), result);
+  }
+  if (overlapped) {
+    REX_KERNEL_STATE()->CompleteOverlappedImmediate(overlapped.guest_address(), result);
+    return X_ERROR_IO_PENDING;
+  }
+  return result;
+}
