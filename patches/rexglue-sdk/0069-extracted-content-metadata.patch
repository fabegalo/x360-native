+u32 XamContentGetMetaDataInternal_entry(MappedVoid content, MappedVoid metadata, MappedVoid overlapped) {
+  u32 result = kernel::X_ERROR_INVALID_PARAMETER;
+  auto& title = CurrentTitle();
+  if (content && metadata && title.heap.IsGuestRangeAccessible(content.GetGuestAddress(), sizeof(kernel::XCONTENT_AGGREGATE_DATA), kernel::kMemoryProtectRead) &&
+      title.heap.IsGuestRangeAccessible(metadata.GetGuestAddress(), sizeof(filesystem::XContentMetadata), kernel::kMemoryProtectWrite)) {
+    const auto& data = *content.As<const kernel::XCONTENT_AGGREGATE_DATA*>();
+    const auto* device = GetPlaceholderDevice(data.device_id);
+    if (!device) result = kernel::X_ERROR_DEVICE_NOT_CONNECTED;
+    else if (device->device_type != DeviceType::kHDD) result = kernel::XResultFromWin32(50);
+    else result = CurrentXAM().GetContentManager().GetContentMetadata(data, metadata.As<u8*>());
+  }
+  if (overlapped) {
+    title.overlapped_dispatcher.Complete(overlapped.GetGuestAddress(), {.result = result});
     return kernel::X_ERROR_IO_PENDING;
   }
   return result;
