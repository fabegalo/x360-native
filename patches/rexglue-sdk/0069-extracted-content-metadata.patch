+// Extracted executable packages have no STFS header. Project only facts from
+// their XEX execution header and installed files into the packed metadata ABI.
+// This neither changes the content type nor manufactures package licenses.
+X_RESULT ContentManager::GetContentMetadata(const XCONTENT_AGGREGATE_DATA& data,
+                                          uint8_t* output) try {
+  if (!ValidName(data.file_name())) return X_ERROR_INVALID_PARAMETER;
+  const auto type = uint32_t(data.content_type.get());
+  if (type != 0x4000 && type != 0x7000 && type != 0x80000 && type != 0xD0000)
+    return X_RESULT_FROM_WIN32(50);
+  const auto path = ResolvePackagePath(data.xuid, data);
+  auto file = filesystem::OpenFile(path / "default.xex", "rb");
+  if (!file) return X_ERROR_FILE_NOT_FOUND;
+  struct Guard { FILE* file; ~Guard() { fclose(file); } } guard{file};
+  const auto size = std::filesystem::file_size(path / "default.xex");
+  auto read = [&](uint32_t offset, void* bytes, size_t count) {
+    return uint64_t(offset) + count <= size && !fseek(file, offset, SEEK_SET) &&
+           fread(bytes, 1, count, file) == count;
+  };
+  std::array<uint8_t, 24> header{};
+  if (!read(0, header.data(), header.size()) || memcmp(header.data(), "XEX2", 4))
+    return 13 /* ERROR_INVALID_DATA */;
+  const auto image = memory::load_and_swap<uint32_t>(header.data() + 8);
+  const auto count = memory::load_and_swap<uint32_t>(header.data() + 20);
+  if (image < 24 || image > size || count > (image - 24) / 8)
+    return 13 /* ERROR_INVALID_DATA */;
+  filesystem::XContentMetadata metadata{};
+  bool found = false;
+  for (uint32_t i = 0; i < count; ++i) {
+    std::array<be<uint32_t>, 2> option{};
+    if (!read(24 + i * 8, option.data(), sizeof(option))) return 13 /* ERROR_INVALID_DATA */;
+    if (option[0] != 0x40006) continue;
+    const uint32_t offset = option[1];
+    if (found || offset < 24 + count * 8 || uint64_t(offset) + 24 > image ||
+        !read(offset, &metadata.execution_info, 24)) return 13 /* ERROR_INVALID_DATA */;
+    found = true;
+  }
+  if (!found || metadata.execution_info.title_id != data.title_id)
+    return 13 /* ERROR_INVALID_DATA */;
+  std::array<uint8_t, 36> attributes{};
+  auto result = GetContentAttributes(data, attributes.data());
+  if (result) return result;
+  metadata.content_type = data.content_type;
+  metadata.metadata_version = 2;
+  metadata.content_size = memory::load_and_swap<uint64_t>(attributes.data() + 28);
+  metadata.profile_id = data.xuid;
+  for (uint32_t language = 1; language <= 12; ++language)
+    metadata.set_display_name(XLanguage(language), data.display_name());
+  metadata.set_title_name(data.display_name());
+  memcpy(output, &metadata, sizeof(metadata));
+  return X_ERROR_SUCCESS;
+} catch (const std::filesystem::filesystem_error&) {
+  return X_ERROR_ACCESS_DENIED;
+}
