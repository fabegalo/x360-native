+REX_TEST_CASE("extracted package metadata contains verified XEX facts and rejects corrupt execution headers", "[kernel][xam][extracted-metadata]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([&](Caller& c) {
+    const auto package = fixture.GetRoot() / "0000000000000000" / "584108B7" / "000D0000" / "package";
+    std::filesystem::create_directories(package);
+    std::array<u8, 96> xex{}; std::memcpy(xex.data(), "XEX2", 4);
+    const auto put = [&](u32 offset, u32 value) { rex::memory::store_and_swap<u32>(xex.data() + offset, value); };
+    put(8, 96); put(20, 1); put(24, 0x40006); put(28, 32); put(32 + 8, 0x12345678); put(32 + 12, 0x584108B7);
+    const auto image = package / "default.xex"; REQUIRE(rex::platform::WriteHostFile(image, xex));
+    REQUIRE(rex::platform::WriteHostFile(package / "data.bin", "data"));
+    const auto input = c.Alloc(sizeof(rex::kernel::XCONTENT_AGGREGATE_DATA));
+    auto* data = reinterpret_cast<rex::kernel::XCONTENT_AGGREGATE_DATA*>(c.GetBase() + input);
+    *data = {}; data->device_id = 1; data->title_id = 0x584108B7;
+    data->content_type = static_cast<rex::kernel::XContentType>(0xD0000); data->SetFileName("package"); data->SetDisplayName(u"Extracted");
+    const auto output = c.Alloc(sizeof(rex::filesystem::XContentMetadata) + 4), overlap = c.Alloc(sizeof(rex::kernel::XOVERLAPPED));
+    c.Store32(output + sizeof(rex::filesystem::XContentMetadata), 0xDEADBEEF);
+    REQUIRE(c.XAM("XamContentGetMetaDataInternal", {input, output, 0}) == 0);
+    const auto* metadata = reinterpret_cast<const rex::filesystem::XContentMetadata*>(c.GetBase() + output);
+    CHECK(static_cast<u32>(metadata->metadata_version) == 2); CHECK(static_cast<u64>(metadata->content_size) == 100);
+    CHECK(static_cast<u32>(metadata->execution_info.title_id) == 0x584108B7);
+    CHECK(metadata->GetTitleName() == u"Extracted"); CHECK(static_cast<u64>(metadata->profile_id) == 0);
+    CHECK(metadata->GetDisplayName(rex::kernel::XLanguage::kEnglish) == u"Extracted");
+    CHECK(c.Load32(output + sizeof(rex::filesystem::XContentMetadata)) == 0xDEADBEEF);
+    CHECK(c.XAM("XamContentGetMetaDataInternal", {input, output, overlap}) == rex::kernel::X_ERROR_IO_PENDING);
+    CHECK(c.Load32(overlap) == 0);
+    c.Store32(output, 0xCAFEBABE); put(32 + 12, 0xDEADBEEF); REQUIRE(rex::platform::WriteHostFile(image, xex));
+    CHECK(c.XAM("XamContentGetMetaDataInternal", {input, output, 0}) == 13); CHECK(c.Load32(output) == 0xCAFEBABE);
+    put(32 + 12, 0x584108B7); put(20, 0xFFFFFFFF); REQUIRE(rex::platform::WriteHostFile(image, xex));
+    CHECK(c.XAM("XamContentGetMetaDataInternal", {input, output, 0}) == 13);
+    data->content_type = rex::kernel::XContentType::kSavedGame;
+    CHECK(c.XAM("XamContentGetMetaDataInternal", {input, output, 0}) == rex::kernel::XResultFromWin32(50));
+    CHECK(c.XAM("XamContentGetMetaDataInternal", {input, 0x7F100000, 0}) == rex::kernel::X_ERROR_INVALID_PARAMETER);
+  });
