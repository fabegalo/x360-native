+REX_TEST_CASE("local logon modes preserve transactional selection and reject peer or online accounts", "[kernel][xam][local-profile-session]") {
+  KernelFixture fixture;
+  auto& profile = rex::xam::CurrentXAM().GetUserProfile();
+  u64 first = 0, second = 0;
+  REQUIRE(profile.CreateLocal("First", &first) == 0);
+  REQUIRE(profile.CreateLocal("Second", &second) == 0);
+  fixture.RunOnGuestThread([&](Caller& caller) {
+    const auto users = caller.Alloc(4 * 392), output = caller.Alloc(4);
+    for (const u32 device : {0u, 1u}) {
+      REQUIRE(caller.XAM("XamProfileCreateEnumerator", {device, output}) == 0);
+      CHECK(caller.Kernel("NtClose", {caller.Load32(output)}) == 0);
+    }
+    CHECK(caller.XAM("XamProfileCreateEnumerator", {2, output}) == rex::kernel::X_ERROR_DEVICE_NOT_CONNECTED);
+    CHECK(caller.Load32(output) == 0);
+    caller.Store64(users, first);
+    REQUIRE(caller.XAM("XamUserLogonEx", {users, 0x120424, 0}) == 0);
+    CHECK(profile.identity().xuid == first);
+    CHECK(profile.GetSigninState() == 1);
+    caller.Store64(users, second);
+    REQUIRE(caller.XAM("XamUserLogon", {users, 0x24, 0}) == 0);
+    CHECK(profile.identity().xuid == second);
+    CHECK(profile.FindLocal(first).signin_state == 0);
+    REQUIRE(caller.XAM("XamUserLogon", {users, 0x63, 0}) == 0);
+    caller.Store64(users, first);
+    caller.Store64(users + 48, 1);
+    CHECK(caller.XAM("XamUserLogonEx", {users, 0x120424, 0}) == static_cast<u32>(rex::kernel::X_E_INVALIDARG));
+    caller.Store64(users + 48, 0);
+    caller.Store64(users + 392, second);
+    CHECK(caller.XAM("XamUserLogonEx", {users, 0x120424, 0}) == 0x80004001u);
+    caller.Store64(users + 392, 0);
+    CHECK(caller.XAM("XamUserLogonEx", {users, 0xFFFFFFFF, 0}) == 0x80004001u);
+    CHECK(profile.identity().xuid == second);
+    CHECK(profile.GetSigninState() == 1);
+    CHECK(profile.FindLocal(first).signin_state == 0);
+  });
+}
