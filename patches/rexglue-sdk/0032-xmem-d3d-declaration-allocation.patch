@@ -310,6 +310,23 @@ u32 XamAlloc_entry(u32 unk, u32 size, mapped_u32 out_ptr) {
   return X_ERROR_SUCCESS;
 }
 
+// XAM 17559 816E69E0 selects physical allocation with bit 31; otherwise it
+// decodes the owner/tag into an Rtl heap, with bit 30 requesting zeroed storage.
+// Reuse the existing guest heap for virtual allocations. Separate XAM pool
+// budgets/accounting are not modeled. Physical classes remain unsupported here.
+u32 XMemAlloc_entry(u32 size, u32 attributes) {
+  if (attributes & 0x80000000u) {
+    REXKRNL_WARN("XMemAlloc: unsupported attributes {:08X}", uint32_t(attributes));
+    return 0;
+  }
+  return REX_KERNEL_MEMORY()->SystemHeapAlloc(size, 0x20);
+}
+void XMemFree_entry(u32 pointer, u32 attributes) {
+  // The original free path identifies the allocation from the pointer and
+  // ignores the attributes argument (816E6AB0).
+  if (pointer) REX_KERNEL_MEMORY()->SystemHeapFree(pointer);
+}
