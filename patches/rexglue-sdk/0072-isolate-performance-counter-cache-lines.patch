diff --git a/src/core/perf/counter.cpp b/src/core/perf/counter.cpp
--- a/src/core/perf/counter.cpp
+++ b/src/core/perf/counter.cpp
@@ -33,7 +33,9 @@ namespace {
 
 constexpr size_t kNumCounters = static_cast<size_t>(CounterId::kCount);
 
-std::array<std::atomic<int64_t>, kNumCounters> g_counters{};
+// Independent writers must not contend on the same cache line.
+struct alignas(64) CounterSlot { std::atomic<int64_t> value{0}; };
+std::array<CounterSlot, kNumCounters> g_counters{};
 std::array<std::atomic<int64_t>, kNumCounters> g_snapshot{};
 std::atomic<bool> g_enabled{false};
 std::chrono::steady_clock::time_point g_start;
@@ -101,26 +103,26 @@ const char* CounterName(CounterId id) {
 
 void SetCounter(CounterId id, int64_t value) {
   if (!IsEnabled()) return;
-  g_counters[static_cast<size_t>(id)].store(value, std::memory_order_relaxed);
+  g_counters[static_cast<size_t>(id)].value.store(value, std::memory_order_relaxed);
 }
 
 void IncrementCounter(CounterId id, int64_t delta) {
   if (!IsEnabled()) return;
-  g_counters[static_cast<size_t>(id)].fetch_add(delta, std::memory_order_relaxed);
+  g_counters[static_cast<size_t>(id)].value.fetch_add(delta, std::memory_order_relaxed);
 }
 
 int64_t GetCounter(CounterId id) {
-  return g_counters[static_cast<size_t>(id)].load(std::memory_order_relaxed);
+  return g_counters[static_cast<size_t>(id)].value.load(std::memory_order_relaxed);
 }
 
 void ResetFrameCounters() {
   for (size_t i = 0; i < kNumCounters; ++i) {
     if (kIsGauge[i]) {
       // Gauges: snapshot the current value, don't zero
-      g_snapshot[i].store(g_counters[i].load(std::memory_order_relaxed), std::memory_order_relaxed);
+      g_snapshot[i].store(g_counters[i].value.load(std::memory_order_relaxed), std::memory_order_relaxed);
     } else {
       // Accumulators: snapshot and zero for next frame
-      g_snapshot[i].store(g_counters[i].exchange(0, std::memory_order_relaxed),
+      g_snapshot[i].store(g_counters[i].value.exchange(0, std::memory_order_relaxed),
                           std::memory_order_relaxed);
     }
   }
@@ -133,7 +135,7 @@ int64_t GetSnapshotCounter(CounterId id) {
 void Init() {
   g_start = std::chrono::steady_clock::now();
   for (auto& c : g_counters)
-    c.store(0, std::memory_order_relaxed);
+    c.value.store(0, std::memory_order_relaxed);
   for (auto& s : g_snapshot)
     s.store(0, std::memory_order_relaxed);
   const auto path = REXCVAR_GET(perf_log_csv);
