diff --git a/tests/unit/ui/sdl3_ui_test.cpp b/tests/unit/ui/sdl3_ui_test.cpp
--- a/tests/unit/ui/sdl3_ui_test.cpp
+++ b/tests/unit/ui/sdl3_ui_test.cpp
@@ -13,6 +13,10 @@
 #include <memory>
 #include <string>
 
+#if REX_PLATFORM_WIN32
+#include <windows.h>
+#endif
+#include <rex/utility.h>
 #include <SDL3/SDL_hints.h>
 #include <SDL3/SDL_video.h>
 
