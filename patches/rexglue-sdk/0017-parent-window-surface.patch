 }
+
+
+#if REX_PLATFORM_WIN32
+REX_TEST_CASE_METHOD(Fixture, "embedded SDL surfaces retain the host frame across replacement", "[ui][sdl3][embedded-window]") {
+  auto driver = Create();
+  REQUIRE(driver);
+  REQUIRE(REX_SETTINGS().SetText(rex::SettingLayer::kTitle, "ui.sdl.video_driver", "windows").has_value());
+  rex::AppDriverContext context(REX_SETTINGS(), REX_LOGGER());
+  REQUIRE(driver->Initialize(context).has_value());
+  rex::ScopeGuard shutdown([&] { driver->Shutdown(); });
+  rex::ScopeGuard reset_parent([&] {
+    CHECK(REX_SETTINGS().SetText(rex::SettingLayer::kTitle, "ui.sdl.parent_window", "0").has_value());
+  });
+  const auto previous_dpi = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+  rex::ScopeGuard restore_dpi([&] { if (previous_dpi) SetThreadDpiAwarenessContext(previous_dpi); });
+  const auto parent = CreateWindowExW(0, L"STATIC", L"SDK embedded surface fixture", WS_OVERLAPPEDWINDOW,
+      0, 0, 400, 240, nullptr, nullptr, GetModuleHandleW(nullptr), nullptr);
+  REQUIRE(parent != nullptr);
+  rex::ScopeGuard destroy([&] { driver->CloseUIWindow(); DestroyWindow(parent); });
+  REQUIRE(REX_SETTINGS().SetText(rex::SettingLayer::kTitle, "ui.sdl.parent_window", "1").has_value());
+  CHECK_FALSE(driver->OpenWindow(rex::ui::WindowConfig{}).has_value());
+  CHECK_FALSE(driver->GetNativeWindow().has_value());
+  REQUIRE(REX_SETTINGS().SetText(rex::SettingLayer::kTitle, "ui.sdl.parent_window",
+      std::to_string(reinterpret_cast<uintptr_t>(parent))).has_value());
+  for (unsigned replacement = 0; replacement < 3; ++replacement) {
+    REQUIRE(driver->OpenWindow(rex::ui::WindowConfig{}).has_value());
+    auto native = driver->GetNativeWindow();
+    REQUIRE(native.has_value());
+    const auto child = static_cast<HWND>(native->window);
+    CHECK(GetParent(child) == parent);
+    CHECK((GetWindowLongPtrW(child, GWL_STYLE) & WS_CHILD) != 0);
+    CHECK((GetWindowLongPtrW(child, GWL_STYLE) & WS_CLIPSIBLINGS) != 0);
+    RECT host{}, view{};
+    REQUIRE(GetClientRect(parent, &host));
+    REQUIRE(GetWindowRect(child, &view));
+    CHECK(view.right - view.left == host.right);
+    CHECK(view.bottom - view.top == host.bottom);
+    driver->SetFullscreen(true, true, 0, 1920, 1080);
+    CHECK(GetParent(child) == parent);
+    CHECK((SDL_GetWindowFlags(static_cast<SDL_Window*>(native->sdl)) & SDL_WINDOW_FULLSCREEN) == 0);
+    MSG message{};
+    REQUIRE(PeekMessageW(&message, parent, WM_APP + 0x360, WM_APP + 0x360, PM_REMOVE));
+    CHECK(message.wParam == reinterpret_cast<WPARAM>(child));
+    driver->CloseUIWindow();
+    CHECK_FALSE(IsWindow(child));
+    CHECK(IsWindow(parent));
+  }
+}
+#endif
