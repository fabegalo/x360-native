+uint32_t UserProfile::RenameLocal(uint64_t xuid, const std::string& name) {
+  auto storage_lock = rex::thread::global_critical_region::AcquireDirect();
+  bool notify = false;
+  {
+    std::lock_guard lock(identity_mutex_);
+    if (!ValidLocalName(name)) return X_ERROR_INVALID_PARAMETER;
+    auto next = profiles_;
+    const auto target = std::find_if(next.begin(), next.end(),
+        [xuid](const auto& profile) { return profile.xuid == xuid; });
+    if (target == next.end()) return X_ERROR_NO_SUCH_USER;
+    for (const auto& profile : next) {
+      if (profile.xuid != xuid && profile.name.size() == name.size() &&
+          std::equal(name.begin(), name.end(), profile.name.begin(),
+              [](unsigned char a, unsigned char b) { return std::tolower(a) == std::tolower(b); }))
+        return X_ERROR_ALREADY_EXISTS;
+    }
+    if (target->name == name) return X_ERROR_SUCCESS;
+    target->name = name;
+    auto selected = identity_;
+    if (selected.xuid == xuid) selected.name = name;
+    if (!PersistProfiles(next, selected)) return X_ERROR_FUNCTION_FAILED;
+    notify = selected.xuid == xuid && selected.signin_state != 0;
+    profiles_ = std::move(next);
+    identity_ = std::move(selected);
+    // Renaming does not change identity or revoke save/achievement handles.
+  }
+  // Original 17559 816DE9B8 publishes profile-change notification 14 with
+  // the affected slot mask after persisting and updating the cached name.
+  if (notify && kernel_state_) kernel_state_->BroadcastNotification(0xE, 1);
+  return X_ERROR_SUCCESS;
+}
