+// Original 17559 816DE888 and GamerProfile 9010BC20: XUID in r3,
+// bounded WCHAR name in r4; synchronous Win32 result (not an HRESULT).
+uint32_t RenameLocalProfile(uint64_t xuid, uint32_t name_address) {
+  if (!name_address) return X_ERROR_INVALID_PARAMETER;
+  std::string name;
+  for (uint32_t i = 0; i < 16; ++i) {
+    const uint64_t address = uint64_t(name_address) + i * 2;
+    if (address > 0xFFFFFFFFu || !AchievementGuestSpan(REX_KERNEL_MEMORY(),
+        uint32_t(address), 2, memory::kMemoryProtectRead)) return X_ERROR_INVALID_PARAMETER;
+    const auto c = memory::load_and_swap<uint16_t>(REX_KERNEL_MEMORY()->TranslateVirtual(uint32_t(address)));
+    if (!c) return REX_KERNEL_STATE()->user_profile()->RenameLocal(xuid, name);
+    if (i == 15 || c < 32 || c > 126) return X_ERROR_INVALID_PARAMETER;
+    name.push_back(char(c));
+  }
+  return X_ERROR_INVALID_PARAMETER;
+}
