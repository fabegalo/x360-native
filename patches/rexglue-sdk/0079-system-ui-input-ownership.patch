+// Controls in use while a system UI owns a controller stay with that UI until
+// released, so the press that closes the Guide never becomes a title press.
+struct SystemUiLatch {
+  bool armed = false;     // a system UI owned this controller since the last title query
+  uint16_t buttons = 0;   // held through the UI: hidden until released
+  bool left_trigger = false, right_trigger = false;
+  uint32_t keys = 0;      // pad keystrokes whose key-up still belongs to the UI
+};
+std::mutex system_ui_latch_mutex;
+SystemUiLatch system_ui_latches[4];
+
+void ArmSystemUiLatch(uint32_t owner) {
+  std::lock_guard lock(system_ui_latch_mutex);
+  for (uint32_t user = 0; user < 4; ++user)
+    if (owner == 0xFF || owner == user) system_ui_latches[user].armed = true;
+}
+
 bool SystemUiOwnsInput(uint32_t user) {
   auto xam = REX_KERNEL_STATE()->GetKernelModule<XamModule>("xam.xex");
   const auto ui = xam->GetSystemUiSession();
-  return ui.visible && (ui.user == user || ui.user == 0xFF);
+  const bool owned = ui.visible && (ui.user == user || ui.user == 0xFF);
+  if (owned) ArmSystemUiLatch(ui.user);
+  return owned;
+}
+
+// Pad keystroke virtual keys 0x5800-0x5817 (A..right thumb).
+uint32_t PadKeyBit(uint16_t virtual_key) {
+  return virtual_key >= 0x5800 && virtual_key <= 0x5817 ? 1u << (virtual_key - 0x5800) : 0;
+}
+
+// First title query after a system UI: latch everything still held.
+void TakeSystemUiLatch(SystemUiLatch& latch, const X_INPUT_STATE& held) {
+  if (!latch.armed) return;
+  latch.armed = false;
+  latch.buttons = uint16_t(held.gamepad.buttons);
+  latch.left_trigger = held.gamepad.left_trigger != 0;
+  latch.right_trigger = held.gamepad.right_trigger != 0;
+}
+
+// Title view of a raw controller state. The Guide button is never a title
+// button: the system UI host enables it only for its own polling.
+void FilterTitleState(uint32_t user, X_INPUT_STATE* state) {
+  if (!state) return;
+  state->gamepad.buttons = uint16_t(state->gamepad.buttons) & ~rex::input::X_INPUT_GAMEPAD_GUIDE;
+  if (user >= 4) return;
+  std::lock_guard lock(system_ui_latch_mutex);
+  auto& latch = system_ui_latches[user];
+  TakeSystemUiLatch(latch, *state);
+  const uint16_t buttons = uint16_t(state->gamepad.buttons);
+  latch.buttons &= buttons;
+  state->gamepad.buttons = buttons & ~latch.buttons;
+  if (latch.left_trigger) {
+    if (state->gamepad.left_trigger) state->gamepad.left_trigger = 0;
+    else latch.left_trigger = false;
+  }
+  if (latch.right_trigger) {
+    if (state->gamepad.right_trigger) state->gamepad.right_trigger = 0;
+    else latch.right_trigger = false;
+  }
+}
+
+// The HUD received this key-down: its repeats and key-up belong to the UI.
+void NoteSystemUiKeystroke(const X_INPUT_KEYSTROKE& stroke) {
+  const uint32_t user = stroke.user_index;
+  const uint32_t bit = PadKeyBit(uint16_t(stroke.virtual_key));
+  if (user >= 4 || !bit) return;
+  std::lock_guard lock(system_ui_latch_mutex);
+  auto& latch = system_ui_latches[user];
+  latch.armed = true;
+  if (uint16_t(stroke.flags) & rex::input::X_INPUT_KEYSTROKE_KEYUP) latch.keys &= ~bit;
+  else latch.keys |= bit;
+}
+
+// Drops the remaining transitions of a key the system UI consumed.
+bool SystemUiOwnsKeystroke(uint32_t user, const X_INPUT_KEYSTROKE& stroke) {
+  if (user >= 4) return false;
+  std::lock_guard lock(system_ui_latch_mutex);
+  auto& latch = system_ui_latches[user];
+  const uint32_t bit = PadKeyBit(uint16_t(stroke.virtual_key));
+  if (!bit || !(latch.keys & bit)) return false;
+  if (uint16_t(stroke.flags) & rex::input::X_INPUT_KEYSTROKE_KEYUP) latch.keys &= ~bit;
+  return true;
+}
+
+uint32_t GetTitleKeystroke(rex::input::InputSystem* is, uint32_t user, uint32_t flags,
+                           X_INPUT_KEYSTROKE* keystroke) {
+  for (;;) {
+    const auto result = is->GetKeystroke(user, flags, keystroke);
+    if (result != X_ERROR_SUCCESS || !SystemUiOwnsKeystroke(keystroke->user_index, *keystroke))
+      return result;
+  }
 }
 
