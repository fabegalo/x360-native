+void DxbcShaderTranslator::Float32ToF16ExtendedRange(uint32_t reg,
+                                                     uint32_t components) {
+  uint32_t quantized = PushSystemTemp();
+  uint32_t exponent = PushSystemTemp();
+  uint32_t scale = PushSystemTemp();
+  const dxbc::Dest q_dest = dxbc::Dest::R(quantized, components);
+  const dxbc::Dest e_dest = dxbc::Dest::R(exponent, components);
+  const dxbc::Dest s_dest = dxbc::Dest::R(scale, components);
+  const dxbc::Dest dest = dxbc::Dest::R(reg, components);
+  const dxbc::Src q = dxbc::Src::R(quantized);
+  const dxbc::Src e = dxbc::Src::R(exponent);
+  const dxbc::Src s = dxbc::Src::R(scale);
+  const dxbc::Src value = dxbc::Src::R(reg);
+  // Match the reference SPIR-V pack's round-to-nearest-even. DXBC f32tof16
+  // truncates and saturates finite overflow, so testing its exponent for Inf
+  // cannot implement the guest extended range.
+  a_.OpNE(q_dest, value, value);
+  a_.OpMovC(dest, q, dxbc::Src::LF(0.0f), value);
+  a_.OpMin(dest, value, dxbc::Src::LF(131008.0f));
+  a_.OpMax(dest, value, dxbc::Src::LF(-131008.0f));
+  a_.OpUBFE(e_dest, dxbc::Src::LU(8), dxbc::Src::LU(23), value);
+  // Below 2^-14, quantize in units of 2^-24; otherwise keep 11 significant
+  // bits. All scaling is by exact powers of two, including subnormal halves.
+  a_.OpUMax(e_dest, e, dxbc::Src::LU(113));
+  a_.OpIAdd(s_dest, -e, dxbc::Src::LI(264));
+  a_.OpIShL(s_dest, s, dxbc::Src::LU(23));
+  a_.OpMul(q_dest, value.Abs(), s);
+  a_.OpRoundNE(q_dest, q);
+  a_.OpFToU(q_dest, q);
+  a_.OpIAdd(e_dest, e, dxbc::Src::LI(-113));
+  a_.OpIShL(e_dest, e, dxbc::Src::LU(10));
+  a_.OpIAdd(q_dest, q, e);
+  a_.OpUShR(s_dest, value, dxbc::Src::LU(16));
+  a_.OpAnd(s_dest, s, dxbc::Src::LU(0x8000));
+  a_.OpOr(dest, q, s);
+  PopSystemTemp(3);
+}
