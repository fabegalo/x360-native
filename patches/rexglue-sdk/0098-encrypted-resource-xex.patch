+bool VerifyResourcePages(const IXEXImage& xex, std::span<const u8> image) {
+  const auto* format = xex.GetOptHeader<kernel::XEXOptFileFormatInfo>(kernel::kXEXHeaderFileFormatInfo);
+  if (format->encryption_type == kernel::kXEXEncryptionNone) return true;
+  const auto header = xex.GetHeaderBytes();
+  const u64 offset = xex.GetHeader().security_offset;
+  const auto& security = xex.GetSecurity();
+  const u64 count = security.pages.size();
+  if (offset + kXEX2PageTableOffset + count * sizeof(kernel::XEXPageDescriptor) > header.size()) return false;
+  const auto* raw = reinterpret_cast<const kernel::XEXSecurityInfoHeader*>(header.data() + offset);
+  const char* expected = raw->section_digest;
+  const u32 page_size = security.image_flags & kernel::kXEXImagePageSize4KB ? 4096 : 65536;
+  u64 covered = 0;
+  for (u32 i = 0; i < count; ++i) {
+    const u64 size = u64(security.pages[i].page_count) * page_size;
+    if (covered > image.size() || size > image.size() - covered) return false;
+    std::array<u8, 20> digest{};
+    ExCryptSha(image.data() + covered, static_cast<u32>(size),
+               reinterpret_cast<const u8*>(&raw->page_descriptors[i]), sizeof(kernel::XEXPageDescriptor),
+               nullptr, 0, digest.data(), static_cast<u32>(digest.size()));
+    if (std::memcmp(digest.data(), expected, digest.size())) return false;
+    expected = raw->page_descriptors[i].data_digest;
+    covered += size;
+  }
+  return covered == xex.GetImageSize();
+}
