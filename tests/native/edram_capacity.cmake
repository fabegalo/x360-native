# Real-plugin draw, resolve, clear, persistence and wrap at 10/40 MiB.
# -DPROBE=... -DOUTPUT=... -DAPI=d3d12|vulkan -DXENOS=ON|OFF
file(MAKE_DIRECTORY "${OUTPUT}")
get_filename_component(probe_directory "${PROBE}" DIRECTORY)
set(backends native)
if(XENOS)
  list(APPEND backends xenos)
endif()
foreach(clear OFF ON)
  unset(expected)
  foreach(backend IN LISTS backends)
    foreach(configuration standard:0 extended:4096 extended:8191 standard:8191)
      string(REPLACE ":" ";" fields "${configuration}")
      list(GET fields 0 capacity)
      list(GET fields 1 base)
      set(options)
      if(backend STREQUAL "xenos")
        list(APPEND options --xenos)
      endif()
      list(APPEND options --edram-base "${base}")
      if(clear)
        list(APPEND options --clear-after-resolve --no-sample-counts)
      endif()
      list(APPEND options "edram_tile_count=${capacity}")
      if(backend STREQUAL "xenos")
        if(API STREQUAL "d3d12")
          list(APPEND options render_target_path_d3d12=rov)
        else()
          list(APPEND options render_target_path_vulkan=fsi)
        endif()
        list(APPEND options async_shader_compilation=false readback_resolve=full)
      endif()
      set(runtime_start 0)
      if(EXISTS "${OUTPUT}/runtime.log")
        file(SIZE "${OUTPUT}/runtime.log" runtime_start)
      endif()
      execute_process(COMMAND "${PROBE}" "${OUTPUT}" "${API}" 6 ${options}
          WORKING_DIRECTORY "${probe_directory}" TIMEOUT 75
          RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
      file(WRITE "${OUTPUT}/current.log" "${out}${err}")
      if(NOT result EQUAL 0 OR NOT out MATCHES "PASS frames=6")
        if(API STREQUAL "d3d12" AND EXISTS "${OUTPUT}/runtime.log")
          file(SIZE "${OUTPUT}/runtime.log" runtime_end)
          if(runtime_end LESS runtime_start)
            set(runtime_start 0)
          endif()
          file(READ "${OUTPUT}/runtime.log" runtime OFFSET ${runtime_start})
          if(runtime MATCHES "Microsoft Basic Render Driver" AND
              "${out}${err}" MATCHES "render GPU timeout|fence 0 of")
            message(FATAL_ERROR "requires a hardware D3D12 adapter: WARP did not complete a ROV draw")
          endif()
        endif()
        message(FATAL_ERROR "${backend}/${API} ${configuration} clear=${clear}: ${result}\n${out}${err}")
      endif()
      string(REGEX MATCHALL "frame [0-9]+ scanout [0-9a-f]+" hashes "${out}")
      list(LENGTH hashes count)
      if(NOT count EQUAL 6 OR (DEFINED expected AND NOT hashes STREQUAL expected))
        message(FATAL_ERROR "${backend}/${API} ${configuration} clear=${clear}: mismatched frame hashes\n${hashes}\n${expected}")
      endif()
      set(expected "${hashes}")
      message("${backend}/${API} ${configuration} clear=${clear}: six matching frame hashes")
    endforeach()
  endforeach()
endforeach()
