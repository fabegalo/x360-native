# Real-plugin draw, resolve, clear, persistence and wrap at 10/40 MiB.
# -DPROBE=... -DOUTPUT=... -DAPI=d3d12|vulkan -DXENOS=ON|OFF
file(MAKE_DIRECTORY "${OUTPUT}")
get_filename_component(probe_directory "${PROBE}" DIRECTORY)
set(backends native)
if(XENOS)
  list(APPEND backends xenos)
  if(MINMAX_BLEND OR VERTEX_ALIASES)
    list(APPEND backends xenos-host)
  endif()
endif()
set(clear_modes OFF ON)
set(configurations standard:0 extended:4096 extended:8191 standard:8191)
if(MINMAX_BLEND OR VERTEX_ALIASES)
  set(clear_modes OFF)
  set(configurations standard:0)
endif()
set(alias_modes OFF)
set(frame_count 6)
if(VERTEX_ALIASES)
  list(APPEND alias_modes ON)
  set(frame_count 8)
endif()
foreach(clear IN LISTS clear_modes)
  unset(expected)
  foreach(aliases IN LISTS alias_modes)
    foreach(backend IN LISTS backends)
      set(expected_key expected)
      if(VERTEX_ALIASES)
        # Address aliases preserve each backend's own physical-address output.
        set(expected_key expected_${backend})
      endif()
      foreach(configuration IN LISTS configurations)
        string(REPLACE ":" ";" fields "${configuration}")
        list(GET fields 0 capacity)
        list(GET fields 1 base)
        set(options)
        if(backend MATCHES "^xenos")
          list(APPEND options --xenos)
        endif()
        if(VERTEX_ALIASES)
          list(APPEND options --no-sample-counts)
        endif()
        if(aliases)
          list(APPEND options --vertex-aliases)
        endif()
        if(MINMAX_BLEND)
          list(APPEND options --minmax-blend --no-sample-counts)
        endif()
        list(APPEND options --edram-base "${base}")
        if(clear)
          list(APPEND options --clear-after-resolve --no-sample-counts)
        endif()
        list(APPEND options "gpu.xenos.edram_tile_count=${capacity}")
        if(backend MATCHES "^xenos")
          if(API STREQUAL "d3d12")
            if(backend STREQUAL "xenos-host")
              list(APPEND options gpu.d3d12.render_target_path=rtv)
            else()
              list(APPEND options gpu.d3d12.render_target_path=rov)
            endif()
          else()
            if(backend STREQUAL "xenos-host")
              list(APPEND options gpu.vulkan.render_target_path=fbo)
            else()
              list(APPEND options gpu.vulkan.render_target_path=fsi)
            endif()
          endif()
          list(APPEND options gpu.xenos.async_shader_compilation=false gpu.xenos.readback_resolve=full)
        endif()
        set(runtime_start 0)
        if(EXISTS "${OUTPUT}/runtime.log")
          file(SIZE "${OUTPUT}/runtime.log" runtime_start)
        endif()
        execute_process(COMMAND "${PROBE}" "${OUTPUT}" "${API}" ${frame_count} ${options}
            WORKING_DIRECTORY "${probe_directory}" TIMEOUT 75
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        file(WRITE "${OUTPUT}/current.log" "${out}${err}")
        if(NOT result EQUAL 0 OR NOT out MATCHES "PASS frames=${frame_count}")
          if(API STREQUAL "d3d12" AND EXISTS "${OUTPUT}/runtime.log")
            file(SIZE "${OUTPUT}/runtime.log" runtime_end)
            if(runtime_end LESS runtime_start)
              set(runtime_start 0)
            endif()
            file(READ "${OUTPUT}/runtime.log" runtime OFFSET ${runtime_start})
            if(runtime MATCHES "Microsoft Basic Render Driver" AND
                "${out}${err}" MATCHES "render GPU timeout|fence 0 of")
              message(FATAL_ERROR "requires a hardware D3D12 adapter: WARP did not complete a ROV draw")
            endif()
          endif()
          message(FATAL_ERROR "${backend}/${API} ${configuration} clear=${clear}: ${result}\n${out}${err}")
        endif()
        string(REGEX MATCHALL "frame [0-9]+ scanout [0-9a-f]+" hashes "${out}")
        list(LENGTH hashes count)
        if(NOT count EQUAL frame_count OR (DEFINED ${expected_key} AND NOT hashes STREQUAL "${${expected_key}}"))
          message(FATAL_ERROR "${backend}/${API} ${configuration} clear=${clear} aliases=${aliases}: mismatched frame hashes\n${hashes}\n${${expected_key}}")
        endif()
        set(${expected_key} "${hashes}")
        message("${backend}/${API} ${configuration} clear=${clear} aliases=${aliases}: ${frame_count} matching frame hashes")
      endforeach()
    endforeach()
  endforeach()
endforeach()
