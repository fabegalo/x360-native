cmake_minimum_required(VERSION 3.25)
include("${ROOT}/cmake/sdk/x360n_title_sdk.cmake")
file(MAKE_DIRECTORY "${WORK}/llvm/bin")
file(WRITE "${WORK}/llvm/bin/ld.lld" "synthetic linker, never executed\n")
set(CMAKE_CXX_COMPILER "${WORK}/llvm/bin/clang++")
set(CMAKE_CXX_COMPILER_ID Clang)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
unset(REXGLUE_LLD)
x360n_configure_sdk_toolchain()
if(NOT REXGLUE_LLD STREQUAL "${WORK}/llvm/bin/ld.lld")
    message(FATAL_ERROR "Portable LLVM linker was not selected")
endif()
set(REXGLUE_LLD explicit-user-linker)
x360n_configure_sdk_toolchain()
if(NOT REXGLUE_LLD STREQUAL "explicit-user-linker")
    message(FATAL_ERROR "Explicit linker was replaced")
endif()
unset(REXGLUE_LLD)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
x360n_configure_sdk_toolchain()
if(REXGLUE_LLD)
    message(FATAL_ERROR "Large-model linker forced on ARM64")
endif()
set(CMAKE_SYSTEM_PROCESSOR x86_64)
foreach(CMAKE_SYSTEM_NAME Windows Darwin)
    x360n_configure_sdk_toolchain()
    if(REXGLUE_LLD)
        message(FATAL_ERROR "ELF linker selected for ${CMAKE_SYSTEM_NAME}")
    endif()
endforeach()
set(CMAKE_SYSTEM_NAME Linux)
file(REMOVE "${WORK}/llvm/bin/ld.lld")
x360n_configure_sdk_toolchain()
if(REXGLUE_LLD)
    message(FATAL_ERROR "Missing portable linker was accepted")
endif()
file(REMOVE_RECURSE "${WORK}")
message(STATUS "Portable, explicit, missing and platform linker selection passed")
